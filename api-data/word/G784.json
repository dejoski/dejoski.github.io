{"G7840":{"base":"G7840","renderings":{"total":0,"top":[]},"entries":[{"sn":"G7840","base":"G7840","lang":"g","lemma":"καταδύω","tr":"kataduō","pos":"G:V","gloss":"to descend into","def":"1. intransitive, in active present καταδύνω and middle καταδύομαι:—; to go down, sink, set , of the sun, ἠέλιος κατέδυ (Iliad by Homer); ἐς ἠέλιον καταδύντα till sun set , (Odyssey by Homer); of ships, to be sunk or rather to be disabled (see. infr. II), (Herdotus Historicus):—;of persons, καταδεδυκώς having popped down , (Aristophanes Comicus) \n2. to go down into, plunge into , with accusative, καταδῦναι ὅμιλον,…","uses":0}],"top":[]},"G7841":{"base":"G7841","renderings":{"total":0,"top":[]},"entries":[{"sn":"G7841","base":"G7841","lang":"g","lemma":"καταθαρσέω","tr":"katatharseō","pos":"G:V","gloss":"to rely upon","def":"to rely upon with confidence","uses":0}],"top":[]},"G7842":{"base":"G7842","renderings":{"total":0,"top":[]},"entries":[{"sn":"G7842","base":"G7842","lang":"g","lemma":"καταθλάω","tr":"katathlaō","pos":"G:V","gloss":"to break in pieces","def":"to break in pieces","uses":0}],"top":[]},"G7843":{"base":"G7843","renderings":{"total":0,"top":[]},"entries":[{"sn":"G7843","base":"G7843","lang":"g","lemma":"καταθύμιος","tr":"katathumios","pos":"G:A","gloss":"wishes","def":"1. in the mind or thoughts , (Odyssey by Homer); μηδέ τί τοι θάνατος κατ. ἔστω let not death sit heavy on thy heart , (Iliad by Homer) \n2. according to one's mind, satisfactory , (Theognis Elegiacus) (ML)","uses":0}],"top":[]},"G7844":{"base":"G7844","renderings":{"total":0,"top":[]},"entries":[{"sn":"G7844","base":"G7844","lang":"g","lemma":"καταιγίς","tr":"kataigis","pos":"G:N-F","gloss":"a blast","def":"a blast; gale","uses":0}],"top":[]},"G7845":{"base":"G7845","renderings":{"total":0,"top":[]},"entries":[{"sn":"G7845","base":"G7845","lang":"g","lemma":"κατακάλυμμα","tr":"katakalumma","pos":"G:N-N","gloss":"an overcovering","def":"an overcovering","uses":0}],"top":[]},"G7846":{"base":"G7846","ren