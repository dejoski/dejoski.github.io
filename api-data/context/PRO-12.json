{"1-7":{"people":[],"places":[],"words":[{"base":"H6662","lemma":"צַדִּיק","tr":"tsad·diq","gloss":"righteous","lang":"h","inPassage":3,"uses":206},{"base":"H7563","lemma":"רָשָׁע","tr":"ra·sah","gloss":"wicked","lang":"h","inPassage":3,"uses":263},{"base":"H0157","lemma":"אָהֵב","tr":"a·hav","gloss":"to love: lover","lang":"h","inPassage":2,"uses":211},{"base":"H1198","lemma":"בַּ֫עַר","tr":"ba·ar","gloss":"stupid","lang":"h","inPassage":1,"uses":5},{"base":"H7538","lemma":"רָקָב","tr":"ra·qav","gloss":"rottenness","lang":"h","inPassage":1,"uses":5},{"base":"H8458","lemma":"תַּחְבֻּלָה","tr":"tach·bu·lah","gloss":"counsel","lang":"h","inPassage":1,"uses":6},{"base":"H6329","lemma":"פּוּק","tr":"puq","gloss":"to promote","lang":"h","inPassage":1,"uses":7},{"base":"H4209","lemma":"מְזִמָּה","tr":"me·zim·mah","gloss":"plot","lang":"h","inPassage":1,"uses":19},{"base":"H5850","lemma":"עֲטָרָה","tr":"a·ta·rah","gloss":"crown","lang":"h","inPassage":1,"uses":23},{"base":"H8433","lemma":"תּוֹכֵחָה","tr":"to·khe·chah","gloss":"rebuke","lang":"h","inPassage":1,"uses":28}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":15,"verse":10,"verseEnd":10,"votes":20,"source":"openbible","text":"Discipline is harsh for him who leaves the path; he who hates correction will die.","from":1},{"book":"PRO","chapter":9,"verse":7,"verseEnd":7,"votes":17,"source":"openbible","text":"He who corrects a mocker brings shame on himself; he who rebukes a wicked man taints himself.","from":1},{"book":"PRO","chapter":9,"verse":8,"verseEnd":8,"votes":17,"source":"openbible","text":"Do not rebuke a mocker, or he will hate you; rebuke a wise man, and he will love you.","from":1},{"book":"PSA","chapter":119,"verse":97,"verseEnd":97,"votes":15,"source":"openbible","text":"Oh, how I love Your law! All day long it is my meditation.","from":1},{"book":"PSA","chapter":119,"verse":100,"verseEnd":100,"votes":15,"source":"openbible","text":"I discern more than the elders, for I obey Your precepts.","from":1},{"book":"PRO","chapter":10,"verse":25,"verseEnd":25,"votes":12,"source":"both","text":"When the whirlwind passes, the wicked are no more, but the righteous are secure forever.","from":3},{"book":"PRO","chapter":18,"verse":1,"verseEnd":1,"votes":11,"source":"both","text":"He who isolates himself pursues selfish desires; he rebels against all sound judgment.","from":1},{"book":"PSA","chapter":32,"verse":9,"verseEnd":9,"votes":10,"source":"both","text":"Do not be like the horse or mule, which have no understanding; they must be controlled with bit and bridle to make them come to you.","from":1}],"notes":[],"groups":[]},"8-14":{"people":[],"places":[],"words":[{"base":"H6662","lemma":"צַדִּיק","tr":"tsad·diq","gloss":"righteous","lang":"h","inPassage":3,"uses":206},{"base":"H2638","lemma":"חָסֵר","tr":"cha·ser","gloss":"lacking","lang":"h","inPassage":2,"uses":17},{"base":"H7646","lemma":"שָׂבֵעַ","tr":"sa·va","gloss":"to satisfy","lang":"h","inPassage":2,"uses":97},{"base":"H7563","lemma":"רָשָׁע","tr":"ra·sah","gloss":"wicked","lang":"h","inPassage":2,"uses":263},{"base":"H3899","lemma":"לֶ֫חֶם","tr":"le·chem","gloss":"food","lang":"h","inPassage":2,"uses":298},{"base":"H6310","lemma":"פֶּה","tr":"peh","gloss":"lip","lang":"h","inPassage":2,"uses":498},{"base":"H2896","lemma":"טוֹב","tr":"tov","gloss":"pleasant","lang":"h","inPassage":2,"uses":538},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":2,"uses":595},{"base":"H7034","lemma":"קָלָה","tr":"qa·lah","gloss":"to dishonor","lang":"h","inPassage":1,"uses":6},{"base":"H4685","lemma":"מָצוֹד","tr":"ma·tsod","gloss":"siegework","lang":"h","inPassage":1,"uses":7}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":28,"verse":19,"verseEnd":19,"votes":15,"source":"both","text":"The one who works his land will have plenty of food, but whoever chases fantasies will have his fill of poverty.","from":11},{"book":"DEU","chapter":25,"verse":4,"verseEnd":4,"votes":14,"source":"both","text":"Do not muzzle an ox while it is treading out the grain.","from":10},{"book":"PRO","chapter":14,"verse":23,"verseEnd":23,"votes":12,"source":"both","text":"There is profit in all labor, but mere talk leads only to poverty.","from":11},{"book":"PRO","chapter":18,"verse":20,"verseEnd":20,"votes":12,"source":"openbible","text":"From the fruit of his mouth a manʼs belly is filled; with the harvest from his lips he is satisfied.","from":14},{"book":"PRO","chapter":18,"verse":21,"verseEnd":21,"votes":12,"source":"openbible","text":"Life and death are in the power of the tongue, and those who love it will eat its fruit.","from":14},{"book":"ISA","chapter":3,"verse":10,"verseEnd":10,"votes":11,"source":"openbible","text":"Tell the righteous it will be well with them, for they will enjoy the fruit of their labor.","from":14},{"book":"ISA","chapter":3,"verse":11,"verseEnd":11,"votes":11,"source":"openbible","text":"Woe to the wicked; disaster is upon them! For they will be repaid with what their hands have done.","from":14},{"book":"LUK","chapter":14,"verse":11,"verseEnd":11,"votes":10,"source":"both","text":"For everyone who exalts himself will be humbled, and the one who humbles himself will be exalted.”","from":9}],"notes":[],"groups":[]},"15-19":{"people":[],"places":[],"words":[{"base":"H0191","lemma":"אֱוִיל","tr":"e·vil","gloss":"fool(ish)","lang":"h","inPassage":2,"uses":26},{"base":"H8267","lemma":"שֶׁ֫קֶר","tr":"she·qer","gloss":"deception","lang":"h","inPassage":2,"uses":113},{"base":"H3956","lemma":"לָשׁוֹן","tr":"la·shon","gloss":"tongue","lang":"h","inPassage":2,"uses":117},{"base":"H2450","lemma":"חָכָם","tr":"cha·kham","gloss":"wise","lang":"h","inPassage":2,"uses":138},{"base":"H0981","lemma":"בָּטָה","tr":"ba·tah","gloss":"to speak rashly","lang":"h","inPassage":1,"uses":4},{"base":"H6175","lemma":"עָרוּם","tr":"a·rum","gloss":"prudent","lang":"h","inPassage":1,"uses":11},{"base":"H7280","lemma":"רָגַע","tr":"ra·ga","gloss":"to disturb","lang":"h","inPassage":1,"uses":13},{"base":"H6315","lemma":"פּוּחַ","tr":"pu·ach","gloss":"to breathe","lang":"h","inPassage":1,"uses":14},{"base":"H4832","lemma":"מַרְפֵּא","tr":"mar·pe","gloss":"healing","lang":"h","inPassage":1,"uses":16},{"base":"H7036","lemma":"קָלוֹן","tr":"qa·lon","gloss":"dishonor","lang":"h","inPassage":1,"uses":17}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":16,"verse":24,"verseEnd":24,"votes":19,"source":"both","text":"Pleasant words are a honeycomb, sweet to the soul and healing to the bones.","from":18},{"book":"PRO","chapter":15,"verse":4,"verseEnd":4,"votes":16,"source":"openbible","text":"A soothing tongue is a tree of life, but a perverse tongue crushes the spirit.","from":18},{"book":"PRO","chapter":3,"verse":7,"verseEnd":7,"votes":15,"source":"both","text":"Be not wise in your own eyes; fear the LORD and turn away from evil.","from":15},{"book":"PRO","chapter":29,"verse":11,"verseEnd":11,"votes":13,"source":"both","text":"A fool vents all his anger, but a wise man holds it back.","from":16},{"book":"PRO","chapter":14,"verse":16,"verseEnd":16,"votes":10,"source":"both","text":"A wise man fears and turns from evil, but a fool is careless and reckless.","from":15},{"book":"PRO","chapter":19,"verse":9,"verseEnd":9,"votes":10,"source":"both","text":"A false witness will not go unpunished, and one who pours out lies will perish.","from":19},{"book":"PRO","chapter":19,"verse":20,"verseEnd":20,"votes":10,"source":"both","text":"Listen to counsel and accept discipline, that you may be wise the rest of your days.","from":15},{"book":"PRO","chapter":1,"verse":5,"verseEnd":5,"votes":9,"source":"both","text":"let the wise listen and gain instruction, and the discerning acquire wise counsel","from":15}],"notes":[],"groups":[]},"20-28":{"people":[],"places":[],"words":[{"base":"H7423","lemma":"רְמִיָּה","tr":"re·miy·yah","gloss":"deceit","lang":"h","inPassage":2,"uses":15},{"base":"H2742","lemma":"חָרוּץ","tr":"cha·ruts","gloss":"sharp","lang":"h","inPassage":2,"uses":19},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":3,"uses":595},{"base":"H6662","lemma":"צַדִּיק","tr":"tsad·diq","gloss":"righteous","lang":"h","inPassage":2,"uses":206},{"base":"H7563","lemma":"רָשָׁע","tr":"ra·sah","gloss":"wicked","lang":"h","inPassage":2,"uses":263},{"base":"H0579","lemma":"אָנָה","tr":"a·nah","gloss":"to meet","lang":"h","inPassage":1,"uses":4},{"base":"H0120","lemma":"אָדָם","tr":"a·dam","gloss":"man","lang":"h","inPassage":2,"uses":550},{"base":"H1674","lemma":"דְּאָגָה","tr":"de·a·gah","gloss":"anxiety","lang":"h","inPassage":1,"uses":6},{"base":"H7451","lemma":"רַע","tr":"ra","gloss":"bad: harmful","lang":"h","inPassage":2,"uses":661},{"base":"H1870","lemma":"דֶּ֫רֶךְ","tr":"de·rekh","gloss":"way: conduct","lang":"h","inPassage":2,"uses":706}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":16,"verse":24,"verseEnd":24,"votes":26,"source":"both","text":"Pleasant words are a honeycomb, sweet to the soul and healing to the bones.","from":25},{"book":"PRO","chapter":15,"verse":13,"verseEnd":13,"votes":23,"source":"both","text":"A joyful heart makes a cheerful countenance, but sorrow of the heart crushes the spirit.","from":25},{"book":"PRO","chapter":17,"verse":22,"verseEnd":22,"votes":22,"source":"both","text":"A joyful heart is good medicine, but a broken spirit dries up the bones.","from":25},{"book":"ISA","chapter":50,"verse":4,"verseEnd":4,"votes":20,"source":"both","text":"The Lord GOD has given Me the tongue of discipleship, to sustain the weary with a word. He awakens Me morning by morning; He awakens My ear to listen as a disciple.","from":25},{"book":"PRO","chapter":15,"verse":23,"verseEnd":23,"votes":19,"source":"both","text":"A man takes joy in a fitting reply— and how good is a timely word!","from":25},{"book":"PRO","chapter":12,"verse":18,"verseEnd":18,"votes":13,"source":"both","text":"Speaking rashly is like a piercing sword, but the tongue of the wise brings healing.","from":25},{"book":"ZEC","chapter":1,"verse":13,"verseEnd":13,"votes":13,"source":"both","text":"So the LORD spoke kind and comforting words to the angel who was speaking with me.","from":25},{"book":"PSA","chapter":5,"verse":6,"verseEnd":6,"votes":12,"source":"both","text":"You destroy those who tell lies; the LORD abhors the man of bloodshed and deceit.","from":22}],"notes":[],"groups":[]}}