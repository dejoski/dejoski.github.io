{"1-5":{"people":[{"id":"moses-h4872","name":"Moses","kind":"person","brief":"Son of Amram","count":2,"firstVerse":1},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":1,"firstVerse":2},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":1,"firstVerse":2}],"places":[{"id":"judea-h3063n","name":"Judea","kind":"place","brief":"","count":1,"firstVerse":1},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":2,"firstVerse":2},{"id":"phoenicia-g5403","name":"Phoenicia","kind":"place","brief":"","count":1,"firstVerse":3},{"id":"samaria-h8111","name":"Samaria","kind":"place","brief":"","count":1,"firstVerse":3}],"words":[{"base":"G5037","lemma":"τε","tr":"te","gloss":"and","lang":"g","inPassage":3,"uses":215},{"base":"G4059","lemma":"περιτέμνω","tr":"peritemnō","gloss":"to circumcise","lang":"g","inPassage":2,"uses":17},{"base":"G0921","lemma":"Βαρνάβας","tr":"Barnabas","gloss":"Barnabas","lang":"g","inPassage":2,"uses":28},{"base":"G5100","lemma":"τις","tr":"tis","gloss":"one","lang":"g","inPassage":3,"uses":530},{"base":"G4245","lemma":"πρεσβύτερος","tr":"presbuteros","gloss":"elder: Elder","lang":"g","inPassage":2,"uses":65},{"base":"G0575","lemma":"ἀπό","tr":"apo","gloss":"away from","lang":"g","inPassage":3,"uses":644},{"base":"G2419","lemma":"Ἱερουσαλήμ","tr":"Hierousalēm","gloss":"Jerusalem","lang":"g","inPassage":2,"uses":77},{"base":"G3475","lemma":"Μωϋσῆς, Μωσῆς","tr":"Mōusēs, Mōsēs","gloss":"Moses","lang":"g","inPassage":2,"uses":79},{"base":"G0652","lemma":"ἀπόστολος","tr":"apostolos","gloss":"apostle","lang":"g","inPassage":2,"uses":80},{"base":"G1577","lemma":"ἐκκλησία","tr":"ekklēsia","gloss":"assembly","lang":"g","inPassage":2,"uses":114}],"parallels":[],"crossrefs":[{"book":"GAL","chapter":5,"verse":6,"verseEnd":6,"votes":15,"source":"both","text":"For in Christ Jesus neither circumcision nor uncircumcision has any value. What matters is faith, expressing itself through love.","from":1},{"book":"COL","chapter":2,"verse":8,"verseEnd":8,"votes":11,"source":"both","text":"See to it that no one takes you captive through philosophy and empty deception, which are based on human tradition and the spiritual forces of the world rather than on Christ.","from":1},{"book":"LEV","chapter":12,"verse":3,"verseEnd":3,"votes":10,"source":"both","text":"And on the eighth day the flesh of the boyʼs foreskin is to be circumcised.","from":1},{"book":"GAL","chapter":2,"verse":11,"verseEnd":11,"votes":8,"source":"openbible","text":"When Cephas came to Antioch, however, I opposed him to his face, because he stood to be condemned.","from":1},{"book":"GAL","chapter":2,"verse":14,"verseEnd":14,"votes":8,"source":"openbible","text":"When I saw that they were not walking in line with the truth of the gospel, I said to Cephas in front of them all, “If you, who are a Jew, live like a Gentile and not like a Jew, how can you compel the Gentiles to live like Jews?”","from":1},{"book":"ACT","chapter":15,"verse":24,"verseEnd":24,"votes":7,"source":"both","text":"It has come to our attention that some went out from us without our authorization and unsettled you, troubling your minds by what they said.","from":1},{"book":"ROM","chapter":4,"verse":8,"verseEnd":8,"votes":7,"source":"openbible","text":"Blessed is the man whose sin the Lord will never count against him.”","from":1},{"book":"ROM","chapter":4,"verse":12,"verseEnd":12,"votes":7,"source":"openbible","text":"And he is also the father of the circumcised who not only are circumcised, but who also walk in the footsteps of the faith that our father Abraham had before he was circumcised.","from":1}],"notes":[],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":2},{"id":"herod-family","title":"The Herods","people":2},{"id":"jerusalem-church","title":"The Jerusalem Church","people":2}]},"6-12":{"people":[{"id":"peter-g4074g","name":"Peter","kind":"person","brief":"An apostle","count":1,"firstVerse":7},{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":11},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":1,"firstVerse":12},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":1,"firstVerse":12}],"places":[],"words":[{"base":"G1223","lemma":"διά","tr":"dia","gloss":"through","lang":"g","inPassage":3,"uses":666},{"base":"G3777","lemma":"οὔτε","tr":"oute","gloss":"neither","lang":"g","inPassage":2,"uses":87},{"base":"G1484","lemma":"ἔθνος","tr":"ethnos","gloss":"Gentiles","lang":"g","inPassage":2,"uses":162},{"base":"G5037","lemma":"τε","tr":"te","gloss":"and","lang":"g","inPassage":2,"uses":215},{"base":"G4100","lemma":"πιστεύω","tr":"pisteuō","gloss":"to trust (in)","lang":"g","inPassage":2,"uses":237},{"base":"G3056","lemma":"λόγος","tr":"logos","gloss":"word","lang":"g","inPassage":2,"uses":329},{"base":"G2589","lemma":"καρδιογνώστης","tr":"kardiognōstēs","gloss":"heart-knower","lang":"g","inPassage":1,"uses":2},{"base":"G0191","lemma":"ἀκούω","tr":"akouō","gloss":"to hear","lang":"g","inPassage":2,"uses":426},{"base":"G1834","lemma":"ἐξηγέομαι","tr":"exēgeomai","gloss":"to tell","lang":"g","inPassage":1,"uses":6},{"base":"G2218","lemma":"ζυγός","tr":"zugos","gloss":"yoke","lang":"g","inPassage":1,"uses":6}],"parallels":[],"crossrefs":[{"book":"ROM","chapter":3,"verse":24,"verseEnd":24,"votes":14,"source":"both","text":"and are justified freely by His grace through the redemption that is in Christ Jesus.","from":11},{"book":"TIT","chapter":3,"verse":4,"verseEnd":4,"votes":10,"source":"openbible","text":"But when the kindness of God our Savior and His love for mankind appeared,","from":11},{"book":"TIT","chapter":3,"verse":7,"verseEnd":7,"votes":10,"source":"openbible","text":"so that, having been justified by His grace, we would become heirs with the hope of eternal life.","from":11},{"book":"MAT","chapter":23,"verse":4,"verseEnd":4,"votes":9,"source":"both","text":"They tie up heavy, burdensome loads and lay them on menʼs shoulders, but they themselves are not willing to lift a finger to move them.","from":10},{"book":"GAL","chapter":5,"verse":1,"verseEnd":1,"votes":9,"source":"both","text":"It is for freedom that Christ has set us free. Stand firm, then, and do not be encumbered once more by a yoke of slavery.","from":10},{"book":"TIT","chapter":2,"verse":11,"verseEnd":11,"votes":8,"source":"both","text":"For the grace of God has appeared, bringing salvation to everyone.","from":11},{"book":"GAL","chapter":2,"verse":16,"verseEnd":16,"votes":7,"source":"both","text":"know that a man is not justified by works of the law, but by faith in Jesus Christ. So we, too, have believed in Christ Jesus, that we may be justified by faith in Christ and not by works of the law, because by works of the law no one will be justified.","from":11},{"book":"EPH","chapter":2,"verse":5,"verseEnd":5,"votes":7,"source":"openbible","text":"made us alive with Christ even when we were dead in our trespasses. It is by grace you have been saved!","from":11}],"notes":[],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":4},{"id":"herod-family","title":"The Herods","people":4},{"id":"jerusalem-church","title":"The Jerusalem Church","people":4},{"id":"high-priestly-family","title":"The High-Priestly Family","people":3},{"id":"roman-officials","title":"Roman Officials","people":3},{"id":"john-baptist-circle","title":"John the Baptist's Circle","people":2}]},"13-21":{"people":[{"id":"james-g2385i","name":"James","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":13},{"id":"peter-g4074g","name":"Peter","kind":"person","brief":"An apostle","count":1,"firstVerse":14},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":16},{"id":"moses-h4872","name":"Moses","kind":"person","brief":"Son of Amram","count":1,"firstVerse":21}],"places":[],"words":[{"base":"G0456","lemma":"ἀνοικοδομέω","tr":"anoikodomeō","gloss":"to rebuild","lang":"g","inPassage":2,"uses":2},{"base":"G1484","lemma":"ἔθνος","tr":"ethnos","gloss":"Gentiles","lang":"g","inPassage":3,"uses":162},{"base":"G1909","lemma":"ἐπί","tr":"epi","gloss":"upon","lang":"g","inPassage":3,"uses":885},{"base":"G2531","lemma":"καθώς","tr":"kathōs","gloss":"as","lang":"g","inPassage":2,"uses":182},{"base":"G3686","lemma":"ὄνομα","tr":"onoma","gloss":"name","lang":"g","inPassage":2,"uses":229},{"base":"G2679","lemma":"κατασκάπτω","tr":"kataskaptō","gloss":"to ruin","lang":"g","inPassage":1,"uses":2},{"base":"G0461","lemma":"ἀνορθόω","tr":"anorthoō","gloss":"to restore","lang":"g","inPassage":1,"uses":3},{"base":"G1989","lemma":"ἐπιστέλλω","tr":"epistellō","gloss":"to write to","lang":"g","inPassage":1,"uses":3},{"base":"G4156","lemma":"πνικτός","tr":"pniktos","gloss":"strangled","lang":"g","inPassage":1,"uses":3},{"base":"G3326","lemma":"μετά","tr":"meta","gloss":"with","lang":"g","inPassage":2,"uses":465}],"parallels":[],"crossrefs":[{"book":"AMO","chapter":9,"verse":11,"verseEnd":11,"votes":63,"source":"openbible","text":"“In that day I will restore the fallen tent of David. I will repair its gaps, restore its ruins, and rebuild it as in the days of old,","from":16},{"book":"AMO","chapter":9,"verse":12,"verseEnd":12,"votes":63,"source":"openbible","text":"that they may possess the remnant of Edom and all the nations that bear My name,” declares the LORD, who will do this.","from":16},{"book":"ZEC","chapter":2,"verse":11,"verseEnd":11,"votes":18,"source":"both","text":"“On that day many nations will join themselves to the LORD, and they will become My people. I will dwell among you, and you will know that the LORD of Hosts has sent Me to you.","from":17},{"book":"ZEC","chapter":8,"verse":20,"verseEnd":20,"votes":14,"source":"openbible","text":"This is what the LORD of Hosts says: “Peoples will yet come—the residents of many cities—","from":17},{"book":"ZEC","chapter":8,"verse":23,"verseEnd":23,"votes":14,"source":"openbible","text":"This is what the LORD of Hosts says: “In those days ten men from the nations of every tongue will tightly grasp the robe of a Jew, saying, ‘Let us go with you, for we have heard that God is with you.’”","from":17},{"book":"ISA","chapter":65,"verse":1,"verseEnd":1,"votes":12,"source":"both","text":"“I revealed Myself to those who did not ask for Me; I was found by those who did not seek Me. To a nation that did not call My name, I said, ‘Here I am! Here I am!’","from":17},{"book":"HOS","chapter":2,"verse":23,"verseEnd":23,"votes":11,"source":"both","text":"And I will sow her as My own in the land, and I will have compassion on ‘No Compassion.’ I will say to those called ‘Not My People,’ ‘You are My people,’ and they will say, ‘You are my God.’”","from":17},{"book":"ACT","chapter":15,"verse":29,"verseEnd":29,"votes":9,"source":"both","text":"You must abstain from food sacrificed to idols, from blood, from the meat of strangled animals, and from sexual immorality. You will do well to avoid these things. Farewell.","from":20}],"notes":[{"id":"amos-9-11","title":"David's fallen tent restored","kind":"prophecy"}],"groups":[{"id":"jerusalem-church","title":"The Jerusalem Church","people":2}]},"22-29":{"people":[{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":2,"firstVerse":22},{"id":"judas-g2455m","name":"Judas","kind":"person","brief":"","count":2,"firstVerse":22},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":2,"firstVerse":22},{"id":"silas-g4609","name":"Silas","kind":"person","brief":"","count":2,"firstVerse":22},{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":26}],"places":[{"id":"antioch-g0490g","name":"Antioch","kind":"place","brief":"","count":2,"firstVerse":22},{"id":"cilicia-g2791","name":"Cilicia","kind":"place","brief":"","count":1,"firstVerse":23},{"id":"syria-h0758i","name":"Syria","kind":"place","brief":"","count":1,"firstVerse":23}],"words":[{"base":"G1380","lemma":"δοκέω","tr":"dokeō","gloss":"to think","lang":"g","inPassage":3,"uses":62},{"base":"G4862","lemma":"σύν","tr":"sun","gloss":"with","lang":"g","inPassage":3,"uses":128},{"base":"G4609","lemma":"Σίλας","tr":"Silas","gloss":"Silas","lang":"g","inPassage":2,"uses":12},{"base":"G0435","lemma":"ἀνήρ","tr":"anēr","gloss":"man","lang":"g","inPassage":3,"uses":216},{"base":"G1537","lemma":"ἐκ","tr":"ek","gloss":"out from","lang":"g","inPassage":4,"uses":913},{"base":"G0490","lemma":"Ἀντιόχεια","tr":"Antiocheia","gloss":"Antioch","lang":"g","inPassage":2,"uses":18},{"base":"G1586","lemma":"ἐκλέγω","tr":"eklegō","gloss":"to select","lang":"g","inPassage":2,"uses":22},{"base":"G0080","lemma":"ἀδελφός","tr":"adelphos","gloss":"brother","lang":"g","inPassage":3,"uses":343},{"base":"G0921","lemma":"Βαρνάβας","tr":"Barnabas","gloss":"Barnabas","lang":"g","inPassage":2,"uses":28},{"base":"G2455","lemma":"Ἰούδας","tr":"Ioudas","gloss":"Judas","lang":"g","inPassage":2,"uses":41}],"parallels":[],"crossrefs":[{"book":"ACT","chapter":15,"verse":20,"verseEnd":20,"votes":17,"source":"both","text":"Instead, we should write and tell them to abstain from food polluted by idols, from sexual immorality, from the meat of strangled animals, and from blood.","from":29},{"book":"ACT","chapter":21,"verse":25,"verseEnd":25,"votes":10,"source":"both","text":"As for the Gentile believers, we have written to them our decision that they must abstain from food sacrificed to idols, from blood, from the meat of strangled animals, and from sexual immorality.”","from":29},{"book":"GAL","chapter":5,"verse":12,"verseEnd":12,"votes":9,"source":"both","text":"As for those who are agitating you, I wish they would proceed to emasculate themselves!","from":24},{"book":"ACT","chapter":15,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Then some men came down from Judea and were teaching the brothers, “Unless you are circumcised according to the custom of Moses, you cannot be saved.”","from":24},{"book":"GAL","chapter":5,"verse":10,"verseEnd":10,"votes":8,"source":"openbible","text":"I am confident in the Lord that you will take no other view. The one who is troubling you will bear the judgment, whoever he may be.","from":24},{"book":"TIT","chapter":1,"verse":10,"verseEnd":10,"votes":8,"source":"openbible","text":"For many are rebellious and full of empty talk and deception, especially those of the circumcision,","from":24},{"book":"TIT","chapter":1,"verse":11,"verseEnd":11,"votes":8,"source":"openbible","text":"who must be silenced. For the sake of dishonorable gain, they undermine entire households and teach things they should not.","from":24},{"book":"REV","chapter":2,"verse":14,"verseEnd":14,"votes":8,"source":"both","text":"But I have a few things against you, because some of you hold to the teaching of Balaam, who taught Balak to place a stumbling block before the Israelites so they would eat food sacrificed to idols and commit sexual immorality.","from":29}],"notes":[],"groups":[{"id":"jerusalem-church","title":"The Jerusalem Church","people":5},{"id":"paul-circle","title":"Paul's Circle","people":4},{"id":"herod-family","title":"The Herods","people":3},{"id":"high-priestly-family","title":"The High-Priestly Family","people":2},{"id":"roman-officials","title":"Roman Officials","people":2}]},"30-35":{"people":[{"id":"silas-g4609","name":"Silas","kind":"person","brief":"","count":2,"firstVerse":32},{"id":"judas-g2455m","name":"Judas","kind":"person","brief":"","count":1,"firstVerse":32},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":1,"firstVerse":35},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":1,"firstVerse":35}],"places":[{"id":"antioch-g0490g","name":"Antioch","kind":"place","brief":"","count":2,"firstVerse":30}],"words":[{"base":"G0490","lemma":"Ἀντιόχεια","tr":"Antiocheia","gloss":"Antioch","lang":"g","inPassage":2,"uses":18},{"base":"G0630","lemma":"ἀπολύω","tr":"apoluō","gloss":"to release: release","lang":"g","inPassage":2,"uses":64},{"base":"G3056","lemma":"λόγος","tr":"logos","gloss":"word","lang":"g","inPassage":2,"uses":329},{"base":"G0080","lemma":"ἀδελφός","tr":"adelphos","gloss":"brother","lang":"g","inPassage":2,"uses":343},{"base":"G4183","lemma":"πολύς","tr":"polus","gloss":"much","lang":"g","inPassage":2,"uses":367},{"base":"G3326","lemma":"μετά","tr":"meta","gloss":"with","lang":"g","inPassage":2,"uses":465},{"base":"G1991","lemma":"ἐπιστηρίζω","tr":"epistērizō","gloss":"to strengthen","lang":"g","inPassage":1,"uses":4},{"base":"G1304","lemma":"διατρίβω","tr":"diatribō","gloss":"to remain","lang":"g","inPassage":1,"uses":9},{"base":"G1929","lemma":"ἐπιδίδωμι","tr":"epididōmi","gloss":"to give","lang":"g","inPassage":1,"uses":9},{"base":"G4609","lemma":"Σίλας","tr":"Silas","gloss":"Silas","lang":"g","inPassage":1,"uses":12}],"parallels":[],"crossrefs":[{"book":"ACT","chapter":11,"verse":23,"verseEnd":23,"votes":5,"source":"both","text":"When he arrived and saw the grace of God, he rejoiced and encouraged them all to abide in the Lord with all their hearts.","from":32},{"book":"1CO","chapter":16,"verse":11,"verseEnd":11,"votes":5,"source":"both","text":"No one, then, should treat him with contempt. Send him on his way in peace so that he can return to me, for I am expecting him along with the brothers.","from":33},{"book":"GEN","chapter":26,"verse":29,"verseEnd":29,"votes":0,"source":"tsk","text":"that you will not harm us, just as we have not harmed you but have done only good to you, sending you on your way in peace. And now you are blessed by the Lord.”","from":33},{"book":"EXO","chapter":4,"verse":18,"verseEnd":18,"votes":0,"source":"tsk","text":"Then Moses went back to his father-in-law Jethro and said to him, “Please let me return to my brothers in Egypt to see if they are still alive.” “Go in peace,” Jethro replied.","from":33},{"book":"ISA","chapter":35,"verse":3,"verseEnd":4,"votes":0,"source":"tsk","text":"Strengthen the limp hands and steady the feeble knees! Say to those with anxious hearts: “Be strong, do not fear! Behold, your God will come with vengeance. With divine retribution He will come to save you.”","from":32},{"book":"MAT","chapter":23,"verse":34,"verseEnd":34,"votes":0,"source":"tsk","text":"Because of this, I am sending you prophets and wise men and teachers. Some of them you will kill and crucify, and others you will flog in your synagogues and persecute from town to town.","from":32},{"book":"MAT","chapter":28,"verse":19,"verseEnd":20,"votes":0,"source":"tsk","text":"Therefore go and make disciples of all nations, baptizing them in the name of the Father, and of the Son, and of the Holy Spirit, and teaching them to obey all that I have commanded you. And surely I am with you always, even to the end of the age.”","from":35},{"book":"LUK","chapter":11,"verse":49,"verseEnd":49,"votes":0,"source":"tsk","text":"Because of this, the wisdom of God said, ‘I will send them prophets and apostles; some of them they will kill and others they will persecute.’","from":32}],"notes":[],"groups":[{"id":"jerusalem-church","title":"The Jerusalem Church","people":4},{"id":"paul-circle","title":"Paul's Circle","people":3},{"id":"herod-family","title":"The Herods","people":2}]},"36-41":{"people":[{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":3,"firstVerse":36},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":3,"firstVerse":36},{"id":"mark-g3138","name":"Mark","kind":"person","brief":"Paul's companian","count":2,"firstVerse":37},{"id":"silas-g4609","name":"Silas","kind":"person","brief":"","count":1,"firstVerse":40}],"places":[{"id":"pamphylia-g3828","name":"Pamphylia","kind":"place","brief":"","count":1,"firstVerse":38},{"id":"cyprus-h3794h","name":"Cyprus","kind":"place","brief":"In Cyprus","count":1,"firstVerse":39},{"id":"cilicia-g2791","name":"Cilicia","kind":"place","brief":"","count":1,"firstVerse":41},{"id":"syria-h0758i","name":"Syria","kind":"place","brief":"","count":1,"firstVerse":41}],"words":[{"base":"G0921","lemma":"Βαρνάβας","tr":"Barnabas","gloss":"Barnabas","lang":"g","inPassage":3,"uses":28},{"base":"G4838","lemma":"συμπαραλαμβάνω","tr":"sumparalambanō","gloss":"to take along with","lang":"g","inPassage":2,"uses":4},{"base":"G3138","lemma":"Μάρκος","tr":"Markos","gloss":"Mark","lang":"g","inPassage":2,"uses":8},{"base":"G3972","lemma":"Παῦλος","tr":"Paulos","gloss":"Paul","lang":"g","inPassage":3,"uses":158},{"base":"G0575","lemma":"ἀπό","tr":"apo","gloss":"away from","lang":"g","inPassage":3,"uses":644},{"base":"G0080","lemma":"ἀδελφός","tr":"adelphos","gloss":"brother","lang":"g","inPassage":2,"uses":343},{"base":"G0673","lemma":"ἀποχωρίζω","tr":"apochōrizō","gloss":"to separate from","lang":"g","inPassage":1,"uses":2},{"base":"G1951","lemma":"ἐπιλέγω","tr":"epilegō","gloss":"to call","lang":"g","inPassage":1,"uses":2},{"base":"G3948","lemma":"παροξυσμός","tr":"paroxusmos","gloss":"stirring up","lang":"g","inPassage":1,"uses":2},{"base":"G1602","lemma":"ἐκπλέω","tr":"ekpleō","gloss":"to sail out","lang":"g","inPassage":1,"uses":3}],"parallels":[],"crossrefs":[{"book":"ACT","chapter":13,"verse":13,"verseEnd":13,"votes":12,"source":"both","text":"After setting sail from Paphos, Paul and his companions came to Perga in Pamphylia, where John left them to return to Jerusalem.","from":38},{"book":"ACT","chapter":12,"verse":12,"verseEnd":12,"votes":7,"source":"both","text":"And when he had realized this, he went to the house of Mary the mother of John, also called Mark, where many people had gathered together and were praying.","from":37},{"book":"ACT","chapter":15,"verse":23,"verseEnd":23,"votes":7,"source":"both","text":"and sent them with this letter: The apostles and the elders, your brothers, To the brothers among the Gentiles in Antioch, Syria, and Cilicia: Greetings.","from":41},{"book":"ACT","chapter":13,"verse":4,"verseEnd":4,"votes":6,"source":"both","text":"So Barnabas and Saul, sent forth by the Holy Spirit, went down to Seleucia and sailed from there to Cyprus.","from":36},{"book":"ACT","chapter":14,"verse":6,"verseEnd":6,"votes":6,"source":"both","text":"they found out about it and fled to the Lycaonian cities of Lystra and Derbe and to the surrounding region,","from":36},{"book":"ACT","chapter":13,"verse":13,"verseEnd":13,"votes":5,"source":"openbible","text":"After setting sail from Paphos, Paul and his companions came to Perga in Pamphylia, where John left them to return to Jerusalem.","from":36},{"book":"ACT","chapter":13,"verse":14,"verseEnd":14,"votes":5,"source":"openbible","text":"And from Perga, they traveled inland to Pisidian Antioch, where they entered the synagogue on the Sabbath and sat down.","from":36},{"book":"ACT","chapter":13,"verse":51,"verseEnd":51,"votes":5,"source":"both","text":"So they shook the dust off their feet in protest against them and went to Iconium.","from":36}],"notes":[],"groups":[{"id":"jerusalem-church","title":"The Jerusalem Church","people":5},{"id":"paul-circle","title":"Paul's Circle","people":4},{"id":"herod-family","title":"The Herods","people":2}]}}