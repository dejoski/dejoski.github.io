{"1-4":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H6963","lemma":"קוֹל","tr":"qol","gloss":"voice","lang":"h","inPassage":2,"uses":506},{"base":"H4498","lemma":"מָנוֹס","tr":"ma·nos","gloss":"refuge","lang":"h","inPassage":1,"uses":8},{"base":"H0369","lemma":"אַ֫יִן","tr":"a·yin","gloss":"nothing","lang":"h","inPassage":2,"uses":788},{"base":"H9030","lemma":"נִי","tr":"ni","gloss":"me","lang":"h","inPassage":2,"uses":908},{"base":"H7879","lemma":"שִׂיחַ","tr":"si·ach","gloss":"complaint","lang":"h","inPassage":1,"uses":14},{"base":"H2098","lemma":"זוּ","tr":"zu","gloss":"this","lang":"h","inPassage":1,"uses":15},{"base":"H5848","lemma":"עָטַף","tr":"a·taph","gloss":"to turn aside","lang":"h","inPassage":1,"uses":16},{"base":"H5410","lemma":"נָתִיב","tr":"na·tiv","gloss":"path","lang":"h","inPassage":1,"uses":26},{"base":"H6341","lemma":"פַּח","tr":"pach","gloss":"snare","lang":"h","inPassage":1,"uses":27},{"base":"H2934","lemma":"טָמַן","tr":"ta·man","gloss":"to hide","lang":"h","inPassage":1,"uses":31}],"parallels":[],"crossrefs":[{"book":"ROM","chapter":8,"verse":26,"verseEnd":26,"votes":11,"source":"both","text":"In the same way, the Spirit helps us in our weakness. For we do not know how we ought to pray, but the Spirit Himself intercedes for us with groans too deep for words.","from":2},{"book":"ISA","chapter":26,"verse":16,"verseEnd":16,"votes":10,"source":"both","text":"O LORD, they sought You in their distress; when You disciplined them, they poured out a quiet prayer.","from":2},{"book":"PSA","chapter":30,"verse":8,"verseEnd":8,"votes":8,"source":"openbible","text":"To You, O LORD, I called, and I begged my Lord for mercy:","from":1},{"book":"PSA","chapter":57,"verse":1,"verseEnd":1,"votes":8,"source":"openbible","text":"Have mercy on me, O God, have mercy, for in You my soul takes refuge. In the shadow of Your wings I will take shelter until the danger has passed.","from":1},{"book":"JER","chapter":30,"verse":17,"verseEnd":17,"votes":8,"source":"openbible","text":"But I will restore your health and heal your wounds, declares the LORD, because they call you an outcast, Zion, for whom no one cares.”","from":4},{"book":"PSA","chapter":31,"verse":11,"verseEnd":11,"votes":7,"source":"both","text":"Among all my enemies I am a disgrace, and among my neighbors even more. I am dreaded by my friends— they flee when they see me on the street.","from":4},{"book":"PSA","chapter":62,"verse":8,"verseEnd":8,"votes":7,"source":"both","text":"Trust in Him at all times, O people; pour out your hearts before Him. God is our refuge. Selah","from":2},{"book":"PSA","chapter":88,"verse":18,"verseEnd":18,"votes":7,"source":"both","text":"You have removed my beloved and my friend; darkness is my closest companion.","from":4}],"notes":[],"groups":[]},"5-7":{"people":[],"places":[],"words":[{"base":"H3803","lemma":"כָּתַר","tr":"ka·tar","gloss":"to surround","lang":"h","inPassage":1,"uses":6},{"base":"H4525","lemma":"מַסְגֵּר","tr":"mas·ger","gloss":"locksmith","lang":"h","inPassage":1,"uses":7},{"base":"H1809","lemma":"דָּלַל","tr":"da·lal","gloss":"to languish","lang":"h","inPassage":1,"uses":9},{"base":"H4268","lemma":"מַחְסֶּה","tr":"ma·cha·seh","gloss":"refuge","lang":"h","inPassage":1,"uses":20},{"base":"H7440","lemma":"רִנָּה","tr":"rin·nah","gloss":"cry","lang":"h","inPassage":1,"uses":33},{"base":"H1580","lemma":"גָּמַל","tr":"ga·mal","gloss":"to wean","lang":"h","inPassage":1,"uses":37},{"base":"H0553","lemma":"אָמֵץ","tr":"a·mats","gloss":"to strengthen","lang":"h","inPassage":1,"uses":41},{"base":"H7181","lemma":"קָשַׁב","tr":"qa·shav","gloss":"to listen","lang":"h","inPassage":1,"uses":46},{"base":"H2506","lemma":"חֵ֫לֶק","tr":"che·leq","gloss":"portion","lang":"h","inPassage":1,"uses":67},{"base":"H2199","lemma":"זָעַק","tr":"za·aq","gloss":"to cry out","lang":"h","inPassage":1,"uses":73}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":143,"verse":11,"verseEnd":11,"votes":11,"source":"both","text":"For the sake of Your name, O LORD, revive me. In Your righteousness, bring my soul out of trouble.","from":7},{"book":"PSA","chapter":146,"verse":7,"verseEnd":7,"votes":10,"source":"both","text":"He executes justice for the oppressed and gives food to the hungry. The LORD sets the prisoners free,","from":7},{"book":"PSA","chapter":7,"verse":6,"verseEnd":6,"votes":8,"source":"openbible","text":"Arise, O LORD, in Your anger; rise up against the fury of my enemies. Awake, my God, and ordain judgment.","from":7},{"book":"PSA","chapter":7,"verse":7,"verseEnd":7,"votes":8,"source":"openbible","text":"Let the assembled peoples gather around You; take Your seat over them on high.","from":7},{"book":"PSA","chapter":13,"verse":6,"verseEnd":6,"votes":7,"source":"both","text":"I will sing to the LORD, for He has been good to me.","from":7},{"book":"PSA","chapter":16,"verse":5,"verseEnd":5,"votes":7,"source":"both","text":"The LORD is my chosen portion and my cup; You have made my lot secure.","from":5},{"book":"PSA","chapter":79,"verse":8,"verseEnd":8,"votes":6,"source":"both","text":"Do not hold past sins against us; let Your compassion come quickly, for we are brought low.","from":6},{"book":"PSA","chapter":119,"verse":57,"verseEnd":57,"votes":6,"source":"both","text":"The LORD is my portion; I have promised to keep Your words.","from":5}],"notes":[],"groups":[]}}