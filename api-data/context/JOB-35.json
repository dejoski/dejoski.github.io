{"1-8":{"people":[{"id":"elihu-h0453k","name":"Elihu","kind":"person","brief":"Son of Barachel","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":6,"uses":752},{"base":"H0453","lemma":"אֱלִיהוּ","tr":"e·li·hu","gloss":"Elihu","lang":"h","inPassage":1,"uses":11},{"base":"H5532","lemma":"סָכַן","tr":"sa·khan","gloss":"be useful","lang":"h","inPassage":1,"uses":12},{"base":"H7789","lemma":"שׁוּר","tr":"shur","gloss":"to see","lang":"h","inPassage":1,"uses":15},{"base":"H0518","lemma":"אִם","tr":"im","gloss":"if","lang":"h","inPassage":2,"uses":1067},{"base":"H7231","lemma":"רָבַב","tr":"ra·vav","gloss":"to multiply","lang":"h","inPassage":1,"uses":21},{"base":"H7834","lemma":"שַׁ֫חַק","tr":"sha·chaq","gloss":"cloud","lang":"h","inPassage":1,"uses":21},{"base":"H3276","lemma":"יָעַל","tr":"ya·al","gloss":"to gain","lang":"h","inPassage":1,"uses":23},{"base":"H7562","lemma":"רֶ֫שַׁע","tr":"re·sah","gloss":"wickedness","lang":"h","inPassage":1,"uses":30},{"base":"H1361","lemma":"גָּבַהּ","tr":"ga·vah","gloss":"to exult","lang":"h","inPassage":1,"uses":34}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":34,"verse":9,"verseEnd":9,"votes":6,"source":"both","text":"For he has said, ‘It profits a man nothing that he should delight in God.’","from":3},{"book":"PRO","chapter":8,"verse":36,"verseEnd":36,"votes":6,"source":"both","text":"But he who fails to find me harms himself; all who hate me love death.”","from":6},{"book":"JER","chapter":7,"verse":19,"verseEnd":19,"votes":6,"source":"both","text":"But am I the One they are provoking? declares the LORD. Is it not themselves they spite, to their own shame?","from":6},{"book":"JOB","chapter":22,"verse":2,"verseEnd":2,"votes":5,"source":"openbible","text":"“Can a man be of use to God? Can even a wise man benefit Him?","from":7},{"book":"JOB","chapter":22,"verse":3,"verseEnd":3,"votes":5,"source":"openbible","text":"Does it delight the Almighty that you are righteous? Does He profit if your ways are blameless?","from":7},{"book":"JOB","chapter":22,"verse":12,"verseEnd":12,"votes":5,"source":"both","text":"Is not God as high as the heavens? Look at the highest stars, how lofty they are!","from":5},{"book":"PSA","chapter":16,"verse":2,"verseEnd":2,"votes":5,"source":"both","text":"I said to the LORD, “You are my Lord; apart from You I have no good thing.”","from":7},{"book":"PRO","chapter":9,"verse":12,"verseEnd":12,"votes":5,"source":"both","text":"If you are wise, you are wise to your own advantage; but if you scoff, you alone will bear the consequences.","from":7}],"notes":[],"groups":[]},"9-13":{"people":[],"places":[],"words":[{"base":"H0502","lemma":"אָלַף","tr":"a·laph","gloss":"to teach","lang":"h","inPassage":1,"uses":4},{"base":"H6217","lemma":"עָשׁוּקִים","tr":"a·shuq","gloss":"oppression","lang":"h","inPassage":1,"uses":4},{"base":"H2158","lemma":"זָמִיר","tr":"za·mir","gloss":"song","lang":"h","inPassage":1,"uses":6},{"base":"H7789","lemma":"שׁוּר","tr":"shur","gloss":"to see","lang":"h","inPassage":1,"uses":15},{"base":"H7768","lemma":"שָׁוַע","tr":"sha·va","gloss":"to cry","lang":"h","inPassage":1,"uses":21},{"base":"H2449","lemma":"חָכַם","tr":"cha·kham","gloss":"be wise","lang":"h","inPassage":1,"uses":27},{"base":"H0346","lemma":"אַיֵּה","tr":"ay·yeh","gloss":"where?","lang":"h","inPassage":1,"uses":45},{"base":"H7706","lemma":"שַׁדַּי","tr":"shad·day","gloss":"Almighty","lang":"h","inPassage":1,"uses":48},{"base":"H1347","lemma":"גָּאוֹן","tr":"ga·on","gloss":"pride","lang":"h","inPassage":1,"uses":49},{"base":"H7723","lemma":"שָׁוְא","tr":"shav","gloss":"vanity: false","lang":"h","inPassage":1,"uses":53}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":42,"verse":8,"verseEnd":8,"votes":7,"source":"both","text":"The LORD decrees His loving devotion by day, and at night His song is with me as a prayer to the God of my life.","from":10},{"book":"PSA","chapter":94,"verse":12,"verseEnd":12,"votes":7,"source":"both","text":"Blessed is the man You discipline, O LORD, and teach from Your law,","from":11},{"book":"EXO","chapter":2,"verse":23,"verseEnd":23,"votes":6,"source":"both","text":"After a long time, the king of Egypt died. The Israelites groaned and cried out under their burden of slavery, and their cry for deliverance from bondage ascended to God.","from":9},{"book":"PSA","chapter":149,"verse":5,"verseEnd":5,"votes":6,"source":"both","text":"Let the saints exult in glory; let them shout for joy upon their beds.","from":10},{"book":"PRO","chapter":15,"verse":29,"verseEnd":29,"votes":6,"source":"both","text":"The LORD is far from the wicked, but He hears the prayer of the righteous.","from":13},{"book":"ACT","chapter":16,"verse":25,"verseEnd":25,"votes":6,"source":"both","text":"About midnight Paul and Silas were praying and singing hymns to God, and the other prisoners were listening to them.","from":10},{"book":"PSA","chapter":77,"verse":6,"verseEnd":6,"votes":5,"source":"both","text":"At night I remembered my song; in my heart I mused, and my spirit pondered:","from":10},{"book":"ISA","chapter":1,"verse":15,"verseEnd":15,"votes":5,"source":"both","text":"When you spread out your hands in prayer, I will hide My eyes from you; even though you multiply your prayers, I will not listen. Your hands are covered with blood.","from":13}],"notes":[],"groups":[]},"14-16":{"people":[{"id":"job-h0347","name":"Job","kind":"person","brief":"Father of Jemimah","count":1,"firstVerse":16}],"places":[],"words":[{"base":"H6475","lemma":"פָּצָה","tr":"pa·tsah","gloss":"to open","lang":"h","inPassage":1,"uses":15},{"base":"H7789","lemma":"שׁוּר","tr":"shur","gloss":"to see","lang":"h","inPassage":1,"uses":15},{"base":"H1779","lemma":"דִּין","tr":"din","gloss":"judgment","lang":"h","inPassage":1,"uses":20},{"base":"H4405","lemma":"מִלָּה","tr":"mil·lah","gloss":"speech","lang":"h","inPassage":1,"uses":38},{"base":"H0347","lemma":"אִיּוֹב","tr":"iy·yov","gloss":"Job","lang":"h","inPassage":1,"uses":58},{"base":"H1097","lemma":"בְּלִי","tr":"be·li","gloss":"without","lang":"h","inPassage":1,"uses":58},{"base":"H2342","lemma":"חוּל","tr":"chul","gloss":"to twist: tremble","lang":"h","inPassage":1,"uses":58},{"base":"H1892","lemma":"הֶ֫בֶל","tr":"he·vel","gloss":"vanity","lang":"h","inPassage":1,"uses":73},{"base":"H1847","lemma":"דַּ֫עַת","tr":"da·at","gloss":"knowledge","lang":"h","inPassage":1,"uses":92},{"base":"H0637","lemma":"אַף","tr":"aph","gloss":"also","lang":"h","inPassage":1,"uses":134}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":38,"verse":2,"verseEnd":2,"votes":6,"source":"both","text":"“Who is this who obscures My counsel by words without knowledge?","from":16},{"book":"JOB","chapter":9,"verse":11,"verseEnd":11,"votes":5,"source":"both","text":"Were He to pass by me, I would not see Him; were He to move, I would not recognize Him.","from":14},{"book":"NUM","chapter":20,"verse":12,"verseEnd":12,"votes":0,"source":"tsk","text":"But the LORD said to Moses and Aaron, “Because you did not trust Me to show My holiness in the sight of the Israelites, you will not bring this assembly into the land that I have given them.”","from":15},{"book":"JOB","chapter":3,"verse":1,"verseEnd":1,"votes":0,"source":"tsk","text":"After this, Job opened his mouth and cursed the day of his birth.","from":16},{"book":"JOB","chapter":4,"verse":5,"verseEnd":5,"votes":0,"source":"tsk","text":"But now trouble has come upon you, and you are weary. It strikes you, and you are dismayed.","from":15},{"book":"JOB","chapter":9,"verse":14,"verseEnd":14,"votes":0,"source":"tsk","text":"How then can I answer Him or choose my arguments against Him?","from":15},{"book":"JOB","chapter":9,"verse":19,"verseEnd":19,"votes":0,"source":"tsk","text":"If it is a matter of strength, He is indeed mighty! If it is a matter of justice, who can summon Him?","from":14},{"book":"JOB","chapter":13,"verse":15,"verseEnd":15,"votes":0,"source":"tsk","text":"Though He slay me, I will hope in Him. I will still defend my ways to His face.","from":15}],"notes":[],"groups":[]}}