{"1-6":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H0562","lemma":"אֹמֶר","tr":"o·mer","gloss":"word","lang":"h","inPassage":2,"uses":6},{"base":"H0369","lemma":"אַ֫יִן","tr":"a·yin","gloss":"nothing","lang":"h","inPassage":3,"uses":788},{"base":"H7097","lemma":"קָצֶה","tr":"qa·tseh","gloss":"end","lang":"h","inPassage":2,"uses":97},{"base":"H3915","lemma":"לַ֫יְלָה","tr":"lay·lah","gloss":"night","lang":"h","inPassage":2,"uses":233},{"base":"H8064","lemma":"שָׁמַיִם","tr":"sha·ma·yim","gloss":"heaven","lang":"h","inPassage":2,"uses":421},{"base":"H2646","lemma":"חֻפָּה","tr":"chup·pah","gloss":"canopy","lang":"h","inPassage":1,"uses":3},{"base":"H8622","lemma":"תְּקוּפָה","tr":"te·qu·phah","gloss":"circuit","lang":"h","inPassage":1,"uses":4},{"base":"H2331","lemma":"חָוָה","tr":"cha·vah","gloss":"to explain","lang":"h","inPassage":1,"uses":6},{"base":"H2535","lemma":"חַמָּה","tr":"cham·mah","gloss":"heat","lang":"h","inPassage":1,"uses":6},{"base":"H5042","lemma":"נָבַע","tr":"na·va","gloss":"to bubble","lang":"h","inPassage":1,"uses":11}],"parallels":[],"crossrefs":[{"book":"ROM","chapter":1,"verse":19,"verseEnd":19,"votes":57,"source":"openbible","text":"For what may be known about God is plain to them, because God has made it plain to them.","from":1},{"book":"ROM","chapter":1,"verse":20,"verseEnd":20,"votes":57,"source":"openbible","text":"For since the creation of the world Godʼs invisible qualities, His eternal power and divine nature, have been clearly seen, being understood from His workmanship, so that men are without excuse.","from":1},{"book":"PSA","chapter":8,"verse":3,"verseEnd":3,"votes":51,"source":"both","text":"When I behold Your heavens, the work of Your fingers, the moon and the stars, which You have set in place—","from":1},{"book":"PSA","chapter":50,"verse":6,"verseEnd":6,"votes":37,"source":"openbible","text":"And the heavens proclaim His righteousness, for God Himself is Judge. Selah","from":1},{"book":"GEN","chapter":1,"verse":14,"verseEnd":14,"votes":26,"source":"openbible","text":"And God said, “Let there be lights in the expanse of the sky to distinguish between the day and the night, and let them be signs to mark the seasons and days and years.","from":1},{"book":"GEN","chapter":1,"verse":15,"verseEnd":15,"votes":26,"source":"openbible","text":"And let them serve as lights in the expanse of the sky to shine upon the earth.” And it was so.","from":1},{"book":"PSA","chapter":33,"verse":6,"verseEnd":6,"votes":26,"source":"both","text":"By the word of the LORD the heavens were made, and all the stars by the breath of His mouth.","from":1},{"book":"PSA","chapter":148,"verse":3,"verseEnd":3,"votes":25,"source":"openbible","text":"Praise Him, O sun and moon; praise Him, all you shining stars.","from":1}],"notes":[],"groups":[]},"7-11":{"people":[],"places":[],"words":[{"base":"H6688","lemma":"צוּף","tr":"tsuph","gloss":"honeycomb","lang":"h","inPassage":1,"uses":2},{"base":"H7227","lemma":"רַב","tr":"rav","gloss":"many","lang":"h","inPassage":2,"uses":454},{"base":"H5317","lemma":"נֹ֫פֶת","tr":"no·phet","gloss":"honey","lang":"h","inPassage":1,"uses":5},{"base":"H1249","lemma":"בַּר","tr":"bar","gloss":"pure","lang":"h","inPassage":1,"uses":7},{"base":"H6337","lemma":"פַּז","tr":"paz","gloss":"pure gold","lang":"h","inPassage":1,"uses":9},{"base":"H4966","lemma":"מָתוֹק","tr":"ma·toq","gloss":"sweet","lang":"h","inPassage":1,"uses":12},{"base":"H6118","lemma":"עֵ֫קֶב","tr":"e·qev","gloss":"consequence","lang":"h","inPassage":1,"uses":15},{"base":"H6612","lemma":"פֶּ֫תִי","tr":"pe·ti","gloss":"simple","lang":"h","inPassage":1,"uses":19},{"base":"H2094","lemma":"זָהַר","tr":"za·har","gloss":"to shine","lang":"h","inPassage":1,"uses":22},{"base":"H6490","lemma":"פִּקּוּד","tr":"piq·qud","gloss":"precept","lang":"h","inPassage":1,"uses":24}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":119,"verse":130,"verseEnd":130,"votes":48,"source":"openbible","text":"The unfolding of Your words gives light; it informs the simple.","from":7},{"book":"PSA","chapter":111,"verse":7,"verseEnd":7,"votes":40,"source":"both","text":"The works of His hands are truth and justice; all His precepts are trustworthy.","from":7},{"book":"COL","chapter":3,"verse":16,"verseEnd":16,"votes":35,"source":"openbible","text":"Let the word of Christ richly dwell within you as you teach and admonish one another with all wisdom, and as you sing psalms, hymns, and spiritual songs with gratitude in your hearts to God.","from":7},{"book":"PRO","chapter":1,"verse":4,"verseEnd":4,"votes":32,"source":"openbible","text":"To impart prudence to the simple and knowledge and discretion to the young,","from":7},{"book":"PSA","chapter":23,"verse":3,"verseEnd":3,"votes":31,"source":"both","text":"He restores my soul; He guides me in the paths of righteousness for the sake of His name.","from":7},{"book":"2TI","chapter":3,"verse":15,"verseEnd":15,"votes":30,"source":"openbible","text":"From infancy you have known the Holy Scriptures, which are able to make you wise for salvation through faith in Christ Jesus.","from":7},{"book":"2TI","chapter":3,"verse":17,"verseEnd":17,"votes":30,"source":"openbible","text":"so that the man of God may be complete, fully equipped for every good work.","from":7},{"book":"PSA","chapter":119,"verse":105,"verseEnd":105,"votes":28,"source":"both","text":"Your word is a lamp to my feet and a light to my path.","from":7}],"notes":[],"groups":[]},"12-14":{"people":[],"places":[],"words":[{"base":"H5352","lemma":"נָקָה","tr":"na·qah","gloss":"to clear","lang":"h","inPassage":2,"uses":44},{"base":"H1902","lemma":"הִגָּיוֹן","tr":"hig·ga·von","gloss":"Higgaion","lang":"h","inPassage":1,"uses":4},{"base":"H2086","lemma":"זֵד","tr":"zed","gloss":"arrogant","lang":"h","inPassage":1,"uses":13},{"base":"H2820","lemma":"חָשַׂךְ","tr":"cha·sakh","gloss":"to withhold","lang":"h","inPassage":1,"uses":28},{"base":"H0561","lemma":"אֵמֶר","tr":"e·mer","gloss":"word","lang":"h","inPassage":1,"uses":49},{"base":"H7522","lemma":"רָצוֹן","tr":"ra·tson","gloss":"acceptance","lang":"h","inPassage":1,"uses":56},{"base":"H8552","lemma":"תָּמַם","tr":"ta·mam","gloss":"to finish","lang":"h","inPassage":1,"uses":63},{"base":"H6697","lemma":"צוּר","tr":"tsur","gloss":"Rocks (of Goats)","lang":"h","inPassage":1,"uses":78},{"base":"H4910","lemma":"מָשַׁל","tr":"ma·shal","gloss":"to rule","lang":"h","inPassage":1,"uses":81},{"base":"H5641","lemma":"סָתַר","tr":"sa·tar","gloss":"to hide","lang":"h","inPassage":1,"uses":81}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":104,"verse":34,"verseEnd":34,"votes":75,"source":"openbible","text":"May my meditation be pleasing to Him, for I rejoice in the LORD.","from":14},{"book":"PSA","chapter":51,"verse":15,"verseEnd":15,"votes":57,"source":"both","text":"O Lord, open my lips, and my mouth will declare Your praise.","from":14},{"book":"PSA","chapter":119,"verse":108,"verseEnd":108,"votes":41,"source":"both","text":"Accept the freewill offerings of my mouth, O LORD, and teach me Your judgments.","from":14},{"book":"PSA","chapter":119,"verse":133,"verseEnd":133,"votes":25,"source":"both","text":"Order my steps in Your word; let no sin rule over me.","from":13},{"book":"1PE","chapter":2,"verse":5,"verseEnd":5,"votes":25,"source":"both","text":"you also, like living stones, are being built into a spiritual house to be a holy priesthood, offering spiritual sacrifices acceptable to God through Jesus Christ.","from":14},{"book":"PSA","chapter":66,"verse":18,"verseEnd":18,"votes":22,"source":"openbible","text":"If I had cherished iniquity in my heart, the Lord would not have listened.","from":14},{"book":"PSA","chapter":66,"verse":20,"verseEnd":20,"votes":22,"source":"openbible","text":"Blessed be God, who has not rejected my prayer or withheld from me His loving devotion!","from":14},{"book":"PRO","chapter":15,"verse":8,"verseEnd":8,"votes":18,"source":"both","text":"The sacrifice of the wicked is detestable to the LORD, but the prayer of the upright is His delight.","from":14}],"notes":[],"groups":[]}}