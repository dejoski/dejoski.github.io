{"1-11":{"people":[{"id":"eliphaz-h0464h","name":"Eliphaz","kind":"person","brief":"","count":1,"firstVerse":1},{"id":"teman-h8487g","name":"Teman","kind":"person","brief":"Grandson of Esau","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H5532","lemma":"סָכַן","tr":"sa·khan","gloss":"be useful","lang":"h","inPassage":2,"uses":12},{"base":"H2220","lemma":"זְרוֹעַ","tr":"ze·ro·a","gloss":"arm","lang":"h","inPassage":2,"uses":91},{"base":"H4325","lemma":"מַי","tr":"ma·yim","gloss":"water","lang":"h","inPassage":2,"uses":581},{"base":"H8229","lemma":"שִׁפְעָה","tr":"shiph·ah","gloss":"abundance","lang":"h","inPassage":1,"uses":6},{"base":"H8489","lemma":"תֵּימָנִי","tr":"te·ma·ni","gloss":"Temanite","lang":"h","inPassage":1,"uses":8},{"base":"H0464","lemma":"אֱלִיפַז","tr":"e·li·phaz","gloss":"Eliphaz","lang":"h","inPassage":1,"uses":15},{"base":"H6174","lemma":"עָרוֹם","tr":"a·rom","gloss":"naked","lang":"h","inPassage":1,"uses":16},{"base":"H7387","lemma":"רֵיקָם","tr":"re·qam","gloss":"emptily","lang":"h","inPassage":1,"uses":16},{"base":"H5889","lemma":"עָיֵף","tr":"a·yeph","gloss":"faint","lang":"h","inPassage":1,"uses":17},{"base":"H1792","lemma":"דָּכָא","tr":"da·kah","gloss":"to crush","lang":"h","inPassage":1,"uses":18}],"parallels":[],"crossrefs":[{"book":"EXO","chapter":22,"verse":26,"verseEnd":26,"votes":7,"source":"both","text":"If you take your neighborʼs cloak as collateral, return it to him by sunset,","from":6},{"book":"JOB","chapter":14,"verse":3,"verseEnd":3,"votes":7,"source":"both","text":"Do You open Your eyes to one like this? Will You bring him into judgment before You?","from":4},{"book":"LUK","chapter":17,"verse":10,"verseEnd":10,"votes":7,"source":"both","text":"So you also, when you have done everything commanded of you, should say, ‘We are unworthy servants; we have only done our duty.’”","from":2},{"book":"JOB","chapter":31,"verse":17,"verseEnd":17,"votes":6,"source":"both","text":"if I have eaten my morsel alone, not sharing it with the fatherless—","from":7},{"book":"PSA","chapter":143,"verse":2,"verseEnd":2,"votes":6,"source":"both","text":"Do not bring Your servant into judgment, for no one alive is righteous before You.","from":4},{"book":"GAL","chapter":6,"verse":7,"verseEnd":7,"votes":6,"source":"openbible","text":"Do not be deceived: God is not to be mocked. Whatever a man sows, he will reap in return.","from":2},{"book":"GAL","chapter":6,"verse":8,"verseEnd":8,"votes":6,"source":"openbible","text":"The one who sows to please his flesh, from the flesh will reap destruction; but the one who sows to please the Spirit, from the Spirit will reap eternal life.","from":2},{"book":"JOB","chapter":35,"verse":6,"verseEnd":6,"votes":5,"source":"openbible","text":"If you sin, what do you accomplish against Him? If you multiply your transgressions, what do you do to Him?","from":2}],"notes":[],"groups":[]},"12-20":{"people":[],"places":[],"words":[{"base":"H0410","lemma":"אֵל","tr":"el","gloss":"God","lang":"h","inPassage":2,"uses":241},{"base":"H7059","lemma":"קָמַט","tr":"qa·mat","gloss":"to seize","lang":"h","inPassage":1,"uses":2},{"base":"H8064","lemma":"שָׁמַיִם","tr":"sha·ma·yim","gloss":"heaven","lang":"h","inPassage":2,"uses":421},{"base":"H2329","lemma":"חוּג","tr":"chug","gloss":"circle","lang":"h","inPassage":1,"uses":3},{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":2,"uses":752},{"base":"H6205","lemma":"עֲרָפֶל","tr":"a·ra·phel","gloss":"cloud","lang":"h","inPassage":1,"uses":15},{"base":"H1363","lemma":"גֹּ֫בַהּ","tr":"go·vah","gloss":"height","lang":"h","inPassage":1,"uses":17},{"base":"H3932","lemma":"לָעַג","tr":"la·ag","gloss":"to mock","lang":"h","inPassage":1,"uses":18},{"base":"H3247","lemma":"יְסוֹד","tr":"ye·sod","gloss":"(Gate of the) Foundation","lang":"h","inPassage":1,"uses":19},{"base":"H9038","lemma":"הֶם","tr":"hem","gloss":"them","lang":"h","inPassage":2,"uses":1125}],"parallels":[],"crossrefs":[{"book":"EZK","chapter":8,"verse":12,"verseEnd":12,"votes":7,"source":"both","text":"“Son of man,” He said to me, “do you see what the elders of the house of Israel are doing in the darkness, each at the shrine of his own idol? For they are saying, ‘The LORD does not see us; the LORD has forsaken the land.’”","from":13},{"book":"JOB","chapter":15,"verse":32,"verseEnd":32,"votes":6,"source":"both","text":"It will be paid in full before his time, and his branch will not flourish.","from":16},{"book":"JOB","chapter":21,"verse":14,"verseEnd":14,"votes":6,"source":"openbible","text":"Yet they say to God: ‘Leave us alone! For we have no desire to know Your ways.","from":17},{"book":"JOB","chapter":21,"verse":15,"verseEnd":15,"votes":6,"source":"openbible","text":"Who is the Almighty, that we should serve Him, and what would we gain if we pray to Him?’","from":17},{"book":"JOB","chapter":21,"verse":16,"verseEnd":16,"votes":6,"source":"both","text":"Still, their prosperity is not in their own hands, so I stay far from the counsel of the wicked.","from":18},{"book":"PSA","chapter":10,"verse":11,"verseEnd":11,"votes":6,"source":"both","text":"He says to himself, “God has forgotten; He hides His face and never sees.”","from":13},{"book":"PSA","chapter":58,"verse":10,"verseEnd":10,"votes":6,"source":"both","text":"The righteous will rejoice when they see they are avenged; they will wash their feet in the blood of the wicked.","from":19},{"book":"PSA","chapter":52,"verse":6,"verseEnd":6,"votes":5,"source":"both","text":"The righteous will see and fear; they will mock the evildoer, saying,","from":19}],"notes":[],"groups":[]},"21-30":{"people":[],"places":[{"id":"ophir-h0211h","name":"Ophir","kind":"place","brief":"In Judah","count":1,"firstVerse":24}],"words":[{"base":"H7706","lemma":"שַׁדַּי","tr":"shad·day","gloss":"Almighty","lang":"h","inPassage":3,"uses":48},{"base":"H1220","lemma":"בֶּ֫צֶר","tr":"be·tser","gloss":"gold","lang":"h","inPassage":2,"uses":2},{"base":"H4422","lemma":"מָלַט","tr":"ma·lat","gloss":"to escape","lang":"h","inPassage":2,"uses":95},{"base":"H7999","lemma":"שָׁלֵם","tr":"sa·lem","gloss":"to complete","lang":"h","inPassage":2,"uses":116},{"base":"H9032","lemma":"ךְ","tr":"kh","gloss":"you","lang":"h","inPassage":2,"uses":333},{"base":"H4994","lemma":"נָא","tr":"na","gloss":"please","lang":"h","inPassage":2,"uses":404},{"base":"H1466","lemma":"גֵּוָה","tr":"ge·vah","gloss":"pride","lang":"h","inPassage":1,"uses":3},{"base":"H8443","lemma":"תּוֹעָפָה","tr":"to·a·phah","gloss":"peak","lang":"h","inPassage":1,"uses":4},{"base":"H1252","lemma":"בֹּר","tr":"bor","gloss":"cleanness","lang":"h","inPassage":1,"uses":5},{"base":"H0562","lemma":"אֹמֶר","tr":"o·mer","gloss":"word","lang":"h","inPassage":1,"uses":6}],"parallels":[],"crossrefs":[{"book":"MAT","chapter":21,"verse":22,"verseEnd":22,"votes":59,"source":"both","text":"If you believe, you will receive whatever you ask for in prayer.”","from":28},{"book":"PSA","chapter":90,"verse":17,"verseEnd":17,"votes":51,"source":"both","text":"May the favor of the Lord our God rest upon us; establish for us the work of our hands— yes, establish the work of our hands!","from":28},{"book":"PSA","chapter":20,"verse":4,"verseEnd":4,"votes":43,"source":"both","text":"May He give you the desires of your heart and make all your plans succeed.","from":28},{"book":"ISA","chapter":30,"verse":21,"verseEnd":21,"votes":29,"source":"both","text":"And whether you turn to the right or to the left, your ears will hear this command behind you: “This is the way. Walk in it.”","from":28},{"book":"PRO","chapter":4,"verse":18,"verseEnd":18,"votes":27,"source":"both","text":"The path of the righteous is like the first gleam of dawn, shining brighter and brighter until midday.","from":28},{"book":"JHN","chapter":8,"verse":12,"verseEnd":12,"votes":27,"source":"both","text":"Once again, Jesus spoke to the people and said, “I am the light of the world. Whoever follows Me will never walk in the darkness, but will have the light of life.”","from":28},{"book":"MAL","chapter":4,"verse":2,"verseEnd":2,"votes":25,"source":"both","text":"“But for you who fear My name, the sun of righteousness will rise with healing in its wings, and you will go out and leap like calves from the stall.","from":28},{"book":"LAM","chapter":3,"verse":37,"verseEnd":37,"votes":24,"source":"both","text":"Who has spoken and it came to pass, unless the Lord has ordained it?","from":28}],"notes":[],"groups":[]}}