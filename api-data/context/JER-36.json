14},{"id":"nethaniah-h5418j","name":"Nethaniah","kind":"person","brief":"Son of Shelemiah","count":1,"firstVerse":14},{"id":"shelemiah-h8018k","name":"Shelemiah","kind":"person","brief":"Son of Cushi","count":1,"firstVerse":14}],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":9},{"id":"new-gate-h2319g","name":"New Gate","kind":"place","brief":"","count":1,"firstVerse":10}],"words":[{"base":"H1263","lemma":"בָּרוּךְ","tr":"ba·rukh","gloss":"Baruch","lang":"h","inPassage":9,"uses":26},{"base":"H7121","lemma":"קָרָא","tr":"qa·ra","gloss":"to call: call to","lang":"h","inPassage":7,"uses":733},{"base":"H0241","lemma":"אֹ֫זֶן","tr":"o·zen","gloss":"ear","lang":"h","inPassage":5,"uses":187},{"base":"H1587","lemma":"גְּמַרְיָ֫הוּ","tr":"ge·mar·yah","gloss":"Gemariah","lang":"h","inPassage":3,"uses":5},{"base":"H5612","lemma":"סֵ֫פֶר","tr":"se·pher","gloss":"scroll: document","lang":"h","inPassage":4,"uses":186},{"base":"H8227","lemma":"שָׁפָן","tr":"sha·phan","gloss":"rock badger","lang":"h","inPassage":3,"uses":34},{"base":"H5046","lemma":"נָגַד","tr":"na·gad","gloss":"to tell","lang":"h","inPassage":4,"uses":370},{"base":"H8269","lemma":"שַׂר","tr":"sar","gloss":"ruler","lang":"h","inPassage":4,"uses":421},{"base":"H5608","lemma":"סָפַר","tr":"sa·phar","gloss":"to recount","lang":"h","inPassage":3,"uses":159},{"base":"H4039","lemma":"מְגִלָּה","tr":"me·gil·lah","gloss":"scroll","lang":"h","inPassage":2,"uses":21}],"parallels":[],"crossrefs":[{"book":"2CH","chapter":20,"verse":3,"verseEnd":3,"votes":5,"source":"both","text":"Jehoshaphat was alarmed and set his face to seek the LORD. And he proclaimed a fast throughout Judah.","from":9},{"book":"JER","chapter":26,"verse":22,"verseEnd":22,"votes":5,"source":"both","text":"Then King Jehoiakim sent men to Egypt: Elnathan son of Achbor along with some other men.","from":12},{"book":"JER","chapter":36,"verse":4,"verseEnd":4,"votes":5,"source":"both","text":"So Jeremiah called Baruch son of Neriah, and at the dictation of Jeremiah, Baruch wrote on a scroll all the words that the LORD had spoken to Jeremiah.","from":18},{"book":"LEV","chapter":23,"verse":27,"verseEnd":27,"votes":0,"source":"tsk","text":"“The tenth day of this seventh month is the Day of Atonement. You shall hold a sacred assembly and humble yourselves, and present a food offering to the LORD.","from":9},{"book":"2SA","chapter":8,"verse":17,"verseEnd":17,"votes":0,"source":"tsk","text":"Zadok son of Ahitub and Ahimelech son of Abiathar were priests; Seraiah was the scribe;","from":10},{"book":"2SA","chapter":20,"verse":25,"verseEnd":25,"votes":0,"source":"tsk","text":"Sheva was the scribe; Zadok and Abiathar were priests;","from":10},{"book":"1KI","chapter":17,"verse":3,"verseEnd":3,"votes":0,"source":"tsk","text":"“Leave here, turn eastward, and hide yourself by the Brook of Cherith, east of the Jordan.","from":19},{"book":"1KI","chapter":18,"verse":4,"verseEnd":4,"votes":0,"source":"tsk","text":"for when Jezebel had slaughtered the prophets of the LORD, Obadiah had taken a hundred prophets and hidden them, fifty men per cave, providing them with food and water.)","from":19}],"notes":[],"groups":[{"id":"exile-prophets","title":"Last kings of Judah and the prophets of the exile","people":5},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2}]},"20-26":{"people":[{"id":"elishama-h0476l","name":"Elishama","kind":"person","brief":"","count":2,"firstVerse":20},{"id":"jehudi-h3065","name":"Jehudi","kind":"person","brief":"Son of Nethaniah","count":2,"firstVerse":21},{"id":"delaiah-h1806k","name":"Delaiah","kind":"person","brief":"Son of Shemaiah","count":1,"firstVerse":25},{"id":"elnathan-h0494k","name":"Elnathan","kind":"person","brief":"Son of Achbor","count":1,"firstVerse":25},{"id":"gemariah-h1587h","name":"Gemariah","kind":"person","brief":"Son of Shaphan","count":1,"firstVerse":25},{"id":"abdeel-h5655","name":"Abdeel","kind":"person","brief":"Father of Shelemiah","count":1,"firstVerse":26},{"id":"azriel-h5837i","name":"Azriel","kind":"person","brief":"Father of Seraiah","count":1,"firstVerse":26},{"id":"baruch-h1263j","name":"Baruch","kind":"person","brief":"Jeremiah's servant","count":1,"firstVerse":26},{"id":"hammelech-h4428h","name":"Hammelech","kind":"person","brief":"Father of Jerahmeel","count":1,"firstVerse":26},{"id":"jerahmeel-h3396i","name":"Jerahmeel","kind":"person","brief":"Son of Hammelech","count":1,"firstVerse":26},{"id":"jeremiah-h3414l","name":"Jeremiah","kind":"person","brief":"A prophet","count":1,"firstVerse":26},{"id":"seraiah-h8304m","name":"Seraiah","kind":"person","brief":"Son of Azriel","count":1,"firstVerse":26},{"id":"shelemiah-h8018l","name":"Shelemiah","kind":"person","brief":"Son of Abdeel","count":1,"firstVerse":26}],"places":[],"words":[{"base":"H4039","lemma":"מְגִלָּה","tr":"me·gil·lah","gloss":"scroll","lang":"h","inPassage":4,"uses":21},{"base":"H0254","lemma":"אָח","tr":"ach","gloss":"hearth","lang":"h","inPassage":3,"uses":3},{"base":"H3065","lemma":"יְהוּדִי","tr":"ye·hu·di","gloss":"Jehudi","lang":"h","inPassage":3,"uses":4},{"base":"H5608","lemma":"סָפַר","tr":"sa·phar","gloss":"to recount","lang":"h","inPassage":4,"uses":159},{"base":"H0241","lemma":"אֹ֫זֶן","tr":"o·zen","gloss":"ear","lang":"h","inPassage":3,"uses":187},{"base":"H0476","lemma":"אֱלִישָׁמָע","tr":"e·li·sha·ma","gloss":"Elishama","lang":"h","inPassage":2,"uses":17},{"base":"H3957","lemma":"לִשְׁכָּה","tr":"lish·kah","gloss":"chamber","lang":"h","inPassage":2,"uses":47},{"base":"H7167","lemma":"קָרַע","tr":"qa·ra","gloss":"to tear","lang":"h","inPassage":2,"uses":63},{"base":"H3947","lemma":"לָקַח","tr":"la·qach","gloss":"to take: take","lang":"h","inPassage":3,"uses":966},{"base":"H0784","lemma":"אֵשׁ","tr":"esh","gloss":"fire","lang":"h","inPassage":2,"uses":378}],"parallels":[],"crossrefs":[{"book":"1KI","chapter":17,"verse":3,"verseEnd":3,"votes":5,"source":"both","text":"“Leave here, turn eastward, and hide yourself by the Brook of Cherith, east of the Jordan.","from":26},{"book":"1KI","chapter":19,"verse":1,"verseEnd":1,"votes":5,"source":"openbible","text":"Now Ahab told Jezebel everything that Elijah had done and how he had killed all the prophets with the sword.","from":26},{"book":"1KI","chapter":19,"verse":3,"verseEnd":3,"votes":5,"source":"openbible","text":"And Elijah was afraid and ran for his life. When he came to Beersheba in Judah, he left his servant there,","from":26},{"book":"1KI","chapter":19,"verse":10,"verseEnd":10,"votes":5,"source":"both","text":"“I have been very zealous for the LORD, the God of Hosts,” he replied, “but the Israelites have forsaken Your covenant, torn down Your altars, and killed Your prophets with the sword. I am the only one left, and they are seeking my life as well.”","from":26},{"book":"1KI","chapter":19,"verse":14,"verseEnd":14,"votes":5,"source":"both","text":"“I have been very zealous for the LORD, the God of Hosts,” he replied, “but the Israelites have forsaken Your covenant, torn down Your altars, and killed Your prophets with the sword. I am the only one left, and they are seeking my life as well.”","from":26},{"book":"PSA","chapter":91,"verse":1,"verseEnd":1,"votes":5,"source":"both","text":"He who dwells in the shelter of the Most High will abide in the shadow of the Almighty.","from":26},{"book":"JER","chapter":36,"verse":12,"verseEnd":12,"votes":5,"source":"both","text":"he went down to the scribeʼs chamber in the kingʼs palace, where all the officials were sitting: Elishama the scribe, Delaiah son of Shemaiah, Elnathan son of Achbor, Gemariah son of Shaphan, Zedekiah son of Hananiah, and all the other officials.","from":20},{"book":"JER","chapter":36,"verse":16,"verseEnd":16,"votes":5,"source":"both","text":"When they had heard all these words, they turned to one another in fear and said to Baruch, “Surely we must report all these words to the king.”","from":24}],"notes":[],"groups":[{"id":"exile-prophets","title":"Last kings of Judah and the prophets of the exile","people":2}]},"27-32":{"people":[{"id":"baruch-h1263j","name":"Baruch","kind":"person","brief":"Jeremiah's servant","count":2,"firstVerse":27},{"id":"jeremiah-h3414l","name":"Jeremiah","kind":"person","brief":"A prophet","count":2,"firstVerse":27},{"id":"judah-h3063g","name":"Judah","kind":"person","brief":"Son of Israel","count":5,"firstVerse":28},{"id":"jehoiakim-h3079g","name":"Jehoiakim","kind":"person","brief":"King of Judah","count":4,"firstVerse":28},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":30},{"id":"neriah-h5374","name":"Neriah","kind":"person","brief":"Son of Mahseiah","count":1,"firstVerse":32}],"places":[{"id":"babylon-h0894","name":"Babylon","kind":"place","brief":"","count":1,"firstVerse":29},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":31}],"words":[{"base":"H4039","lemma":"מְגִלָּה","tr":"me·gil·lah","gloss":"scroll","lang":"h","inPassage":5,"uses":21},{"base":"H3079","lemma":"יְהוֹיָקִים","tr":"ye·ho·ya·qim","gloss":"Jehoiakim","lang":"h","inPassage":4,"uses":37},{"base":"H8313","lemma":"שָׂרַף","tr":"sa·raph","gloss":"to burn","lang":"h","inPassage":4,"uses":117},{"base":"H3414","lemma":"יִרְמְיָ֫הוּ","tr":"yir·me·yah","gloss":"Jeremiah","lang":"h","inPassage":4,"uses":147},{"base":"H3789","lemma":"כָּתַב","tr":"ka·tav","gloss":"to write","lang":"h","inPassage":4,"uses":224},{"base":"H3063","lemma":"יְהוּדָה","tr":"ye·hu·dah","gloss":"Judah","lang":"h","inPassage":5,"uses":820},{"base":"H1263","lemma":"בָּרוּךְ","tr":"ba·rukh","gloss":"Baruch","lang":"h","inPassage":2,"uses":26},{"base":"H0312","lemma":"אַחֵר","tr":"a·cher","gloss":"another","lang":"h","inPassage":2,"uses":166},{"base":"H7223","lemma":"רִאשׁוֹן","tr":"ri·shon","gloss":"first","lang":"h","inPassage":2,"uses":181},{"base":"H6310","lemma":"פֶּה","tr":"peh","gloss":"lip","lang":"h","inPassage":2,"uses":498}],"parallels":[],"crossrefs":[{"book":"JER","chapter":36,"verse":4,"verseEnd":4,"votes":6,"source":"both","text":"So Jeremiah called Baruch son of Neriah, and at the dictation of Jeremiah, Baruch wrote on a scroll all the words that the LORD had spoken to Jeremiah.","from":32},{"book":"JER","chapter":36,"verse":18,"verseEnd":18,"votes":5,"source":"both","text":"“It was at his dictation,” Baruch replied. “He recited all these words to me and I wrote them in ink on the scroll.”","from":32},{"book":"GEN","chapter":31,"verse":40,"verseEnd":40,"votes":0,"source":"tsk","text":"As it was, the heat consumed me by day and the frost by night, and sleep fled from my eyes.","from":30},{"book":"EXO","chapter":4,"verse":15,"verseEnd":16,"votes":0,"source":"tsk","text":"You are to speak to him and put the words in his mouth. I will help both of you to speak, and I will teach you what to do. He will speak to the people for you. He will be your spokesman, and it will be as if you were God to him.","from":32},{"book":"LEV","chapter":26,"verse":14,"verseEnd":14,"votes":0,"source":"tsk","text":"If, however, you fail to obey Me and to carry out all these commandments,","from":31},{"book":"LEV","chapter":26,"verse":18,"verseEnd":18,"votes":0,"source":"tsk","text":"And if after all this you will not obey Me, I will proceed to punish you sevenfold for your sins.","from":32},{"book":"LEV","chapter":26,"verse":21,"verseEnd":21,"votes":0,"source":"tsk","text":"If you walk in hostility toward Me and refuse to obey Me, I will multiply your plagues seven times, according to your sins.","from":32},{"book":"LEV","chapter":26,"verse":24,"verseEnd":24,"votes":0,"source":"tsk","text":"then I will act with hostility toward you, and I will strike you sevenfold for your sins.","from":32}],"notes":[],"groups":[{"id":"exile-prophets","title":"Last kings of Judah and the prophets of the exile","people":3},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2}]}}