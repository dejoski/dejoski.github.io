{"1-6":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1},{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":1,"firstVerse":1},{"id":"solomon-h8010","name":"Solomon","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H0995","lemma":"בִּין","tr":"bin","gloss":"to understand","lang":"h","inPassage":3,"uses":170},{"base":"H4912","lemma":"מָשָׁל","tr":"ma·shal","gloss":"proverb","lang":"h","inPassage":2,"uses":39},{"base":"H4148","lemma":"מוּסָר","tr":"mu·sar","gloss":"discipline","lang":"h","inPassage":2,"uses":50},{"base":"H2450","lemma":"חָכָם","tr":"cha·kham","gloss":"wise","lang":"h","inPassage":2,"uses":138},{"base":"H4426","lemma":"מְלִיצָה","tr":"me·li·tsah","gloss":"mockery","lang":"h","inPassage":1,"uses":2},{"base":"H6195","lemma":"עׇרְמָה","tr":"or·mah","gloss":"craftiness","lang":"h","inPassage":1,"uses":5},{"base":"H8458","lemma":"תַּחְבֻּלָה","tr":"tach·bu·lah","gloss":"counsel","lang":"h","inPassage":1,"uses":6},{"base":"H3948","lemma":"לֶ֫קַח","tr":"le·qach","gloss":"teaching","lang":"h","inPassage":1,"uses":9},{"base":"H2420","lemma":"חִידָה","tr":"chi·dah","gloss":"riddle","lang":"h","inPassage":1,"uses":17},{"base":"H4209","lemma":"מְזִמָּה","tr":"me·zim·mah","gloss":"plot","lang":"h","inPassage":1,"uses":19}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":12,"verse":1,"verseEnd":1,"votes":30,"source":"both","text":"Whoever loves discipline loves knowledge, but he who hates correction is stupid.","from":5},{"book":"PRO","chapter":10,"verse":1,"verseEnd":1,"votes":28,"source":"both","text":"The proverbs of Solomon: A wise son brings joy to his father, but a foolish son grief to his mother.","from":1},{"book":"PRO","chapter":9,"verse":9,"verseEnd":9,"votes":18,"source":"both","text":"Instruct a wise man, and he will be wiser still; teach a righteous man, and he will increase his learning.","from":5},{"book":"PRO","chapter":2,"verse":1,"verseEnd":1,"votes":14,"source":"openbible","text":"My son, if you accept my words and hide my commandments within you,","from":3},{"book":"PRO","chapter":2,"verse":9,"verseEnd":9,"votes":14,"source":"openbible","text":"Then you will discern righteousness and justice and equity—every good path.","from":3},{"book":"PSA","chapter":78,"verse":2,"verseEnd":2,"votes":10,"source":"both","text":"I will open my mouth in parables; I will utter things hidden from the beginning,","from":6},{"book":"1CO","chapter":10,"verse":15,"verseEnd":15,"votes":9,"source":"both","text":"I speak to reasonable people; judge for yourselves what I say.","from":5},{"book":"JOB","chapter":22,"verse":22,"verseEnd":22,"votes":8,"source":"both","text":"Receive instruction from His mouth, and lay up His words in your heart.","from":3}],"notes":[],"groups":[{"id":"kings-prophets","title":"Kings, prophets and the house of David","people":2},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2}]},"7-9":{"people":[],"places":[],"words":[{"base":"H4148","lemma":"מוּסָר","tr":"mu·sar","gloss":"discipline","lang":"h","inPassage":2,"uses":50},{"base":"H3880","lemma":"לִוְיָה","tr":"liv·yah","gloss":"wreath","lang":"h","inPassage":1,"uses":2},{"base":"H6060","lemma":"עֲנָק","tr":"a·naq","gloss":"neck","lang":"h","inPassage":1,"uses":3},{"base":"H1621","lemma":"גַּרְגְּרוֹת","tr":"gar·ge·rot","gloss":"neck","lang":"h","inPassage":1,"uses":4},{"base":"H0936","lemma":"בּוּז","tr":"buz","gloss":"to despise","lang":"h","inPassage":1,"uses":12},{"base":"H0191","lemma":"אֱוִיל","tr":"e·vil","gloss":"fool(ish)","lang":"h","inPassage":1,"uses":26},{"base":"H5203","lemma":"נָטַשׁ","tr":"na·tash","gloss":"to leave","lang":"h","inPassage":1,"uses":40},{"base":"H3374","lemma":"יִרְאָה","tr":"yir·ah","gloss":"fear","lang":"h","inPassage":1,"uses":45},{"base":"H7225","lemma":"רֵאשִׁית","tr":"re·shit","gloss":"first: beginning","lang":"h","inPassage":1,"uses":51},{"base":"H2580","lemma":"חֵן","tr":"chen","gloss":"favor","lang":"h","inPassage":1,"uses":69}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":28,"verse":28,"verseEnd":28,"votes":84,"source":"both","text":"And He said to man, ‘Behold, the fear of the Lord, that is wisdom, and to turn away from evil is understanding.’”","from":7},{"book":"PSA","chapter":111,"verse":10,"verseEnd":10,"votes":57,"source":"both","text":"The fear of the LORD is the beginning of wisdom; all who follow His precepts gain rich understanding. His praise endures forever!","from":7},{"book":"PSA","chapter":112,"verse":1,"verseEnd":1,"votes":57,"source":"both","text":"Hallelujah! Blessed is the man who fears the LORD, who greatly delights in His commandments.","from":7},{"book":"PRO","chapter":9,"verse":10,"verseEnd":10,"votes":51,"source":"both","text":"The fear of the LORD is the beginning of wisdom, and knowledge of the Holy One is understanding.","from":7},{"book":"ECC","chapter":12,"verse":13,"verseEnd":13,"votes":51,"source":"both","text":"When all has been heard, the conclusion of the matter is this: Fear God and keep His commandments, because this is the whole duty of man.","from":7},{"book":"PRO","chapter":15,"verse":33,"verseEnd":33,"votes":36,"source":"openbible","text":"The fear of the LORD is the instruction of wisdom, and humility comes before honor.","from":7},{"book":"PRO","chapter":18,"verse":2,"verseEnd":2,"votes":29,"source":"both","text":"A fool does not delight in understanding, but only in airing his opinions.","from":7},{"book":"PRO","chapter":1,"verse":22,"verseEnd":22,"votes":25,"source":"both","text":"“How long, O simple ones, will you love your simple ways? How long will scoffers delight in their scorn and fools hate knowledge?","from":7}],"notes":[{"id":"prov-1-fear-lord","title":"The fear of the LORD is the beginning","kind":"background"}],"groups":[]},"10-19":{"people":[],"places":[],"words":[{"base":"H1818","lemma":"דָּם","tr":"dam","gloss":"blood","lang":"h","inPassage":3,"uses":360},{"base":"H2600","lemma":"חִנָּם","tr":"chin·nam","gloss":"for nothing","lang":"h","inPassage":2,"uses":32},{"base":"H6845","lemma":"צָפַן","tr":"tsa·phan","gloss":"to treasure","lang":"h","inPassage":2,"uses":32},{"base":"H0693","lemma":"אָרַב","tr":"a·rav","gloss":"to ambush","lang":"h","inPassage":2,"uses":41},{"base":"H1167","lemma":"בַּעַל","tr":"ba·al","gloss":"master","lang":"h","inPassage":2,"uses":84},{"base":"H7272","lemma":"רֶ֫גֶל","tr":"re·gel","gloss":"foot","lang":"h","inPassage":2,"uses":245},{"base":"H3599","lemma":"כִּיס","tr":"kis","gloss":"purse","lang":"h","inPassage":1,"uses":5},{"base":"H0408","lemma":"אַל","tr":"al","gloss":"not","lang":"h","inPassage":2,"uses":724},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":2,"uses":754},{"base":"H0854","lemma":"אֵת","tr":"et","gloss":"with","lang":"h","inPassage":2,"uses":929}],"parallels":[],"crossrefs":[{"book":"EPH","chapter":5,"verse":11,"verseEnd":11,"votes":20,"source":"both","text":"Have no fellowship with the fruitless deeds of darkness, but rather expose them.","from":10},{"book":"PSA","chapter":119,"verse":101,"verseEnd":101,"votes":13,"source":"both","text":"I have kept my feet from every evil path, that I may keep Your word.","from":15},{"book":"PRO","chapter":16,"verse":29,"verseEnd":29,"votes":13,"source":"openbible","text":"A violent man entices his neighbor and leads him down a path that is not good.","from":10},{"book":"PSA","chapter":1,"verse":1,"verseEnd":1,"votes":11,"source":"both","text":"Blessed is the man who does not walk in the counsel of the wicked, or set foot on the path of sinners, or sit in the seat of mockers.","from":10},{"book":"PSA","chapter":1,"verse":1,"verseEnd":1,"votes":9,"source":"both","text":"Blessed is the man who does not walk in the counsel of the wicked, or set foot on the path of sinners, or sit in the seat of mockers.","from":15},{"book":"PRO","chapter":13,"verse":20,"verseEnd":20,"votes":9,"source":"both","text":"He who walks with the wise will become wise, but the companion of fools will be destroyed.","from":10},{"book":"PRO","chapter":4,"verse":27,"verseEnd":27,"votes":8,"source":"both","text":"Do not swerve to the right or to the left; turn your feet away from evil.","from":15},{"book":"PRO","chapter":15,"verse":27,"verseEnd":27,"votes":8,"source":"both","text":"He who is greedy for unjust gain brings trouble on his household, but he who hates bribes will live.","from":19}],"notes":[{"id":"prov-1-fear-lord","title":"The fear of the LORD is the beginning","kind":"background"}],"groups":[]},"20-33":{"people":[],"places":[],"words":[{"base":"H6612","lemma":"פֶּ֫תִי","tr":"pe·ti","gloss":"simple","lang":"h","inPassage":3,"uses":19},{"base":"H8433","lemma":"תּוֹכֵחָה","tr":"to·khe·chah","gloss":"rebuke","lang":"h","inPassage":3,"uses":28},{"base":"H6343","lemma":"פַּ֫חַד","tr":"pa·chad","gloss":"dread","lang":"h","inPassage":3,"uses":49},{"base":"H0343","lemma":"אֵיד","tr":"ed","gloss":"calamity","lang":"h","inPassage":2,"uses":24},{"base":"H0014","lemma":"אָבָה","tr":"a·vah","gloss":"be willing","lang":"h","inPassage":2,"uses":54},{"base":"H3684","lemma":"כְּסִיל","tr":"ke·sil","gloss":"fool","lang":"h","inPassage":2,"uses":70},{"base":"H7121","lemma":"קָרָא","tr":"qa·ra","gloss":"to call: call to","lang":"h","inPassage":3,"uses":733},{"base":"H6098","lemma":"עֵצָה","tr":"e·tsah","gloss":"counsel","lang":"h","inPassage":2,"uses":89},{"base":"H1847","lemma":"דַּ֫עַת","tr":"da·at","gloss":"knowledge","lang":"h","inPassage":2,"uses":92},{"base":"H8130","lemma":"שָׂנֵא","tr":"sa·ne","gloss":"to hate","lang":"h","inPassage":2,"uses":146}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":25,"verse":12,"verseEnd":12,"votes":29,"source":"openbible","text":"Who is the man who fears the LORD? He will instruct him in the path chosen for him.","from":33},{"book":"PSA","chapter":25,"verse":13,"verseEnd":13,"votes":29,"source":"openbible","text":"His soul will dwell in prosperity, and his descendants will inherit the land.","from":33},{"book":"PSA","chapter":112,"verse":7,"verseEnd":7,"votes":19,"source":"both","text":"He does not fear bad news; his heart is steadfast, trusting in the LORD.","from":33},{"book":"PSA","chapter":112,"verse":8,"verseEnd":8,"votes":19,"source":"openbible","text":"His heart is assured; he does not fear, until he looks in triumph on his foes.","from":33},{"book":"ISA","chapter":26,"verse":3,"verseEnd":3,"votes":15,"source":"both","text":"You will keep in perfect peace the steadfast of mind, because he trusts in You.","from":33},{"book":"EZK","chapter":33,"verse":11,"verseEnd":11,"votes":14,"source":"both","text":"Say to them: ‘As surely as I live, declares the Lord GOD, I take no pleasure in the death of the wicked, but rather that the wicked should turn from their ways and live. Turn! Turn from your evil ways! For why should you die, O house of Israel?’","from":23},{"book":"ACT","chapter":3,"verse":19,"verseEnd":19,"votes":12,"source":"both","text":"Repent, then, and turn back, so that your sins may be wiped away,","from":23},{"book":"PRO","chapter":14,"verse":14,"verseEnd":14,"votes":11,"source":"both","text":"The backslider in heart receives the fill of his own ways, but a good man is rewarded for his ways.","from":31}],"notes":[],"groups":[]}}