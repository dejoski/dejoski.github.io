{"1-6":{"people":[],"places":[],"words":[{"base":"H3477","lemma":"יָשָׁר","tr":"ya·shar","gloss":"upright","lang":"h","inPassage":2,"uses":119},{"base":"H6662","lemma":"צַדִּיק","tr":"tsad·diq","gloss":"righteous","lang":"h","inPassage":2,"uses":206},{"base":"H5769","lemma":"עוֹלָם","tr":"o·lam","gloss":"forever: enduring","lang":"h","inPassage":2,"uses":438},{"base":"H2587","lemma":"חַנּוּן","tr":"chan·nun","gloss":"gracious","lang":"h","inPassage":1,"uses":13},{"base":"H7349","lemma":"רַחוּם","tr":"ra·chum","gloss":"compassionate","lang":"h","inPassage":1,"uses":13},{"base":"H2224","lemma":"זָרַח","tr":"za·rach","gloss":"to rise","lang":"h","inPassage":1,"uses":18},{"base":"H2143","lemma":"זֵ֫כֶר","tr":"ze·kher","gloss":"memorial","lang":"h","inPassage":1,"uses":23},{"base":"H1952","lemma":"הוֹן","tr":"hon","gloss":"substance","lang":"h","inPassage":1,"uses":26},{"base":"H3867","lemma":"לָוָה","tr":"la·vah","gloss":"to join","lang":"h","inPassage":1,"uses":26},{"base":"H6239","lemma":"עֹ֫שֶׁר","tr":"o·sher","gloss":"riches","lang":"h","inPassage":1,"uses":37}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":128,"verse":1,"verseEnd":1,"votes":19,"source":"both","text":"Blessed are all who fear the LORD, who walk in His ways!","from":1},{"book":"PRO","chapter":15,"verse":6,"verseEnd":6,"votes":19,"source":"both","text":"The house of the righteous has great treasure, but the income of the wicked is trouble.","from":3},{"book":"GEN","chapter":17,"verse":7,"verseEnd":7,"votes":17,"source":"both","text":"I will establish My covenant as an everlasting covenant between Me and you and your descendants after you, to be your God and the God of your descendants after you.","from":2},{"book":"PRO","chapter":3,"verse":16,"verseEnd":16,"votes":17,"source":"both","text":"Long life is in her right hand; in her left hand are riches and honor.","from":3},{"book":"PSA","chapter":37,"verse":26,"verseEnd":26,"votes":16,"source":"both","text":"They are ever generous and quick to lend, and their children are a blessing.","from":2},{"book":"PRO","chapter":20,"verse":7,"verseEnd":7,"votes":16,"source":"both","text":"The righteous man walks with integrity; blessed are his children after him.","from":2},{"book":"ISA","chapter":50,"verse":10,"verseEnd":10,"votes":15,"source":"both","text":"Who among you fears the LORD and obeys the voice of His Servant? Who among you walks in darkness and has no light? Let him trust in the name of the LORD; let him lean on his God.","from":1},{"book":"PSA","chapter":25,"verse":13,"verseEnd":13,"votes":13,"source":"both","text":"His soul will dwell in prosperity, and his descendants will inherit the land.","from":2}],"notes":[],"groups":[]},"7-10":{"people":[],"places":[],"words":[{"base":"H7563","lemma":"רָשָׁע","tr":"ra·sah","gloss":"wicked","lang":"h","inPassage":2,"uses":263},{"base":"H3372","lemma":"יָרֵא","tr":"ya·re","gloss":"to fear","lang":"h","inPassage":2,"uses":315},{"base":"H2786","lemma":"חָרַק","tr":"cha·raq","gloss":"to grind","lang":"h","inPassage":1,"uses":5},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":2,"uses":595},{"base":"H6340","lemma":"פָּזַר","tr":"pa·zar","gloss":"to scatter","lang":"h","inPassage":1,"uses":10},{"base":"H8378","lemma":"תַּאֲוָה","tr":"ta·a·vah","gloss":"desire","lang":"h","inPassage":1,"uses":20},{"base":"H4549","lemma":"מָסַס","tr":"ma·sas","gloss":"to melt","lang":"h","inPassage":1,"uses":21},{"base":"H8052","lemma":"שְׁמוּעָה","tr":"she·mu·ah","gloss":"tidings","lang":"h","inPassage":1,"uses":27},{"base":"H5564","lemma":"סָמַךְ","tr":"sa·makh","gloss":"to support","lang":"h","inPassage":1,"uses":48},{"base":"H5703","lemma":"עַד","tr":"ad","gloss":"perpetuity","lang":"h","inPassage":1,"uses":48}],"parallels":[],"crossrefs":[{"book":"ISA","chapter":26,"verse":3,"verseEnd":3,"votes":22,"source":"openbible","text":"You will keep in perfect peace the steadfast of mind, because he trusts in You.","from":7},{"book":"ISA","chapter":26,"verse":4,"verseEnd":4,"votes":22,"source":"openbible","text":"Trust in the LORD forever, because GOD the LORD is the Rock eternal.","from":7},{"book":"PRO","chapter":1,"verse":33,"verseEnd":33,"votes":19,"source":"both","text":"But whoever listens to me will dwell in safety, secure from the fear of evil.”","from":7},{"book":"PSA","chapter":57,"verse":7,"verseEnd":7,"votes":18,"source":"both","text":"My heart is steadfast, O God, my heart is steadfast. I will sing and make music.","from":7},{"book":"PSA","chapter":118,"verse":6,"verseEnd":6,"votes":13,"source":"both","text":"The LORD is on my side; I will not be afraid. What can man do to me?","from":7},{"book":"PRO","chapter":3,"verse":25,"verseEnd":25,"votes":12,"source":"openbible","text":"Do not fear sudden danger or the ruin that overtakes the wicked,","from":7},{"book":"PRO","chapter":3,"verse":26,"verseEnd":26,"votes":12,"source":"openbible","text":"for the LORD will be your confidence and will keep your foot from the snare.","from":7},{"book":"JHN","chapter":14,"verse":1,"verseEnd":1,"votes":11,"source":"both","text":"“Do not let your hearts be troubled. You believe in God; believe in Me as well.","from":7}],"notes":[],"groups":[]}}