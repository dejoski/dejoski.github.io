{"1-5":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H5973","lemma":"עִם","tr":"im","gloss":"with","lang":"h","inPassage":4,"uses":1051},{"base":"H9038","lemma":"הֶם","tr":"hem","gloss":"them","lang":"h","inPassage":3,"uses":1125},{"base":"H4639","lemma":"מַעֲשֶׂה","tr":"ma·a·seh","gloss":"deed: work","lang":"h","inPassage":2,"uses":235},{"base":"H0408","lemma":"אַל","tr":"al","gloss":"not","lang":"h","inPassage":2,"uses":724},{"base":"H6468","lemma":"פְּעֻלָּה","tr":"pe·ul·lah","gloss":"wages","lang":"h","inPassage":1,"uses":14},{"base":"H1687","lemma":"דְּבִיר","tr":"de·vir","gloss":"sanctuary","lang":"h","inPassage":1,"uses":16},{"base":"H2814","lemma":"חָשָׁה","tr":"cha·shah","gloss":"be silent","lang":"h","inPassage":1,"uses":16},{"base":"H4911","lemma":"מָשַׁל","tr":"ma·shal","gloss":"to liken","lang":"h","inPassage":1,"uses":16},{"base":"H8469","lemma":"תַּחֲנוּן","tr":"ta·cha·nun","gloss":"supplication","lang":"h","inPassage":1,"uses":18},{"base":"H1576","lemma":"גְּמוּל","tr":"ge·mul","gloss":"recompense","lang":"h","inPassage":1,"uses":19}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":143,"verse":7,"verseEnd":7,"votes":15,"source":"both","text":"Answer me quickly, O LORD; my spirit fails. Do not hide Your face from me, or I will be like those who descend to the Pit.","from":1},{"book":"PSA","chapter":55,"verse":21,"verseEnd":21,"votes":13,"source":"both","text":"His speech is smooth as butter, but war is in his heart. His words are softer than oil, yet they are swords unsheathed.","from":3},{"book":"PSA","chapter":18,"verse":2,"verseEnd":2,"votes":11,"source":"both","text":"The LORD is my rock, my fortress, and my deliverer. My God is my rock, in whom I take refuge, my shield, and the horn of my salvation, my stronghold.","from":1},{"book":"PSA","chapter":83,"verse":1,"verseEnd":1,"votes":10,"source":"both","text":"O God, be not silent; be not speechless; be not still, O God.","from":1},{"book":"PSA","chapter":88,"verse":4,"verseEnd":4,"votes":10,"source":"openbible","text":"I am counted among those descending to the Pit. I am like a man without strength.","from":1},{"book":"PSA","chapter":88,"verse":6,"verseEnd":6,"votes":10,"source":"openbible","text":"You have laid me in the lowest Pit, in the darkest of the depths.","from":1},{"book":"PRO","chapter":1,"verse":12,"verseEnd":12,"votes":10,"source":"both","text":"let us swallow them alive like Sheol, and whole like those descending into the Pit.","from":1},{"book":"PSA","chapter":12,"verse":2,"verseEnd":2,"votes":8,"source":"both","text":"They lie to one another; they speak with flattering lips and a double heart.","from":3}],"notes":[],"groups":[]},"6-9":{"people":[],"places":[],"words":[{"base":"H5797","lemma":"עֹז","tr":"oz","gloss":"strength","lang":"h","inPassage":2,"uses":92},{"base":"H1288","lemma":"בָּרַךְ","tr":"ba·rakh","gloss":"to bless","lang":"h","inPassage":2,"uses":330},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":2,"uses":595},{"base":"H5937","lemma":"עָלַז","tr":"a·laz","gloss":"to exult","lang":"h","inPassage":1,"uses":16},{"base":"H8469","lemma":"תַּחֲנוּן","tr":"ta·cha·nun","gloss":"supplication","lang":"h","inPassage":1,"uses":18},{"base":"H4581","lemma":"מָעוֹז","tr":"ma·oz","gloss":"security","lang":"h","inPassage":1,"uses":36},{"base":"H4899","lemma":"מָשִׁיחַ","tr":"ma·shi·ach","gloss":"anointed","lang":"h","inPassage":1,"uses":39},{"base":"H4043","lemma":"מָגֵן","tr":"ma·gen","gloss":"shield","lang":"h","inPassage":1,"uses":63},{"base":"H3444","lemma":"יְשׁוּעָה","tr":"ye·shu·ah","gloss":"salvation","lang":"h","inPassage":1,"uses":78},{"base":"H5826","lemma":"עָזַר","tr":"a·zar","gloss":"to help","lang":"h","inPassage":1,"uses":81}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":30,"verse":11,"verseEnd":11,"votes":44,"source":"openbible","text":"You turned my mourning into dancing; You peeled off my sackcloth and clothed me with joy,","from":7},{"book":"PSA","chapter":30,"verse":12,"verseEnd":12,"votes":44,"source":"openbible","text":"that my heart may sing Your praises and not be silent. O LORD my God, I will give thanks forever.","from":7},{"book":"PSA","chapter":56,"verse":3,"verseEnd":3,"votes":41,"source":"openbible","text":"When I am afraid, I put my trust in You.","from":7},{"book":"PSA","chapter":56,"verse":4,"verseEnd":4,"votes":41,"source":"openbible","text":"In God, whose word I praise— in God I trust. I will not be afraid. What can man do to me?","from":7},{"book":"ISA","chapter":61,"verse":10,"verseEnd":10,"votes":31,"source":"both","text":"I will rejoice greatly in the LORD, my soul will exult in my God; for He has clothed me with garments of salvation and wrapped me in a robe of righteousness, as a bridegroom wears a priestly headdress, as a bride adorns herself with her jewels.","from":7},{"book":"EPH","chapter":6,"verse":10,"verseEnd":10,"votes":29,"source":"both","text":"Finally, be strong in the Lord and in His mighty power.","from":7},{"book":"PSA","chapter":40,"verse":3,"verseEnd":3,"votes":27,"source":"openbible","text":"He put a new song in my mouth, a hymn of praise to our God. Many will see and fear and put their trust in the LORD.","from":7},{"book":"PSA","chapter":13,"verse":5,"verseEnd":5,"votes":26,"source":"both","text":"But I have trusted in Your loving devotion; my heart will rejoice in Your salvation.","from":7}],"notes":[],"groups":[]}}