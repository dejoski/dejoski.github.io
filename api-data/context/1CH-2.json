 Benjamin 12,000.","from":1}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":15},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2},{"id":"judges-era","title":"Judges era and the road to David","people":2}]},"9-17":{"people":[{"id":"ram-h7410g","name":"Ram","kind":"person","brief":"Son of Hezron","count":2,"firstVerse":9},{"id":"a-wife-of-hezron-h2696k","name":"a wife of Hezron","kind":"person","brief":"From Judah","count":1,"firstVerse":9},{"id":"caleb-h3612h","name":"Caleb","kind":"person","brief":"Son of Hezron","count":1,"firstVerse":9},{"id":"hezron-h2696h","name":"Hezron","kind":"person","brief":"Son of Perez","count":1,"firstVerse":9},{"id":"jerahmeel-h3396g","name":"Jerahmeel","kind":"person","brief":"Son of Hezron","count":1,"firstVerse":9},{"id":"nahshon-h5177","name":"Nahshon","kind":"person","brief":"Son of Amminadab","count":2,"firstVerse":10},{"id":"amminadab-h5992g","name":"Amminadab","kind":"person","brief":"Son of Ram","count":1,"firstVerse":10},{"id":"judah-h3063g","name":"Judah","kind":"person","brief":"Son of Israel","count":1,"firstVerse":10},{"id":"boaz-h1162g","name":"Boaz","kind":"person","brief":"Son of Salmon","count":2,"firstVerse":11},{"id":"salmon-h8007g","name":"Salmon","kind":"person","brief":"Son of Nahshon","count":1,"firstVerse":11},{"id":"jesse-h3448","name":"Jesse","kind":"person","brief":"David's father","count":2,"firstVerse":12},{"id":"obed-h5744g","name":"Obed","kind":"person","brief":"Son of Boaz","count":1,"firstVerse":12},{"id":"abinadab-h0041i","name":"Abinadab","kind":"person","brief":"David's brother","count":1,"firstVerse":13},{"id":"eliab-h0446i","name":"Eliab","kind":"person","brief":"David's brother","count":1,"firstVerse":13},{"id":"shimeah-h8093","name":"Shimeah","kind":"person","brief":"David's brother","count":1,"firstVerse":13},{"id":"nethanel-h5417h","name":"Nethanel","kind":"person","brief":"David's brother","count":1,"firstVerse":14},{"id":"ra