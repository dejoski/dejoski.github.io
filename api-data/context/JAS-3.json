{"1-12":{"people":[],"places":[],"words":[{"base":"G1150","lemma":"δαμάζω","tr":"damazō","gloss":"to tame","lang":"g","inPassage":3,"uses":4},{"base":"G1100","lemma":"γλῶσσα","tr":"glōssa","gloss":"tongue","lang":"g","inPassage":4,"uses":49},{"base":"G3329","lemma":"μετάγω","tr":"metagō","gloss":"to turn","lang":"g","inPassage":2,"uses":2},{"base":"G5394","lemma":"φλογίζω","tr":"phlogizō","gloss":"to kindle","lang":"g","inPassage":2,"uses":2},{"base":"G2245","lemma":"ἡλίκος","tr":"hēlikos","gloss":"how great?","lang":"g","inPassage":2,"uses":3},{"base":"G1099","lemma":"γλυκύς","tr":"glukus","gloss":"sweet","lang":"g","inPassage":2,"uses":4},{"base":"G3650","lemma":"ὅλος","tr":"holos","gloss":"all","lang":"g","inPassage":3,"uses":109},{"base":"G4417","lemma":"πταίω","tr":"ptaiō","gloss":"to stumble","lang":"g","inPassage":2,"uses":5},{"base":"G4983","lemma":"σῶμα","tr":"sōma","gloss":"body","lang":"g","inPassage":3,"uses":142},{"base":"G5259","lemma":"ὑπό","tr":"hupo","gloss":"by","lang":"g","inPassage":3,"uses":219}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":120,"verse":2,"verseEnd":2,"votes":50,"source":"openbible","text":"Deliver my soul, O LORD, from lying lips and a deceitful tongue.","from":6},{"book":"PSA","chapter":120,"verse":3,"verseEnd":3,"votes":50,"source":"openbible","text":"What will He do to you, and what will be added to you, O deceitful tongue?","from":6},{"book":"JAS","chapter":1,"verse":26,"verseEnd":26,"votes":35,"source":"both","text":"If anyone considers himself religious and yet does not bridle his tongue, he deceives his heart and his religion is worthless.","from":2},{"book":"PRO","chapter":13,"verse":3,"verseEnd":3,"votes":33,"source":"both","text":"He who guards his mouth protects his life, but the one who opens his lips invites his own ruin.","from":2},{"book":"1PE","chapter":3,"verse":10,"verseEnd":10,"votes":29,"source":"both","text":"For, “Whoever would love life and see good days must keep his tongue from evil and his lips from deceitful speech.","from":2},{"book":"PRO","chapter":18,"verse":21,"verseEnd":21,"votes":28,"source":"both","text":"Life and death are in the power of the tongue, and those who love it will eat its fruit.","from":5},{"book":"MAT","chapter":12,"verse":37,"verseEnd":37,"votes":28,"source":"both","text":"For by your words you will be acquitted, and by your words you will be condemned.”","from":2},{"book":"PRO","chapter":16,"verse":27,"verseEnd":27,"votes":26,"source":"both","text":"A worthless man digs up evil, and his speech is like a scorching fire.","from":6}],"notes":[],"groups":[]},"13-18":{"people":[],"places":[],"words":[{"base":"G4678","lemma":"σοφία","tr":"sophia","gloss":"wisdom","lang":"g","inPassage":3,"uses":51},{"base":"G2052","lemma":"ἐριθεία","tr":"eritheia","gloss":"rivalry","lang":"g","inPassage":2,"uses":7},{"base":"G0509","lemma":"ἄνωθεν","tr":"anōthen","gloss":"from above","lang":"g","inPassage":2,"uses":13},{"base":"G2205","lemma":"ζῆλος","tr":"zēlos","gloss":"zeal","lang":"g","inPassage":2,"uses":16},{"base":"G2590","lemma":"καρπός","tr":"karpos","gloss":"fruit","lang":"g","inPassage":2,"uses":66},{"base":"G1515","lemma":"εἰρήνη","tr":"eirēnē","gloss":"peace","lang":"g","inPassage":2,"uses":92},{"base":"G1516","lemma":"εἰρηνικός","tr":"eirēnikos","gloss":"peaceful","lang":"g","inPassage":1,"uses":2},{"base":"G4089","lemma":"πικρός","tr":"pikros","gloss":"bitter","lang":"g","inPassage":1,"uses":2},{"base":"G2620","lemma":"κατακαυχάομαι","tr":"katakauchaomai","gloss":"to boast","lang":"g","inPassage":1,"uses":4},{"base":"G0181","lemma":"ἀκαταστασία","tr":"akatastasia","gloss":"disorder","lang":"g","inPassage":1,"uses":5}],"parallels":[],"crossrefs":[{"book":"GAL","chapter":5,"verse":22,"verseEnd":22,"votes":58,"source":"openbible","text":"But the fruit of the Spirit is love, joy, peace, patience, kindness, goodness, faithfulness,","from":17},{"book":"GAL","chapter":5,"verse":23,"verseEnd":23,"votes":58,"source":"openbible","text":"gentleness, and self-control. Against such things there is no law.","from":17},{"book":"GAL","chapter":5,"verse":23,"verseEnd":23,"votes":51,"source":"openbible","text":"gentleness, and self-control. Against such things there is no law.","from":13},{"book":"PRO","chapter":2,"verse":6,"verseEnd":6,"votes":47,"source":"both","text":"For the LORD gives wisdom; from His mouth come knowledge and understanding.","from":17},{"book":"MAT","chapter":5,"verse":9,"verseEnd":9,"votes":41,"source":"both","text":"Blessed are the peacemakers, for they will be called sons of God.","from":18},{"book":"1CO","chapter":13,"verse":4,"verseEnd":4,"votes":38,"source":"openbible","text":"Love is patient, love is kind. It does not envy, it does not boast, it is not proud.","from":17},{"book":"1CO","chapter":13,"verse":7,"verseEnd":7,"votes":38,"source":"openbible","text":"It bears all things, believes all things, hopes all things, endures all things.","from":17},{"book":"MAT","chapter":5,"verse":5,"verseEnd":5,"votes":36,"source":"openbible","text":"Blessed are the meek, for they will inherit the earth.","from":13}],"notes":[{"id":"prov-1-fear-lord","title":"The fear of the LORD is the beginning","kind":"background"}],"groups":[]}}