:"person","brief":"A singer","count":1,"firstVerse":18},{"id":"azaziah-h5812g","name":"Azaziah","kind":"person","brief":"","count":1,"firstVerse":21},{"id":"chenaniah-h3663","name":"Chenaniah","kind":"person","brief":"","count":1,"firstVerse":22},{"id":"elkanah-h0511m","name":"Elkanah","kind":"person","brief":"","count":1,"firstVerse":23},{"id":"amasai-h6022i","name":"Amasai","kind":"person","brief":"Priestly musician","count":1,"firstVerse":24},{"id":"eliezer-h0461j","name":"Eliezer","kind":"person","brief":"","count":1,"firstVerse":24},{"id":"joshaphat-h3146h","name":"Joshaphat","kind":"person","brief":"","count":1,"firstVerse":24},{"id":"nethanel-h5417i","name":"Nethanel","kind":"person","brief":"","count":1,"firstVerse":24},{"id":"shebaniah-h7645g","name":"Shebaniah","kind":"person","brief":"","count":1,"firstVerse":24}],"places":[],"words":[{"base":"H5654","lemma":"עֹבֵד אֱדוֹם","tr":"o·ved e·dom","gloss":"Obed-edom","lang":"h","inPassage":6,"uses":40},{"base":"H7778","lemma":"שֹׁעֵר","tr":"sho·er","gloss":"gatekeeper","lang":"h","inPassage":3,"uses":37},{"base":"H1141","lemma":"בְּנָיָ֫הוּ","tr":"be·na·yah","gloss":"Benaiah","lang":"h","inPassage":3,"uses":42},{"base":"H2148","lemma":"זְכַרְיָהוּ","tr":"ze·khar·yah","gloss":"Zechariah","lang":"h","inPassage":3,"uses":43},{"base":"H0466","lemma":"אֱלִיפְלֵ֫הוּ","tr":"e·liph·le·hu","gloss":"Eliphelehu","lang":"h","inPassage":2,"uses":2},{"base":"H4737","lemma":"מִקְנֵיָ֫הוּ","tr":"miq·ne·ya·hu","gloss":"Mikneiah","lang":"h","inPassage":2,"uses":2},{"base":"H6042","lemma":"עֻנִּי","tr":"un·ni","gloss":"Unni","lang":"h","inPassage":2,"uses":3},{"base":"H8070","lemma":"שְׁמִירָמוֹת","tr":"she·mi·ra·mot","gloss":"Shemiramoth","lang":"h","inPassage":2,"uses":4},{"base":"H0251","lemma":"אָח","tr":"ach","gloss":"brother: male-sibling","lang":"h","inPassage":4,"uses":629},{"base":"H0387","lemma":"אֵיתָן","tr":"e·tan","gloss":"Ethan","lang":"h","inPassage":2,"uses":8}],"parallels":[],"crossrefs":[{"book":"1CH","chapter":13,"verse":8,"verseEnd":8,"votes":5,"source":"both","text":"David and all the Israelites were celebrating before God with all their might, with songs and on harps and lyres, with tambourines, cymbals, and trumpets.","from":16},{"book":"1CH","chapter":16,"verse":6,"verseEnd":6,"votes":5,"source":"both","text":"and the priests Benaiah and Jahaziel blew the trumpets regularly before the ark of the covenant of God.","from":24},{"book":"NUM","chapter":10,"verse":8,"verseEnd":8,"votes":0,"source":"tsk","text":"The sons of Aaron, the priests, are to sound the trumpets. This shall be a permanent statute for you and the generations to come.","from":24},{"book":"1SA","chapter":8,"verse":2,"verseEnd":2,"votes":0,"source":"tsk","text":"The name of his firstborn son was Joel, and the name of his second was Abijah. They were judges in Beersheba.","from":17},{"book":"1SA","chapter":10,"verse":5,"verseEnd":5,"votes":0,"source":"tsk","text":"After that you will come to Gibeah of God, where the Philistines have an outpost. As you approach the city, you will meet a group of prophets coming down from the high place, preceded by harps, tambourines, flutes, and lyres, and they will be prophesying.","from":21},{"book":"2KI","chapter":22,"verse":4,"verseEnd":4,"votes":0,"source":"tsk","text":"“Go up to Hilkiah the high priest and have him count the money that has been brought into the house of the LORD, which the doorkeepers have collected from the people.","from":23},{"book":"2KI","chapter":25,"verse":18,"verseEnd":18,"votes":0,"source":"tsk","text":"The captain of the guard also took away Seraiah the chief priest, Zephaniah the priest of second rank, and the three doorkeepers.","from":23},{"book":"1CH","chapter":6,"verse":31,"verseEnd":38,"votes":0,"source":"tsk","text":"These are the men David put in charge of the music in the house of the LORD after the ark rested there. They ministered with song before the tabernacle, the Tent of Meeting, until Solomon built the house of the LORD in Jerusalem. And they performed their duties according to the regulations given them. These are the men who served, together with their sons. From the Kohathites: Heman the singer, the son of Joel, the son of Samuel, the son of Elkanah, the son of Jeroham, the son of Eliel, the son of Toah, the son of Zuph, the son of Elkanah, the son of Mahath, the son of Amasai,","from":16}],"notes":[],"groups":[]},"25-29":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":3,"firstVerse":25},{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":2,"firstVerse":25},{"id":"obed-edom-h5654","name":"Obed-edom","kind":"person","brief":"A Singer","count":1,"firstVerse":25},{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":2,"firstVerse":26},{"id":"chenaniah-h3663","name":"Chenaniah","kind":"person","brief":"","count":1,"firstVerse":27},{"id":"michal-h4324g","name":"Michal","kind":"person","brief":"Saul's daughter","count":1,"firstVerse":29},{"id":"saul-h7586g","name":"Saul","kind":"person","brief":"King of Israel,","count":1,"firstVerse":29}],"places":[],"words":[{"base":"H0727","lemma":"אֲרוֹן","tr":"a·ron","gloss":"ark","lang":"h","inPassage":5,"uses":202},{"base":"H1285","lemma":"בְּרִית","tr":"be·rit","gloss":"covenant","lang":"h","inPassage":4,"uses":284},{"base":"H1732","lemma":"דָּוִד","tr":"da·vid","gloss":"David","lang":"h","inPassage":5,"uses":1075},{"base":"H5654","lemma":"עֹבֵד אֱדוֹם","tr":"o·ved e·dom","gloss":"Obed-edom","lang":"h","inPassage":2,"uses":40},{"base":"H7891","lemma":"שִׁיר","tr":"shir","gloss":"to sing","lang":"h","inPassage":2,"uses":87},{"base":"H3881","lemma":"לֵוִי","tr":"le·viy·yi","gloss":"Levi","lang":"h","inPassage":2,"uses":291},{"base":"H7651","lemma":"שֶׁ֫בַע","tr":"she·va","gloss":"seven","lang":"h","inPassage":2,"uses":394},{"base":"H8269","lemma":"שַׂר","tr":"sar","gloss":"ruler","lang":"h","inPassage":2,"uses":421},{"base":"H3663","lemma":"כְּנַנְיָ֫הוּ","tr":"ke·nan·yah","gloss":"Chenaniah","lang":"h","inPassage":1,"uses":3},{"base":"H5375","lemma":"נָשָׂא","tr":"na·sa","gloss":"to lift: raise","lang":"h","inPassage":2,"uses":656}],"parallels":[],"crossrefs":[{"book":"NUM","chapter":23,"verse":29,"verseEnd":29,"votes":5,"source":"both","text":"Then Balaam said, “Build for me seven altars here, and prepare for me seven bulls and seven rams.”","from":26},{"book":"2SA","chapter":6,"verse":20,"verseEnd":20,"votes":5,"source":"openbible","text":"When David returned home to bless his own household, Saulʼs daughter Michal came out to meet him. “How the king of Israel has distinguished himself today!” she said. “He has uncovered himself today in the sight of the maidservants of his subjects, like a vulgar person would do.”","from":29},{"book":"2SA","chapter":6,"verse":23,"verseEnd":23,"votes":5,"source":"openbible","text":"And Michal the daughter of Saul had no children to the day of her death.","from":29},{"book":"1CH","chapter":13,"verse":8,"verseEnd":8,"votes":5,"source":"both","text":"David and all the Israelites were celebrating before God with all their might, with songs and on harps and lyres, with tambourines, cymbals, and trumpets.","from":28},{"book":"EXO","chapter":15,"verse":20,"verseEnd":20,"votes":0,"source":"tsk","text":"Then Miriam the prophetess, Aaronʼs sister, took a tambourine in her hand, and all the women followed her with tambourines and dancing.","from":29},{"book":"NUM","chapter":10,"verse":2,"verseEnd":2,"votes":0,"source":"tsk","text":"“Make two trumpets of hammered silver to be used for calling the congregation and for having the camps set out.","from":28},{"book":"NUM","chapter":10,"verse":33,"verseEnd":33,"votes":0,"source":"tsk","text":"So they set out on a three-day journey from the mountain of the LORD, with the ark of the covenant of the LORD traveling ahead of them for those three days to seek a resting place for them.","from":29},{"book":"NUM","chapter":23,"verse":1,"verseEnd":2,"votes":0,"source":"tsk","text":"Then Balaam said to Balak, “Build for me seven altars here, and prepare for me seven bulls and seven rams.” So Balak did as Balaam had instructed, and Balak and Balaam offered a bull and a ram on each altar.","from":26}],"notes":[],"groups":[{"id":"kings-prophets","title":"Kings, prophets and the house of David","people":3},{"id":"patriarchs","title":"The patriarchal families","people":2}]}}