":"patriarchs","title":"The patriarchal families","people":4},{"id":"exodus-family","title":"Moses and his circle","people":2},{"id":"judges-era","title":"Judges era and the road to David","people":2}]},"10-16":{"people":[{"id":"reuben-h7205","name":"Reuben","kind":"person","brief":"Son of Israel","count":2,"firstVerse":10},{"id":"elizur-h0468","name":"Elizur","kind":"person","brief":"Son of Shedeur","count":1,"firstVerse":10},{"id":"shedeur-h7707","name":"Shedeur","kind":"person","brief":"Father of Elizur","count":1,"firstVerse":10},{"id":"shelumiel-h8017","name":"Shelumiel","kind":"person","brief":"Son of Zurishaddai","count":1,"firstVerse":12},{"id":"simeon-h8095g","name":"Simeon","kind":"person","brief":"Son of Israel","count":1,"firstVerse":12},{"id":"zurishaddai-h6701","name":"Zurishaddai","kind":"person","brief":"Father of Shelumiel","count":1,"firstVerse":12},{"id":"deuel-h1845","name":"Deuel","kind":"person","brief":"Father of Eliasaph","count":1,"firstVerse":14},{"id":"eliasaph-h0460g","name":"Eliasaph","kind":"person","brief":"Son of Deuel","count":1,"firstVerse":14},{"id":"gad-h1410g","name":"Gad","kind":"person","brief":"Son of Israel","count":1,"firstVerse":14}],"places":[],"words":[{"base":"H6635","lemma":"צָבָא","tr":"tsa·va","gloss":"army","lang":"h","inPassage":5,"uses":484},{"base":"H0505","lemma":"אֶ֫לֶף","tr":"e·leph","gloss":"thousand","lang":"h","inPassage":5,"uses":506},{"base":"H2572","lemma":"חֲמִשִּׁים","tr":"cha·mish·shim","gloss":"fifty","lang":"h","inPassage":4,"uses":163},{"base":"H3967","lemma":"מֵאָה","tr":"me·ah","gloss":"hundred","lang":"h","inPassage":5,"uses":581},{"base":"H6485","lemma":"פָּקַד","tr":"pa·qad","gloss":"to reckon: list","lang":"h","inPassage":4,"uses":303},{"base":"H7205","lemma":"רְאוּבֵן","tr":"re·u·ven","gloss":"Reuben","lang":"h","inPassage":3,"uses":72},{"base":"H5387","lemma":"נָשִׂיא","tr":"na·si","gloss":"leader","lang":"h","inPassage":3,"uses":134},{"base":"H6701","lemma":"צוּרִישַׁדָּ֑י","tr":"tsu·ri·shad·day","gloss":"Zurishaddai","lang":"h","inPassage":2,"uses":7},{"base":"H8095","lemma":"שִׁמְעוֹן","tr":"shim·on","gloss":"Simeon","lang":"h","inPassage":2,"uses":44},{"base":"H1410","lemma":"גָּד","tr":"gad","gloss":"Gad","lang":"h","inPassage":2,"uses":72}],"parallels":[],"crossrefs":[{"book":"NUM","chapter":10,"verse":18,"verseEnd":18,"votes":5,"source":"both","text":"Then the divisions of the camp of Reuben set out under their standard, with Elizur son of Shedeur in command.","from":16},{"book":"GEN","chapter":49,"verse":3,"verseEnd":4,"votes":0,"source":"tsk","text":"Reuben, you are my firstborn, my might, and the beginning of my strength, excelling in honor, excelling in power. Uncontrolled as the waters, you will no longer excel, because you went up to your fatherʼs bed, onto my couch, and defiled it.","from":10},{"book":"NUM","chapter":1,"verse":5,"verseEnd":5,"votes":0,"source":"tsk","text":"These are the names of the men who are to assist you: From the tribe of Reuben, Elizur son of Shedeur;","from":10},{"book":"NUM","chapter":1,"verse":6,"verseEnd":6,"votes":0,"source":"tsk","text":"from Simeon, Shelumiel son of Zurishaddai;","from":12},{"book":"NUM","chapter":1,"verse":14,"verseEnd":14,"votes":0,"source":"tsk","text":"from Gad, Eliasaph son of Deuel;","from":14},{"book":"NUM","chapter":1,"verse":21,"verseEnd":21,"votes":0,"source":"tsk","text":"those registered to the tribe of Reuben numbered 46,500.","from":11},{"book":"NUM","chapter":1,"verse":23,"verseEnd":23,"votes":0,"source":"tsk","text":"those registered to the tribe of Simeon numbered 59,300.","from":13},{"book":"NUM","chapter":1,"verse":25,"verseEnd":25,"votes":0,"source":"tsk","text":"those registered to the tribe of Gad numbered 45,650.","from":15}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":3}]},"17-24":{"people":[{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":1,"firstVerse":17},{"id":"ephraim-h0669g","name":"Ephraim"