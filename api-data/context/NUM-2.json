he LORD had commanded Moses.","from":34},{"book":"NUM","chapter":1,"verse":12,"verseEnd":12,"votes":0,"source":"tsk","text":"from Dan, Ahiezer son of Ammishaddai;","from":25},{"book":"NUM","chapter":1,"verse":13,"verseEnd":13,"votes":0,"source":"tsk","text":"from Asher, Pagiel son of Ocran;","from":27}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":4}]}}