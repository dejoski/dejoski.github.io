{"1-8":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H4974","lemma":"מְתֹם","tr":"me·tom","gloss":"soundness","lang":"h","inPassage":2,"uses":4},{"base":"H5181","lemma":"נָחֵת","tr":"na·chat","gloss":"to descend","lang":"h","inPassage":2,"uses":11},{"base":"H0369","lemma":"אַ֫יִן","tr":"a·yin","gloss":"nothing","lang":"h","inPassage":3,"uses":788},{"base":"H1320","lemma":"בָּשָׂר","tr":"ba·sar","gloss":"flesh","lang":"h","inPassage":2,"uses":270},{"base":"H3966","lemma":"מְאֹד","tr":"me·od","gloss":"much","lang":"h","inPassage":2,"uses":300},{"base":"H5100","lemma":"נְהָמָה","tr":"ne·ha·mah","gloss":"groaning","lang":"h","inPassage":1,"uses":2},{"base":"H6313","lemma":"פּוּג","tr":"pug","gloss":"be numb","lang":"h","inPassage":1,"uses":4},{"base":"H7033","lemma":"קָלָה","tr":"qa·lah","gloss":"to roast","lang":"h","inPassage":1,"uses":4},{"base":"H1794","lemma":"דָּכָה","tr":"da·khah","gloss":"to crush","lang":"h","inPassage":1,"uses":5},{"base":"H2250","lemma":"חַבּוּרָה","tr":"chab·bu·rah","gloss":"wound","lang":"h","inPassage":1,"uses":7}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":40,"verse":12,"verseEnd":12,"votes":11,"source":"both","text":"For evils without number surround me; my sins have overtaken me, so that I cannot see. They are more than the hairs of my head, and my heart has failed within me.","from":4},{"book":"EZR","chapter":9,"verse":6,"verseEnd":6,"votes":9,"source":"both","text":"and said: “O my God, I am ashamed and embarrassed to lift up my face to You, my God, because our iniquities are higher than our heads, and our guilt has reached the heavens.","from":4},{"book":"PSA","chapter":6,"verse":1,"verseEnd":1,"votes":7,"source":"both","text":"O LORD, do not rebuke me in Your anger or discipline me in Your wrath.","from":1},{"book":"MAT","chapter":11,"verse":28,"verseEnd":28,"votes":7,"source":"both","text":"Come to Me, all you who are weary and burdened, and I will give you rest.","from":4},{"book":"JOB","chapter":30,"verse":28,"verseEnd":28,"votes":6,"source":"both","text":"I go about blackened, but not by the sun. I stand up in the assembly and cry for help.","from":6},{"book":"PSA","chapter":6,"verse":2,"verseEnd":2,"votes":6,"source":"both","text":"Be merciful to me, O LORD, for I am frail; heal me, O LORD, for my bones are in agony.","from":3},{"book":"JOB","chapter":6,"verse":4,"verseEnd":4,"votes":5,"source":"both","text":"For the arrows of the Almighty have pierced me; my spirit drinks in their poison; the terrors of God are arrayed against me.","from":2},{"book":"PSA","chapter":32,"verse":4,"verseEnd":4,"votes":5,"source":"both","text":"For day and night Your hand was heavy upon me; my strength was drained as in the summer heat. Selah","from":2}],"notes":[],"groups":[]},"9-14":{"people":[],"places":[],"words":[{"base":"H5048","lemma":"נֶ֫גֶד","tr":"ne·ged","gloss":"before","lang":"h","inPassage":2,"uses":151},{"base":"H6310","lemma":"פֶּה","tr":"peh","gloss":"lip","lang":"h","inPassage":2,"uses":498},{"base":"H5975","lemma":"עָמַד","tr":"a·mad","gloss":"to stand: stand","lang":"h","inPassage":2,"uses":521},{"base":"H5367","lemma":"נָקַשׁ","tr":"na·qash","gloss":"to snare","lang":"h","inPassage":1,"uses":5},{"base":"H0483","lemma":"אִלֵּם","tr":"il·lem","gloss":"mute","lang":"h","inPassage":1,"uses":6},{"base":"H2795","lemma":"חֵרֵשׁ","tr":"che·resh","gloss":"deaf","lang":"h","inPassage":1,"uses":9},{"base":"H0369","lemma":"אַ֫יִן","tr":"a·yin","gloss":"nothing","lang":"h","inPassage":2,"uses":788},{"base":"H0585","lemma":"אֲנָחָה","tr":"a·na·chah","gloss":"sighing","lang":"h","inPassage":1,"uses":11},{"base":"H1942","lemma":"הַוָּה","tr":"hav·vah","gloss":"desire","lang":"h","inPassage":1,"uses":16},{"base":"H8378","lemma":"תַּאֲוָה","tr":"ta·a·vah","gloss":"desire","lang":"h","inPassage":1,"uses":20}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":10,"verse":17,"verseEnd":17,"votes":7,"source":"openbible","text":"You have heard, O LORD, the desire of the humble; You will strengthen their hearts. You will incline Your ear,","from":9},{"book":"PSA","chapter":31,"verse":11,"verseEnd":11,"votes":7,"source":"both","text":"Among all my enemies I am a disgrace, and among my neighbors even more. I am dreaded by my friends— they flee when they see me on the street.","from":11},{"book":"PSA","chapter":6,"verse":6,"verseEnd":6,"votes":6,"source":"openbible","text":"I am weary from groaning; all night I flood my bed with weeping and drench my couch with tears.","from":9},{"book":"PSA","chapter":6,"verse":7,"verseEnd":7,"votes":6,"source":"both","text":"My eyes fail from grief; they grow dim because of all my foes.","from":10},{"book":"LUK","chapter":23,"verse":49,"verseEnd":49,"votes":6,"source":"both","text":"But all those who knew Jesus, including the women who had followed Him from Galilee, stood at a distance watching these things.","from":11},{"book":"JOB","chapter":19,"verse":13,"verseEnd":13,"votes":5,"source":"openbible","text":"He has removed my brothers from me; my acquaintances have abandoned me.","from":11},{"book":"JOB","chapter":19,"verse":17,"verseEnd":17,"votes":5,"source":"openbible","text":"My breath is repulsive to my wife, and I am loathsome to my own family.","from":11},{"book":"PSA","chapter":35,"verse":20,"verseEnd":20,"votes":5,"source":"both","text":"For they do not speak peace, but they devise deceitful schemes against those who live quietly in the land.","from":12}],"notes":[],"groups":[]},"15-22":{"people":[],"places":[],"words":[{"base":"H0136","lemma":"אֲדֹנָי","tr":"a·do·nai","gloss":"Lord","lang":"h","inPassage":2,"uses":440},{"base":"H6761","lemma":"צֶ֫לַע","tr":"tse·la","gloss":"stumbling","lang":"h","inPassage":1,"uses":4},{"base":"H8478","lemma":"תַּחַת","tr":"ta·chat","gloss":"underneath: under","lang":"h","inPassage":2,"uses":505},{"base":"H2896","lemma":"טוֹב","tr":"tov","gloss":"pleasant","lang":"h","inPassage":2,"uses":538},{"base":"H7853","lemma":"שָׂטַן","tr":"sa·tan","gloss":"to oppose","lang":"h","inPassage":1,"uses":6},{"base":"H1672","lemma":"דָּאַג","tr":"da·ag","gloss":"be anxious","lang":"h","inPassage":1,"uses":7},{"base":"H0408","lemma":"אַל","tr":"al","gloss":"not","lang":"h","inPassage":2,"uses":724},{"base":"H4341","lemma":"מַכְאוֹב","tr":"makh·ov","gloss":"pain","lang":"h","inPassage":1,"uses":16},{"base":"H2363","lemma":"חוּשׁ","tr":"chush","gloss":"to hasten","lang":"h","inPassage":1,"uses":20},{"base":"H6105","lemma":"עָצֹם","tr":"a·tsom","gloss":"be vast","lang":"h","inPassage":1,"uses":20}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":27,"verse":1,"verseEnd":1,"votes":10,"source":"both","text":"The LORD is my light and my salvation— whom shall I fear? The LORD is the stronghold of my life— whom shall I dread?","from":22},{"book":"PSA","chapter":40,"verse":13,"verseEnd":13,"votes":10,"source":"both","text":"Be pleased, O LORD, to deliver me; hurry, O LORD, to help me.","from":22},{"book":"PSA","chapter":39,"verse":7,"verseEnd":7,"votes":9,"source":"both","text":"And now, O Lord, for what do I wait? My hope is in You.","from":15},{"book":"PSA","chapter":17,"verse":6,"verseEnd":6,"votes":8,"source":"openbible","text":"I call on You, O God, for You will answer me. Incline Your ear to me; hear my words.","from":15},{"book":"PSA","chapter":32,"verse":5,"verseEnd":5,"votes":8,"source":"both","text":"Then I acknowledged my sin to You and did not hide my iniquity. I said, “I will confess my transgressions to the LORD,” and You forgave the guilt of my sin. Selah","from":18},{"book":"PRO","chapter":28,"verse":13,"verseEnd":13,"votes":8,"source":"both","text":"He who conceals his sins will not prosper, but whoever confesses and renounces them will find mercy.","from":18},{"book":"PSA","chapter":22,"verse":19,"verseEnd":19,"votes":7,"source":"both","text":"But You, O LORD, be not far off; O my Strength, come quickly to help me.","from":21},{"book":"PSA","chapter":35,"verse":12,"verseEnd":12,"votes":7,"source":"both","text":"They repay me evil for good, to the bereavement of my soul.","from":20}],"notes":[],"groups":[]}}