{"1-4":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":1}],"words":[{"base":"H1747","lemma":"דּוּמִיָּה","tr":"du·miy·yah","gloss":"silence","lang":"h","inPassage":1,"uses":4},{"base":"H9031","lemma":"ךָּ","tr":"ka","gloss":"you","lang":"h","inPassage":2,"uses":727},{"base":"H1396","lemma":"גָּבַר","tr":"ga·var","gloss":"to prevail","lang":"h","inPassage":1,"uses":25},{"base":"H2898","lemma":"טוּב","tr":"tuv","gloss":"goodness","lang":"h","inPassage":1,"uses":32},{"base":"H0835","lemma":"אֶ֫שֶׁר","tr":"e·sher","gloss":"blessed","lang":"h","inPassage":1,"uses":45},{"base":"H8416","lemma":"תְּהִלָּה","tr":"te·hil·lah","gloss":"praise","lang":"h","inPassage":1,"uses":57},{"base":"H5088","lemma":"נֶ֫דֶר","tr":"ne·der","gloss":"vow","lang":"h","inPassage":1,"uses":60},{"base":"H8605","lemma":"תְּפִלָּה","tr":"te·phil·lah","gloss":"prayer","lang":"h","inPassage":1,"uses":77},{"base":"H1964","lemma":"הֵיכָל","tr":"he·khal","gloss":"temple","lang":"h","inPassage":1,"uses":80},{"base":"H6588","lemma":"פֶּ֫שַׁע","tr":"pe·sah","gloss":"transgression","lang":"h","inPassage":1,"uses":93}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":84,"verse":4,"verseEnd":4,"votes":19,"source":"both","text":"How blessed are those who dwell in Your house! They are ever praising You. Selah","from":4},{"book":"PSA","chapter":23,"verse":6,"verseEnd":6,"votes":17,"source":"both","text":"Surely goodness and mercy will follow me all the days of my life, and I will dwell in the house of the LORD forever.","from":4},{"book":"EPH","chapter":1,"verse":4,"verseEnd":4,"votes":17,"source":"both","text":"For He chose us in Him before the foundation of the world to be holy and blameless in His presence. In love","from":4},{"book":"PSA","chapter":106,"verse":4,"verseEnd":4,"votes":16,"source":"openbible","text":"Remember me, O LORD, in Your favor to Your people; visit me with Your salvation,","from":4},{"book":"PSA","chapter":106,"verse":5,"verseEnd":5,"votes":16,"source":"openbible","text":"that I may see the prosperity of Your chosen ones, and rejoice in the gladness of Your nation, and give glory with Your inheritance.","from":4},{"book":"PSA","chapter":33,"verse":12,"verseEnd":12,"votes":14,"source":"both","text":"Blessed is the nation whose God is the LORD, the people He has chosen as His inheritance!","from":4},{"book":"PSA","chapter":36,"verse":8,"verseEnd":8,"votes":14,"source":"both","text":"They feast on the abundance of Your house, and You give them drink from Your river of delights.","from":4},{"book":"ISA","chapter":65,"verse":24,"verseEnd":24,"votes":14,"source":"both","text":"Even before they call, I will answer, and while they are still speaking, I will hear.","from":2}],"notes":[],"groups":[]},"5-8":{"people":[],"places":[],"words":[{"base":"H7588","lemma":"שָׁאוֹן","tr":"sha·on","gloss":"roar","lang":"h","inPassage":2,"uses":18},{"base":"H3372","lemma":"יָרֵא","tr":"ya·re","gloss":"to fear","lang":"h","inPassage":2,"uses":315},{"base":"H3220","lemma":"יָם","tr":"yam","gloss":"sea","lang":"h","inPassage":2,"uses":396},{"base":"H7099","lemma":"קָ֫צוּ","tr":"qe·tsev","gloss":"boundary","lang":"h","inPassage":1,"uses":3},{"base":"H7117","lemma":"קְצָת","tr":"qe·tsat","gloss":"end","lang":"h","inPassage":1,"uses":7},{"base":"H7623","lemma":"שָׁבַח","tr":"sha·vach","gloss":"to soothe","lang":"h","inPassage":1,"uses":11},{"base":"H4009","lemma":"מִבְטָח","tr":"miv·tach","gloss":"confidence","lang":"h","inPassage":1,"uses":15},{"base":"H0247","lemma":"אָזַר","tr":"a·zar","gloss":"to gird","lang":"h","inPassage":1,"uses":16},{"base":"H4161","lemma":"מוֹצָא","tr":"mo·tsa","gloss":"exit","lang":"h","inPassage":1,"uses":27},{"base":"H3816","lemma":"לְאֹם","tr":"le·om","gloss":"people","lang":"h","inPassage":1,"uses":31}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":148,"verse":3,"verseEnd":3,"votes":9,"source":"both","text":"Praise Him, O sun and moon; praise Him, all you shining stars.","from":8},{"book":"DEU","chapter":10,"verse":21,"verseEnd":21,"votes":8,"source":"both","text":"He is your praise and He is your God, who has done for you these great and awesome wonders that your eyes have seen.","from":5},{"book":"PSA","chapter":136,"verse":8,"verseEnd":8,"votes":8,"source":"both","text":"the sun to rule the day, His loving devotion endures forever.","from":8},{"book":"PSA","chapter":66,"verse":3,"verseEnd":3,"votes":7,"source":"both","text":"Say to God, “How awesome are Your deeds! So great is Your power that Your enemies cower before You.","from":5},{"book":"PSA","chapter":104,"verse":20,"verseEnd":20,"votes":7,"source":"openbible","text":"You bring darkness, and it becomes night, when all the beasts of the forest prowl.","from":8},{"book":"PSA","chapter":104,"verse":23,"verseEnd":23,"votes":7,"source":"openbible","text":"Man goes forth to his work and to his labor until evening.","from":8},{"book":"PSA","chapter":45,"verse":4,"verseEnd":4,"votes":6,"source":"both","text":"In your splendor ride forth in victory on behalf of truth and humility and justice; may your right hand show your awesome deeds.","from":5},{"book":"PSA","chapter":74,"verse":16,"verseEnd":16,"votes":6,"source":"both","text":"The day is Yours, and also the night; You established the moon and the sun.","from":8}],"notes":[],"groups":[]},"9-13":{"people":[],"places":[],"words":[{"base":"H7491","lemma":"רָעַף","tr":"ra·aph","gloss":"to drip","lang":"h","inPassage":2,"uses":5},{"base":"H3559","lemma":"כּוּן","tr":"kun","gloss":"to establish: prepare","lang":"h","inPassage":2,"uses":217},{"base":"H1417","lemma":"גְּדוּד","tr":"ge·dud","gloss":"furrow","lang":"h","inPassage":1,"uses":2},{"base":"H7783","lemma":"שׁוּק","tr":"shuq","gloss":"to overflow","lang":"h","inPassage":1,"uses":3},{"base":"H8525","lemma":"תֶּ֫לֶם","tr":"te·lem","gloss":"furrow","lang":"h","inPassage":1,"uses":5},{"base":"H7241","lemma":"רְבִיבִים","tr":"ra·viv","gloss":"shower","lang":"h","inPassage":1,"uses":6},{"base":"H5849","lemma":"עָטַר","tr":"a·tar","gloss":"to surround","lang":"h","inPassage":1,"uses":7},{"base":"H1524","lemma":"גִּיל","tr":"gil","gloss":"rejoicing","lang":"h","inPassage":1,"uses":9},{"base":"H6388","lemma":"פֶּ֫לֶג","tr":"pe·leg","gloss":"stream","lang":"h","inPassage":1,"uses":10},{"base":"H5181","lemma":"נָחֵת","tr":"na·chat","gloss":"to descend","lang":"h","inPassage":1,"uses":11}],"parallels":[],"crossrefs":[{"book":"JOL","chapter":2,"verse":21,"verseEnd":21,"votes":22,"source":"openbible","text":"Do not be afraid, O land; rejoice and be glad, for the LORD has done great things.","from":11},{"book":"JOL","chapter":2,"verse":26,"verseEnd":26,"votes":22,"source":"openbible","text":"You will have plenty to eat, until you are satisfied. You will praise the name of the LORD your God, who has worked wonders for you. My people will never again be put to shame.","from":11},{"book":"PSA","chapter":103,"verse":4,"verseEnd":4,"votes":20,"source":"both","text":"who redeems your life from the Pit and crowns you with loving devotion and compassion,","from":11},{"book":"PSA","chapter":5,"verse":12,"verseEnd":12,"votes":19,"source":"both","text":"For surely You, O LORD, bless the righteous; You surround them with the shield of Your favor.","from":11},{"book":"PSA","chapter":36,"verse":8,"verseEnd":8,"votes":15,"source":"both","text":"They feast on the abundance of Your house, and You give them drink from Your river of delights.","from":11},{"book":"HAG","chapter":2,"verse":19,"verseEnd":19,"votes":13,"source":"both","text":"Is there still seed in the barn? The vine, the fig, the pomegranate, and the olive tree have not yet yielded fruit. But from this day on, I will bless you.”","from":11},{"book":"PRO","chapter":14,"verse":18,"verseEnd":18,"votes":11,"source":"both","text":"The simple inherit folly, but the prudent are crowned with knowledge.","from":11},{"book":"PSA","chapter":46,"verse":4,"verseEnd":4,"votes":8,"source":"both","text":"There is a river whose streams delight the city of God, the holy place where the Most High dwells.","from":9}],"notes":[],"groups":[]}}