{"1-3":{"people":[],"places":[],"words":[{"base":"H5000","lemma":"נָאוֶה","tr":"na·eh","gloss":"lovely","lang":"h","inPassage":1,"uses":10},{"base":"H5059","lemma":"נָגַן","tr":"na·gan","gloss":"to play","lang":"h","inPassage":1,"uses":15},{"base":"H6218","lemma":"עָשׂוֹר","tr":"a·s·vor","gloss":"ten","lang":"h","inPassage":1,"uses":16},{"base":"H8643","lemma":"תְּרוּעָה","tr":"te·ru·ah","gloss":"shout","lang":"h","inPassage":1,"uses":36},{"base":"H5035","lemma":"נֵ֫בֶל","tr":"ne·vel","gloss":"bag","lang":"h","inPassage":1,"uses":38},{"base":"H3658","lemma":"כִּנּוֹר","tr":"kin·nor","gloss":"lyre","lang":"h","inPassage":1,"uses":42},{"base":"H2167","lemma":"זָמַר","tr":"za·mar","gloss":"to sing","lang":"h","inPassage":1,"uses":45},{"base":"H2319","lemma":"חָדָשׁ","tr":"cha·dash","gloss":"New (Gate)","lang":"h","inPassage":1,"uses":53},{"base":"H7442","lemma":"רוּן","tr":"run","gloss":"to overcome","lang":"h","inPassage":1,"uses":54},{"base":"H8416","lemma":"תְּהִלָּה","tr":"te·hil·lah","gloss":"praise","lang":"h","inPassage":1,"uses":57}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":32,"verse":11,"verseEnd":11,"votes":12,"source":"both","text":"Be glad in the LORD and rejoice, O righteous ones; shout for joy, all you upright in heart.","from":1},{"book":"PSA","chapter":147,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Hallelujah! How good it is to sing praises to our God, how pleasant and lovely to praise Him!","from":1},{"book":"PHP","chapter":4,"verse":4,"verseEnd":4,"votes":8,"source":"both","text":"Rejoice in the Lord always. I will say it again: Rejoice!","from":1},{"book":"PSA","chapter":150,"verse":3,"verseEnd":3,"votes":7,"source":"openbible","text":"Praise Him with the sound of the horn; praise Him with the harp and lyre.","from":2},{"book":"PSA","chapter":150,"verse":6,"verseEnd":6,"votes":7,"source":"openbible","text":"Let everything that has breath praise the LORD! Hallelujah!","from":2},{"book":"PSA","chapter":97,"verse":12,"verseEnd":12,"votes":6,"source":"both","text":"Rejoice in the LORD, you righteous ones, and praise His holy name.","from":1},{"book":"PSA","chapter":98,"verse":4,"verseEnd":4,"votes":6,"source":"openbible","text":"Make a joyful noise to the LORD, all the earth; break forth—let your cry ring out, and sing praises!","from":2},{"book":"PSA","chapter":98,"verse":5,"verseEnd":5,"votes":6,"source":"openbible","text":"Sing praises to the LORD with the lyre, in melodious song with the harp.","from":2}],"notes":[],"groups":[]},"4-9":{"people":[],"places":[],"words":[{"base":"H5067","lemma":"נֵד","tr":"ned","gloss":"heap","lang":"h","inPassage":1,"uses":6},{"base":"H3664","lemma":"כָּנַס","tr":"ka·nas","gloss":"to gather","lang":"h","inPassage":1,"uses":11},{"base":"H8398","lemma":"תֵּבֵל","tr":"te·vel","gloss":"world","lang":"h","inPassage":1,"uses":36},{"base":"H8415","lemma":"תְּהוֹם","tr":"te·hom","gloss":"abyss","lang":"h","inPassage":1,"uses":36},{"base":"H0530","lemma":"אֱמוּנָה","tr":"e·mu·nah","gloss":"faithfulness","lang":"h","inPassage":1,"uses":49},{"base":"H0214","lemma":"אוֹצָר","tr":"o·tsar","gloss":"treasure","lang":"h","inPassage":1,"uses":79},{"base":"H1481","lemma":"גּוּר","tr":"gur","gloss":"to sojourn","lang":"h","inPassage":1,"uses":97},{"base":"H3477","lemma":"יָשָׁר","tr":"ya·shar","gloss":"upright","lang":"h","inPassage":1,"uses":119},{"base":"H6666","lemma":"צְדָקָה","tr":"tse·da·qah","gloss":"righteousness","lang":"h","inPassage":1,"uses":157},{"base":"H0157","lemma":"אָהֵב","tr":"a·hav","gloss":"to love: lover","lang":"h","inPassage":1,"uses":211}],"parallels":[],"crossrefs":[{"book":"HEB","chapter":11,"verse":3,"verseEnd":3,"votes":29,"source":"both","text":"By faith we understand that the universe was formed at Godʼs command, so that what is seen was not made out of what was visible.","from":6},{"book":"GEN","chapter":1,"verse":3,"verseEnd":3,"votes":20,"source":"both","text":"And God said, “Let there be light,” and there was light.","from":9},{"book":"JHN","chapter":1,"verse":1,"verseEnd":1,"votes":18,"source":"openbible","text":"In the beginning was the Word, and the Word was with God, and the Word was God.","from":6},{"book":"JHN","chapter":1,"verse":3,"verseEnd":3,"votes":18,"source":"openbible","text":"Through Him all things were made, and without Him nothing was made that has been made.","from":6},{"book":"2PE","chapter":3,"verse":5,"verseEnd":5,"votes":18,"source":"both","text":"But they deliberately overlook the fact that long ago by Godʼs word the heavens existed and the earth was formed out of water and by water,","from":6},{"book":"JOB","chapter":33,"verse":4,"verseEnd":4,"votes":17,"source":"both","text":"The Spirit of God has made me, and the breath of the Almighty gives me life.","from":6},{"book":"PSA","chapter":148,"verse":5,"verseEnd":5,"votes":15,"source":"openbible","text":"Let them praise the name of the LORD, for He gave the command and they were created.","from":9},{"book":"PSA","chapter":148,"verse":6,"verseEnd":6,"votes":15,"source":"openbible","text":"He established them forever and ever; He issued a decree that will never pass away.","from":9}],"notes":[],"groups":[]},"10-12":{"people":[],"places":[],"words":[{"base":"H4284","lemma":"מַחֲשָׁבָה","tr":"ma·cha·sha·vah","gloss":"plot","lang":"h","inPassage":2,"uses":56},{"base":"H6098","lemma":"עֵצָה","tr":"e·tsah","gloss":"counsel","lang":"h","inPassage":2,"uses":89},{"base":"H1755","lemma":"דּוֹר","tr":"dor","gloss":"generation","lang":"h","inPassage":2,"uses":167},{"base":"H6331","lemma":"פּוּר","tr":"pur","gloss":"to break","lang":"h","inPassage":1,"uses":3},{"base":"H1471","lemma":"גּוֹי","tr":"goy","gloss":"nation","lang":"h","inPassage":2,"uses":561},{"base":"H5106","lemma":"נוּא","tr":"nu","gloss":"to forbid","lang":"h","inPassage":1,"uses":8},{"base":"H0835","lemma":"אֶ֫שֶׁר","tr":"e·sher","gloss":"blessed","lang":"h","inPassage":1,"uses":45},{"base":"H0977","lemma":"בָּחַר","tr":"ba·char","gloss":"to choose","lang":"h","inPassage":1,"uses":171},{"base":"H5159","lemma":"נַחֲלָה","tr":"na·cha·lah","gloss":"inheritance","lang":"h","inPassage":1,"uses":222},{"base":"H5769","lemma":"עוֹלָם","tr":"o·lam","gloss":"forever: enduring","lang":"h","inPassage":1,"uses":438}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":21,"verse":11,"verseEnd":11,"votes":272,"source":"both","text":"Though they intend You harm, the schemes they devise will not prevail.","from":10},{"book":"JOB","chapter":5,"verse":12,"verseEnd":12,"votes":244,"source":"openbible","text":"He thwarts the schemes of the crafty, so that their hands find no success.","from":10},{"book":"JOB","chapter":5,"verse":13,"verseEnd":13,"votes":244,"source":"openbible","text":"He catches the wise in their craftiness, and sweeps away the plans of the cunning.","from":10},{"book":"ISA","chapter":44,"verse":25,"verseEnd":25,"votes":209,"source":"both","text":"who foils the signs of false prophets and makes fools of diviners, who confounds the wise and turns their knowledge into nonsense,","from":10},{"book":"PRO","chapter":21,"verse":30,"verseEnd":30,"votes":187,"source":"both","text":"There is no wisdom, no understanding, no counsel that can prevail against the LORD.","from":10},{"book":"2SA","chapter":15,"verse":31,"verseEnd":31,"votes":160,"source":"both","text":"Now someone told David: “Ahithophel is among the conspirators with Absalom.” So David pleaded, “O LORD, please turn the counsel of Ahithophel into foolishness!”","from":10},{"book":"PSA","chapter":140,"verse":8,"verseEnd":8,"votes":144,"source":"both","text":"Grant not, O LORD, the desires of the wicked; do not promote their evil plans, lest they be exalted. Selah","from":10},{"book":"ISA","chapter":8,"verse":9,"verseEnd":9,"votes":143,"source":"openbible","text":"Huddle together, O peoples, and be shattered; pay attention, all you distant lands; prepare for battle, and be shattered; prepare for battle, and be shattered!","from":10}],"notes":[],"groups":[]},"13-19":{"people":[],"places":[],"words":[{"base":"H7230","lemma":"רֹב","tr":"rov","gloss":"abundance","lang":"h","inPassage":3,"uses":149},{"base":"H5337","lemma":"נָצַל","tr":"na·tsal","gloss":"to rescue","lang":"h","inPassage":2,"uses":213},{"base":"H2428","lemma":"חַ֫יִל","tr":"cha·yil","gloss":"strength: soldiers","lang":"h","inPassage":2,"uses":246},{"base":"H7688","lemma":"שָׁגַח","tr":"sha·gach","gloss":"to gaze","lang":"h","inPassage":1,"uses":3},{"base":"H4349","lemma":"מָכוֹן","tr":"ma·khon","gloss":"foundation","lang":"h","inPassage":1,"uses":17},{"base":"H3427","lemma":"יָשַׁב","tr":"ya·shav","gloss":"to dwell","lang":"h","inPassage":2,"uses":1079},{"base":"H8668","lemma":"תְּשׁוּעָה","tr":"te·shu·ah","gloss":"deliverance: salvation","lang":"h","inPassage":1,"uses":34},{"base":"H3176","lemma":"יָחַל","tr":"ya·chal","gloss":"to wait: wait","lang":"h","inPassage":1,"uses":41},{"base":"H3335","lemma":"יָצַר","tr":"ya·tsar","gloss":"to form: formed","lang":"h","inPassage":1,"uses":62},{"base":"H3373","lemma":"יָרֵא","tr":"ya·re","gloss":"afraid","lang":"h","inPassage":1,"uses":64}],"parallels":[],"crossrefs":[{"book":"1PE","chapter":3,"verse":12,"verseEnd":12,"votes":23,"source":"both","text":"For the eyes of the Lord are on the righteous, and His ears are inclined to their prayer. But the face of the Lord is against those who do evil.”","from":18},{"book":"JOB","chapter":36,"verse":7,"verseEnd":7,"votes":16,"source":"both","text":"He does not take His eyes off the righteous, but He enthrones them with kings and exalts them forever.","from":18},{"book":"PSA","chapter":147,"verse":11,"verseEnd":11,"votes":16,"source":"both","text":"The LORD is pleased with those who fear Him, who hope in His loving devotion.","from":18},{"book":"PSA","chapter":34,"verse":15,"verseEnd":15,"votes":14,"source":"openbible","text":"The eyes of the LORD are on the righteous, and His ears are inclined to their cry.","from":18},{"book":"PSA","chapter":34,"verse":20,"verseEnd":20,"votes":14,"source":"openbible","text":"He protects all his bones; not one of them will be broken.","from":18},{"book":"PSA","chapter":37,"verse":19,"verseEnd":19,"votes":14,"source":"both","text":"In the time of evil they will not be ashamed, and in the days of famine they will be satisfied.","from":19},{"book":"JOB","chapter":28,"verse":24,"verseEnd":24,"votes":10,"source":"both","text":"For He looks to the ends of the earth and sees everything under the heavens.","from":13},{"book":"PRO","chapter":10,"verse":3,"verseEnd":3,"votes":10,"source":"both","text":"The LORD does not let the righteous go hungry, but He denies the craving of the wicked.","from":19}],"notes":[],"groups":[]},"20-22":{"people":[],"places":[],"words":[{"base":"H2442","lemma":"חָכָה","tr":"cha·khah","gloss":"to wait","lang":"h","inPassage":1,"uses":14},{"base":"H5828","lemma":"עֵ֫זֶר","tr":"e·zer","gloss":"helper","lang":"h","inPassage":1,"uses":21},{"base":"H3176","lemma":"יָחַל","tr":"ya·chal","gloss":"to wait: wait","lang":"h","inPassage":1,"uses":41},{"base":"H4043","lemma":"מָגֵן","tr":"ma·gen","gloss":"shield","lang":"h","inPassage":1,"uses":63},{"base":"H0982","lemma":"בָּטַח","tr":"ba·tach","gloss":"to trust","lang":"h","inPassage":1,"uses":120},{"base":"H8055","lemma":"שָׂמַח","tr":"sa·mach","gloss":"to rejoice","lang":"h","inPassage":1,"uses":155},{"base":"H2617","lemma":"חֶ֫סֶד","tr":"che·sed","gloss":"kindness","lang":"h","inPassage":1,"uses":247},{"base":"H9032","lemma":"ךְ","tr":"kh","gloss":"you","lang":"h","inPassage":1,"uses":333},{"base":"H6944","lemma":"קֹ֫דֶשׁ","tr":"qo·desh","gloss":"holiness","lang":"h","inPassage":1,"uses":469},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":1,"uses":595}],"parallels":[],"crossrefs":[{"book":"ISA","chapter":40,"verse":31,"verseEnd":31,"votes":16,"source":"both","text":"But those who wait upon the LORD will renew their strength; they will mount up with wings like eagles; they will run and not grow weary, they will walk and not faint.","from":20},{"book":"PSA","chapter":27,"verse":14,"verseEnd":14,"votes":14,"source":"both","text":"Wait patiently for the LORD; be strong and courageous. Wait patiently for the LORD!","from":20},{"book":"PSA","chapter":13,"verse":5,"verseEnd":5,"votes":12,"source":"both","text":"But I have trusted in Your loving devotion; my heart will rejoice in Your salvation.","from":22},{"book":"PSA","chapter":119,"verse":76,"verseEnd":76,"votes":11,"source":"both","text":"May Your loving devotion comfort me, I pray, according to Your promise to Your servant.","from":22},{"book":"PSA","chapter":130,"verse":5,"verseEnd":5,"votes":11,"source":"openbible","text":"I wait for the LORD; my soul does wait, and in His word I put my hope.","from":20},{"book":"PSA","chapter":130,"verse":6,"verseEnd":6,"votes":11,"source":"openbible","text":"My soul waits for the Lord more than watchmen wait for the morning— more than watchmen wait for the morning.","from":20},{"book":"PSA","chapter":13,"verse":5,"verseEnd":5,"votes":10,"source":"both","text":"But I have trusted in Your loving devotion; my heart will rejoice in Your salvation.","from":21},{"book":"MAT","chapter":9,"verse":29,"verseEnd":29,"votes":10,"source":"both","text":"Then He touched their eyes and said, “According to your faith will it be done to you.”","from":22}],"notes":[],"groups":[]}}