{"1-7":{"people":[],"places":[],"words":[{"base":"G1063","lemma":"γάρ","tr":"gar","gloss":"for","lang":"g","inPassage":7,"uses":1041},{"base":"G5411","lemma":"φόρος","tr":"phoros","gloss":"tax","lang":"g","inPassage":3,"uses":5},{"base":"G1849","lemma":"ἐξουσία","tr":"exousia","gloss":"authority","lang":"g","inPassage":4,"uses":102},{"base":"G5401","lemma":"φόβος","tr":"phobos","gloss":"fear","lang":"g","inPassage":3,"uses":47},{"base":"G2556","lemma":"κακός","tr":"kakos","gloss":"evil","lang":"g","inPassage":3,"uses":50},{"base":"G0018","lemma":"ἀγαθός","tr":"agathos","gloss":"good","lang":"g","inPassage":3,"uses":102},{"base":"G0436","lemma":"ἀνθίστημι","tr":"anthistēmi","gloss":"to oppose","lang":"g","inPassage":2,"uses":14},{"base":"G1249","lemma":"διάκονος","tr":"diakonos","gloss":"servant","lang":"g","inPassage":2,"uses":29},{"base":"G3709","lemma":"ὀργή","tr":"orgē","gloss":"wrath","lang":"g","inPassage":2,"uses":36},{"base":"G5293","lemma":"ὑποτάσσω","tr":"hupotassō","gloss":"to subject","lang":"g","inPassage":2,"uses":38}],"parallels":[],"crossrefs":[{"book":"TIT","chapter":3,"verse":1,"verseEnd":1,"votes":69,"source":"both","text":"Remind the believers to submit to rulers and authorities, to be obedient and ready for every good work,","from":1},{"book":"1PE","chapter":2,"verse":13,"verseEnd":13,"votes":53,"source":"openbible","text":"Submit yourselves for the Lordʼs sake to every human institution, whether to the king as the supreme authority,","from":1},{"book":"1PE","chapter":2,"verse":17,"verseEnd":17,"votes":53,"source":"openbible","text":"Treat everyone with high regard: Love the brotherhood of believers, fear God, honor the king.","from":1},{"book":"DAN","chapter":2,"verse":21,"verseEnd":21,"votes":43,"source":"both","text":"He changes the times and seasons; He removes kings and establishes them. He gives wisdom to the wise and knowledge to the discerning.","from":1},{"book":"JHN","chapter":19,"verse":11,"verseEnd":11,"votes":25,"source":"both","text":"Jesus answered, “You would have no authority over Me if it were not given to you from above. Therefore the one who handed Me over to you is guilty of greater sin.”","from":1},{"book":"PRO","chapter":8,"verse":15,"verseEnd":15,"votes":23,"source":"openbible","text":"By me kings reign, and rulers enact just laws;","from":1},{"book":"PRO","chapter":8,"verse":16,"verseEnd":16,"votes":23,"source":"openbible","text":"By me princes rule, and all nobles who govern justly.","from":1},{"book":"JER","chapter":27,"verse":5,"verseEnd":5,"votes":18,"source":"openbible","text":"By My great power and outstretched arm, I made the earth and the men and beasts on the face of it, and I give it to whom I please.","from":1}],"notes":[],"groups":[]},"8-10":{"people":[],"places":[],"words":[{"base":"G0025","lemma":"ἀγαπάω","tr":"agapaō","gloss":"to love","lang":"g","inPassage":3,"uses":143},{"base":"G4139","lemma":"πλησίον","tr":"plēsion","gloss":"near","lang":"g","inPassage":2,"uses":17},{"base":"G3367","lemma":"μηδείς","tr":"mēdeis","gloss":"nothing","lang":"g","inPassage":2,"uses":90},{"base":"G2087","lemma":"ἕτερος","tr":"heteros","gloss":"other","lang":"g","inPassage":2,"uses":97},{"base":"G0026","lemma":"ἀγάπη","tr":"agapē","gloss":"love","lang":"g","inPassage":2,"uses":116},{"base":"G3551","lemma":"νόμος","tr":"nomos","gloss":"law","lang":"g","inPassage":2,"uses":193},{"base":"G0346","lemma":"ἀνακεφαλαιόομαι","tr":"anakephalaioomai","gloss":"to summarise","lang":"g","inPassage":1,"uses":2},{"base":"G1487","lemma":"εἰ","tr":"ei","gloss":"if","lang":"g","inPassage":2,"uses":508},{"base":"G5407","lemma":"φονεύω","tr":"phoneuō","gloss":"to murder","lang":"g","inPassage":1,"uses":12},{"base":"G2813","lemma":"κλέπτω","tr":"kleptō","gloss":"to steal","lang":"g","inPassage":1,"uses":13}],"parallels":[],"crossrefs":[{"book":"MAT","chapter":22,"verse":39,"verseEnd":39,"votes":57,"source":"openbible","text":"And the second is like it: ‘Love your neighbor as yourself.’","from":10},{"book":"MAT","chapter":22,"verse":40,"verseEnd":40,"votes":57,"source":"both","text":"All the Law and the Prophets hang on these two commandments.”","from":10},{"book":"MAT","chapter":22,"verse":39,"verseEnd":39,"votes":53,"source":"openbible","text":"And the second is like it: ‘Love your neighbor as yourself.’","from":8},{"book":"MAT","chapter":22,"verse":40,"verseEnd":40,"votes":53,"source":"openbible","text":"All the Law and the Prophets hang on these two commandments.”","from":8},{"book":"EXO","chapter":20,"verse":12,"verseEnd":12,"votes":50,"source":"openbible","text":"Honor your father and mother, so that your days may be long in the land that the LORD your God is giving you.","from":9},{"book":"EXO","chapter":20,"verse":17,"verseEnd":17,"votes":50,"source":"openbible","text":"You shall not covet your neighborʼs house. You shall not covet your neighborʼs wife, or his manservant or maidservant, or his ox or donkey, or anything that belongs to your neighbor.”","from":9},{"book":"1CO","chapter":13,"verse":4,"verseEnd":4,"votes":49,"source":"openbible","text":"Love is patient, love is kind. It does not envy, it does not boast, it is not proud.","from":10},{"book":"1CO","chapter":13,"verse":7,"verseEnd":7,"votes":49,"source":"openbible","text":"It bears all things, believes all things, hopes all things, endures all things.","from":10}],"notes":[{"id":"deut-6-4-greatest","title":"The two great commandments","kind":"quotation"}],"groups":[]},"11-14":{"people":[{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":14}],"places":[],"words":[{"base":"G3361","lemma":"μή","tr":"mē","gloss":"not","lang":"g","inPassage":4,"uses":1068},{"base":"G1746","lemma":"ἐνδύω","tr":"enduō","gloss":"to put on","lang":"g","inPassage":2,"uses":27},{"base":"G4307","lemma":"πρόνοια","tr":"pronoia","gloss":"foresight","lang":"g","inPassage":1,"uses":2},{"base":"G2250","lemma":"ἡμέρα","tr":"hēmera","gloss":"day","lang":"g","inPassage":2,"uses":389},{"base":"G2156","lemma":"εὐσχημόνως","tr":"euschēmonōs","gloss":"properly","lang":"g","inPassage":1,"uses":3},{"base":"G2970","lemma":"κῶμος","tr":"kōmos","gloss":"orgy","lang":"g","inPassage":1,"uses":3},{"base":"G3178","lemma":"μέθη","tr":"methē","gloss":"drunkenness","lang":"g","inPassage":1,"uses":3},{"base":"G2845","lemma":"κοίτη","tr":"koitē","gloss":"bed","lang":"g","inPassage":1,"uses":4},{"base":"G3696","lemma":"ὅπλον","tr":"hoplon","gloss":"weapon","lang":"g","inPassage":1,"uses":6},{"base":"G4298","lemma":"προκόπτω","tr":"prokoptō","gloss":"to advance","lang":"g","inPassage":1,"uses":6}],"parallels":[],"crossrefs":[{"book":"EPH","chapter":4,"verse":24,"verseEnd":24,"votes":52,"source":"both","text":"and to put on the new self, created to be like God in true righteousness and holiness.","from":14},{"book":"GAL","chapter":3,"verse":27,"verseEnd":27,"votes":41,"source":"both","text":"For all of you who were baptized into Christ have clothed yourselves with Christ.","from":14},{"book":"GAL","chapter":5,"verse":16,"verseEnd":16,"votes":40,"source":"openbible","text":"So I say, walk by the Spirit, and you will not gratify the desires of the flesh.","from":14},{"book":"GAL","chapter":5,"verse":17,"verseEnd":17,"votes":40,"source":"openbible","text":"For the flesh craves what is contrary to the Spirit, and the Spirit what is contrary to the flesh. They are opposed to each other, so that you do not do what you want.","from":14},{"book":"1TH","chapter":5,"verse":5,"verseEnd":5,"votes":36,"source":"openbible","text":"For you are all sons of the light and sons of the day; we do not belong to the night or to the darkness.","from":11},{"book":"1TH","chapter":5,"verse":8,"verseEnd":8,"votes":36,"source":"openbible","text":"But since we belong to the day, let us be sober, putting on the breastplate of faith and love, and the helmet of our hope of salvation.","from":11},{"book":"1PE","chapter":4,"verse":7,"verseEnd":7,"votes":35,"source":"both","text":"The end of all things is near. Therefore be clear-minded and sober, so that you can pray.","from":11},{"book":"GAL","chapter":5,"verse":24,"verseEnd":24,"votes":32,"source":"both","text":"Those who belong to Christ Jesus have crucified the flesh with its passions and desires.","from":14}],"notes":[],"groups":[]}}