{"1-3":{"people":[{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":2,"firstVerse":1},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":2,"firstVerse":1},{"id":"herod-g2264h","name":"Herod","kind":"person","brief":"A Tetrarch","count":1,"firstVerse":1},{"id":"lucius-g3066","name":"Lucius","kind":"person","brief":"Christian prophet","count":1,"firstVerse":1},{"id":"manaen-g3127","name":"Manaen","kind":"person","brief":"Christian prophet","count":1,"firstVerse":1},{"id":"simeon-g4826i","name":"Simeon","kind":"person","brief":"Christian prophet","count":1,"firstVerse":1}],"places":[{"id":"antioch-g0490g","name":"Antioch","kind":"place","brief":"","count":1,"firstVerse":1},{"id":"cyrene-g2956","name":"Cyrene","kind":"place","brief":"","count":1,"firstVerse":1}],"words":[{"base":"G4569","lemma":"Σαῦλος","tr":"Saulos","gloss":"Saul","lang":"g","inPassage":2,"uses":15},{"base":"G3522","lemma":"νηστεύω","tr":"nēsteuō","gloss":"to fast","lang":"g","inPassage":2,"uses":20},{"base":"G0921","lemma":"Βαρνάβας","tr":"Barnabas","gloss":"Barnabas","lang":"g","inPassage":2,"uses":28},{"base":"G5037","lemma":"τε","tr":"te","gloss":"and","lang":"g","inPassage":2,"uses":215},{"base":"G3066","lemma":"Λούκιος","tr":"Loukios","gloss":"Lucius","lang":"g","inPassage":1,"uses":2},{"base":"G3008","lemma":"λειτουργέω","tr":"leitourgeō","gloss":"to minister","lang":"g","inPassage":1,"uses":3},{"base":"G5076","lemma":"τετράρχης","tr":"tetrarchēs","gloss":"tetrarch","lang":"g","inPassage":1,"uses":4},{"base":"G1211","lemma":"δή","tr":"dē","gloss":"so","lang":"g","inPassage":1,"uses":6},{"base":"G2956","lemma":"Κυρηναῖος","tr":"Kurēnaios","gloss":"Cyrene","lang":"g","inPassage":1,"uses":6},{"base":"G4826","lemma":"Συμεών","tr":"Sumeōn","gloss":"Simeon","lang":"g","inPassage":1,"uses":7}],"parallels":[],"crossrefs":[{"book":"GAL","chapter":1,"verse":15,"verseEnd":15,"votes":12,"source":"both","text":"But when God, who set me apart from my motherʼs womb and called me by His grace, was pleased","from":2},{"book":"ACT","chapter":6,"verse":6,"verseEnd":6,"votes":10,"source":"both","text":"They presented these seven to the apostles, who prayed and laid their hands on them.","from":3},{"book":"ACT","chapter":9,"verse":15,"verseEnd":15,"votes":10,"source":"both","text":"“Go!” said the Lord. “This man is My chosen instrument to carry My name before the Gentiles and their kings, and before the people of Israel.","from":2},{"book":"ACT","chapter":4,"verse":36,"verseEnd":36,"votes":9,"source":"both","text":"Joseph, a Levite from Cyprus, whom the apostles called Barnabas (meaning Son of Encouragement),","from":1},{"book":"ROM","chapter":1,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Paul, a servant of Christ Jesus, called to be an apostle, and set apart for the gospel of God—","from":2},{"book":"1CO","chapter":12,"verse":11,"verseEnd":11,"votes":8,"source":"both","text":"All these are the work of one and the same Spirit, who apportions them to each one as He determines.","from":2},{"book":"2TI","chapter":1,"verse":11,"verseEnd":11,"votes":8,"source":"both","text":"to which I was appointed as a preacher, an apostle, and a teacher.","from":2},{"book":"ACT","chapter":15,"verse":35,"verseEnd":35,"votes":7,"source":"both","text":"But Paul and Barnabas remained at Antioch, along with many others, teaching and preaching the word of the Lord.","from":1}],"notes":[],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":5},{"id":"herod-family","title":"The Herods","people":4},{"id":"jerusalem-church","title":"The Jerusalem Church","people":2},{"id":"roman-officials","title":"Roman Officials","people":2}]},"4-12":{"people":[{"id":"judah-h3063g","name":"Judah","kind":"person","brief":"Son of Israel","count":2,"firstVerse":5},{"id":"mark-g3138","name":"Mark","kind":"person","brief":"Paul's companian","count":1,"firstVerse":5},{"id":"bar-jesus-g0919","name":"Bar-jesus","kind":"person","brief":"","count":2,"firstVerse":6},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":2,"firstVerse":7},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":1,"firstVerse":7},{"id":"sergius-paulus-g4588","name":"Sergius Paulus","kind":"person","brief":"Proconsul","count":1,"firstVerse":7}],"places":[{"id":"cyprus-h3794h","name":"Cyprus","kind":"place","brief":"In Cyprus","count":1,"firstVerse":4},{"id":"seleucia-g4581","name":"Seleucia","kind":"place","brief":"","count":1,"firstVerse":4},{"id":"salamis-g4529","name":"Salamis","kind":"place","brief":"","count":1,"firstVerse":5},{"id":"paphos-g3974","name":"Paphos","kind":"place","brief":"","count":1,"firstVerse":6}],"words":[{"base":"G0446","lemma":"ἀνθύπατος","tr":"anthupatos","gloss":"proconsul","lang":"g","inPassage":3,"uses":5},{"base":"G3097","lemma":"μάγος","tr":"magos","gloss":"sage","lang":"g","inPassage":2,"uses":6},{"base":"G1294","lemma":"διαστρέφω","tr":"diastrephō","gloss":"to pervert","lang":"g","inPassage":2,"uses":7},{"base":"G4569","lemma":"Σαῦλος","tr":"Saulos","gloss":"Saul","lang":"g","inPassage":2,"uses":15},{"base":"G0891","lemma":"ἄχρι","tr":"achri","gloss":"until","lang":"g","inPassage":2,"uses":48},{"base":"G2962","lemma":"κύριος","tr":"kurios","gloss":"lord: God","lang":"g","inPassage":3,"uses":714},{"base":"G1909","lemma":"ἐπί","tr":"epi","gloss":"upon","lang":"g","inPassage":3,"uses":885},{"base":"G2212","lemma":"ζητέω","tr":"zēteō","gloss":"to seek","lang":"g","inPassage":2,"uses":117},{"base":"G3972","lemma":"Παῦλος","tr":"Paulos","gloss":"Paul","lang":"g","inPassage":2,"uses":158},{"base":"G2453","lemma":"Ἰουδαῖος","tr":"Ioudaios","gloss":"Jew","lang":"g","inPassage":2,"uses":194}],"parallels":[],"crossrefs":[{"book":"MIC","chapter":3,"verse":8,"verseEnd":8,"votes":24,"source":"both","text":"As for me, however, I am filled with power by the Spirit of the LORD, with justice and courage, to declare to Jacob his transgression and to Israel his sin.","from":9},{"book":"JHN","chapter":8,"verse":44,"verseEnd":44,"votes":12,"source":"both","text":"You belong to your father, the devil, and you want to carry out his desires. He was a murderer from the beginning, refusing to uphold the truth, because there is no truth in him. When he lies, he speaks his native language, because he is a liar and the father of lies.","from":10},{"book":"HOS","chapter":14,"verse":9,"verseEnd":9,"votes":7,"source":"both","text":"Whoever is wise, let him understand these things; whoever is discerning, let him know them. For the ways of the LORD are right, and the righteous walk in them but the rebellious stumble in them.","from":10},{"book":"MAT","chapter":7,"verse":15,"verseEnd":15,"votes":7,"source":"openbible","text":"Beware of false prophets. They come to you in sheepʼs clothing, but inwardly they are ravenous wolves.","from":6},{"book":"MAT","chapter":13,"verse":38,"verseEnd":38,"votes":7,"source":"both","text":"The field is the world, and the good seed represents the sons of the kingdom. The weeds are the sons of the evil one,","from":10},{"book":"2CO","chapter":11,"verse":3,"verseEnd":3,"votes":7,"source":"both","text":"I am afraid, however, that just as Eve was deceived by the serpentʼs cunning, your minds may be led astray from your simple and pure devotion to Christ.","from":10},{"book":"GAL","chapter":1,"verse":7,"verseEnd":7,"votes":7,"source":"both","text":"which is not even a gospel. Evidently some people are troubling you and trying to distort the gospel of Christ.","from":10},{"book":"ACT","chapter":4,"verse":8,"verseEnd":8,"votes":6,"source":"both","text":"Then Peter, filled with the Holy Spirit, said to them, “Rulers and elders of the people!","from":9}],"notes":[],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":4},{"id":"jerusalem-church","title":"The Jerusalem Church","people":4},{"id":"herod-family","title":"The Herods","people":2}]},"13-25":{"people":[{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":2,"firstVerse":13},{"id":"mark-g3138","name":"Mark","kind":"person","brief":"Paul's companian","count":1,"firstVerse":13},{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":4,"firstVerse":16},{"id":"samuel-h8050g","name":"Samuel","kind":"person","brief":"Prophet and Judge","count":1,"firstVerse":20},{"id":"benjamin-h1144g","name":"Benjamin","kind":"person","brief":"Son of Israel","count":1,"firstVerse":21},{"id":"kish-h7027g","name":"Kish","kind":"person","brief":"Saul's father","count":1,"firstVerse":21},{"id":"saul-h7586g","name":"Saul","kind":"person","brief":"King of Israel,","count":1,"firstVerse":21},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":22},{"id":"jesse-h3448","name":"Jesse","kind":"person","brief":"David's father","count":1,"firstVerse":22},{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":23},{"id":"john-g2491g","name":"John","kind":"person","brief":"A prophet","count":2,"firstVerse":24}],"places":[{"id":"perga-g4011","name":"Perga","kind":"place","brief":"","count":2,"firstVerse":13},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":13},{"id":"pamphylia-g3828","name":"Pamphylia","kind":"place","brief":"","count":1,"firstVerse":13},{"id":"paphos-g3974","name":"Paphos","kind":"place","brief":"","count":1,"firstVerse":13},{"id":"antioch-g0490h","name":"Antioch","kind":"place","brief":"","count":1,"firstVerse":14},{"id":"pisidia-g4099","name":"Pisidia","kind":"place","brief":"","count":1,"firstVerse":14},{"id":"egypt-h4714g","name":"Egypt","kind":"place","brief":"","count":1,"firstVerse":17},{"id":"canaan-h3667a","name":"Canaan","kind":"place","brief":"","count":1,"firstVerse":19}],"words":[{"base":"G2992","lemma":"λαός","tr":"laos","gloss":"a people","lang":"g","inPassage":4,"uses":141},{"base":"G0435","lemma":"ἀνήρ","tr":"anēr","gloss":"man","lang":"g","inPassage":4,"uses":216},{"base":"G2474","lemma":"Ἰσραήλ","tr":"Israēl","gloss":"Israel","lang":"g","inPassage":3,"uses":68},{"base":"G4011","lemma":"Πέργη","tr":"Pergē","gloss":"Perga","lang":"g","inPassage":2,"uses":3},{"base":"G3326","lemma":"μετά","tr":"meta","gloss":"with","lang":"g","inPassage":4,"uses":465},{"base":"G2491","lemma":"Ἰωάννης","tr":"Iōannēs","gloss":"John","lang":"g","inPassage":3,"uses":135},{"base":"G0575","lemma":"ἀπό","tr":"apo","gloss":"away from","lang":"g","inPassage":4,"uses":644},{"base":"G1093","lemma":"γῆ","tr":"gē","gloss":"earth: planet","lang":"g","inPassage":3,"uses":248},{"base":"G5613","lemma":"ὡς","tr":"hōs","gloss":"as","lang":"g","inPassage":3,"uses":503},{"base":"G2094","lemma":"ἔτος","tr":"etos","gloss":"year","lang":"g","inPassage":2,"uses":49}],"parallels":[],"crossrefs":[{"book":"1SA","chapter":13,"verse":13,"verseEnd":13,"votes":30,"source":"both","text":"“You have acted foolishly,” Samuel declared. “You have not kept the command that the LORD your God gave you; if you had, the LORD would have established your kingdom over Israel for all time.","from":22},{"book":"1SA","chapter":13,"verse":14,"verseEnd":14,"votes":30,"source":"both","text":"But now your kingdom will not endure; the LORD has sought a man after His own heart and appointed him ruler over His people, because you have not kept the command of the LORD.”","from":22},{"book":"1KI","chapter":15,"verse":5,"verseEnd":5,"votes":17,"source":"openbible","text":"For David had done what was right in the eyes of the LORD and had not turned aside from anything the LORD commanded all the days of his life, except in the matter of Uriah the Hittite.","from":22},{"book":"PSA","chapter":78,"verse":70,"verseEnd":70,"votes":16,"source":"openbible","text":"He chose David His servant and took him from the sheepfolds;","from":22},{"book":"PSA","chapter":78,"verse":72,"verseEnd":72,"votes":16,"source":"openbible","text":"So David shepherded them with integrity of heart and guided them with skillful hands.","from":22},{"book":"1SA","chapter":16,"verse":13,"verseEnd":13,"votes":15,"source":"both","text":"So Samuel took the horn of oil and anointed him in the presence of his brothers, and the Spirit of the LORD rushed upon David from that day forward. Then Samuel set out and went to Ramah.","from":22},{"book":"1SA","chapter":16,"verse":1,"verseEnd":1,"votes":13,"source":"both","text":"Now the LORD said to Samuel, “How long are you going to mourn for Saul, since I have rejected him as king over Israel? Fill your horn with oil and go. I am sending you to Jesse of Bethlehem, for I have selected from his sons a king for Myself.”","from":22},{"book":"MAT","chapter":1,"verse":1,"verseEnd":1,"votes":10,"source":"both","text":"This is the record of the genealogy of Jesus Christ, the son of David, the son of Abraham:","from":23}],"notes":[],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":3},{"id":"herod-family","title":"The Herods","people":3},{"id":"jerusalem-church","title":"The Jerusalem Church","people":3},{"id":"judges-era","title":"Judges era and the road to David","people":3},{"id":"kings-prophets","title":"Kings, prophets and the house of David","people":2},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2},{"id":"john-baptist-circle","title":"John the Baptist's Circle","people":2},{"id":"high-priestly-family","title":"The High-Priestly Family","people":2},{"id":"roman-officials","title":"Roman Officials","people":2},{"id":"patriarchs","title":"The patriarchal families","people":2},{"id":"jesus-family","title":"Jesus and His Family Circle","people":2}]},"26-37":{"people":[{"id":"abraham-h0085","name":"Abraham","kind":"person","brief":"Son of Terah","count":1,"firstVerse":26},{"id":"pilate-g4091","name":"Pilate","kind":"person","brief":"A Roman ruler","count":1,"firstVerse":28},{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":33},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":2,"firstVerse":34}],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":2,"firstVerse":27},{"id":"galilee-h1551","name":"Galilee","kind":"place","brief":"","count":1,"firstVerse":31}],"words":[{"base":"G1312","lemma":"διαφθορά","tr":"diaphthora","gloss":"decay","lang":"g","inPassage":4,"uses":6},{"base":"G3741","lemma":"ὅσιος","tr":"hosios","gloss":"sacred","lang":"g","inPassage":2,"uses":8},{"base":"G1492","lemma":"εἴδω","tr":"eidō","gloss":"to perceive: understand","lang":"g","inPassage":3,"uses":374},{"base":"G1138","lemma":"Δαυείδ, Δαυίδ, Δαβίδ","tr":"Daueid, Dauid, Dabid","gloss":"David","lang":"g","inPassage":2,"uses":59},{"base":"G4314","lemma":"πρός","tr":"pros","gloss":"to","lang":"g","inPassage":3,"uses":700},{"base":"G2419","lemma":"Ἱερουσαλήμ","tr":"Hierousalēm","gloss":"Jerusalem","lang":"g","inPassage":2,"uses":77},{"base":"G0450","lemma":"ἀνίστημι","tr":"anistēmi","gloss":"to arise","lang":"g","inPassage":2,"uses":107},{"base":"G3498","lemma":"νεκρός","tr":"nekros","gloss":"dead","lang":"g","inPassage":2,"uses":128},{"base":"G1453","lemma":"ἐγείρω","tr":"egeirō","gloss":"to arise","lang":"g","inPassage":2,"uses":143},{"base":"G1125","lemma":"γράφω","tr":"graphō","gloss":"to write","lang":"g","inPassage":2,"uses":190}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":2,"verse":7,"verseEnd":7,"votes":14,"source":"both","text":"I will proclaim the decree spoken to Me by the LORD: “You are My Son; today I have become Your Father.","from":33},{"book":"PSA","chapter":16,"verse":10,"verseEnd":10,"votes":12,"source":"both","text":"For You will not abandon my soul to Sheol, nor will You let Your Holy One see decay.","from":35},{"book":"HEB","chapter":5,"verse":5,"verseEnd":5,"votes":12,"source":"both","text":"So also Christ did not take upon Himself the glory of becoming a high priest, but He was called by the One who said to Him: “You are My Son; today I have become Your Father.”","from":33},{"book":"HEB","chapter":1,"verse":5,"verseEnd":5,"votes":11,"source":"openbible","text":"For to which of the angels did God ever say: “You are My Son; today I have become Your Father”? Or again: “I will be His Father, and He will be My Son”?","from":33},{"book":"HEB","chapter":1,"verse":6,"verseEnd":6,"votes":11,"source":"openbible","text":"And again, when God brings His firstborn into the world, He says: “Let all Godʼs angels worship Him.”","from":33},{"book":"ISA","chapter":55,"verse":3,"verseEnd":3,"votes":9,"source":"both","text":"Incline your ear and come to Me; listen, so that your soul may live. I will make with you an everlasting covenant— My loving devotion promised to David.","from":34},{"book":"ACT","chapter":2,"verse":29,"verseEnd":29,"votes":9,"source":"both","text":"Brothers, I can tell you with confidence that the patriarch David died and was buried, and his tomb is with us to this day.","from":36},{"book":"PSA","chapter":89,"verse":2,"verseEnd":2,"votes":8,"source":"openbible","text":"For I have said, “Loving devotion is built up forever; in the heavens You establish Your faithfulness.”","from":34}],"notes":[{"id":"ps-2-7","title":"You are my Son","kind":"prophecy"},{"id":"ps-16-10","title":"You will not abandon me to the grave","kind":"prophecy"},{"id":"acts-13-34-david-mercies","title":"The holy and sure blessings of David","kind":"prophecy"}],"groups":[{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2},{"id":"herod-family","title":"The Herods","people":2},{"id":"high-priestly-family","title":"The High-Priestly Family","people":2},{"id":"roman-officials","title":"Roman Officials","people":2}]},"38-41":{"people":[{"id":"moses-h4872","name":"Moses","kind":"person","brief":"Son of Amram","count":2,"firstVerse":38}],"places":[],"words":[{"base":"G1344","lemma":"δικαιόω","tr":"dikaioō","gloss":"to justify","lang":"g","inPassage":2,"uses":39},{"base":"G2041","lemma":"ἔργον","tr":"ergon","gloss":"work","lang":"g","inPassage":2,"uses":169},{"base":"G4100","lemma":"πιστεύω","tr":"pisteuō","gloss":"to trust (in)","lang":"g","inPassage":2,"uses":237},{"base":"G1555","lemma":"ἐκδιηγέομαι","tr":"ekdiēgeomai","gloss":"to tell in detail","lang":"g","inPassage":1,"uses":2},{"base":"G3767","lemma":"οὖν","tr":"oun","gloss":"therefore","lang":"g","inPassage":2,"uses":497},{"base":"G0853","lemma":"ἀφανίζω","tr":"aphanizō","gloss":"to destroy","lang":"g","inPassage":1,"uses":5},{"base":"G1904","lemma":"ἐπέρχομαι","tr":"eperchomai","gloss":"to arrive","lang":"g","inPassage":1,"uses":9},{"base":"G1110","lemma":"γνωστός, γνώριμος","tr":"gnōstos, gnōrimos","gloss":"acquainted with","lang":"g","inPassage":1,"uses":15},{"base":"G0859","lemma":"ἄφεσις","tr":"aphesis","gloss":"forgiveness","lang":"g","inPassage":1,"uses":17},{"base":"G2605","lemma":"καταγγέλλω","tr":"katangellō","gloss":"to proclaim","lang":"g","inPassage":1,"uses":18}],"parallels":[],"crossrefs":[{"book":"HAB","chapter":1,"verse":5,"verseEnd":5,"votes":58,"source":"openbible","text":"“Look at the nations and observe— be utterly astounded! For I am doing a work in your days that you would never believe even if someone told you.","from":41},{"book":"ROM","chapter":10,"verse":4,"verseEnd":4,"votes":14,"source":"both","text":"For Christ is the end of the law, to bring righteousness to everyone who believes.","from":39},{"book":"GAL","chapter":2,"verse":16,"verseEnd":16,"votes":14,"source":"both","text":"know that a man is not justified by works of the law, but by faith in Jesus Christ. So we, too, have believed in Christ Jesus, that we may be justified by faith in Christ and not by works of the law, because by works of the law no one will be justified.","from":39},{"book":"ROM","chapter":8,"verse":3,"verseEnd":3,"votes":13,"source":"both","text":"For what the law was powerless to do in that it was weakened by the flesh, God did by sending His own Son in the likeness of sinful man, as an offering for sin. He thus condemned sin in the flesh,","from":39},{"book":"LUK","chapter":24,"verse":47,"verseEnd":47,"votes":12,"source":"both","text":"and in His name repentance and forgiveness of sins will be proclaimed to all nations, beginning in Jerusalem.","from":38},{"book":"1PE","chapter":4,"verse":17,"verseEnd":17,"votes":12,"source":"both","text":"For it is time for judgment to begin with the family of God; and if it begins with us, what will the outcome be for those who disobey the gospel of God?","from":41},{"book":"HEB","chapter":7,"verse":19,"verseEnd":19,"votes":11,"source":"openbible","text":"(for the law made nothing perfect), and a better hope is introduced, by which we draw near to God.","from":39},{"book":"ROM","chapter":10,"verse":10,"verseEnd":10,"votes":9,"source":"both","text":"For with your heart you believe and are justified, and with your mouth you confess and are saved.","from":39}],"notes":[{"id":"acts-13-41-hab-1-5","title":"Look, you scoffers, and perish","kind":"prophecy"}],"groups":[]},"42-52":{"people":[{"id":"judah-h3063g","name":"Judah","kind":"person","brief":"Son of Israel","count":4,"firstVerse":42},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":4,"firstVerse":43},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":3,"firstVerse":43}],"places":[{"id":"iconium-g2430","name":"Iconium","kind":"place","brief":"","count":1,"firstVerse":51}],"words":[{"base":"G3972","lemma":"Παῦλος","tr":"Paulos","gloss":"Paul","lang":"g","inPassage":4,"uses":158},{"base":"G0921","lemma":"Βαρνάβας","tr":"Barnabas","gloss":"Barnabas","lang":"g","inPassage":3,"uses":28},{"base":"G3056","lemma":"λόγος","tr":"logos","gloss":"word","lang":"g","inPassage":4,"uses":329},{"base":"G1484","lemma":"ἔθνος","tr":"ethnos","gloss":"Gentiles","lang":"g","inPassage":3,"uses":162},{"base":"G2962","lemma":"κύριος","tr":"kurios","gloss":"lord: God","lang":"g","inPassage":4,"uses":714},{"base":"G4576","lemma":"σέβομαι","tr":"sebomai","gloss":"be devout","lang":"g","inPassage":2,"uses":10},{"base":"G2453","lemma":"Ἰουδαῖος","tr":"Ioudaios","gloss":"Jew","lang":"g","inPassage":3,"uses":194},{"base":"G2980","lemma":"λαλέω","tr":"laleō","gloss":"to speak","lang":"g","inPassage":3,"uses":294},{"base":"G4521","lemma":"σάββατον","tr":"sabbaton","gloss":"Sabbath","lang":"g","inPassage":2,"uses":67},{"base":"G0166","lemma":"αἰώνιος","tr":"aiōnios","gloss":"eternal","lang":"g","inPassage":2,"uses":70}],"parallels":[],"crossrefs":[{"book":"ISA","chapter":49,"verse":6,"verseEnd":6,"votes":31,"source":"both","text":"He says: “It is not enough for You to be My Servant, to raise up the tribes of Jacob, and to restore the protected ones of Israel. I will also make You a light for the nations, to bring My salvation to the ends of the earth.”","from":47},{"book":"ISA","chapter":42,"verse":6,"verseEnd":6,"votes":21,"source":"both","text":"“I, the LORD, have called you for a righteous purpose, and I will take hold of your hand. I will keep you and appoint you to be a covenant for the people and a light to the nations,","from":47},{"book":"LUK","chapter":2,"verse":32,"verseEnd":32,"votes":17,"source":"both","text":"a light for revelation to the Gentiles, and for glory to Your people Israel.”","from":47},{"book":"ROM","chapter":8,"verse":29,"verseEnd":29,"votes":13,"source":"openbible","text":"For those God foreknew, He also predestined to be conformed to the image of His Son, so that He would be the firstborn among many brothers.","from":48},{"book":"ROM","chapter":8,"verse":30,"verseEnd":30,"votes":13,"source":"both","text":"And those He predestined, He also called; those He called, He also justified; those He justified, He also glorified.","from":48},{"book":"MAT","chapter":10,"verse":14,"verseEnd":14,"votes":12,"source":"both","text":"And if anyone will not welcome you or heed your words, shake the dust off your feet when you leave that home or town.","from":51},{"book":"ACT","chapter":28,"verse":28,"verseEnd":28,"votes":12,"source":"both","text":"Be advised, therefore, that Godʼs salvation has been sent to the Gentiles, and they will listen!”","from":46},{"book":"ROM","chapter":11,"verse":7,"verseEnd":7,"votes":12,"source":"both","text":"What then? What Israel was seeking, it failed to obtain, but the elect did. The others were hardened,","from":48}],"notes":[{"id":"isa-49-6-light","title":"A light for the nations","kind":"prophecy"}],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":2},{"id":"herod-family","title":"The Herods","people":2},{"id":"jerusalem-church","title":"The Jerusalem Church","people":2}]}}