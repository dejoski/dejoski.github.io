{"1-9":{"people":[{"id":"elihu-h0453k","name":"Elihu","kind":"person","brief":"Son of Barachel","count":1,"firstVerse":1},{"id":"job-h0347","name":"Job","kind":"person","brief":"Father of Jemimah","count":2,"firstVerse":5}],"places":[],"words":[{"base":"H4941","lemma":"מִשְׁפָּט","tr":"mish·pat","gloss":"justice: judgement","lang":"h","inPassage":3,"uses":422},{"base":"H4405","lemma":"מִלָּה","tr":"mil·lah","gloss":"speech","lang":"h","inPassage":2,"uses":38},{"base":"H0347","lemma":"אִיּוֹב","tr":"iy·yov","gloss":"Job","lang":"h","inPassage":2,"uses":58},{"base":"H1397","lemma":"גָּבֶר","tr":"ga·ver","gloss":"great man","lang":"h","inPassage":2,"uses":65},{"base":"H5973","lemma":"עִם","tr":"im","gloss":"with","lang":"h","inPassage":3,"uses":1051},{"base":"H0732","lemma":"אָרַח","tr":"a·rach","gloss":"to journey","lang":"h","inPassage":1,"uses":6},{"base":"H3933","lemma":"לַ֫עַג","tr":"la·ag","gloss":"derision","lang":"h","inPassage":1,"uses":7},{"base":"H0605","lemma":"אָנַשׁ","tr":"a·nash","gloss":"be incurable","lang":"h","inPassage":1,"uses":9},{"base":"H0453","lemma":"אֱלִיהוּ","tr":"e·li·hu","gloss":"Elihu","lang":"h","inPassage":1,"uses":11},{"base":"H2938","lemma":"טָעַם","tr":"ta·am","gloss":"to perceive","lang":"h","inPassage":1,"uses":11}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":12,"verse":11,"verseEnd":11,"votes":6,"source":"both","text":"Does not the ear test words as the tongue tastes its food?","from":3},{"book":"JOB","chapter":15,"verse":16,"verseEnd":16,"votes":6,"source":"both","text":"how much less man, who is vile and corrupt, who drinks injustice like water?","from":7},{"book":"JOB","chapter":27,"verse":2,"verseEnd":2,"votes":6,"source":"both","text":"“As surely as God lives, who has deprived me of justice— the Almighty, who has embittered my soul—","from":5},{"book":"JOB","chapter":33,"verse":9,"verseEnd":9,"votes":6,"source":"both","text":"‘I am pure, without transgression; I am clean, with no iniquity in me.","from":5},{"book":"JOB","chapter":6,"verse":4,"verseEnd":4,"votes":5,"source":"both","text":"For the arrows of the Almighty have pierced me; my spirit drinks in their poison; the terrors of God are arrayed against me.","from":6},{"book":"JOB","chapter":21,"verse":14,"verseEnd":14,"votes":5,"source":"openbible","text":"Yet they say to God: ‘Leave us alone! For we have no desire to know Your ways.","from":9},{"book":"JOB","chapter":21,"verse":16,"verseEnd":16,"votes":5,"source":"openbible","text":"Still, their prosperity is not in their own hands, so I stay far from the counsel of the wicked.","from":9},{"book":"JOB","chapter":35,"verse":3,"verseEnd":3,"votes":5,"source":"both","text":"For you ask, ‘What does it profit me, and what benefit do I gain apart from sin?’","from":9}],"notes":[],"groups":[]},"10-15":{"people":[],"places":[],"words":[{"base":"H7706","lemma":"שַׁדַּי","tr":"shad·day","gloss":"Almighty","lang":"h","inPassage":2,"uses":48},{"base":"H0410","lemma":"אֵל","tr":"el","gloss":"God","lang":"h","inPassage":2,"uses":241},{"base":"H4310","lemma":"מִי","tr":"mi","gloss":"who?","lang":"h","inPassage":2,"uses":423},{"base":"H0120","lemma":"אָדָם","tr":"a·dam","gloss":"man","lang":"h","inPassage":2,"uses":550},{"base":"H7760","lemma":"שׂוּם","tr":"sum","gloss":"to set: make","lang":"h","inPassage":2,"uses":585},{"base":"H0551","lemma":"אׇמְנָם","tr":"om·nam","gloss":"truly","lang":"h","inPassage":1,"uses":9},{"base":"H5791","lemma":"עָוַת","tr":"a·vat","gloss":"to pervert","lang":"h","inPassage":1,"uses":11},{"base":"H2486","lemma":"חָלִ֫ילָה","tr":"cha·li·lah","gloss":"forbid","lang":"h","inPassage":1,"uses":21},{"base":"H1478","lemma":"גָּוַע","tr":"ga·va","gloss":"to die","lang":"h","inPassage":1,"uses":24},{"base":"H5397","lemma":"נְשָׁמָה","tr":"ne·sha·mah","gloss":"breath","lang":"h","inPassage":1,"uses":24}],"parallels":[],"crossrefs":[{"book":"2CO","chapter":5,"verse":10,"verseEnd":10,"votes":11,"source":"both","text":"For we must all appear before the judgment seat of Christ, that each one may receive his due for the things done in the body, whether good or bad.","from":11},{"book":"REV","chapter":22,"verse":12,"verseEnd":12,"votes":10,"source":"both","text":"“Behold, I am coming soon, and My reward is with Me, to give to each one according to what he has done.","from":11},{"book":"DEU","chapter":32,"verse":4,"verseEnd":4,"votes":9,"source":"both","text":"He is the Rock, His work is perfect; all His ways are just. A God of faithfulness without injustice, righteous and upright is He.","from":10},{"book":"ROM","chapter":2,"verse":6,"verseEnd":6,"votes":9,"source":"both","text":"God “will repay each one according to his deeds.”","from":11},{"book":"ROM","chapter":9,"verse":14,"verseEnd":14,"votes":9,"source":"both","text":"What then shall we say? Is God unjust? Certainly not!","from":10},{"book":"PSA","chapter":62,"verse":12,"verseEnd":12,"votes":8,"source":"both","text":"and loving devotion to You, O Lord. For You will repay each man according to his deeds.","from":11},{"book":"PSA","chapter":104,"verse":29,"verseEnd":29,"votes":8,"source":"both","text":"When You hide Your face, they are terrified; when You take away their breath, they die and return to dust.","from":14},{"book":"JER","chapter":32,"verse":19,"verseEnd":19,"votes":8,"source":"both","text":"the One great in counsel and mighty in deed, whose eyes are on all the ways of the sons of men, to reward each one according to his ways and according to the fruit of his deeds.","from":11}],"notes":[],"groups":[]},"16-20":{"people":[],"places":[],"words":[{"base":"H2676","lemma":"חָצוֹת","tr":"cha·tsot","gloss":"middle","lang":"h","inPassage":1,"uses":3},{"base":"H7771","lemma":"שׁוֹעַ","tr":"sho·a","gloss":"rich","lang":"h","inPassage":1,"uses":3},{"base":"H1607","lemma":"גָּעַשׁ","tr":"ga·ash","gloss":"to shake","lang":"h","inPassage":1,"uses":9},{"base":"H3524","lemma":"כַּבִּיר","tr":"kab·bir","gloss":"mighty","lang":"h","inPassage":1,"uses":10},{"base":"H0047","lemma":"אַבִּיר","tr":"ab·bir","gloss":"mighty: ox","lang":"h","inPassage":1,"uses":17},{"base":"H0518","lemma":"אִם","tr":"im","gloss":"if","lang":"h","inPassage":2,"uses":1067},{"base":"H7281","lemma":"רֶ֫גַע","tr":"re·ga","gloss":"moment","lang":"h","inPassage":1,"uses":22},{"base":"H1100","lemma":"בְּלִיַּ֫עַל","tr":"be·liy·ya·al","gloss":"Belial","lang":"h","inPassage":1,"uses":27},{"base":"H5081","lemma":"נָדִיב","tr":"na·div","gloss":"noble: willing","lang":"h","inPassage":1,"uses":28},{"base":"H2280","lemma":"חָבַשׁ","tr":"cha·vash","gloss":"to saddle","lang":"h","inPassage":1,"uses":33}],"parallels":[],"crossrefs":[{"book":"DEU","chapter":10,"verse":17,"verseEnd":17,"votes":8,"source":"both","text":"For the LORD your God is God of gods and Lord of lords, the great, mighty, and awesome God, showing no partiality and accepting no bribe.","from":19},{"book":"JAS","chapter":2,"verse":5,"verseEnd":5,"votes":8,"source":"both","text":"Listen, my beloved brothers: Has not God chosen the poor of this world to be rich in faith and to inherit the kingdom He promised those who love Him?","from":19},{"book":"ACT","chapter":10,"verse":34,"verseEnd":34,"votes":7,"source":"both","text":"Then Peter began to speak: “I now truly understand that God does not show favoritism,","from":19},{"book":"ROM","chapter":2,"verse":11,"verseEnd":11,"votes":6,"source":"both","text":"For God does not show favoritism.","from":19},{"book":"COL","chapter":3,"verse":25,"verseEnd":25,"votes":6,"source":"both","text":"Whoever does wrong will be repaid for his wrong, and there is no favoritism.","from":19},{"book":"EXO","chapter":22,"verse":28,"verseEnd":28,"votes":5,"source":"both","text":"You must not blaspheme God or curse the ruler of your people.","from":18},{"book":"2SA","chapter":23,"verse":3,"verseEnd":3,"votes":5,"source":"both","text":"The God of Israel spoke; the Rock of Israel said to me, ‘He who rules the people with justice, who rules in the fear of God,","from":17},{"book":"2CH","chapter":19,"verse":7,"verseEnd":7,"votes":5,"source":"both","text":"And now, may the fear of the LORD be upon you. Be careful what you do, for with the LORD our God there is no injustice or partiality or bribery.”","from":19}],"notes":[],"groups":[]},"21-30":{"people":[],"places":[],"words":[{"base":"H6818","lemma":"צְעָקָה","tr":"tsa·a·qah","gloss":"cry","lang":"h","inPassage":2,"uses":21},{"base":"H5641","lemma":"סָתַר","tr":"sa·tar","gloss":"to hide","lang":"h","inPassage":2,"uses":81},{"base":"H4310","lemma":"מִי","tr":"mi","gloss":"who?","lang":"h","inPassage":2,"uses":423},{"base":"H8478","lemma":"תַּחַת","tr":"ta·chat","gloss":"underneath: under","lang":"h","inPassage":2,"uses":505},{"base":"H0120","lemma":"אָדָם","tr":"a·dam","gloss":"man","lang":"h","inPassage":2,"uses":550},{"base":"H1870","lemma":"דֶּ֫רֶךְ","tr":"de·rekh","gloss":"way: conduct","lang":"h","inPassage":2,"uses":706},{"base":"H3651","lemma":"כֵּן","tr":"ken","gloss":"right","lang":"h","inPassage":2,"uses":765},{"base":"H3524","lemma":"כַּבִּיר","tr":"kab·bir","gloss":"mighty","lang":"h","inPassage":1,"uses":10},{"base":"H5606","lemma":"סָפַק","tr":"sa·phaq","gloss":"to slap","lang":"h","inPassage":1,"uses":10},{"base":"H0369","lemma":"אַ֫יִן","tr":"a·yin","gloss":"nothing","lang":"h","inPassage":2,"uses":788}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":15,"verse":3,"verseEnd":3,"votes":12,"source":"both","text":"The eyes of the LORD are in every place, observing the evil and the good.","from":21},{"book":"JOB","chapter":31,"verse":4,"verseEnd":4,"votes":9,"source":"both","text":"Does He not see my ways and count my every step?","from":21},{"book":"PRO","chapter":5,"verse":21,"verseEnd":21,"votes":7,"source":"both","text":"For a manʼs ways are before the eyes of the LORD, and the LORD examines all his paths.","from":21},{"book":"JER","chapter":16,"verse":17,"verseEnd":17,"votes":7,"source":"both","text":"For My eyes are on all their ways. They are not hidden from My face, and their guilt is not concealed from My eyes.","from":21},{"book":"HEB","chapter":4,"verse":13,"verseEnd":13,"votes":7,"source":"both","text":"Nothing in all creation is hidden from Godʼs sight; everything is uncovered and exposed before the eyes of Him to whom we must give account.","from":22},{"book":"JAS","chapter":5,"verse":4,"verseEnd":4,"votes":7,"source":"both","text":"Look, the wages you withheld from the workmen who mowed your fields are crying out against you. The cries of the harvesters have reached the ears of the Lord of Hosts.","from":28},{"book":"EXO","chapter":3,"verse":7,"verseEnd":7,"votes":6,"source":"both","text":"The LORD said, “I have indeed seen the affliction of My people in Egypt. I have heard them crying out because of their oppressors, and I am aware of their sufferings.","from":28},{"book":"JOB","chapter":35,"verse":9,"verseEnd":9,"votes":6,"source":"both","text":"Men cry out under great oppression; they plead for relief from the arm of the mighty.","from":28}],"notes":[],"groups":[]},"31-37":{"people":[{"id":"job-h0347","name":"Job","kind":"person","brief":"Father of Jemimah","count":2,"firstVerse":35}],"places":[],"words":[{"base":"H0347","lemma":"אִיּוֹב","tr":"iy·yov","gloss":"Job","lang":"h","inPassage":2,"uses":58},{"base":"H3254","lemma":"יָסַף","tr":"ya·saph","gloss":"to add: again","lang":"h","inPassage":2,"uses":212},{"base":"H0410","lemma":"אֵל","tr":"el","gloss":"God","lang":"h","inPassage":2,"uses":241},{"base":"H0582","lemma":"אֱנוֹשׁ","tr":"e·nosh","gloss":"human","lang":"h","inPassage":2,"uses":565},{"base":"H8666","lemma":"תְּשׁוּבָה","tr":"te·shu·vah","gloss":"turn","lang":"h","inPassage":1,"uses":8},{"base":"H5606","lemma":"סָפַק","tr":"sa·phaq","gloss":"to slap","lang":"h","inPassage":1,"uses":10},{"base":"H9030","lemma":"נִי","tr":"ni","gloss":"me","lang":"h","inPassage":2,"uses":908},{"base":"H1107","lemma":"בִּלְעֲדֵי","tr":"bil·a·de","gloss":"beside","lang":"h","inPassage":1,"uses":17},{"base":"H0859","lemma":"אַתָּ֫ה","tr":"at·tah","gloss":"you(m.s.)","lang":"h","inPassage":2,"uses":1092},{"base":"H1696","lemma":"דָבַר","tr":"da·var","gloss":"to speak: speak","lang":"h","inPassage":2,"uses":1142}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":35,"verse":16,"verseEnd":16,"votes":6,"source":"both","text":"So Job opens his mouth in vain and multiplies words without knowledge.”","from":35},{"book":"JOB","chapter":27,"verse":23,"verseEnd":23,"votes":5,"source":"both","text":"It claps its hands at him and hisses him out of his place.","from":37},{"book":"JOB","chapter":38,"verse":2,"verseEnd":2,"votes":5,"source":"both","text":"“Who is this who obscures My counsel by words without knowledge?","from":35},{"book":"PSA","chapter":19,"verse":12,"verseEnd":12,"votes":5,"source":"both","text":"Who can discern his own errors? Cleanse me from my hidden faults.","from":32},{"book":"PSA","chapter":32,"verse":8,"verseEnd":8,"votes":5,"source":"both","text":"I will instruct you and teach you the way you should go; I will give you counsel and watch over you.","from":32},{"book":"PSA","chapter":139,"verse":23,"verseEnd":23,"votes":5,"source":"openbible","text":"Search me, O God, and know my heart; test me and know my concerns.","from":32},{"book":"PSA","chapter":139,"verse":24,"verseEnd":24,"votes":5,"source":"openbible","text":"See if there is any offensive way in me; lead me in the way everlasting.","from":32},{"book":"LEV","chapter":26,"verse":41,"verseEnd":41,"votes":0,"source":"tsk","text":"and I acted with hostility toward them and brought them into the land of their enemies—and if their uncircumcised hearts will be humbled and they will make amends for their iniquity,","from":31}],"notes":[],"groups":[]}}