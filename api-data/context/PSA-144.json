{"1-4":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H7286","lemma":"רָדַד","tr":"ra·dad","gloss":"to subdue","lang":"h","inPassage":1,"uses":3},{"base":"H0120","lemma":"אָדָם","tr":"a·dam","gloss":"man","lang":"h","inPassage":2,"uses":550},{"base":"H7128","lemma":"קְרָב","tr":"qe·rav","gloss":"battle","lang":"h","inPassage":1,"uses":9},{"base":"H4869","lemma":"מִשְׂגָּב","tr":"mis·gav","gloss":"high refuge","lang":"h","inPassage":1,"uses":17},{"base":"H4686","lemma":"מְצוּדָה","tr":"ma·tsu·dah","gloss":"net","lang":"h","inPassage":1,"uses":21},{"base":"H6403","lemma":"פָּלַט","tr":"pa·lat","gloss":"to escape","lang":"h","inPassage":1,"uses":26},{"base":"H1819","lemma":"דָּמָה","tr":"da·mah","gloss":"to resemble","lang":"h","inPassage":1,"uses":30},{"base":"H0676","lemma":"אֶצְבַּע","tr":"ets·ba","gloss":"finger","lang":"h","inPassage":1,"uses":31},{"base":"H2620","lemma":"חָסָה","tr":"cha·sah","gloss":"to seek refuge","lang":"h","inPassage":1,"uses":37},{"base":"H6738","lemma":"צֵל","tr":"tsel","gloss":"shadow","lang":"h","inPassage":1,"uses":49}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":18,"verse":34,"verseEnd":34,"votes":26,"source":"both","text":"He trains my hands for battle; my arms can bend a bow of bronze.","from":1},{"book":"2SA","chapter":22,"verse":35,"verseEnd":35,"votes":23,"source":"both","text":"He trains my hands for battle; my arms can bend a bow of bronze.","from":1},{"book":"PSA","chapter":18,"verse":2,"verseEnd":2,"votes":23,"source":"both","text":"The LORD is my rock, my fortress, and my deliverer. My God is my rock, in whom I take refuge, my shield, and the horn of my salvation, my stronghold.","from":1},{"book":"PSA","chapter":44,"verse":3,"verseEnd":3,"votes":20,"source":"openbible","text":"For it was not by their sword that they took the land; their arm did not bring them victory. It was by Your right hand, Your arm, and the light of Your face, because You favored them.","from":1},{"book":"PSA","chapter":44,"verse":4,"verseEnd":4,"votes":20,"source":"openbible","text":"You are my King, O God, who ordains victories for Jacob.","from":1},{"book":"PSA","chapter":8,"verse":4,"verseEnd":4,"votes":15,"source":"both","text":"what is man that You are mindful of him, or the son of man that You care for him?","from":3},{"book":"EPH","chapter":6,"verse":10,"verseEnd":10,"votes":15,"source":"openbible","text":"Finally, be strong in the Lord and in His mighty power.","from":1},{"book":"EPH","chapter":6,"verse":11,"verseEnd":11,"votes":15,"source":"openbible","text":"Put on the full armor of God, so that you can make your stand against the devilʼs schemes.","from":1}],"notes":[],"groups":[]},"5-8":{"people":[],"places":[],"words":[{"base":"H3225","lemma":"יָמִין","tr":"ya·min","gloss":"right","lang":"h","inPassage":2,"uses":140},{"base":"H6225","lemma":"עָשַׁן","tr":"a·shan","gloss":"be angry","lang":"h","inPassage":1,"uses":6},{"base":"H7971","lemma":"שָׁלַח","tr":"sha·lach","gloss":"to send: depart","lang":"h","inPassage":2,"uses":847},{"base":"H2000","lemma":"הָמַם","tr":"ha·mam","gloss":"to confuse","lang":"h","inPassage":1,"uses":14},{"base":"H6475","lemma":"פָּצָה","tr":"pa·tsah","gloss":"to open","lang":"h","inPassage":1,"uses":15},{"base":"H1300","lemma":"בָּרַק","tr":"ba·raq","gloss":"to use lightning","lang":"h","inPassage":1,"uses":21},{"base":"H5236","lemma":"נֵכָר","tr":"ne·khar","gloss":"foreign","lang":"h","inPassage":1,"uses":36},{"base":"H2671","lemma":"חֵץ","tr":"chets","gloss":"arrow","lang":"h","inPassage":1,"uses":53},{"base":"H7723","lemma":"שָׁוְא","tr":"shav","gloss":"vanity: false","lang":"h","inPassage":1,"uses":53},{"base":"H4791","lemma":"מָרוֹם","tr":"ma·rom","gloss":"height","lang":"h","inPassage":1,"uses":54}],"parallels":[],"crossrefs":[{"book":"DEU","chapter":32,"verse":23,"verseEnd":23,"votes":6,"source":"both","text":"I will heap disasters upon them; I will spend My arrows against them.","from":6},{"book":"PSA","chapter":12,"verse":2,"verseEnd":2,"votes":6,"source":"both","text":"They lie to one another; they speak with flattering lips and a double heart.","from":8},{"book":"PSA","chapter":18,"verse":9,"verseEnd":9,"votes":6,"source":"both","text":"He parted the heavens and came down with dark clouds beneath His feet.","from":5},{"book":"PSA","chapter":104,"verse":32,"verseEnd":32,"votes":6,"source":"both","text":"He looks on the earth, and it trembles; He touches the mountains, and they smolder.","from":5},{"book":"PSA","chapter":18,"verse":13,"verseEnd":13,"votes":5,"source":"openbible","text":"The LORD thundered from heaven; the voice of the Most High resounded— hailstones and coals of fire.","from":6},{"book":"PSA","chapter":18,"verse":14,"verseEnd":14,"votes":5,"source":"openbible","text":"He shot His arrows and scattered the foes; He hurled lightning and routed them.","from":6},{"book":"PSA","chapter":18,"verse":16,"verseEnd":16,"votes":5,"source":"both","text":"He reached down from on high and took hold of me; He drew me out of deep waters.","from":7},{"book":"PSA","chapter":69,"verse":1,"verseEnd":1,"votes":5,"source":"openbible","text":"Save me, O God, for the waters are up to my neck.","from":7}],"notes":[],"groups":[]},"9-11":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":10}],"places":[],"words":[{"base":"H6475","lemma":"פָּצָה","tr":"pa·tsah","gloss":"to open","lang":"h","inPassage":2,"uses":15},{"base":"H3225","lemma":"יָמִין","tr":"ya·min","gloss":"right","lang":"h","inPassage":2,"uses":140},{"base":"H9032","lemma":"ךְ","tr":"kh","gloss":"you","lang":"h","inPassage":2,"uses":333},{"base":"H6218","lemma":"עָשׂוֹר","tr":"a·s·vor","gloss":"ten","lang":"h","inPassage":1,"uses":16},{"base":"H8668","lemma":"תְּשׁוּעָה","tr":"te·shu·ah","gloss":"deliverance: salvation","lang":"h","inPassage":1,"uses":34},{"base":"H5236","lemma":"נֵכָר","tr":"ne·khar","gloss":"foreign","lang":"h","inPassage":1,"uses":36},{"base":"H5035","lemma":"נֵ֫בֶל","tr":"ne·vel","gloss":"bag","lang":"h","inPassage":1,"uses":38},{"base":"H2167","lemma":"זָמַר","tr":"za·mar","gloss":"to sing","lang":"h","inPassage":1,"uses":45},{"base":"H2319","lemma":"חָדָשׁ","tr":"cha·dash","gloss":"New (Gate)","lang":"h","inPassage":1,"uses":53},{"base":"H7723","lemma":"שָׁוְא","tr":"shav","gloss":"vanity: false","lang":"h","inPassage":1,"uses":53}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":18,"verse":50,"verseEnd":50,"votes":7,"source":"both","text":"Great salvation He brings to His king. He shows loving devotion to His anointed, to David and his descendants forever.","from":10},{"book":"PSA","chapter":33,"verse":2,"verseEnd":2,"votes":6,"source":"openbible","text":"Praise the LORD with the harp; make music to Him with ten strings.","from":9},{"book":"PSA","chapter":33,"verse":3,"verseEnd":3,"votes":6,"source":"openbible","text":"Sing to Him a new song; play skillfully with a shout of joy.","from":9},{"book":"PSA","chapter":140,"verse":7,"verseEnd":7,"votes":6,"source":"both","text":"O GOD the Lord, the strength of my salvation, You shield my head in the day of battle.","from":10},{"book":"PSA","chapter":144,"verse":7,"verseEnd":7,"votes":6,"source":"openbible","text":"Reach down from on high; set me free and rescue me from the deep waters, from the grasp of foreigners,","from":11},{"book":"PSA","chapter":144,"verse":8,"verseEnd":8,"votes":6,"source":"openbible","text":"whose mouths speak falsehood, whose right hands are deceitful.","from":11},{"book":"PSA","chapter":33,"verse":16,"verseEnd":16,"votes":5,"source":"openbible","text":"No king is saved by his vast army; no warrior is delivered by his great strength.","from":10},{"book":"PSA","chapter":33,"verse":18,"verseEnd":18,"votes":5,"source":"openbible","text":"Surely the eyes of the LORD are on those who fear Him, on those whose hope is in His loving devotion","from":10}],"notes":[],"groups":[]},"12-15":{"people":[],"places":[],"words":[{"base":"H2177","lemma":"זַן","tr":"zan","gloss":"kind","lang":"h","inPassage":2,"uses":3},{"base":"H0835","lemma":"אֶ֫שֶׁר","tr":"e·sher","gloss":"blessed","lang":"h","inPassage":2,"uses":45},{"base":"H0369","lemma":"אַ֫יִן","tr":"a·yin","gloss":"nothing","lang":"h","inPassage":3,"uses":788},{"base":"H2106","lemma":"זָוִית","tr":"za·vit","gloss":"corner","lang":"h","inPassage":1,"uses":2},{"base":"H6682","lemma":"צְוָחָה","tr":"tse·va·chah","gloss":"outcry","lang":"h","inPassage":1,"uses":4},{"base":"H6329","lemma":"פּוּק","tr":"puq","gloss":"to promote","lang":"h","inPassage":1,"uses":7},{"base":"H2404","lemma":"חָטַב","tr":"cha·tav","gloss":"to chop","lang":"h","inPassage":1,"uses":9},{"base":"H5445","lemma":"סָבַל","tr":"sa·val","gloss":"to bear","lang":"h","inPassage":1,"uses":9},{"base":"H6556","lemma":"פֶּ֫רֶץ","tr":"pe·rets","gloss":"breach","lang":"h","inPassage":1,"uses":19},{"base":"H8403","lemma":"תַּבְנִית","tr":"tav·nit","gloss":"pattern","lang":"h","inPassage":1,"uses":20}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":33,"verse":12,"verseEnd":12,"votes":13,"source":"both","text":"Blessed is the nation whose God is the LORD, the people He has chosen as His inheritance!","from":15},{"book":"PSA","chapter":128,"verse":3,"verseEnd":3,"votes":11,"source":"both","text":"Your wife will be like a fruitful vine flourishing within your house, your sons like olive shoots sitting around your table.","from":12},{"book":"EPH","chapter":1,"verse":3,"verseEnd":3,"votes":11,"source":"both","text":"Blessed be the God and Father of our Lord Jesus Christ, who has blessed us in Christ with every spiritual blessing in the heavenly realms.","from":15},{"book":"PSA","chapter":146,"verse":5,"verseEnd":5,"votes":9,"source":"both","text":"Blessed is he whose help is the God of Jacob, whose hope is in the LORD his God,","from":15},{"book":"1PE","chapter":3,"verse":3,"verseEnd":3,"votes":9,"source":"openbible","text":"Your beauty should not come from outward adornment, such as braided hair or gold jewelry or fine clothes,","from":12},{"book":"1PE","chapter":3,"verse":6,"verseEnd":6,"votes":9,"source":"openbible","text":"just as Sarah obeyed Abraham and called him lord. And you are her children if you do what is right and refuse to give way to fear.","from":12},{"book":"ISA","chapter":44,"verse":3,"verseEnd":3,"votes":8,"source":"openbible","text":"For I will pour water on the thirsty land, and currents on the dry ground. I will pour out My Spirit on your descendants, and My blessing on your offspring.","from":12},{"book":"ISA","chapter":44,"verse":5,"verseEnd":5,"votes":8,"source":"openbible","text":"One will say, ‘I belong to the LORD,’ another will call himself by the name of Jacob, and still another will write on his hand, ‘The LORDʼs,’ and will take the name of Israel.”","from":12}],"notes":[],"groups":[]}}