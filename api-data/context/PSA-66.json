{"1-7":{"people":[],"places":[],"words":[{"base":"H2167","lemma":"זָמַר","tr":"za·mar","gloss":"to sing","lang":"h","inPassage":3,"uses":45},{"base":"H5542","lemma":"סֶ֫לָה","tr":"se·lah","gloss":"Selah","lang":"h","inPassage":2,"uses":74},{"base":"H3519","lemma":"כָּבוֹד","tr":"ka·vod","gloss":"glory","lang":"h","inPassage":2,"uses":200},{"base":"H3372","lemma":"יָרֵא","tr":"ya·re","gloss":"to fear","lang":"h","inPassage":2,"uses":315},{"base":"H4659","lemma":"מִפְעָל","tr":"miph·al","gloss":"work","lang":"h","inPassage":1,"uses":3},{"base":"H9031","lemma":"ךָּ","tr":"ka","gloss":"you","lang":"h","inPassage":2,"uses":727},{"base":"H8034","lemma":"שֵׁם","tr":"shem","gloss":"name","lang":"h","inPassage":2,"uses":864},{"base":"H3004","lemma":"יַבָּשָׁה","tr":"yab·ba·shah","gloss":"dry land","lang":"h","inPassage":1,"uses":14},{"base":"H5637","lemma":"סָרַר","tr":"sa·rar","gloss":"to rebel","lang":"h","inPassage":1,"uses":17},{"base":"H3584","lemma":"כָּחַשׁ","tr":"ka·chash","gloss":"to deceive","lang":"h","inPassage":1,"uses":22}],"parallels":[],"crossrefs":[{"book":"1CH","chapter":16,"verse":23,"verseEnd":23,"votes":14,"source":"openbible","text":"Sing to the LORD, all the earth. Proclaim His salvation day after day.","from":1},{"book":"1CH","chapter":16,"verse":24,"verseEnd":24,"votes":14,"source":"openbible","text":"Declare His glory among the nations, His wonderful deeds among all peoples.","from":1},{"book":"PSA","chapter":100,"verse":1,"verseEnd":1,"votes":11,"source":"both","text":"Make a joyful noise to the LORD, all the earth.","from":1},{"book":"PSA","chapter":18,"verse":44,"verseEnd":44,"votes":10,"source":"both","text":"When they hear me, they obey me; foreigners cower before me.","from":3},{"book":"PSA","chapter":105,"verse":2,"verseEnd":2,"votes":10,"source":"openbible","text":"Sing to Him, sing praises to Him; tell of all His wonders.","from":2},{"book":"PSA","chapter":105,"verse":3,"verseEnd":3,"votes":10,"source":"openbible","text":"Glory in His holy name; let the hearts of those who seek the LORD rejoice.","from":2},{"book":"PSA","chapter":65,"verse":5,"verseEnd":5,"votes":9,"source":"both","text":"With awesome deeds of righteousness You answer us, O God of our salvation, the hope of all the ends of the earth and of the farthest seas.","from":3},{"book":"PSA","chapter":11,"verse":4,"verseEnd":4,"votes":8,"source":"both","text":"The LORD is in His holy temple; the LORD is on His heavenly throne. His eyes are watching closely; they examine the sons of men.","from":7}],"notes":[],"groups":[]},"8-12":{"people":[],"places":[],"words":[{"base":"H6884","lemma":"צָרַף","tr":"tsa·raph","gloss":"to refine","lang":"h","inPassage":2,"uses":33},{"base":"H7310","lemma":"רְוָיָה","tr":"re·va·yah","gloss":"abundance","lang":"h","inPassage":1,"uses":2},{"base":"H7760","lemma":"שׂוּם","tr":"sum","gloss":"to set: make","lang":"h","inPassage":2,"uses":585},{"base":"H4132","lemma":"מוֹט","tr":"mot","gloss":"yoke","lang":"h","inPassage":1,"uses":6},{"base":"H4686","lemma":"מְצוּדָה","tr":"ma·tsu·dah","gloss":"net","lang":"h","inPassage":1,"uses":21},{"base":"H0974","lemma":"בָּחַן","tr":"ba·chan","gloss":"to test","lang":"h","inPassage":1,"uses":29},{"base":"H4975","lemma":"מׇתְנַ֫יִם","tr":"mo·ten","gloss":"loin","lang":"h","inPassage":1,"uses":47},{"base":"H8416","lemma":"תְּהִלָּה","tr":"te·hil·lah","gloss":"praise","lang":"h","inPassage":1,"uses":57},{"base":"H7392","lemma":"רָכַב","tr":"ra·khav","gloss":"to ride","lang":"h","inPassage":1,"uses":78},{"base":"H7272","lemma":"רֶ֫גֶל","tr":"re·gel","gloss":"foot","lang":"h","inPassage":1,"uses":245}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":121,"verse":3,"verseEnd":3,"votes":11,"source":"both","text":"He will not allow your foot to slip; your Protector will not slumber.","from":9},{"book":"ISA","chapter":48,"verse":10,"verseEnd":10,"votes":11,"source":"both","text":"See, I have refined you, but not as silver; I have tested you in the furnace of affliction.","from":10},{"book":"PSA","chapter":17,"verse":3,"verseEnd":3,"votes":10,"source":"both","text":"You have tried my heart; You have visited me in the night. You have tested me and found no evil; I have resolved not to sin with my mouth.","from":10},{"book":"ISA","chapter":43,"verse":1,"verseEnd":1,"votes":10,"source":"openbible","text":"But now this is what the LORD says— He who created you, O Jacob, and He who formed you, O Israel: “Do not fear, for I have redeemed you; I have called you by your name; you are Mine!","from":12},{"book":"ISA","chapter":43,"verse":2,"verseEnd":2,"votes":10,"source":"openbible","text":"When you pass through the waters, I will be with you; and when you go through the rivers, they will not overwhelm you. When you walk through the fire, you will not be scorched; the flames will not set you ablaze.","from":12},{"book":"PRO","chapter":17,"verse":3,"verseEnd":3,"votes":8,"source":"both","text":"A crucible for silver and a furnace for gold, but the LORD is the tester of hearts.","from":10},{"book":"PSA","chapter":94,"verse":18,"verseEnd":18,"votes":7,"source":"both","text":"If I say, “My foot is slipping,” Your loving devotion, O LORD, supports me.","from":9},{"book":"PSA","chapter":112,"verse":6,"verseEnd":6,"votes":7,"source":"both","text":"Surely he will never be shaken; the righteous man will be remembered forever.","from":9}],"notes":[],"groups":[]},"13-15":{"people":[],"places":[],"words":[{"base":"H5930","lemma":"עֹלָה","tr":"o·lah","gloss":"burnt offering","lang":"h","inPassage":2,"uses":287},{"base":"H4220","lemma":"מֵחַ","tr":"me·ach","gloss":"fatling","lang":"h","inPassage":1,"uses":2},{"base":"H6475","lemma":"פָּצָה","tr":"pa·tsah","gloss":"to open","lang":"h","inPassage":1,"uses":15},{"base":"H5973","lemma":"עִם","tr":"im","gloss":"with","lang":"h","inPassage":2,"uses":1051},{"base":"H6260","lemma":"עַתּוּד","tr":"at·tud","gloss":"goat","lang":"h","inPassage":1,"uses":29},{"base":"H5088","lemma":"נֶ֫דֶר","tr":"ne·der","gloss":"vow","lang":"h","inPassage":1,"uses":60},{"base":"H7004","lemma":"קְטֹ֫רֶת","tr":"qe·to·ret","gloss":"incense","lang":"h","inPassage":1,"uses":60},{"base":"H5542","lemma":"סֶ֫לָה","tr":"se·lah","gloss":"Selah","lang":"h","inPassage":1,"uses":74},{"base":"H6862","lemma":"צַר","tr":"tsar","gloss":"narrow","lang":"h","inPassage":1,"uses":109},{"base":"H7999","lemma":"שָׁלֵם","tr":"sa·lem","gloss":"to complete","lang":"h","inPassage":1,"uses":116}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":100,"verse":4,"verseEnd":4,"votes":10,"source":"both","text":"Enter His gates with thanksgiving and His courts with praise; give thanks to Him and bless His name.","from":13},{"book":"PSA","chapter":56,"verse":12,"verseEnd":12,"votes":9,"source":"both","text":"Your vows are upon me, O God; I will render thank offerings to You.","from":13},{"book":"PSA","chapter":116,"verse":14,"verseEnd":14,"votes":8,"source":"both","text":"I will fulfill my vows to the LORD in the presence of all His people.","from":13},{"book":"PSA","chapter":116,"verse":17,"verseEnd":17,"votes":8,"source":"openbible","text":"I will offer to You a sacrifice of thanksgiving and call on the name of the LORD.","from":13},{"book":"PSA","chapter":116,"verse":19,"verseEnd":19,"votes":8,"source":"openbible","text":"in the courts of the LORDʼs house, in your midst, O Jerusalem. Hallelujah!","from":13},{"book":"PSA","chapter":118,"verse":19,"verseEnd":19,"votes":8,"source":"both","text":"Open to me the gates of righteousness, that I may enter and give thanks to the LORD.","from":13},{"book":"ECC","chapter":5,"verse":4,"verseEnd":4,"votes":8,"source":"both","text":"When you make a vow to God, do not delay in fulfilling it, because He takes no pleasure in fools. Fulfill your vow.","from":13},{"book":"HEB","chapter":13,"verse":15,"verseEnd":15,"votes":8,"source":"both","text":"Through Jesus, therefore, let us continually offer to God a sacrifice of praise, the fruit of lips that confess His name.","from":13}],"notes":[],"groups":[]},"16-20":{"people":[],"places":[],"words":[{"base":"H8605","lemma":"תְּפִלָּה","tr":"te·phil·lah","gloss":"prayer","lang":"h","inPassage":2,"uses":77},{"base":"H8085","lemma":"שָׁמַע","tr":"sha·ma","gloss":"to hear: hear","lang":"h","inPassage":3,"uses":1159},{"base":"H7318","lemma":"רוֹמָם","tr":"ro·mam","gloss":"extolling","lang":"h","inPassage":1,"uses":2},{"base":"H0403","lemma":"אָכֵן","tr":"a·khen","gloss":"surely","lang":"h","inPassage":1,"uses":18},{"base":"H7181","lemma":"קָשַׁב","tr":"qa·shav","gloss":"to listen","lang":"h","inPassage":1,"uses":46},{"base":"H3373","lemma":"יָרֵא","tr":"ya·re","gloss":"afraid","lang":"h","inPassage":1,"uses":64},{"base":"H0205","lemma":"אָ֫וֶן","tr":"a·ven","gloss":"evil: wickedness","lang":"h","inPassage":1,"uses":77},{"base":"H3956","lemma":"לָשׁוֹן","tr":"la·shon","gloss":"tongue","lang":"h","inPassage":1,"uses":117},{"base":"H5608","lemma":"סָפַר","tr":"sa·phar","gloss":"to recount","lang":"h","inPassage":1,"uses":159},{"base":"H2617","lemma":"חֶ֫סֶד","tr":"che·sed","gloss":"kindness","lang":"h","inPassage":1,"uses":247}],"parallels":[],"crossrefs":[{"book":"JHN","chapter":9,"verse":31,"verseEnd":31,"votes":32,"source":"both","text":"We know that God does not listen to sinners, but He does listen to the one who worships Him and does His will.","from":18},{"book":"PRO","chapter":28,"verse":9,"verseEnd":9,"votes":30,"source":"both","text":"Whoever turns his ear away from hearing the law, even his prayer is detestable.","from":18},{"book":"PRO","chapter":15,"verse":29,"verseEnd":29,"votes":27,"source":"both","text":"The LORD is far from the wicked, but He hears the prayer of the righteous.","from":18},{"book":"PRO","chapter":15,"verse":8,"verseEnd":8,"votes":23,"source":"both","text":"The sacrifice of the wicked is detestable to the LORD, but the prayer of the upright is His delight.","from":18},{"book":"ISA","chapter":1,"verse":15,"verseEnd":15,"votes":18,"source":"both","text":"When you spread out your hands in prayer, I will hide My eyes from you; even though you multiply your prayers, I will not listen. Your hands are covered with blood.","from":18},{"book":"JAS","chapter":4,"verse":3,"verseEnd":3,"votes":15,"source":"both","text":"And when you do ask, you do not receive, because you ask with wrong motives, that you may squander it on your pleasures.","from":18},{"book":"PSA","chapter":116,"verse":1,"verseEnd":1,"votes":12,"source":"openbible","text":"I love the LORD, for He has heard my voice— my appeal for mercy.","from":19},{"book":"PSA","chapter":116,"verse":2,"verseEnd":2,"votes":12,"source":"openbible","text":"Because He has inclined His ear to me, I will call on Him as long as I live.","from":19}],"notes":[],"groups":[]}}