ah-h7498g","name":"Raphah","kind":"person","brief":"Saul's family","count":1,"firstVerse":43},{"id":"azrikam-h5840h","name":"Azrikam","kind":"person","brief":"Saul's family","count":1,"firstVerse":44},{"id":"bocheru-h1074","name":"Bocheru","kind":"person","brief":"Saul's family","count":1,"firstVerse":44},{"id":"hanan-h2605h","name":"Hanan","kind":"person","brief":"Saul's family","count":1,"firstVerse":44},{"id":"ishmael-h3458i","name":"Ishmael","kind":"person","brief":"Saul's family","count":1,"firstVerse":44},{"id":"obadiah-h5662j","name":"Obadiah","kind":"person","brief":"Son of Azel","count":1,"firstVerse":44},{"id":"sheariah-h8187","name":"Sheariah","kind":"person","brief":"Saul's family","count":1,"firstVerse":44}],"places":[{"id":"gibeon-h1391","name":"Gibeon","kind":"place","brief":"","count":1,"firstVerse":35},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":38}],"words":[{"base":"H3205","lemma":"יָלַד","tr":"ya·lad","gloss":"to beget","lang":"h","inPassage":9,"uses":496},{"base":"H0682","lemma":"אָצֵל","tr":"a·tsel","gloss":"Azel","lang":"h","inPassage":3,"uses":7},{"base":"H7027","lemma":"קִישׁ","tr":"qish","gloss":"Kish","lang":"h","inPassage":3,"uses":21},{"base":"H3294","lemma":"יַעְרָה","tr":"ya·rah","gloss":"Jarah","lang":"h","inPassage":2,"uses":2},{"base":"H4810","lemma":"מְרִי בַעַל","tr":"me·ri va·al","gloss":"Merib-baal","lang":"h","inPassage":2,"uses":2},{"base":"H4732","lemma":"מִקְלוֹת","tr":"miq·lot","gloss":"Mikloth","lang":"h","inPassage":2,"uses":4},{"base":"H4162","lemma":"מוֹצָא","tr":"mo·tsa","gloss":"Moza","lang":"h","inPassage":2,"uses":5},{"base":"H4807","lemma":"מְרִיב בַּ֫עַל","tr":"me·riv ba·al","gloss":"Merib-baal","lang":"h","inPassage":2,"uses":6},{"base":"H4444","lemma":"מַלְכִּישׁוּעַ","tr":"mal·ki·shu·a","gloss":"Malchi-shua","lang":"h","inPassage":2,"uses":10},{"base":"H2174","lemma":"זִמְרִי","tr":"zim·ri","gloss":"Zimri","lang":"h","inPassage":2,"uses":15}],"parallels":[],"crossrefs":[{"book":"1SA","chapter":13,"verse":22,"verseEnd":22,"votes":0,"source":"tsk","text":"So on the day of battle not a sword or spear could be found in the hands of the troops with Saul and Jonathan; only Saul and his son Jonathan had weapons.","from":39},{"book":"1SA","chapter":14,"verse":1,"verseEnd":1,"votes":0,"source":"tsk","text":"One day Jonathan son of Saul said to the young man bearing his armor, “Come, let us cross over to the Philistine outpost on the other side.” But Jonathan did not tell his father.","from":39},{"book":"1SA","chapter":14,"verse":49,"verseEnd":49,"votes":0,"source":"tsk","text":"Now the sons of Saul were Jonathan, Ishvi, and Malchishua. His two daughters were named Merab (his firstborn) and Michal (his younger daughter).","from":39},{"book":"1SA","chapter":14,"verse":50,"verseEnd":51,"votes":0,"source":"tsk","text":"His wifeʼs name was Ahinoam daughter of Ahimaaz. The name of the commander of his army was Abner, the son of Saulʼs uncle Ner. Saulʼs father Kish and Abnerʼs father Ner were sons of Abiel.","from":39},{"book":"1SA","chapter":31,"verse":2,"verseEnd":2,"votes":0,"source":"tsk","text":"The Philistines hotly pursued Saul and his sons, and they killed Saulʼs sons Jonathan, Abinadab, and Malchishua.","from":39},{"book":"1CH","chapter":2,"verse":23,"verseEnd":24,"votes":0,"source":"tsk","text":"But Geshur and Aram captured Havvoth-jair, along with Kenath and its sixty surrounding villages. All these were descendants of Machir the father of Gilead. After Hezron died in Caleb-ephrathah, his wife Abijah bore to him Ashhur the father of Tekoa.","from":35},{"book":"1CH","chapter":2,"verse":45,"verseEnd":45,"votes":0,"source":"tsk","text":"The son of Shammai was Maon, and Maon was the father of Beth-zur.","from":35},{"book":"1CH","chapter":2,"verse":50,"verseEnd":52,"votes":0,"source":"tsk","text":"These were the descendants of Caleb. The sons of Hur the firstborn of Ephrathah: Shobal the father of Kiriath-jearim, Salma the father of Bethlehem, and Hareph the father of Beth-gader. These were the descendants of Shobal the father of Kiriath-jearim: Haroeh, half the Manahathites,","from":35}],"notes":[],"groups":[{"id":"kings-prophets","title":"Kings, prophets and the house of David","people":4}]}}