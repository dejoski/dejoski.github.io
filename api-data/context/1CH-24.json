":19},{"book":"EZR","chapter":2,"verse":36,"verseEnd":36,"votes":0,"source":"tsk","text":"The priests: The descendants of Jedaiah (through the house of Jeshua), 973;","from":7},{"book":"EZR","chapter":2,"verse":36,"verseEnd":36,"votes":0,"source":"tsk","text":"The priests: The descendants of Jedaiah (through the house of Jeshua), 973;","from":11}],"notes":[],"groups":[]},"20-31":{"people":[{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":3,"firstVerse":20},{"id":"amram-h6019g","name":"Amram","kind":"person","brief":"Moses' father","count":1,"firstVerse":20},{"id":"jehdeiah-h3165g","name":"Jehdeiah","kind":"person","brief":"Son of Shebuel","count":1,"firstVerse":20},{"id":"shebuel-h7619g","name":"Shebuel","kind":"person","brief":"Son of Gershom","count":1,"firstVerse":20},{"id":"isshiah-h3449j","name":"Isshiah","kind":"person","brief":"Son of Rehabiah","count":1,"firstVerse":21},{"id":"rehabiah-h7345","name":"Rehabiah","kind":"person","brief":"Son of Eliezer","count":1,"firstVerse":21},{"id":"izhar-h3324","name":"Izhar","kind":"person","brief":"Son of Kohath","count":1,"firstVerse":22},{"id":"jahath-h3189j","name":"Jahath","kind":"person","brief":"Son of Shelomith","count":1,"firstVerse":22},{"id":"shelomith-h8019a","name":"Shelomith","kind":"person","brief":"Son of Izhar","count":1,"firstVerse":22},{"id":"amariah-h0568i","name":"Amariah","kind":"person","brief":"Son of Hebron","count":1,"firstVerse":23},{"id":"jahaziel-h3166i","name":"Jahaziel","kind":"person","brief":"Son of Hebron","count":1,"firstVerse":23},{"id":"jekameam-h3360","name":"Jekameam","kind":"person","brief":"Son of Hebron","count":1,"firstVerse":23},{"id":"jeriah-h3404g","name":"Jeriah","kind":"person","brief":"Son of Hebron","count":1,"firstVerse":23},{"id":"micah-h4318j","name":"Micah","kind":"person","brief":"Son of Uzziel","count":2,"firstVerse":24},{"id":"shamir-h8069i","name":"Shamir","kind":"person","brief":"Son of Micah","count":1,"firstVerse":24},{"id":"uzzie