{"1-4":{"people":[],"places":[],"words":[{"base":"H1984","lemma":"הָלַל","tr":"ha·lal","gloss":"to shine","lang":"h","inPassage":3,"uses":165},{"base":"H5081","lemma":"נָדִיב","tr":"na·div","gloss":"noble: willing","lang":"h","inPassage":1,"uses":28},{"base":"H8668","lemma":"תְּשׁוּעָה","tr":"te·shu·ah","gloss":"deliverance: salvation","lang":"h","inPassage":1,"uses":34},{"base":"H2167","lemma":"זָמַר","tr":"za·mar","gloss":"to sing","lang":"h","inPassage":1,"uses":45},{"base":"H3050","lemma":"יָהּ","tr":"yah","gloss":"LORD","lang":"h","inPassage":1,"uses":48},{"base":"H0982","lemma":"בָּטַח","tr":"ba·tach","gloss":"to trust","lang":"h","inPassage":1,"uses":120},{"base":"H0006","lemma":"אָבַד","tr":"a·vad","gloss":"to perish","lang":"h","inPassage":1,"uses":184},{"base":"H0127","lemma":"אֲדָמָה","tr":"a·da·mah","gloss":"land: soil","lang":"h","inPassage":1,"uses":225},{"base":"H7307","lemma":"רוּחַ","tr":"ru·ach","gloss":"spirit","lang":"h","inPassage":1,"uses":378},{"base":"H5750","lemma":"עוֹד","tr":"od","gloss":"still","lang":"h","inPassage":1,"uses":490}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":118,"verse":8,"verseEnd":8,"votes":22,"source":"openbible","text":"It is better to take refuge in the LORD than to trust in man.","from":3},{"book":"PSA","chapter":118,"verse":9,"verseEnd":9,"votes":22,"source":"openbible","text":"It is better to take refuge in the LORD than to trust in princes.","from":3},{"book":"ISA","chapter":2,"verse":22,"verseEnd":22,"votes":17,"source":"both","text":"Put no more trust in man, who has only the breath in his nostrils. Of what account is he?","from":3},{"book":"JER","chapter":17,"verse":5,"verseEnd":5,"votes":17,"source":"openbible","text":"This is what the LORD says: “Cursed is the man who trusts in mankind, who makes mere flesh his strength and turns his heart from the LORD.","from":3},{"book":"JER","chapter":17,"verse":6,"verseEnd":6,"votes":17,"source":"openbible","text":"He will be like a shrub in the desert; he will not see when prosperity comes. He will dwell in the parched places of the desert, in a salt land where no one lives.","from":3},{"book":"PSA","chapter":63,"verse":4,"verseEnd":4,"votes":16,"source":"both","text":"So I will bless You as long as I live; in Your name I will lift my hands.","from":2},{"book":"ECC","chapter":12,"verse":7,"verseEnd":7,"votes":16,"source":"both","text":"before the dust returns to the ground from which it came and the spirit returns to God who gave it.","from":4},{"book":"PSA","chapter":104,"verse":33,"verseEnd":33,"votes":13,"source":"both","text":"I will sing to the LORD all my life; I will sing praise to my God while I have my being.","from":2}],"notes":[],"groups":[]},"5-10":{"people":[{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":1,"firstVerse":5}],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":10}],"words":[{"base":"H1755","lemma":"דּוֹר","tr":"dor","gloss":"generation","lang":"h","inPassage":2,"uses":167},{"base":"H2210","lemma":"זָקַף","tr":"za·qaph","gloss":"to raise","lang":"h","inPassage":1,"uses":2},{"base":"H7664","lemma":"שֵׂ֫בֶר","tr":"se·ver","gloss":"hope","lang":"h","inPassage":1,"uses":2},{"base":"H5769","lemma":"עוֹלָם","tr":"o·lam","gloss":"forever: enduring","lang":"h","inPassage":2,"uses":438},{"base":"H8104","lemma":"שָׁמַר","tr":"sha·mar","gloss":"to keep: obey","lang":"h","inPassage":2,"uses":469},{"base":"H3721","lemma":"כָּפַף","tr":"ka·phaph","gloss":"to bend","lang":"h","inPassage":1,"uses":5},{"base":"H5425","lemma":"נָתַר","tr":"na·tar","gloss":"to start","lang":"h","inPassage":1,"uses":8},{"base":"H5791","lemma":"עָוַת","tr":"a·vat","gloss":"to pervert","lang":"h","inPassage":1,"uses":11},{"base":"H6491","lemma":"פָּקַח","tr":"pa·qach","gloss":"to open","lang":"h","inPassage":1,"uses":20},{"base":"H7457","lemma":"רָעֵב","tr":"ra·ev","gloss":"hungry","lang":"h","inPassage":1,"uses":20}],"parallels":[],"crossrefs":[{"book":"JER","chapter":17,"verse":7,"verseEnd":7,"votes":23,"source":"openbible","text":"But blessed is the man who trusts in the LORD, whose confidence is in Him.","from":5},{"book":"JER","chapter":17,"verse":8,"verseEnd":8,"votes":23,"source":"openbible","text":"He is like a tree planted by the waters that sends out its roots toward the stream. It does not fear when the heat comes, and its leaves are always green. It does not worry in a year of drought, nor does it cease to produce fruit.","from":5},{"book":"PSA","chapter":11,"verse":7,"verseEnd":7,"votes":16,"source":"both","text":"For the LORD is righteous; He loves justice. The upright will see His face.","from":8},{"book":"PSA","chapter":145,"verse":14,"verseEnd":14,"votes":15,"source":"both","text":"The LORD upholds all who fall and lifts up all who are bowed down.","from":8},{"book":"PSA","chapter":144,"verse":15,"verseEnd":15,"votes":13,"source":"both","text":"Blessed are the people of whom this is so; blessed are the people whose God is the LORD.","from":5},{"book":"MAT","chapter":9,"verse":30,"verseEnd":30,"votes":13,"source":"both","text":"And their eyes were opened. Jesus warned them sternly, “See that no one finds out about this!”","from":8},{"book":"PSA","chapter":10,"verse":16,"verseEnd":16,"votes":11,"source":"both","text":"The LORD is King forever and ever; the nations perish from His land.","from":10},{"book":"PSA","chapter":103,"verse":6,"verseEnd":6,"votes":11,"source":"both","text":"The LORD executes righteousness and justice for all the oppressed.","from":7}],"notes":[],"groups":[]}}