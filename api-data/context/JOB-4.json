{"1-11":{"people":[{"id":"eliphaz-h0464h","name":"Eliphaz","kind":"person","brief":"","count":1,"firstVerse":1},{"id":"teman-h8487g","name":"Teman","kind":"person","brief":"Grandson of Esau","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H0006","lemma":"אָבַד","tr":"a·vad","gloss":"to perish","lang":"h","inPassage":3,"uses":184},{"base":"H3811","lemma":"לָאָה","tr":"la·ah","gloss":"be weary","lang":"h","inPassage":2,"uses":19},{"base":"H4405","lemma":"מִלָּה","tr":"mil·lah","gloss":"speech","lang":"h","inPassage":2,"uses":38},{"base":"H3690","lemma":"כִּסְלָה","tr":"kis·lah","gloss":"confidence","lang":"h","inPassage":1,"uses":2},{"base":"H4310","lemma":"מִי","tr":"mi","gloss":"who?","lang":"h","inPassage":2,"uses":423},{"base":"H3918","lemma":"לַ֫יִשׁ","tr":"la·yish","gloss":"lion","lang":"h","inPassage":1,"uses":3},{"base":"H7504","lemma":"רָפֶה","tr":"ra·pheh","gloss":"weak","lang":"h","inPassage":1,"uses":4},{"base":"H7581","lemma":"שְׁאָגָה","tr":"she·a·gah","gloss":"roaring","lang":"h","inPassage":1,"uses":7},{"base":"H7826","lemma":"שַׁ֫חַל","tr":"sha·chal","gloss":"lion","lang":"h","inPassage":1,"uses":7},{"base":"H8489","lemma":"תֵּימָנִי","tr":"te·ma·ni","gloss":"Temanite","lang":"h","inPassage":1,"uses":8}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":3,"verse":26,"verseEnd":26,"votes":18,"source":"both","text":"for the LORD will be your confidence and will keep your foot from the snare.","from":6},{"book":"PRO","chapter":14,"verse":26,"verseEnd":26,"votes":17,"source":"both","text":"He who fears the LORD is secure in confidence, and his children shall have a place of refuge.","from":6},{"book":"JOB","chapter":1,"verse":1,"verseEnd":1,"votes":15,"source":"both","text":"There was a man in the land of Uz whose name was Job. And this man was blameless and upright, fearing God and shunning evil.","from":6},{"book":"JOB","chapter":17,"verse":15,"verseEnd":15,"votes":12,"source":"both","text":"where then is my hope? Who can see any hope for me?","from":6},{"book":"JOB","chapter":23,"verse":11,"verseEnd":11,"votes":10,"source":"openbible","text":"My feet have followed in His tracks; I have kept His way without turning aside.","from":6},{"book":"JOB","chapter":23,"verse":12,"verseEnd":12,"votes":10,"source":"openbible","text":"I have not departed from the command of His lips; I have treasured the words of His mouth more than my daily bread.","from":6},{"book":"GAL","chapter":6,"verse":7,"verseEnd":7,"votes":10,"source":"openbible","text":"Do not be deceived: God is not to be mocked. Whatever a man sows, he will reap in return.","from":8},{"book":"GAL","chapter":6,"verse":8,"verseEnd":8,"votes":10,"source":"openbible","text":"The one who sows to please his flesh, from the flesh will reap destruction; but the one who sows to please the Spirit, from the Spirit will reap eternal life.","from":8}],"notes":[],"groups":[]},"12-21":{"people":[],"places":[],"words":[{"base":"H5568","lemma":"סָמַר","tr":"sa·mar","gloss":"to bristle up","lang":"h","inPassage":1,"uses":2},{"base":"H8102","lemma":"שֵׁ֫מֶץ","tr":"she·mets","gloss":"whisper","lang":"h","inPassage":1,"uses":2},{"base":"H1827","lemma":"דְּמָמָה","tr":"de·ma·mah","gloss":"silence","lang":"h","inPassage":1,"uses":3},{"base":"H5587","lemma":"סְעִפָּה","tr":"sa·iph","gloss":"division","lang":"h","inPassage":1,"uses":3},{"base":"H0582","lemma":"אֱנוֹשׁ","tr":"e·nosh","gloss":"human","lang":"h","inPassage":2,"uses":565},{"base":"H7760","lemma":"שׂוּם","tr":"sum","gloss":"to set: make","lang":"h","inPassage":2,"uses":585},{"base":"H7461","lemma":"רַ֫עַד","tr":"ra·ad","gloss":"trembling","lang":"h","inPassage":1,"uses":6},{"base":"H8185","lemma":"שַׂעֲרָה","tr":"sa·a·rah","gloss":"hair","lang":"h","inPassage":1,"uses":7},{"base":"H8639","lemma":"תַּרְדֵּמָה","tr":"tar·de·mah","gloss":"deep sleep","lang":"h","inPassage":1,"uses":7},{"base":"H2384","lemma":"חִזָּיוֹן","tr":"chiz·za·von","gloss":"vision","lang":"h","inPassage":1,"uses":9}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":9,"verse":2,"verseEnd":2,"votes":9,"source":"both","text":"“Yes, I know that it is so, but how can a mortal be righteous before God?","from":17},{"book":"JOB","chapter":25,"verse":4,"verseEnd":4,"votes":7,"source":"both","text":"How then can a man be just before God? How can one born of woman be pure?","from":17},{"book":"ECC","chapter":7,"verse":20,"verseEnd":20,"votes":6,"source":"both","text":"Surely there is no righteous man on earth who does good and never sins.","from":17},{"book":"GEN","chapter":2,"verse":7,"verseEnd":7,"votes":5,"source":"both","text":"Then the LordGod formed man from the dust of the ground and breathed the breath of life into his nostrils, and the man became a living being.","from":19},{"book":"JOB","chapter":10,"verse":9,"verseEnd":9,"votes":5,"source":"both","text":"Please remember that You molded me like clay. Would You now return me to dust?","from":19},{"book":"JOB","chapter":36,"verse":12,"verseEnd":12,"votes":5,"source":"both","text":"But if they do not obey, then they perish by the sword and die without knowledge.","from":21},{"book":"2PE","chapter":2,"verse":4,"verseEnd":4,"votes":5,"source":"both","text":"For if God did not spare the angels when they sinned, but cast them deep into hell, placing them in chains of darkness to be held for judgment;","from":18},{"book":"JUD","chapter":1,"verse":6,"verseEnd":6,"votes":5,"source":"both","text":"And the angels who did not stay within their own domain but abandoned their proper dwelling—these He has kept in eternal chains under darkness, bound for judgment on that great day.","from":18}],"notes":[],"groups":[]}}