r","lang":"h","inPassage":2,"uses":2},{"base":"H4027","lemma":"מִגְדַּל־אֵל","tr":"mig·dal-el","gloss":"Migdal-el","lang":"h","inPassage":2,"uses":2},{"base":"H5877","lemma":"עֵין חָצוֹר","tr":"en cha·tsor","gloss":"En-hazor","lang":"h","inPassage":2,"uses":2},{"base":"H1043","lemma":"בֵּית־עֲנָת","tr":"bet a·nat","gloss":"Beth-anath","lang":"h","inPassage":2,"uses":6},{"base":"H1053","lemma":"בֵּית שֶׁ֫מֶשׁ","tr":"bet she·mesh","gloss":"Beth-shemesh","lang":"h","inPassage":2,"uses":42},{"base":"H6293","lemma":"פָּגַע","tr":"pa·ga","gloss":"to fall on","lang":"h","inPassage":2,"uses":46},{"base":"H5892","lemma":"עִיר","tr":"ir","gloss":"excitement","lang":"h","inPassage":3,"uses":1090},{"base":"H3383","lemma":"יַרְדֵּן","tr":"yar·den","gloss":"Jordan","lang":"h","inPassage":2,"uses":182},{"base":"H2691","lemma":"חָצֵר","tr":"cha·tser","gloss":"court","lang":"h","inPassage":2,"uses":191}],"parallels":[],"crossrefs":[{"book":"GEN","chapter":10,"verse":18,"verseEnd":18,"votes":0,"source":"tsk","text":"the Arvadites, the Zemarites, and the Hamathites. Later the Canaanite clans were scattered,","from":35},{"book":"NUM","chapter":13,"verse":21,"verseEnd":21,"votes":0,"source":"tsk","text":"So they went up and spied out the land from the Wilderness of Zin as far as Rehob, toward Lebo-hamath.","from":35},{"book":"NUM","chapter":34,"verse":8,"verseEnd":8,"votes":0,"source":"tsk","text":"and from Mount Hor to Lebo-hamath, then extend to Zedad,","from":35},{"book":"DEU","chapter":33,"verse":23,"verseEnd":23,"votes":0,"source":"tsk","text":"Concerning Naphtali he said: “Naphtali is abounding with favor, full of the blessing of the LORD; he shall take possession of the sea and the south.”","from":34},{"book":"JOS","chapter":11,"verse":1,"verseEnd":1,"votes":0,"source":"tsk","text":"Now when Jabin king of Hazor heard about these things, he sent word to Jobab king of Madon; to the kings of Shimron and Achshaph;","from":36},{"book":"JOS","chapter":11,"verse":2,"verseEnd":2,"votes":0,"source":"tsk","text":"to the kings of the north in the mountains, in the Arabah south of Chinnereth, in the foothills, and in Naphoth-dor to the west;","from":35},{"book":"JOS","chapter":11,"verse":20,"verseEnd":20,"votes":0,"source":"tsk","text":"For it was of the LORD to harden their hearts to engage Israel in battle, so that they would be set apart for destruction and would receive no mercy, being annihilated as the LORD had commanded Moses.","from":36},{"book":"JOS","chapter":12,"verse":19,"verseEnd":19,"votes":0,"source":"tsk","text":"the king of Madon, one; the king of Hazor, one;","from":36}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":4}]},"40-48":{"people":[],"places":[{"id":"dan-h1835g","name":"Dan","kind":"place","brief":"In Dan","count":3,"firstVerse":40},{"id":"beth-shemesh-h1053g","name":"Beth-shemesh","kind":"place","brief":"","count":1,"firstVerse":41},{"id":"eshtaol-h0847","name":"Eshtaol","kind":"place","brief":"","count":1,"firstVerse":41},{"id":"zorah-h6881","name":"Zorah","kind":"place","brief":"","count":1,"firstVerse":41},{"id":"aijalon-h0357","name":"Aijalon","kind":"place","brief":"","count":1,"firstVerse":42},{"id":"ithlah-h3494","name":"Ithlah","kind":"place","brief":"","count":1,"firstVerse":42},{"id":"shaalbim-h8169","name":"Shaalbim","kind":"place","brief":"","count":1,"firstVerse":42},{"id":"ekron-h6138","name":"Ekron","kind":"place","brief":"In Philistia","count":1,"firstVerse":43},{"id":"elon-h0356i","name":"Elon","kind":"place","brief":"","count":1,"firstVerse":43},{"id":"timnah-h8553g","name":"Timnah","kind":"place","brief":"In Philistia","count":1,"firstVerse":43},{"id":"baalath-h1191g","name":"Baalath","kind":"place","brief":"","count":1,"firstVerse":44},{"id":"eltekeh-h0514","name":"Eltekeh","kind":"place","brief":"","count":1,"firstVerse":44},{"id":"gibbethon-h1405","name":"Gibbethon","kind":"place","brief":"In Dan/Philistia","count":1,"firstVerse":44},{"id":"bene-berak-h1139","name":"Bene-berak","kind":"place","brief":"","count":1,"firstVerse":45},{"id":"gath-rimmon-h1667g","name":"Gath-rimmon","kind":"place","brief":"","count":1,"firstVerse":45},{"id":"jehud-h3055","name":"Jehud","kind":"place","brief":"","count":1,"firstVerse":45},{"id":"joppa-h3305","name":"Joppa","kind":"place","brief":"","count":1,"firstVerse":46},{"id":"me-jarkon-h4313","name":"Me-jarkon","kind":"place","brief":"","count":1,"firstVerse":46},{"id":"rakkon-h7542","name":"Rakkon","kind":"place","brief":"","count":1,"firstVerse":46}],"words":[{"base":"H1835","lemma":"דָּן","tr":"dan","gloss":"Dan","lang":"h","inPassage":6,"uses":70},{"base":"H1139","lemma":"בְּנֵי־בְרַק","tr":"be·ne-b·raq","gloss":"Bene-berak","lang":"h","inPassage":2,"uses":2},{"base":"H3959","lemma":"לֶ֫שֶׁם","tr":"le·shem","gloss":"Leshem","lang":"h","inPassage":2,"uses":2},{"base":"H4313","lemma":"מֵי הַיַּרְקוֹן","tr":"me hay·yar·qon","gloss":"Me-jarkon","lang":"h","inPassage":2,"uses":2},{"base":"H5905","lemma":"עִיר שָׁ֑מֶשׁ","tr":"ir she·mesh","gloss":"Ir-shemesh","lang":"h","inPassage":2,"uses":2},{"base":"H1667","lemma":"גַּת־רִמּוֹן","tr":"gat-rim·mon","gloss":"Gath-rimmon","lang":"h","inPassage":2,"uses":8},{"base":"H1366","lemma":"גְּבוּל","tr":"ge·vul","gloss":"border: boundary","lang":"h","inPassage":3,"uses":240},{"base":"H5159","lemma":"נַחֲלָה","tr":"na·cha·lah","gloss":"inheritance","lang":"h","inPassage":2,"uses":222},{"base":"H4294","lemma":"מַטֶּה","tr":"mat·teh","gloss":"tribe: rod","lang":"h","inPassage":2,"uses":252},{"base":"H4940","lemma":"מִשְׁפָּחָה","tr":"mish·pa·chah","gloss":"family","lang":"h","inPassage":2,"uses":303}],"parallels":[],"crossrefs":[{"book":"GEN","chapter":38,"verse":12,"verseEnd":12,"votes":0,"source":"tsk","text":"After a long time Judahʼs wife, the daughter of Shua, died. When Judah had finished mourning, he and his friend Hirah the Adullamite went up to his sheepshearers at Timnah.","from":43},{"book":"JOS","chapter":10,"verse":12,"verseEnd":12,"votes":0,"source":"tsk","text":"On the day that the LORD gave the Amorites over to the Israelites, Joshua spoke to the LORD in the presence of Israel: “O sun, stand still over Gibeon, O moon, over the Valley of Aijalon.”","from":42},{"book":"JOS","chapter":15,"verse":33,"verseEnd":33,"votes":0,"source":"tsk","text":"These were in the foothills: Eshtaol, Zorah, Ashnah,","from":41},{"book":"JOS","chapter":15,"verse":45,"verseEnd":45,"votes":0,"source":"tsk","text":"Ekron, with its towns and villages;","from":43},{"book":"JOS","chapter":21,"verse":16,"verseEnd":16,"votes":0,"source":"tsk","text":"Ain, Juttah, and Beth-shemesh—nine cities from these two tribes, together with their pasturelands.","from":41},{"book":"JOS","chapter":21,"verse":23,"verseEnd":23,"votes":0,"source":"tsk","text":"From the tribe of Dan they were given Elteke, Gibbethon,","from":44},{"book":"JOS","chapter":21,"verse":24,"verseEnd":24,"votes":0,"source":"tsk","text":"Aijalon, and Gath-rimmon—four cities, together with their pasturelands.","from":42},{"book":"JOS","chapter":21,"verse":24,"verseEnd":24,"votes":0,"source":"tsk","text":"Aijalon, and Gath-rimmon—four cities, together with their pasturelands.","from":45}],"notes":[],"groups":[]},"49-51":{"people":[{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":2,"firstVerse":49},{"id":"joshua-h3091g","name":"Joshua","kind":"person","brief":"A judge","count":2,"firstVerse":49},{"id":"nun-h5126","name":"Nun","kind":"person","brief":"Father of Joshua","count":2,"firstVerse":49},{"id":"ephraim-h0669g","name":"Ephraim","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":50},{"id":"eleazar-h0499g","name":"Eleazar","kind":"person","brief":"A High Priest","count":1,"firstVerse":51}],"places":[{"id":"timnath-heres-h8556a","name":"Timnath-heres","kind":"place","brief":"","count":1,"firstVerse":50},{"id":"shiloh-h7887","name":"Shiloh","kind":"place","brief":"","count":1,"firstVerse":51}],"words":[{"base":"H8556","lemma":"תִּמְנַת חֶרֶס","tr":"tim·nat che·res","gloss":"Timnath-heres","lang":"h","inPassage":2,"uses":6},{"base":"H5126","lemma":"נוּן","tr":"nun","gloss":"Nun","lang":"h","inPassage":2,"uses":30},{"base":"H5157","lemma":"נָחַל","tr":"na·chal","gloss":"to inherit","lang":"h","inPassage":2,"uses":59},{"base":"H3615","lemma":"כָּלָה","tr":"ka·lah","gloss":"to end: finish","lang":"h","inPassage":2,"uses":208},{"base":"H3091","lemma":"יְהוֹשׁוּעַ","tr":"ye·ho·shu·a","gloss":"Joshua","lang":"h","inPassage":2,"uses":218},{"base":"H5159","lemma":"נַחֲלָה","tr":"na·cha·lah","gloss":"inheritance","lang":"h","inPassage":2,"uses":222},{"base":"H1367","lemma":"גְּבוּלָה","tr":"ge·vu·lah","gloss":"border","lang":"h","inPassage":1,"uses":10},{"base":"H5892","lemma":"עִיר","tr":"ir","gloss":"excitement","lang":"h","inPassage":2,"uses":1090},{"base":"H7887","lemma":"שִׁלוֹ","tr":"shi·loh","gloss":"Shiloh","lang":"h","inPassage":1,"uses":32},{"base":"H2505","lemma":"חָלַק","tr":"cha·laq","gloss":"to divide","lang":"h","inPassage":1,"uses":65}],"parallels":[],"crossrefs":[{"book":"JOS","chapter":14,"verse":1,"verseEnd":1,"votes":5,"source":"both","text":"Now these are the portions that the Israelites inherited in the land of Canaan, as distributed by Eleazar the priest, Joshua son of Nun, and the heads of the families of the tribes of Israel.","from":51},{"book":"JOS","chapter":18,"verse":10,"verseEnd":10,"votes":5,"source":"both","text":"And Joshua cast lots for them in the presence of the LORD at Shiloh, where he distributed the land to the Israelites according to their divisions.","from":51},{"book":"GEN","chapter":49,"verse":10,"verseEnd":10,"votes":0,"source":"tsk","text":"The scepter will not depart from Judah, nor the staff from between his feet, until Shiloh comes and the allegiance of the nations is his.","from":51},{"book":"NUM","chapter":34,"verse":17,"verseEnd":29,"votes":0,"source":"tsk","text":"“These are the names of the men who are to assign the land as an inheritance for you: Eleazar the priest and Joshua son of Nun. Appoint one leader from each tribe to distribute the land. These are their names: Caleb son of Jephunneh from the tribe of Judah; Shemuel son of Ammihud from the tribe of Simeon; Elidad son of Chislon from the tribe of Benjamin;","from":51},{"book":"JOS","chapter":18,"verse":1,"verseEnd":1,"votes":0,"source":"tsk","text":"Then the whole congregation of Israel assembled at Shiloh and set up the Tent of Meeting there. And though the land was subdued before them,","from":51},{"book":"JOS","chapter":24,"verse":30,"verseEnd":30,"votes":0,"source":"tsk","text":"And they buried him in the land of his inheritance, at Timnath-serah in the hill country of Ephraim, north of Mount Gaash.","from":50},{"book":"JDG","chapter":2,"verse":9,"verseEnd":9,"votes":0,"source":"tsk","text":"They buried him in the land of his inheritance, at Timnath-heres in the hill country of Ephraim, north of Mount Gaash.","from":50},{"book":"JDG","chapter":21,"verse":19,"verseEnd":19,"votes":0,"source":"tsk","text":"“But look,” they said, “there is a yearly feast to the LORD in Shiloh, which is north of Bethel east of the road that goes up from Bethel to Shechem, and south of Lebonah.”","from":51}],"notes":[],"groups":[{"id":"exodus-family","title":"Moses and his circle","people":3}]}}