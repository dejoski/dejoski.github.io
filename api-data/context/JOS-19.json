he omer, he who gathered much had no excess, and he who gathered little had no shortfall. Each one gathered as much as he needed to eat.","from":9},{"book":"NUM","chapter":33,"verse":19,"verseEnd":20,"votes":0,"source":"tsk","text":"They set out from Rithmah and camped at Rimmon-perez. They set out from Rimmon-perez and camped at Libnah.","from":7},{"book":"JOS","chapter":15,"verse":28,"verseEnd":28,"votes":0,"source":"tsk","text":"Hazar-shual, Beersheba, Biziothiah,","from":2},{"book":"JOS","chapter":15,"verse":28,"verseEnd":29,"votes":0,"source":"tsk","text":"Hazar-shual, Beersheba, Biziothiah, Baalah, Iim, Ezem,","from":3},{"book":"JOS","chapter":15,"verse":30,"verseEnd":30,"votes":0,"source":"tsk","text":"Eltolad, Chesil, Hormah,","from":4},{"book":"JOS","chapter":15,"verse":31,"verseEnd":31,"votes":0,"source":"tsk","text":"Ziklag, Madmannah, Sansannah,","from":5}],"notes":[{"id":"gen-49-simeon-levi","title":"Simeon and Levi scattered in Israel","kind":"prophecy"}],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":2}]},"10-16":{"people":[{"id":"zebulun-h2074","name":"Zebulun","kind":"person","brief":"Son of Israel","count":2,"firstVerse":10}],"places":[{"id":"sarid-h8301","name":"Sarid","kind":"place","brief":"","count":2,"firstVerse":10},{"id":"dabbesheth-h1708","name":"Dabbesheth","kind":"place","brief":"","count":1,"firstVerse":11},{"id":"jokneam-h3362","name":"Jokneam","kind":"place","brief":"","count":1,"firstVerse":11},{"id":"mareal-h4831","name":"Mareal","kind":"place","brief":"","count":1,"firstVerse":11},{"id":"chesulloth-h3694","name":"Chesulloth","kind":"place","brief":"","count":1,"firstVerse":12},{"id":"daberath-h1705","name":"Daberath","kind":"place","brief":"","count":1,"firstVerse":12},{"id":"japhia-h3309h","name":"Japhia","kind":"place","brief":"","count":1,"firstVerse":12},{"id":"dimnah-h1829","name":"Dimnah","kind":"place","brief":"","count":1,"firstVerse":13},{"id":"eth-kazin-h6278","name":"Eth-kazin","kind":"place","br