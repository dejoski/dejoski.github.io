{"1-6":{"people":[{"id":"bildad-h1085","name":"Bildad","kind":"person","brief":"","count":1,"firstVerse":1},{"id":"shuhites-h7747","name":"Shuhites","kind":"person","brief":"","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H2141","lemma":"זָכַךְ","tr":"za·khakh","gloss":"be clean","lang":"h","inPassage":1,"uses":4},{"base":"H1085","lemma":"בִּלְדַּד","tr":"bil·dad","gloss":"Bildad","lang":"h","inPassage":1,"uses":5},{"base":"H7747","lemma":"שׁוּחִי","tr":"shu·chi","gloss":"Shuhite","lang":"h","inPassage":1,"uses":5},{"base":"H0582","lemma":"אֱנוֹשׁ","tr":"e·nosh","gloss":"human","lang":"h","inPassage":2,"uses":565},{"base":"H7415","lemma":"רִמָּה","tr":"rim·mah","gloss":"worm","lang":"h","inPassage":1,"uses":7},{"base":"H2135","lemma":"זָכָה","tr":"za·khah","gloss":"to clean","lang":"h","inPassage":1,"uses":8},{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":2,"uses":752},{"base":"H5973","lemma":"עִם","tr":"im","gloss":"with","lang":"h","inPassage":2,"uses":1051},{"base":"H3394","lemma":"יָרֵחַ","tr":"ya·re·ach","gloss":"moon","lang":"h","inPassage":1,"uses":27},{"base":"H1416","lemma":"גְּדוּד","tr":"ge·dud","gloss":"band","lang":"h","inPassage":1,"uses":33}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":15,"verse":14,"verseEnd":14,"votes":8,"source":"openbible","text":"What is man, that he should be pure, or one born of woman, that he should be righteous?","from":4},{"book":"JOB","chapter":15,"verse":16,"verseEnd":16,"votes":8,"source":"openbible","text":"how much less man, who is vile and corrupt, who drinks injustice like water?","from":4},{"book":"ROM","chapter":5,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Therefore, since we have been justified through faith, we have peace with God through our Lord Jesus Christ,","from":4},{"book":"JOB","chapter":4,"verse":17,"verseEnd":17,"votes":7,"source":"openbible","text":"‘Can a mortal be more righteous than God, or a man more pure than his Maker?","from":4},{"book":"JOB","chapter":4,"verse":19,"verseEnd":19,"votes":7,"source":"openbible","text":"how much more those who dwell in houses of clay, whose foundations are in the dust, who can be crushed like a moth!","from":4},{"book":"JOB","chapter":9,"verse":2,"verseEnd":2,"votes":7,"source":"both","text":"“Yes, I know that it is so, but how can a mortal be righteous before God?","from":4},{"book":"PSA","chapter":130,"verse":3,"verseEnd":3,"votes":7,"source":"both","text":"If You, O LORD, kept track of iniquities, then who, O Lord, could stand?","from":4},{"book":"PSA","chapter":143,"verse":2,"verseEnd":2,"votes":6,"source":"both","text":"Do not bring Your servant into judgment, for no one alive is righteous before You.","from":4}],"notes":[],"groups":[]}}