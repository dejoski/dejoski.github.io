{"1-6":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H2664","lemma":"חָפַשׂ","tr":"cha·pha·s","gloss":"to search","lang":"h","inPassage":2,"uses":23},{"base":"H3384","lemma":"יָרָא","tr":"ya·ra","gloss":"to shoot","lang":"h","inPassage":2,"uses":80},{"base":"H7285","lemma":"רֶ֫גֶשׁ","tr":"re·gesh","gloss":"throng","lang":"h","inPassage":1,"uses":2},{"base":"H8150","lemma":"שָׁנַן","tr":"sha·nan","gloss":"to sharpen","lang":"h","inPassage":1,"uses":9},{"base":"H4565","lemma":"מִסְתָּר","tr":"mis·tar","gloss":"hiding","lang":"h","inPassage":1,"uses":10},{"base":"H7879","lemma":"שִׂיחַ","tr":"si·ach","gloss":"complaint","lang":"h","inPassage":1,"uses":14},{"base":"H8535","lemma":"תָּם","tr":"tam","gloss":"complete","lang":"h","inPassage":1,"uses":15},{"base":"H6013","lemma":"עָמֹק","tr":"a·moq","gloss":"deep","lang":"h","inPassage":1,"uses":17},{"base":"H5475","lemma":"סוֹד","tr":"sod","gloss":"counsel","lang":"h","inPassage":1,"uses":21},{"base":"H9038","lemma":"הֶם","tr":"hem","gloss":"them","lang":"h","inPassage":2,"uses":1125}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":59,"verse":2,"verseEnd":2,"votes":9,"source":"openbible","text":"Deliver me from workers of iniquity, and save me from men of bloodshed.","from":2},{"book":"PSA","chapter":143,"verse":9,"verseEnd":9,"votes":9,"source":"both","text":"Deliver me from my enemies, O LORD; I flee to You for refuge.","from":2},{"book":"PSA","chapter":31,"verse":20,"verseEnd":20,"votes":8,"source":"both","text":"You hide them in the secret place of Your presence from the schemes of men. You conceal them in Your shelter from accusing tongues.","from":2},{"book":"PSA","chapter":109,"verse":2,"verseEnd":2,"votes":8,"source":"openbible","text":"For wicked and deceitful mouths open against me; they speak against me with lying tongues.","from":2},{"book":"PSA","chapter":109,"verse":3,"verseEnd":3,"votes":8,"source":"openbible","text":"They surround me with hateful words and attack me without cause.","from":2},{"book":"JER","chapter":11,"verse":19,"verseEnd":19,"votes":8,"source":"both","text":"For I was like a gentle lamb led to slaughter; I did not know that they had plotted against me: “Let us destroy the tree with its fruit; let us cut him off from the land of the living, that his name may be remembered no more.”","from":2},{"book":"PSA","chapter":27,"verse":5,"verseEnd":5,"votes":7,"source":"both","text":"For in the day of trouble He will hide me in His shelter; He will conceal me under the cover of His tent; He will set me high upon a rock.","from":2},{"book":"PSA","chapter":3,"verse":1,"verseEnd":1,"votes":6,"source":"both","text":"O LORD, how my foes have increased! How many rise up against me!","from":2}],"notes":[],"groups":[]},"7-10":{"people":[],"places":[],"words":[{"base":"H6597","lemma":"פִּתְאֹם","tr":"pit·om","gloss":"suddenly","lang":"h","inPassage":1,"uses":25},{"base":"H5074","lemma":"נָדַד","tr":"na·dad","gloss":"to wander","lang":"h","inPassage":1,"uses":28},{"base":"H2620","lemma":"חָסָה","tr":"cha·sah","gloss":"to seek refuge","lang":"h","inPassage":1,"uses":37},{"base":"H6467","lemma":"פֹּ֫עַל","tr":"po·al","gloss":"work","lang":"h","inPassage":1,"uses":37},{"base":"H4347","lemma":"מַכָּה","tr":"mak·kah","gloss":"wound","lang":"h","inPassage":1,"uses":48},{"base":"H2671","lemma":"חֵץ","tr":"chets","gloss":"arrow","lang":"h","inPassage":1,"uses":53},{"base":"H3782","lemma":"כָּשַׁל","tr":"ka·shal","gloss":"to stumble","lang":"h","inPassage":1,"uses":62},{"base":"H7919","lemma":"שָׂכַל","tr":"sa·khal","gloss":"be prudent","lang":"h","inPassage":1,"uses":62},{"base":"H3384","lemma":"יָרָא","tr":"ya·ra","gloss":"to shoot","lang":"h","inPassage":1,"uses":80},{"base":"H3956","lemma":"לָשׁוֹן","tr":"la·shon","gloss":"tongue","lang":"h","inPassage":1,"uses":117}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":32,"verse":11,"verseEnd":11,"votes":8,"source":"both","text":"Be glad in the LORD and rejoice, O righteous ones; shout for joy, all you upright in heart.","from":10},{"book":"PSA","chapter":33,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Rejoice in the LORD, O righteous ones; it is fitting for the upright to praise Him.","from":10},{"book":"PRO","chapter":18,"verse":7,"verseEnd":7,"votes":8,"source":"both","text":"A foolʼs mouth is his ruin, and his lips are a snare to his soul.","from":8},{"book":"PRO","chapter":12,"verse":13,"verseEnd":13,"votes":7,"source":"both","text":"An evil man is trapped by his rebellious speech, but a righteous man escapes from trouble.","from":8},{"book":"1CO","chapter":1,"verse":30,"verseEnd":30,"votes":7,"source":"openbible","text":"It is because of Him that you are in Christ Jesus, who has become for us wisdom from God: our righteousness, holiness, and redemption.","from":10},{"book":"1CO","chapter":1,"verse":31,"verseEnd":31,"votes":7,"source":"openbible","text":"Therefore, as it is written: “Let him who boasts boast in the Lord.”","from":10},{"book":"PSA","chapter":7,"verse":12,"verseEnd":12,"votes":6,"source":"openbible","text":"If one does not repent, God will sharpen His sword; He has bent and strung His bow.","from":7},{"book":"PSA","chapter":7,"verse":13,"verseEnd":13,"votes":6,"source":"openbible","text":"He has prepared His deadly weapons; He ordains His arrows with fire.","from":7}],"notes":[],"groups":[]}}