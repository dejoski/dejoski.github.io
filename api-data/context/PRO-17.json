{"1-8":{"people":[],"places":[],"words":[{"base":"H8193","lemma":"שָׂפָה","tr":"sa·phah","gloss":"lips","lang":"h","inPassage":3,"uses":176},{"base":"H7919","lemma":"שָׂכַל","tr":"sa·khal","gloss":"be prudent","lang":"h","inPassage":2,"uses":62},{"base":"H8267","lemma":"שֶׁ֫קֶר","tr":"she·qer","gloss":"deception","lang":"h","inPassage":2,"uses":113},{"base":"H4715","lemma":"מַצְרֵף","tr":"mits·reph","gloss":"crucible","lang":"h","inPassage":1,"uses":2},{"base":"H3826","lemma":"לִבָּה","tr":"lib·bah","gloss":"heart","lang":"h","inPassage":1,"uses":7},{"base":"H7962","lemma":"שַׁלְוָה","tr":"shal·vah","gloss":"ease","lang":"h","inPassage":1,"uses":8},{"base":"H3564","lemma":"כּוּר","tr":"kur","gloss":"furnace","lang":"h","inPassage":1,"uses":9},{"base":"H2720","lemma":"חָרֵב","tr":"cha·rev","gloss":"dry","lang":"h","inPassage":1,"uses":10},{"base":"H5000","lemma":"נָאוֶה","tr":"na·eh","gloss":"lovely","lang":"h","inPassage":1,"uses":10},{"base":"H6595","lemma":"פַּת","tr":"pat","gloss":"morsel","lang":"h","inPassage":1,"uses":15}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":15,"verse":17,"verseEnd":17,"votes":27,"source":"both","text":"Better a dish of vegetables where there is love than a fattened ox with hatred.","from":1},{"book":"PRO","chapter":21,"verse":19,"verseEnd":19,"votes":24,"source":"both","text":"Better to live in the desert than with a contentious and ill-tempered wife.","from":1},{"book":"PSA","chapter":37,"verse":16,"verseEnd":16,"votes":21,"source":"both","text":"Better is the little of the righteous than the abundance of many who are wicked.","from":1},{"book":"PRO","chapter":21,"verse":9,"verseEnd":9,"votes":19,"source":"both","text":"Better to live on a corner of the roof than to share a house with a quarrelsome wife.","from":1},{"book":"ISA","chapter":48,"verse":10,"verseEnd":10,"votes":14,"source":"both","text":"See, I have refined you, but not as silver; I have tested you in the furnace of affliction.","from":3},{"book":"JER","chapter":17,"verse":10,"verseEnd":10,"votes":11,"source":"both","text":"I, the LORD, search the heart; I examine the mind to reward a man according to his way, by what his deeds deserve.","from":3},{"book":"PSA","chapter":26,"verse":2,"verseEnd":2,"votes":10,"source":"both","text":"Test me, O LORD, and try me; examine my heart and mind.","from":3},{"book":"PRO","chapter":14,"verse":31,"verseEnd":31,"votes":10,"source":"both","text":"Whoever oppresses the poor taunts their Maker, but whoever is kind to the needy honors Him.","from":5}],"notes":[],"groups":[]},"9-15":{"people":[],"places":[],"words":[{"base":"H7451","lemma":"רַע","tr":"ra","gloss":"bad: harmful","lang":"h","inPassage":3,"uses":661},{"base":"H3684","lemma":"כְּסִיל","tr":"ke·sil","gloss":"fool","lang":"h","inPassage":2,"uses":70},{"base":"H1245","lemma":"בָּקַשׁ","tr":"ba·qash","gloss":"to seek","lang":"h","inPassage":2,"uses":225},{"base":"H1566","lemma":"גָּלַע","tr":"ga·la","gloss":"to quarrel","lang":"h","inPassage":1,"uses":3},{"base":"H7909","lemma":"שַׁכּוּל","tr":"shak·kul","gloss":"childless","lang":"h","inPassage":1,"uses":7},{"base":"H0394","lemma":"אַכְזָרִי","tr":"akh·za·ri","gloss":"cruel","lang":"h","inPassage":1,"uses":8},{"base":"H6362","lemma":"פָּטַר","tr":"pa·tar","gloss":"to separate","lang":"h","inPassage":1,"uses":9},{"base":"H4066","lemma":"מָדוֹן","tr":"ma·don","gloss":"strife","lang":"h","inPassage":1,"uses":10},{"base":"H5181","lemma":"נָחֵת","tr":"na·chat","gloss":"to descend","lang":"h","inPassage":1,"uses":11},{"base":"H1677","lemma":"דֹּב","tr":"dov","gloss":"bear","lang":"h","inPassage":1,"uses":12}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":10,"verse":12,"verseEnd":12,"votes":24,"source":"both","text":"Hatred stirs up dissension, but love covers all transgressions.","from":9},{"book":"1PE","chapter":4,"verse":8,"verseEnd":8,"votes":18,"source":"both","text":"Above all, love one another deeply, because love covers over a multitude of sins.","from":9},{"book":"PRO","chapter":16,"verse":28,"verseEnd":28,"votes":11,"source":"both","text":"A perverse man spreads dissension, and a gossip divides close friends.","from":9},{"book":"EXO","chapter":23,"verse":7,"verseEnd":7,"votes":10,"source":"both","text":"Stay far away from a false accusation. Do not kill the innocent or the just, for I will not acquit the guilty.","from":15},{"book":"PSA","chapter":109,"verse":4,"verseEnd":4,"votes":9,"source":"openbible","text":"In return for my love they accuse me, but I am a man of prayer.","from":13},{"book":"PSA","chapter":109,"verse":13,"verseEnd":13,"votes":9,"source":"openbible","text":"May his descendants be cut off; may their name be blotted out from the next generation.","from":13},{"book":"PRO","chapter":18,"verse":5,"verseEnd":5,"votes":9,"source":"openbible","text":"Showing partiality to the wicked is not good, nor is depriving the innocent of justice.","from":15},{"book":"ISA","chapter":5,"verse":23,"verseEnd":23,"votes":9,"source":"both","text":"who acquit the guilty for a bribe and deprive the innocent of justice.","from":15}],"notes":[],"groups":[]},"16-22":{"people":[],"places":[],"words":[{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":4,"uses":595},{"base":"H0157","lemma":"אָהֵב","tr":"a·hav","gloss":"to love: lover","lang":"h","inPassage":3,"uses":211},{"base":"H3684","lemma":"כְּסִיל","tr":"ke·sil","gloss":"fool","lang":"h","inPassage":2,"uses":70},{"base":"H7453","lemma":"רֵעַ","tr":"re·a","gloss":"neighbor","lang":"h","inPassage":2,"uses":188},{"base":"H6161","lemma":"עֲרֻבָּה","tr":"a·rub·bah","gloss":"pledge","lang":"h","inPassage":1,"uses":2},{"base":"H4683","lemma":"מַצָּה","tr":"mats·tsah","gloss":"strife","lang":"h","inPassage":1,"uses":3},{"base":"H5218","lemma":"נָכָא","tr":"na·ka","gloss":"stricken","lang":"h","inPassage":1,"uses":4},{"base":"H8424","lemma":"תּוּגָה","tr":"tu·gah","gloss":"grief","lang":"h","inPassage":1,"uses":4},{"base":"H3205","lemma":"יָלַד","tr":"ya·lad","gloss":"to beget","lang":"h","inPassage":2,"uses":496},{"base":"H1634","lemma":"גֶּ֫רֶם","tr":"ge·rem","gloss":"bone","lang":"h","inPassage":1,"uses":5}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":15,"verse":13,"verseEnd":13,"votes":65,"source":"both","text":"A joyful heart makes a cheerful countenance, but sorrow of the heart crushes the spirit.","from":22},{"book":"PRO","chapter":12,"verse":25,"verseEnd":25,"votes":47,"source":"both","text":"Anxiety weighs down the heart of a man, but a good word cheers it up.","from":22},{"book":"PRO","chapter":18,"verse":14,"verseEnd":14,"votes":43,"source":"both","text":"The spirit of a man can endure his sickness, but who can survive a broken spirit?","from":22},{"book":"2CO","chapter":7,"verse":10,"verseEnd":10,"votes":32,"source":"both","text":"Godly sorrow brings repentance that leads to salvation without regret, but worldly sorrow brings death.","from":22},{"book":"PRO","chapter":18,"verse":24,"verseEnd":24,"votes":28,"source":"both","text":"A man of many companions may come to ruin, but there is a friend who stays closer than a brother.","from":17},{"book":"JHN","chapter":15,"verse":13,"verseEnd":13,"votes":21,"source":"openbible","text":"Greater love has no one than this, that he lay down his life for his friends.","from":17},{"book":"JHN","chapter":15,"verse":14,"verseEnd":14,"votes":21,"source":"openbible","text":"You are My friends if you do what I command you.","from":17},{"book":"ROM","chapter":5,"verse":2,"verseEnd":2,"votes":20,"source":"openbible","text":"through whom we have gained access by faith into this grace in which we stand. And we rejoice in the hope of the glory of God.","from":22}],"notes":[],"groups":[]},"23-28":{"people":[],"places":[],"words":[{"base":"H3684","lemma":"כְּסִיל","tr":"ke·sil","gloss":"fool","lang":"h","inPassage":2,"uses":70},{"base":"H0995","lemma":"בִּין","tr":"bin","gloss":"to understand","lang":"h","inPassage":2,"uses":170},{"base":"H0331","lemma":"אָטַם","tr":"a·tam","gloss":"to shutter","lang":"h","inPassage":1,"uses":8},{"base":"H6064","lemma":"עָנַשׁ","tr":"a·nash","gloss":"to fine","lang":"h","inPassage":1,"uses":9},{"base":"H1571","lemma":"גַּם","tr":"gam","gloss":"also","lang":"h","inPassage":2,"uses":769},{"base":"H3476","lemma":"יֹ֫שֶׁר","tr":"yo·sher","gloss":"uprightness","lang":"h","inPassage":1,"uses":14},{"base":"H7810","lemma":"שֹׁ֫חַד","tr":"sha·chad","gloss":"bribe","lang":"h","inPassage":1,"uses":23},{"base":"H3708","lemma":"כַּ֫עַס","tr":"ka·as","gloss":"vexation","lang":"h","inPassage":1,"uses":25},{"base":"H0191","lemma":"אֱוִיל","tr":"e·vil","gloss":"fool(ish)","lang":"h","inPassage":1,"uses":26},{"base":"H2820","lemma":"חָשַׂךְ","tr":"cha·sakh","gloss":"to withhold","lang":"h","inPassage":1,"uses":28}],"parallels":[],"crossrefs":[{"book":"JAS","chapter":3,"verse":18,"verseEnd":18,"votes":34,"source":"both","text":"Peacemakers who sow in peace reap the fruit of righteousness.","from":27},{"book":"JOB","chapter":13,"verse":5,"verseEnd":5,"votes":22,"source":"both","text":"If only you would remain silent; for that would be your wisdom!","from":28},{"book":"JAS","chapter":1,"verse":19,"verseEnd":19,"votes":20,"source":"both","text":"My beloved brothers, understand this: Everyone should be quick to listen, slow to speak, and slow to anger,","from":27},{"book":"PRO","chapter":10,"verse":19,"verseEnd":19,"votes":14,"source":"both","text":"When words are many, sin is unavoidable, but he who restrains his lips is wise.","from":27},{"book":"PRO","chapter":14,"verse":29,"verseEnd":29,"votes":14,"source":"openbible","text":"A patient man has great understanding, but a quick-tempered man promotes folly.","from":27},{"book":"PRO","chapter":15,"verse":2,"verseEnd":2,"votes":14,"source":"both","text":"The tongue of the wise commends knowledge, but the mouth of the fool spouts folly.","from":28},{"book":"ECC","chapter":10,"verse":14,"verseEnd":14,"votes":12,"source":"both","text":"Yet the fool multiplies words. No one knows what is coming, and who can tell him what will come after him?","from":28},{"book":"JAS","chapter":3,"verse":2,"verseEnd":2,"votes":12,"source":"both","text":"We all stumble in many ways. If anyone is never at fault in what he says, he is a perfect man, able to control his whole body.","from":27}],"notes":[],"groups":[]}}