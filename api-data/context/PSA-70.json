{"1-3":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H1889","lemma":"הֶאָח","tr":"he·ach","gloss":"Aha!","lang":"h","inPassage":2,"uses":12},{"base":"H2655","lemma":"חָפֵץ","tr":"cha·phets","gloss":"delighting","lang":"h","inPassage":1,"uses":12},{"base":"H5472","lemma":"סוּג","tr":"sug","gloss":"to turn","lang":"h","inPassage":1,"uses":14},{"base":"H6118","lemma":"עֵ֫קֶב","tr":"e·qev","gloss":"consequence","lang":"h","inPassage":1,"uses":15},{"base":"H2659","lemma":"חָפֵר","tr":"cha·pher","gloss":"be ashamed","lang":"h","inPassage":1,"uses":17},{"base":"H2363","lemma":"חוּשׁ","tr":"chush","gloss":"to hasten","lang":"h","inPassage":1,"uses":20},{"base":"H5833","lemma":"עֶזְרָה","tr":"ez·rah","gloss":"help","lang":"h","inPassage":1,"uses":26},{"base":"H1322","lemma":"בֹּ֫שֶׁת","tr":"bo·shet","gloss":"shame","lang":"h","inPassage":1,"uses":30},{"base":"H3637","lemma":"כָּלַם","tr":"ka·lam","gloss":"be humiliated","lang":"h","inPassage":1,"uses":38},{"base":"H0268","lemma":"אָחוֹר","tr":"a·chor","gloss":"back","lang":"h","inPassage":1,"uses":41}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":40,"verse":13,"verseEnd":13,"votes":12,"source":"openbible","text":"Be pleased, O LORD, to deliver me; hurry, O LORD, to help me.","from":1},{"book":"PSA","chapter":40,"verse":17,"verseEnd":17,"votes":12,"source":"openbible","text":"But I am poor and needy; may the Lord think of me. You are my helper and deliverer; O my God, do not delay.","from":1},{"book":"PSA","chapter":71,"verse":12,"verseEnd":12,"votes":8,"source":"both","text":"Be not far from me, O God. Hurry, O my God, to help me.","from":1},{"book":"PSA","chapter":143,"verse":7,"verseEnd":7,"votes":8,"source":"both","text":"Answer me quickly, O LORD; my spirit fails. Do not hide Your face from me, or I will be like those who descend to the Pit.","from":1},{"book":"PSA","chapter":38,"verse":1,"verseEnd":1,"votes":7,"source":"both","text":"O LORD, do not rebuke me in Your anger or discipline me in Your wrath.","from":1},{"book":"PSA","chapter":35,"verse":4,"verseEnd":4,"votes":6,"source":"both","text":"May those who seek my life be disgraced and put to shame; may those who plan to harm me be driven back and confounded.","from":2},{"book":"PSA","chapter":35,"verse":26,"verseEnd":26,"votes":6,"source":"both","text":"May those who gloat in my distress be ashamed and confounded; may those who exalt themselves over me be clothed in shame and reproach.","from":2},{"book":"PSA","chapter":69,"verse":18,"verseEnd":18,"votes":6,"source":"both","text":"Draw near to my soul and redeem me; ransom me because of my foes.","from":1}],"notes":[],"groups":[]},"4-5":{"people":[],"places":[],"words":[{"base":"H0309","lemma":"אָחַר","tr":"a·char","gloss":"to delay","lang":"h","inPassage":1,"uses":17},{"base":"H2363","lemma":"חוּשׁ","tr":"chush","gloss":"to hasten","lang":"h","inPassage":1,"uses":20},{"base":"H5828","lemma":"עֵ֫זֶר","tr":"e·zer","gloss":"helper","lang":"h","inPassage":1,"uses":21},{"base":"H6403","lemma":"פָּלַט","tr":"pa·lat","gloss":"to escape","lang":"h","inPassage":1,"uses":26},{"base":"H7797","lemma":"שׂוּשׂ","tr":"su·s","gloss":"to rejoice","lang":"h","inPassage":1,"uses":27},{"base":"H0034","lemma":"אֶבְיוֹן","tr":"ev·yon","gloss":"needy","lang":"h","inPassage":1,"uses":61},{"base":"H6041","lemma":"עָנִי","tr":"a·ni","gloss":"afflicted","lang":"h","inPassage":1,"uses":74},{"base":"H3444","lemma":"יְשׁוּעָה","tr":"ye·shu·ah","gloss":"salvation","lang":"h","inPassage":1,"uses":78},{"base":"H8548","lemma":"תָּמִיד","tr":"ta·mid","gloss":"continually","lang":"h","inPassage":1,"uses":104},{"base":"H1431","lemma":"גָּדַל","tr":"ga·dal","gloss":"to magnify","lang":"h","inPassage":1,"uses":117}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":40,"verse":17,"verseEnd":17,"votes":12,"source":"both","text":"But I am poor and needy; may the Lord think of me. You are my helper and deliverer; O my God, do not delay.","from":5},{"book":"PSA","chapter":141,"verse":1,"verseEnd":1,"votes":11,"source":"both","text":"I call upon You, O LORD; come quickly to me. Hear my voice when I call to You.","from":5},{"book":"LAM","chapter":3,"verse":25,"verseEnd":25,"votes":9,"source":"both","text":"The LORD is good to those who wait for Him, to the soul who seeks Him.","from":4},{"book":"PSA","chapter":40,"verse":16,"verseEnd":16,"votes":8,"source":"both","text":"May all who seek You rejoice and be glad in You; may those who love Your salvation always say, “The LORD be magnified!”","from":4},{"book":"PSA","chapter":69,"verse":29,"verseEnd":29,"votes":8,"source":"both","text":"But I am in pain and distress; let Your salvation protect me, O God.","from":5},{"book":"PSA","chapter":35,"verse":27,"verseEnd":27,"votes":6,"source":"both","text":"May those who favor my vindication shout for joy and gladness; may they always say, “Exalted be the LORD who delights in His servantʼs well-being.”","from":4},{"book":"HEB","chapter":10,"verse":37,"verseEnd":37,"votes":6,"source":"both","text":"For, “In just a little while, He who is coming will come and will not delay.","from":5},{"book":"REV","chapter":22,"verse":20,"verseEnd":20,"votes":6,"source":"both","text":"He who testifies to these things says, “Yes, I am coming soon.” Amen. Come, Lord Jesus!","from":5}],"notes":[],"groups":[]}}