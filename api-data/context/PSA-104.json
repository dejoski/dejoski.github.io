{"1-9":{"people":[],"places":[],"words":[{"base":"H1077","lemma":"בַּל","tr":"bal","gloss":"not","lang":"h","inPassage":3,"uses":73},{"base":"H3245","lemma":"יָסַד","tr":"ya·sad","gloss":"to found","lang":"h","inPassage":2,"uses":43},{"base":"H3680","lemma":"כָּסָה","tr":"ka·sah","gloss":"to cover","lang":"h","inPassage":2,"uses":152},{"base":"H7307","lemma":"רוּחַ","tr":"ru·ach","gloss":"spirit","lang":"h","inPassage":2,"uses":378},{"base":"H2022","lemma":"הַר","tr":"har","gloss":"mountain: mount","lang":"h","inPassage":2,"uses":546},{"base":"H4325","lemma":"מַי","tr":"ma·yim","gloss":"water","lang":"h","inPassage":2,"uses":581},{"base":"H7760","lemma":"שׂוּם","tr":"sum","gloss":"to set: make","lang":"h","inPassage":2,"uses":585},{"base":"H7482","lemma":"רַ֫עַם","tr":"ra·am","gloss":"thunder","lang":"h","inPassage":1,"uses":6},{"base":"H2648","lemma":"חָפַז","tr":"cha·phaz","gloss":"to hurry","lang":"h","inPassage":1,"uses":9},{"base":"H3857","lemma":"לָהַט","tr":"la·hat","gloss":"to kindle","lang":"h","inPassage":1,"uses":11}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":26,"verse":7,"verseEnd":7,"votes":13,"source":"both","text":"He stretches out the north over empty space; He hangs the earth upon nothing.","from":5},{"book":"HEB","chapter":1,"verse":7,"verseEnd":7,"votes":13,"source":"both","text":"Now about the angels He says: “He makes His angels winds, His servants flames of fire.”","from":4},{"book":"PSA","chapter":103,"verse":22,"verseEnd":22,"votes":12,"source":"both","text":"Bless the LORD, all His works in all places of His dominion. Bless the LORD, O my soul!","from":1},{"book":"PSA","chapter":24,"verse":2,"verseEnd":2,"votes":10,"source":"both","text":"For He has founded it upon the seas and established it upon the waters.","from":5},{"book":"PSA","chapter":145,"verse":3,"verseEnd":3,"votes":10,"source":"both","text":"Great is the LORD and greatly to be praised; His greatness is unsearchable.","from":1},{"book":"GEN","chapter":7,"verse":19,"verseEnd":19,"votes":9,"source":"both","text":"Finally, the waters completely prevailed upon the earth, so that all the high mountains under all the heavens were covered.","from":6},{"book":"2KI","chapter":2,"verse":11,"verseEnd":11,"votes":9,"source":"both","text":"As they were walking along and talking together, suddenly a chariot of fire with horses of fire appeared and separated the two of them, and Elijah went up into heaven in a whirlwind.","from":4},{"book":"JOB","chapter":38,"verse":10,"verseEnd":10,"votes":9,"source":"openbible","text":"when I fixed its boundaries and set in place its bars and doors,","from":9}],"notes":[],"groups":[]},"10-18":{"people":[],"places":[{"id":"lebanon-h3844g","name":"Lebanon","kind":"place","brief":"","count":1,"firstVerse":16}],"words":[{"base":"H2022","lemma":"הַר","tr":"har","gloss":"mountain: mount","lang":"h","inPassage":3,"uses":546},{"base":"H8248","lemma":"שָׁקָה","tr":"sha·qah","gloss":"to water: watering","lang":"h","inPassage":2,"uses":61},{"base":"H7646","lemma":"שָׂבֵעַ","tr":"sa·va","gloss":"to satisfy","lang":"h","inPassage":2,"uses":97},{"base":"H3824","lemma":"לֵבָב","tr":"le·vav","gloss":"heart","lang":"h","inPassage":2,"uses":252},{"base":"H3899","lemma":"לֶ֫חֶם","tr":"le·chem","gloss":"food","lang":"h","inPassage":2,"uses":298},{"base":"H0996","lemma":"בַּ֫יִן","tr":"ba·yin","gloss":"between","lang":"h","inPassage":2,"uses":407},{"base":"H3277","lemma":"יָעֵל","tr":"ya·el","gloss":"Wildgoats'","lang":"h","inPassage":1,"uses":3},{"base":"H7077","lemma":"קִנֵּן","tr":"qa·nan","gloss":"to make a nest","lang":"h","inPassage":1,"uses":5},{"base":"H0582","lemma":"אֱנוֹשׁ","tr":"e·nosh","gloss":"human","lang":"h","inPassage":2,"uses":565},{"base":"H2624","lemma":"חֲסִידָה","tr":"cha·si·dah","gloss":"stork","lang":"h","inPassage":1,"uses":6}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":23,"verse":5,"verseEnd":5,"votes":13,"source":"both","text":"You prepare a table before me in the presence of my enemies. You anoint my head with oil; my cup overflows.","from":15},{"book":"JOB","chapter":28,"verse":5,"verseEnd":5,"votes":9,"source":"both","text":"Food may come from the earth, but from below it is transformed as by fire.","from":14},{"book":"PSA","chapter":136,"verse":25,"verseEnd":25,"votes":9,"source":"both","text":"He gives food to every creature. His loving devotion endures forever.","from":14},{"book":"PSA","chapter":147,"verse":8,"verseEnd":8,"votes":9,"source":"openbible","text":"who covers the sky with clouds, who prepares rain for the earth, who makes grass to grow on the hills.","from":14},{"book":"PSA","chapter":147,"verse":9,"verseEnd":9,"votes":9,"source":"openbible","text":"He provides food for the animals, and for the young ravens when they call.","from":14},{"book":"ECC","chapter":9,"verse":7,"verseEnd":7,"votes":9,"source":"both","text":"Go, eat your bread with joy, and drink your wine with a cheerful heart, for God has already approved your works:","from":15},{"book":"ECC","chapter":10,"verse":19,"verseEnd":19,"votes":9,"source":"both","text":"A feast is prepared for laughter, and wine makes life merry, but money is the answer for everything.","from":15},{"book":"PSA","chapter":147,"verse":8,"verseEnd":8,"votes":8,"source":"both","text":"who covers the sky with clouds, who prepares rain for the earth, who makes grass to grow on the hills.","from":13}],"notes":[],"groups":[]},"19-26":{"people":[],"places":[],"words":[{"base":"H8121","lemma":"שֶׁ֫מֶשׁ","tr":"she·mesh","gloss":"sun","lang":"h","inPassage":2,"uses":134},{"base":"H2416","lemma":"חַי","tr":"chay","gloss":"alive","lang":"h","inPassage":2,"uses":498},{"base":"H1419","lemma":"גָּדוֹל","tr":"ga·dol","gloss":"great: large","lang":"h","inPassage":2,"uses":526},{"base":"H3882","lemma":"לִוְיָתָן","tr":"liv·ya·tan","gloss":"Leviathan","lang":"h","inPassage":1,"uses":6},{"base":"H4585","lemma":"מְעֹנָה","tr":"me·o·nah","gloss":"habitation","lang":"h","inPassage":1,"uses":9},{"base":"H7075","lemma":"קִנְיָן","tr":"qin·yan","gloss":"acquisition","lang":"h","inPassage":1,"uses":10},{"base":"H8033","lemma":"שָׁם","tr":"sham","gloss":"there","lang":"h","inPassage":2,"uses":834},{"base":"H7430","lemma":"רָמַשׂ","tr":"ra·ma·s","gloss":"to creep","lang":"h","inPassage":1,"uses":17},{"base":"H7431","lemma":"רֶ֫מֶשׂ","tr":"re·me·s","gloss":"creeping","lang":"h","inPassage":1,"uses":17},{"base":"H2224","lemma":"זָרַח","tr":"za·rach","gloss":"to rise","lang":"h","inPassage":1,"uses":18}],"parallels":[],"crossrefs":[{"book":"JER","chapter":10,"verse":12,"verseEnd":12,"votes":13,"source":"both","text":"The LORD made the earth by His power; He established the world by His wisdom and stretched out the heavens by His understanding.","from":24},{"book":"PSA","chapter":40,"verse":5,"verseEnd":5,"votes":11,"source":"both","text":"Many, O LORD my God, are the wonders You have done, and the plans You have for us— none can compare to You— if I proclaim and declare them, they are more than I can count.","from":24},{"book":"PSA","chapter":50,"verse":10,"verseEnd":10,"votes":10,"source":"openbible","text":"for every beast of the forest is Mine— the cattle on a thousand hills.","from":24},{"book":"PSA","chapter":50,"verse":12,"verseEnd":12,"votes":10,"source":"openbible","text":"If I were hungry, I would not tell you, for the world is Mine, and the fullness thereof.","from":24},{"book":"ROM","chapter":11,"verse":33,"verseEnd":33,"votes":10,"source":"both","text":"O, the depth of the riches of the wisdom and knowledge of God! How unsearchable are His judgments, and untraceable His ways!","from":24},{"book":"EPH","chapter":3,"verse":10,"verseEnd":10,"votes":9,"source":"both","text":"His purpose was that now, through the church, the manifold wisdom of God should be made known to the rulers and authorities in the heavenly realms,","from":24},{"book":"GEN","chapter":1,"verse":14,"verseEnd":14,"votes":8,"source":"openbible","text":"And God said, “Let there be lights in the expanse of the sky to distinguish between the day and the night, and let them be signs to mark the seasons and days and years.","from":19},{"book":"GEN","chapter":1,"verse":18,"verseEnd":18,"votes":8,"source":"openbible","text":"to preside over the day and the night, and to separate the light from the darkness. And God saw that it was good.","from":19}],"notes":[],"groups":[]},"27-30":{"people":[],"places":[],"words":[{"base":"H7307","lemma":"רוּחַ","tr":"ru·ach","gloss":"spirit","lang":"h","inPassage":2,"uses":378},{"base":"H7663","lemma":"שָׂבַר","tr":"sa·var","gloss":"to inspect","lang":"h","inPassage":1,"uses":8},{"base":"H2318","lemma":"חָדַשׁ","tr":"cha·dash","gloss":"to renew","lang":"h","inPassage":1,"uses":10},{"base":"H1478","lemma":"גָּוַע","tr":"ga·va","gloss":"to die","lang":"h","inPassage":1,"uses":24},{"base":"H3950","lemma":"לָקַט","tr":"la·qat","gloss":"to gather","lang":"h","inPassage":1,"uses":37},{"base":"H0926","lemma":"בָּהַל","tr":"ba·hal","gloss":"to dismay","lang":"h","inPassage":1,"uses":39},{"base":"H0400","lemma":"אֹ֫כֶל","tr":"o·khel","gloss":"food","lang":"h","inPassage":1,"uses":43},{"base":"H1254","lemma":"בָּרָא","tr":"ba·ra","gloss":"to create","lang":"h","inPassage":1,"uses":55},{"base":"H5641","lemma":"סָתַר","tr":"sa·tar","gloss":"to hide","lang":"h","inPassage":1,"uses":81},{"base":"H7646","lemma":"שָׂבֵעַ","tr":"sa·va","gloss":"to satisfy","lang":"h","inPassage":1,"uses":97}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":33,"verse":4,"verseEnd":4,"votes":15,"source":"both","text":"The Spirit of God has made me, and the breath of the Almighty gives me life.","from":30},{"book":"JOB","chapter":34,"verse":14,"verseEnd":14,"votes":8,"source":"openbible","text":"If He were to set His heart to it and withdraw His Spirit and breath,","from":29},{"book":"JOB","chapter":34,"verse":15,"verseEnd":15,"votes":8,"source":"openbible","text":"all flesh would perish together and mankind would return to the dust.","from":29},{"book":"PSA","chapter":136,"verse":25,"verseEnd":25,"votes":8,"source":"both","text":"He gives food to every creature. His loving devotion endures forever.","from":27},{"book":"PSA","chapter":147,"verse":9,"verseEnd":9,"votes":8,"source":"both","text":"He provides food for the animals, and for the young ravens when they call.","from":27},{"book":"ECC","chapter":12,"verse":7,"verseEnd":7,"votes":8,"source":"both","text":"before the dust returns to the ground from which it came and the spirit returns to God who gave it.","from":29},{"book":"EZK","chapter":37,"verse":9,"verseEnd":9,"votes":8,"source":"both","text":"Then He said to me, “Prophesy to the breath; prophesy, son of man, and tell the breath that this is what the Lord GOD says: Come from the four winds, O breath, and breathe into these slain, so that they may live!”","from":30},{"book":"JOB","chapter":26,"verse":13,"verseEnd":13,"votes":7,"source":"both","text":"By His breath the skies were cleared; His hand pierced the fleeing serpent.","from":30}],"notes":[],"groups":[]},"31-35":{"people":[],"places":[],"words":[{"base":"H8055","lemma":"שָׂמַח","tr":"sa·mach","gloss":"to rejoice","lang":"h","inPassage":2,"uses":155},{"base":"H7460","lemma":"רָעַד","tr":"ra·ad","gloss":"to tremble","lang":"h","inPassage":1,"uses":3},{"base":"H5750","lemma":"עוֹד","tr":"od","gloss":"still","lang":"h","inPassage":2,"uses":490},{"base":"H6225","lemma":"עָשַׁן","tr":"a·shan","gloss":"be angry","lang":"h","inPassage":1,"uses":6},{"base":"H6149","lemma":"עָרַב","tr":"a·rev","gloss":"to please","lang":"h","inPassage":1,"uses":8},{"base":"H7879","lemma":"שִׂיחַ","tr":"si·ach","gloss":"complaint","lang":"h","inPassage":1,"uses":14},{"base":"H2400","lemma":"חַטָּא","tr":"chat·ta","gloss":"sinner","lang":"h","inPassage":1,"uses":19},{"base":"H2167","lemma":"זָמַר","tr":"za·mar","gloss":"to sing","lang":"h","inPassage":1,"uses":45},{"base":"H3050","lemma":"יָהּ","tr":"yah","gloss":"LORD","lang":"h","inPassage":1,"uses":48},{"base":"H8552","lemma":"תָּמַם","tr":"ta·mam","gloss":"to finish","lang":"h","inPassage":1,"uses":63}],"parallels":[],"crossrefs":[{"book":"HAB","chapter":3,"verse":17,"verseEnd":17,"votes":16,"source":"openbible","text":"Though the fig tree does not bud and no fruit is on the vines, though the olive crop fails and the fields produce no food, though the sheep are cut off from the fold and no cattle are in the stalls,","from":34},{"book":"HAB","chapter":3,"verse":18,"verseEnd":18,"votes":16,"source":"openbible","text":"yet I will exult in the LORD; I will rejoice in the God of my salvation!","from":34},{"book":"PHP","chapter":4,"verse":4,"verseEnd":4,"votes":15,"source":"both","text":"Rejoice in the Lord always. I will say it again: Rejoice!","from":34},{"book":"PSA","chapter":1,"verse":2,"verseEnd":2,"votes":14,"source":"both","text":"But his delight is in the Law of the LORD, and on His law he meditates day and night.","from":34},{"book":"PSA","chapter":63,"verse":4,"verseEnd":4,"votes":13,"source":"both","text":"So I will bless You as long as I live; in Your name I will lift my hands.","from":33},{"book":"PSA","chapter":119,"verse":15,"verseEnd":15,"votes":13,"source":"openbible","text":"I will meditate on Your precepts and regard Your ways.","from":34},{"book":"PSA","chapter":119,"verse":16,"verseEnd":16,"votes":13,"source":"openbible","text":"I will delight in Your statutes; I will not forget Your word.","from":34},{"book":"PSA","chapter":119,"verse":127,"verseEnd":127,"votes":13,"source":"openbible","text":"Therefore I love Your commandments more than gold, even the purest gold.","from":34}],"notes":[],"groups":[]}}