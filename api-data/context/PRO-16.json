{"1-7":{"people":[],"places":[],"words":[{"base":"H4617","lemma":"מַעֲנֶה","tr":"ma·a·neh","gloss":"answer","lang":"h","inPassage":2,"uses":7},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":2,"uses":595},{"base":"H7451","lemma":"רַע","tr":"ra","gloss":"bad: harmful","lang":"h","inPassage":2,"uses":661},{"base":"H1870","lemma":"דֶּ֫רֶךְ","tr":"de·rekh","gloss":"way: conduct","lang":"h","inPassage":2,"uses":706},{"base":"H1571","lemma":"גַּם","tr":"gam","gloss":"also","lang":"h","inPassage":2,"uses":769},{"base":"H2134","lemma":"זַךְ","tr":"zakh","gloss":"pure","lang":"h","inPassage":1,"uses":11},{"base":"H1556","lemma":"גָּלַל","tr":"ga·lal","gloss":"to roll","lang":"h","inPassage":1,"uses":18},{"base":"H8505","lemma":"תָּכַן","tr":"ta·khan","gloss":"to measure","lang":"h","inPassage":1,"uses":18},{"base":"H1364","lemma":"גָּבֹהַּ","tr":"ga·vo·ah","gloss":"high","lang":"h","inPassage":1,"uses":41},{"base":"H5352","lemma":"נָקָה","tr":"na·qah","gloss":"to clear","lang":"h","inPassage":1,"uses":44}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":37,"verse":4,"verseEnd":4,"votes":232,"source":"openbible","text":"Delight yourself in the LORD, and He will give you the desires of your heart.","from":3},{"book":"PSA","chapter":37,"verse":5,"verseEnd":5,"votes":232,"source":"openbible","text":"Commit your way to the LORD; trust in Him, and He will do it.","from":3},{"book":"PRO","chapter":3,"verse":6,"verseEnd":6,"votes":186,"source":"openbible","text":"in all your ways acknowledge Him, and He will make your paths straight.","from":3},{"book":"PSA","chapter":55,"verse":22,"verseEnd":22,"votes":149,"source":"both","text":"Cast your burden upon the LORD and He will sustain you; He will never let the righteous be shaken.","from":3},{"book":"PHP","chapter":4,"verse":6,"verseEnd":6,"votes":129,"source":"both","text":"Be anxious for nothing, but in everything, by prayer and petition, with thanksgiving, present your requests to God.","from":3},{"book":"1PE","chapter":5,"verse":7,"verseEnd":7,"votes":118,"source":"both","text":"Cast all your anxiety on Him, because He cares for you.","from":3},{"book":"JOB","chapter":5,"verse":8,"verseEnd":8,"votes":93,"source":"both","text":"However, if I were you, I would appeal to God and lay my cause before Him—","from":3},{"book":"JOB","chapter":22,"verse":28,"verseEnd":28,"votes":91,"source":"both","text":"Your decisions will be carried out, and light will shine on your ways.","from":3}],"notes":[],"groups":[]},"8-15":{"people":[],"places":[],"words":[{"base":"H4941","lemma":"מִשְׁפָּט","tr":"mish·pat","gloss":"justice: judgement","lang":"h","inPassage":3,"uses":422},{"base":"H7522","lemma":"רָצוֹן","tr":"ra·tson","gloss":"acceptance","lang":"h","inPassage":2,"uses":56},{"base":"H6666","lemma":"צְדָקָה","tr":"tse·da·qah","gloss":"righteousness","lang":"h","inPassage":2,"uses":157},{"base":"H8193","lemma":"שָׂפָה","tr":"sa·phah","gloss":"lips","lang":"h","inPassage":2,"uses":176},{"base":"H3559","lemma":"כּוּן","tr":"kun","gloss":"to establish: prepare","lang":"h","inPassage":2,"uses":217},{"base":"H6425","lemma":"פֶּ֫לֶס","tr":"pe·les","gloss":"balance","lang":"h","inPassage":1,"uses":2},{"base":"H3599","lemma":"כִּיס","tr":"kis","gloss":"purse","lang":"h","inPassage":1,"uses":5},{"base":"H4456","lemma":"מַלְקוֹשׁ","tr":"mal·qosh","gloss":"spring rain","lang":"h","inPassage":1,"uses":8},{"base":"H7081","lemma":"קֶ֫סֶם","tr":"qe·sem","gloss":"divination","lang":"h","inPassage":1,"uses":11},{"base":"H6806","lemma":"צַ֫עַד","tr":"tsa·ad","gloss":"step","lang":"h","inPassage":1,"uses":14}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":19,"verse":21,"verseEnd":21,"votes":127,"source":"both","text":"Many plans are in a manʼs heart, but the purpose of the LORD will prevail.","from":9},{"book":"PSA","chapter":37,"verse":23,"verseEnd":23,"votes":96,"source":"both","text":"The steps of a man are ordered by the LORD who takes delight in his journey.","from":9},{"book":"PRO","chapter":16,"verse":1,"verseEnd":1,"votes":90,"source":"both","text":"The plans of the heart belong to man, but the reply of the tongue is from the LORD.","from":9},{"book":"PRO","chapter":20,"verse":24,"verseEnd":24,"votes":84,"source":"both","text":"A manʼs steps are from the LORD, so how can anyone understand his own way?","from":9},{"book":"JER","chapter":10,"verse":23,"verseEnd":23,"votes":76,"source":"both","text":"I know, O LORD, that a manʼs way is not his own; no one who walks directs his own steps.","from":9},{"book":"PRO","chapter":21,"verse":30,"verseEnd":30,"votes":49,"source":"both","text":"There is no wisdom, no understanding, no counsel that can prevail against the LORD.","from":9},{"book":"ISA","chapter":46,"verse":10,"verseEnd":10,"votes":44,"source":"both","text":"I declare the end from the beginning, and from ancient times what is still to come. I say, ‘My purpose will stand, and all My good pleasure I will accomplish.’","from":9},{"book":"PSA","chapter":37,"verse":16,"verseEnd":16,"votes":15,"source":"both","text":"Better is the little of the righteous than the abundance of many who are wicked.","from":8}],"notes":[],"groups":[]},"16-24":{"people":[],"places":[],"words":[{"base":"H3948","lemma":"לֶ֫קַח","tr":"le·qach","gloss":"teaching","lang":"h","inPassage":2,"uses":9},{"base":"H2896","lemma":"טוֹב","tr":"tov","gloss":"pleasant","lang":"h","inPassage":3,"uses":538},{"base":"H7919","lemma":"שָׂכַל","tr":"sa·khal","gloss":"be prudent","lang":"h","inPassage":2,"uses":62},{"base":"H7069","lemma":"קָנָה","tr":"qa·nah","gloss":"to buy","lang":"h","inPassage":2,"uses":84},{"base":"H2450","lemma":"חָכָם","tr":"cha·kham","gloss":"wise","lang":"h","inPassage":2,"uses":138},{"base":"H8193","lemma":"שָׂפָה","tr":"sa·phah","gloss":"lips","lang":"h","inPassage":2,"uses":176},{"base":"H3254","lemma":"יָסַף","tr":"ya·saph","gloss":"to add: again","lang":"h","inPassage":2,"uses":212},{"base":"H4986","lemma":"מֶ֫תֶק","tr":"me·teq","gloss":"sweetness","lang":"h","inPassage":1,"uses":2},{"base":"H6688","lemma":"צוּף","tr":"tsuph","gloss":"honeycomb","lang":"h","inPassage":1,"uses":2},{"base":"H7307","lemma":"רוּחַ","tr":"ru·ach","gloss":"spirit","lang":"h","inPassage":2,"uses":378}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":11,"verse":2,"verseEnd":2,"votes":38,"source":"both","text":"When pride comes, disgrace follows, but with humility comes wisdom.","from":18},{"book":"ISA","chapter":2,"verse":11,"verseEnd":11,"votes":25,"source":"openbible","text":"The proud look of man will be humbled, and the loftiness of men brought low; the LORD alone will be exalted in that day.","from":18},{"book":"ISA","chapter":2,"verse":12,"verseEnd":12,"votes":25,"source":"openbible","text":"For the Day of the LORD of Hosts will come against all the proud and lofty, against all that is exalted— it will be humbled—","from":18},{"book":"PRO","chapter":12,"verse":18,"verseEnd":18,"votes":23,"source":"both","text":"Speaking rashly is like a piercing sword, but the tongue of the wise brings healing.","from":24},{"book":"PRO","chapter":18,"verse":12,"verseEnd":12,"votes":21,"source":"both","text":"Before his downfall a manʼs heart is proud, but humility comes before honor.","from":18},{"book":"PRO","chapter":24,"verse":13,"verseEnd":13,"votes":20,"source":"openbible","text":"Eat honey, my son, for it is good, and the honeycomb is sweet to your taste.","from":24},{"book":"PRO","chapter":24,"verse":14,"verseEnd":14,"votes":20,"source":"openbible","text":"Know therefore that wisdom is sweet to your soul. If you find it, there is a future for you, and your hope will never be cut off.","from":24},{"book":"OBA","chapter":1,"verse":3,"verseEnd":3,"votes":17,"source":"openbible","text":"The pride of your heart has deceived you, O dwellers in the clefts of the rocks whose habitation is the heights, who say in your heart, ‘Who can bring me down to the ground?’","from":18}],"notes":[],"groups":[]},"25-33":{"people":[],"places":[],"words":[{"base":"H1870","lemma":"דֶּ֫רֶךְ","tr":"de·rekh","gloss":"way: conduct","lang":"h","inPassage":4,"uses":706},{"base":"H8419","lemma":"תַּהְפֻּכָה","tr":"tah·pu·khah","gloss":"perversity","lang":"h","inPassage":2,"uses":10},{"base":"H8193","lemma":"שָׂפָה","tr":"sa·phah","gloss":"lips","lang":"h","inPassage":2,"uses":176},{"base":"H6867","lemma":"צָרָב","tr":"tsa·tav","gloss":"burning","lang":"h","inPassage":1,"uses":3},{"base":"H2896","lemma":"טוֹב","tr":"tov","gloss":"pleasant","lang":"h","inPassage":2,"uses":538},{"base":"H7169","lemma":"קָרַץ","tr":"qa·rats","gloss":"to wink","lang":"h","inPassage":1,"uses":5},{"base":"H7279","lemma":"רָגַן","tr":"ra·gan","gloss":"to grumble","lang":"h","inPassage":1,"uses":7},{"base":"H7451","lemma":"רַע","tr":"ra","gloss":"bad: harmful","lang":"h","inPassage":2,"uses":661},{"base":"H6001","lemma":"עָמֵל","tr":"a·mel","gloss":"labour(er)","lang":"h","inPassage":1,"uses":9},{"base":"H4066","lemma":"מָדוֹן","tr":"ma·don","gloss":"strife","lang":"h","inPassage":1,"uses":10}],"parallels":[],"crossrefs":[{"book":"JAS","chapter":1,"verse":19,"verseEnd":19,"votes":30,"source":"both","text":"My beloved brothers, understand this: Everyone should be quick to listen, slow to speak, and slow to anger,","from":32},{"book":"PRO","chapter":15,"verse":18,"verseEnd":18,"votes":28,"source":"both","text":"A hot-tempered man stirs up strife, but he who is slow to anger calms dispute.","from":32},{"book":"PRO","chapter":25,"verse":28,"verseEnd":28,"votes":27,"source":"both","text":"Like a city whose walls are broken down is a man who does not control his temper.","from":32},{"book":"PRO","chapter":14,"verse":29,"verseEnd":29,"votes":23,"source":"both","text":"A patient man has great understanding, but a quick-tempered man promotes folly.","from":32},{"book":"PRO","chapter":19,"verse":11,"verseEnd":11,"votes":22,"source":"both","text":"A manʼs insight gives him patience, and his virtue is to overlook an offense.","from":32},{"book":"ROM","chapter":12,"verse":21,"verseEnd":21,"votes":22,"source":"both","text":"Do not be overcome by evil, but overcome evil with good.","from":32},{"book":"PSA","chapter":103,"verse":8,"verseEnd":8,"votes":17,"source":"both","text":"The LORD is compassionate and gracious, slow to anger, abounding in loving devotion.","from":32},{"book":"PRO","chapter":14,"verse":12,"verseEnd":12,"votes":14,"source":"both","text":"There is a way that seems right to a man, but its end is the way of death.","from":25}],"notes":[],"groups":[]}}