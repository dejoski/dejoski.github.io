{"1-4":{"people":[],"places":[],"words":[{"base":"H4712","lemma":"מֵצַר","tr":"me·tsar","gloss":"terror","lang":"h","inPassage":1,"uses":3},{"base":"H4672","lemma":"מָצָא","tr":"ma·tsa","gloss":"to find","lang":"h","inPassage":2,"uses":455},{"base":"H0661","lemma":"אָפַף","tr":"a·phaph","gloss":"to surround","lang":"h","inPassage":1,"uses":5},{"base":"H7121","lemma":"קָרָא","tr":"qa·ra","gloss":"to call: call to","lang":"h","inPassage":2,"uses":733},{"base":"H0577","lemma":"אָֽנָּ֫א","tr":"an·na","gloss":"Please!","lang":"h","inPassage":1,"uses":13},{"base":"H3015","lemma":"יָגוֹן","tr":"ya·gon","gloss":"sorrow","lang":"h","inPassage":1,"uses":14},{"base":"H8469","lemma":"תַּחֲנוּן","tr":"ta·cha·nun","gloss":"supplication","lang":"h","inPassage":1,"uses":18},{"base":"H2256","lemma":"חֶ֫בֶל","tr":"che·vel","gloss":"Mahalab","lang":"h","inPassage":1,"uses":62},{"base":"H7585","lemma":"שְׁאוֹל","tr":"she·ol","gloss":"hell: Sheol","lang":"h","inPassage":1,"uses":66},{"base":"H6869","lemma":"בַּצָּרָה","tr":"bats·tsa·rah","gloss":"dearth","lang":"h","inPassage":1,"uses":73}],"parallels":[],"crossrefs":[{"book":"1JN","chapter":4,"verse":19,"verseEnd":19,"votes":29,"source":"both","text":"We love because He first loved us.","from":1},{"book":"PSA","chapter":66,"verse":19,"verseEnd":19,"votes":23,"source":"openbible","text":"But God has surely heard; He has attended to the sound of my prayer.","from":1},{"book":"PSA","chapter":66,"verse":20,"verseEnd":20,"votes":23,"source":"openbible","text":"Blessed be God, who has not rejected my prayer or withheld from me His loving devotion!","from":1},{"book":"PSA","chapter":145,"verse":18,"verseEnd":18,"votes":15,"source":"openbible","text":"The LORD is near to all who call on Him, to all who call out to Him in truth.","from":2},{"book":"PSA","chapter":145,"verse":19,"verseEnd":19,"votes":15,"source":"openbible","text":"He fulfills the desires of those who fear Him; He hears their cry and saves them.","from":2},{"book":"JHN","chapter":16,"verse":24,"verseEnd":24,"votes":14,"source":"both","text":"Until now you have not asked for anything in My name. Ask and you will receive, so that your joy may be complete.","from":1},{"book":"1JN","chapter":5,"verse":2,"verseEnd":2,"votes":13,"source":"openbible","text":"By this we know that we love the children of God: when we love God and keep His commandments.","from":1},{"book":"1JN","chapter":5,"verse":3,"verseEnd":3,"votes":13,"source":"openbible","text":"For this is the love of God, that we keep His commandments. And His commandments are not burdensome,","from":1}],"notes":[],"groups":[]},"5-11":{"people":[],"places":[],"words":[{"base":"H1762","lemma":"דְּחִי","tr":"de·chi","gloss":"falling","lang":"h","inPassage":1,"uses":2},{"base":"H1809","lemma":"דָּלַל","tr":"da·lal","gloss":"to languish","lang":"h","inPassage":1,"uses":9},{"base":"H2648","lemma":"חָפַז","tr":"cha·phaz","gloss":"to hurry","lang":"h","inPassage":1,"uses":9},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":2,"uses":754},{"base":"H0589","lemma":"אֲנִי","tr":"a·ni","gloss":"I","lang":"h","inPassage":2,"uses":874},{"base":"H2587","lemma":"חַנּוּן","tr":"chan·nun","gloss":"gracious","lang":"h","inPassage":1,"uses":13},{"base":"H3576","lemma":"כָּזַב","tr":"ka·zav","gloss":"to lie","lang":"h","inPassage":1,"uses":16},{"base":"H6612","lemma":"פֶּ֫תִי","tr":"pe·ti","gloss":"simple","lang":"h","inPassage":1,"uses":19},{"base":"H4496","lemma":"מְנוּחָה","tr":"me·nu·chah","gloss":"Nohah","lang":"h","inPassage":1,"uses":22},{"base":"H1832","lemma":"דִּמְעָה","tr":"dim·ah","gloss":"tears","lang":"h","inPassage":1,"uses":23}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":56,"verse":13,"verseEnd":13,"votes":18,"source":"both","text":"For You have delivered my soul from death, and my feet from stumbling, that I may walk before God in the light of life.","from":8},{"book":"2CO","chapter":4,"verse":13,"verseEnd":13,"votes":15,"source":"both","text":"And in keeping with what is written: “I believed, therefore I have spoken,” we who have the same spirit of faith also believe and therefore speak,","from":10},{"book":"REV","chapter":21,"verse":4,"verseEnd":4,"votes":14,"source":"both","text":"‘He will wipe away every tear from their eyes,’ and there will be no more death or mourning or crying or pain, for the former things have passed away.”","from":8},{"book":"PSA","chapter":13,"verse":6,"verseEnd":6,"votes":11,"source":"both","text":"I will sing to the LORD, for He has been good to me.","from":7},{"book":"PSA","chapter":19,"verse":7,"verseEnd":7,"votes":9,"source":"both","text":"The Law of the LORD is perfect, reviving the soul; the testimony of the LORD is trustworthy, making wise the simple.","from":6},{"book":"PSA","chapter":86,"verse":13,"verseEnd":13,"votes":9,"source":"both","text":"For great is Your loving devotion to me; You have delivered me from the depths of Sheol.","from":8},{"book":"PSA","chapter":142,"verse":6,"verseEnd":6,"votes":9,"source":"both","text":"Listen to my cry, for I am brought quite low. Rescue me from my pursuers, for they are too strong for me.","from":6},{"book":"HEB","chapter":11,"verse":1,"verseEnd":1,"votes":9,"source":"both","text":"Now faith is the assurance of what we hope for and the certainty of what we do not see.","from":10}],"notes":[],"groups":[]},"12-19":{"people":[],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":19}],"words":[{"base":"H5088","lemma":"נֶ֫דֶר","tr":"ne·der","gloss":"vow","lang":"h","inPassage":2,"uses":60},{"base":"H7999","lemma":"שָׁלֵם","tr":"sa·lem","gloss":"to complete","lang":"h","inPassage":2,"uses":116},{"base":"H5048","lemma":"נֶ֫גֶד","tr":"ne·ged","gloss":"before","lang":"h","inPassage":2,"uses":151},{"base":"H4994","lemma":"נָא","tr":"na","gloss":"please","lang":"h","inPassage":2,"uses":404},{"base":"H7121","lemma":"קָרָא","tr":"qa·ra","gloss":"to call: call to","lang":"h","inPassage":2,"uses":733},{"base":"H5650","lemma":"עֶ֫בֶד","tr":"e·ved","gloss":"servant","lang":"h","inPassage":2,"uses":800},{"base":"H4147","lemma":"מוֹסֵר","tr":"mo·ser","gloss":"bond","lang":"h","inPassage":1,"uses":11},{"base":"H8034","lemma":"שֵׁם","tr":"shem","gloss":"name","lang":"h","inPassage":2,"uses":864},{"base":"H0589","lemma":"אֲנִי","tr":"a·ni","gloss":"I","lang":"h","inPassage":2,"uses":874},{"base":"H0577","lemma":"אָֽנָּ֫א","tr":"an·na","gloss":"Please!","lang":"h","inPassage":1,"uses":13}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":72,"verse":14,"verseEnd":14,"votes":24,"source":"both","text":"He will redeem them from oppression and violence, for their blood is precious in his sight.","from":15},{"book":"PSA","chapter":103,"verse":2,"verseEnd":2,"votes":22,"source":"both","text":"Bless the LORD, O my soul, and do not forget all His kind deeds—","from":12},{"book":"1CO","chapter":6,"verse":20,"verseEnd":20,"votes":21,"source":"both","text":"you were bought at a price. Therefore glorify God with your body.","from":12},{"book":"ROM","chapter":12,"verse":1,"verseEnd":1,"votes":15,"source":"both","text":"Therefore I urge you, brothers, on account of Godʼs mercy, to offer your bodies as living sacrifices, holy and pleasing to God, which is your spiritual service of worship.","from":12},{"book":"2CO","chapter":5,"verse":14,"verseEnd":14,"votes":15,"source":"openbible","text":"For Christʼs love compels us, because we are convinced that One died for all, therefore all died.","from":12},{"book":"2CO","chapter":5,"verse":15,"verseEnd":15,"votes":15,"source":"openbible","text":"And He died for all, that those who live should no longer live for themselves, but for Him who died for them and was raised again.","from":12},{"book":"PSA","chapter":86,"verse":16,"verseEnd":16,"votes":13,"source":"both","text":"Turn to me and have mercy; grant Your strength to Your servant; save the son of Your maidservant.","from":16},{"book":"2CH","chapter":32,"verse":25,"verseEnd":25,"votes":12,"source":"openbible","text":"But because his heart was proud, Hezekiah did not repay the favor shown to him. Therefore wrath came upon him and upon Judah and Jerusalem.","from":12}],"notes":[],"groups":[]}}