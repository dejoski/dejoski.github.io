{"1-3":{"people":[{"id":"achish-h0397","name":"Achish","kind":"person","brief":"Philistine king","count":1,"firstVerse":1},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H6035","lemma":"עָנָו","tr":"a·nav","gloss":"poor","lang":"h","inPassage":1,"uses":22},{"base":"H8416","lemma":"תְּהִלָּה","tr":"te·hil·lah","gloss":"praise","lang":"h","inPassage":1,"uses":57},{"base":"H8548","lemma":"תָּמִיד","tr":"ta·mid","gloss":"continually","lang":"h","inPassage":1,"uses":104},{"base":"H1431","lemma":"גָּדַל","tr":"ga·dal","gloss":"to magnify","lang":"h","inPassage":1,"uses":117},{"base":"H3162","lemma":"יַ֫חַד","tr":"ya·chad","gloss":"unitedness","lang":"h","inPassage":1,"uses":141},{"base":"H8055","lemma":"שָׂמַח","tr":"sa·mach","gloss":"to rejoice","lang":"h","inPassage":1,"uses":155},{"base":"H1984","lemma":"הָלַל","tr":"ha·lal","gloss":"to shine","lang":"h","inPassage":1,"uses":165},{"base":"H7311","lemma":"רוּם","tr":"rum","gloss":"to exalt","lang":"h","inPassage":1,"uses":190},{"base":"H6256","lemma":"עֵת","tr":"et","gloss":"time","lang":"h","inPassage":1,"uses":296},{"base":"H1288","lemma":"בָּרַךְ","tr":"ba·rakh","gloss":"to bless","lang":"h","inPassage":1,"uses":330}],"parallels":[],"crossrefs":[{"book":"1TH","chapter":5,"verse":18,"verseEnd":18,"votes":68,"source":"both","text":"Give thanks in every circumstance, for this is Godʼs will for you in Christ Jesus.","from":1},{"book":"COL","chapter":3,"verse":17,"verseEnd":17,"votes":50,"source":"both","text":"And whatever you do, in word or deed, do it all in the name of the Lord Jesus, giving thanks to God the Father through Him.","from":1},{"book":"PSA","chapter":69,"verse":30,"verseEnd":30,"votes":48,"source":"both","text":"I will praise Godʼs name in song and exalt Him with thanksgiving.","from":3},{"book":"PSA","chapter":145,"verse":1,"verseEnd":1,"votes":43,"source":"openbible","text":"I will exalt You, my God and King; I will bless Your name forever and ever.","from":1},{"book":"PSA","chapter":145,"verse":2,"verseEnd":2,"votes":43,"source":"openbible","text":"Every day I will bless You, and I will praise Your name forever and ever.","from":1},{"book":"EPH","chapter":5,"verse":20,"verseEnd":20,"votes":37,"source":"both","text":"always giving thanks to God the Father for everything in the name of our Lord Jesus Christ.","from":1},{"book":"LUK","chapter":1,"verse":46,"verseEnd":46,"votes":36,"source":"both","text":"Then Mary said: “My soul magnifies the Lord,","from":3},{"book":"PSA","chapter":148,"verse":1,"verseEnd":1,"votes":29,"source":"openbible","text":"Hallelujah! Praise the LORD from the heavens; praise Him in the highest places.","from":3}],"notes":[],"groups":[]},"4-7":{"people":[],"places":[],"words":[{"base":"H4034","lemma":"מְגוֹרָה","tr":"me·go·rah","gloss":"fear","lang":"h","inPassage":1,"uses":2},{"base":"H5102","lemma":"נָהַר","tr":"na·har","gloss":"to flow","lang":"h","inPassage":1,"uses":6},{"base":"H2659","lemma":"חָפֵר","tr":"cha·pher","gloss":"be ashamed","lang":"h","inPassage":1,"uses":17},{"base":"H2502","lemma":"חָלַץ","tr":"cha·lats","gloss":"to rescue","lang":"h","inPassage":1,"uses":44},{"base":"H3373","lemma":"יָרֵא","tr":"ya·re","gloss":"afraid","lang":"h","inPassage":1,"uses":64},{"base":"H5027","lemma":"נָבַט","tr":"na·vat","gloss":"to look","lang":"h","inPassage":1,"uses":69},{"base":"H6869","lemma":"בַּצָּרָה","tr":"bats·tsa·rah","gloss":"dearth","lang":"h","inPassage":1,"uses":73},{"base":"H6041","lemma":"עָנִי","tr":"a·ni","gloss":"afflicted","lang":"h","inPassage":1,"uses":74},{"base":"H2583","lemma":"חָנָה","tr":"cha·nah","gloss":"to camp","lang":"h","inPassage":1,"uses":143},{"base":"H1875","lemma":"דָּרַשׁ","tr":"da·rash","gloss":"to seek","lang":"h","inPassage":1,"uses":164}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":18,"verse":6,"verseEnd":6,"votes":142,"source":"both","text":"In my distress I called upon the LORD; I cried to my God for help. From His temple He heard my voice, and my cry for His help reached His ears.","from":4},{"book":"MAT","chapter":7,"verse":7,"verseEnd":7,"votes":102,"source":"both","text":"Ask, and it will be given to you; seek, and you will find; knock, and the door will be opened to you.","from":4},{"book":"PSA","chapter":116,"verse":1,"verseEnd":1,"votes":100,"source":"openbible","text":"I love the LORD, for He has heard my voice— my appeal for mercy.","from":4},{"book":"PSA","chapter":116,"verse":6,"verseEnd":6,"votes":100,"source":"openbible","text":"The LORD preserves the simplehearted; I was helpless, and He saved me.","from":4},{"book":"PSA","chapter":56,"verse":3,"verseEnd":3,"votes":90,"source":"both","text":"When I am afraid, I put my trust in You.","from":4},{"book":"2TI","chapter":1,"verse":7,"verseEnd":7,"votes":80,"source":"both","text":"For God has not given us a spirit of fear, but of power, love, and self-control.","from":4},{"book":"JON","chapter":2,"verse":2,"verseEnd":2,"votes":61,"source":"both","text":"saying: “In my distress I called to the LORD, and He answered me. From the belly of Sheol I called for help, and You heard my voice.","from":4},{"book":"ISA","chapter":12,"verse":2,"verseEnd":2,"votes":58,"source":"both","text":"Surely God is my salvation; I will trust and not be afraid. For the LORD GOD is my strength and my song, and He also has become my salvation.”","from":4}],"notes":[],"groups":[]},"8-10":{"people":[],"places":[],"words":[{"base":"H2938","lemma":"טָעַם","tr":"ta·am","gloss":"to perceive","lang":"h","inPassage":1,"uses":11},{"base":"H4270","lemma":"מַחְסוֹר","tr":"mach·sor","gloss":"need","lang":"h","inPassage":1,"uses":13},{"base":"H7456","lemma":"רָעֵב","tr":"ra·ev","gloss":"be hungry","lang":"h","inPassage":1,"uses":13},{"base":"H2637","lemma":"חָסֵר","tr":"cha·ser","gloss":"to lack","lang":"h","inPassage":1,"uses":23},{"base":"H7326","lemma":"רוּשׁ","tr":"rush","gloss":"be poor","lang":"h","inPassage":1,"uses":24},{"base":"H3715","lemma":"כְּפִיר","tr":"ke·phir","gloss":"lion","lang":"h","inPassage":1,"uses":32},{"base":"H2620","lemma":"חָסָה","tr":"cha·sah","gloss":"to seek refuge","lang":"h","inPassage":1,"uses":37},{"base":"H0835","lemma":"אֶ֫שֶׁר","tr":"e·sher","gloss":"blessed","lang":"h","inPassage":1,"uses":45},{"base":"H2895","lemma":"טוֹב","tr":"tov","gloss":"be pleasing","lang":"h","inPassage":1,"uses":45},{"base":"H3373","lemma":"יָרֵא","tr":"ya·re","gloss":"afraid","lang":"h","inPassage":1,"uses":64}],"parallels":[],"crossrefs":[{"book":"HEB","chapter":6,"verse":4,"verseEnd":4,"votes":111,"source":"openbible","text":"It is impossible for those who have once been enlightened, who have tasted the heavenly gift, who have shared in the Holy Spirit,","from":8},{"book":"HEB","chapter":6,"verse":5,"verseEnd":5,"votes":111,"source":"openbible","text":"who have tasted the goodness of the word of God and the powers of the coming age—","from":8},{"book":"PSA","chapter":119,"verse":103,"verseEnd":103,"votes":107,"source":"both","text":"How sweet are Your words to my taste— sweeter than honey in my mouth!","from":8},{"book":"1PE","chapter":2,"verse":2,"verseEnd":2,"votes":105,"source":"openbible","text":"Like newborn babies, crave pure spiritual milk, so that by it you may grow up in your salvation,","from":8},{"book":"1PE","chapter":2,"verse":3,"verseEnd":3,"votes":105,"source":"openbible","text":"now that you have tasted that the Lord is good.","from":8},{"book":"JER","chapter":31,"verse":14,"verseEnd":14,"votes":57,"source":"both","text":"I will fill the souls of the priests abundantly, and will fill My people with My goodness,” declares the LORD.","from":8},{"book":"PSA","chapter":63,"verse":5,"verseEnd":5,"votes":53,"source":"both","text":"My soul is satisfied as with the richest of foods; with joyful lips my mouth will praise You.","from":8},{"book":"PSA","chapter":84,"verse":11,"verseEnd":11,"votes":51,"source":"both","text":"For the LORD God is a sun and a shield; the LORD gives grace and glory; He withholds no good thing from those who walk with integrity.","from":10}],"notes":[],"groups":[]},"11-14":{"people":[],"places":[],"words":[{"base":"H2896","lemma":"טוֹב","tr":"tov","gloss":"pleasant","lang":"h","inPassage":2,"uses":538},{"base":"H7451","lemma":"רַע","tr":"ra","gloss":"bad: harmful","lang":"h","inPassage":2,"uses":661},{"base":"H2655","lemma":"חָפֵץ","tr":"cha·phets","gloss":"delighting","lang":"h","inPassage":1,"uses":12},{"base":"H4820","lemma":"מִרְמָה","tr":"mir·mah","gloss":"deceit","lang":"h","inPassage":1,"uses":39},{"base":"H3374","lemma":"יִרְאָה","tr":"yir·ah","gloss":"fear","lang":"h","inPassage":1,"uses":45},{"base":"H5341","lemma":"נָצַר","tr":"na·tsar","gloss":"to watch","lang":"h","inPassage":1,"uses":63},{"base":"H3925","lemma":"לָמַד","tr":"la·mad","gloss":"to learn: teach","lang":"h","inPassage":1,"uses":86},{"base":"H3956","lemma":"לָשׁוֹן","tr":"la·shon","gloss":"tongue","lang":"h","inPassage":1,"uses":117},{"base":"H7291","lemma":"רָדַף","tr":"ra·daph","gloss":"to pursue","lang":"h","inPassage":1,"uses":143},{"base":"H8193","lemma":"שָׂפָה","tr":"sa·phah","gloss":"lips","lang":"h","inPassage":1,"uses":176}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":37,"verse":27,"verseEnd":27,"votes":134,"source":"both","text":"Turn away from evil and do good, so that you will abide forever.","from":14},{"book":"HEB","chapter":12,"verse":14,"verseEnd":14,"votes":49,"source":"both","text":"Pursue peace with everyone, as well as holiness, without which no one will see the Lord.","from":14},{"book":"1PE","chapter":3,"verse":11,"verseEnd":11,"votes":44,"source":"both","text":"He must turn from evil and do good; he must seek peace and pursue it.","from":14},{"book":"3JN","chapter":1,"verse":11,"verseEnd":11,"votes":26,"source":"both","text":"Beloved, do not imitate what is evil, but what is good. The one who does good is of God; the one who does evil has not seen God.","from":14},{"book":"PRO","chapter":3,"verse":7,"verseEnd":7,"votes":19,"source":"both","text":"Be not wise in your own eyes; fear the LORD and turn away from evil.","from":14},{"book":"ROM","chapter":12,"verse":18,"verseEnd":18,"votes":15,"source":"both","text":"If it is possible on your part, live at peace with everyone.","from":14},{"book":"PRO","chapter":1,"verse":7,"verseEnd":7,"votes":14,"source":"both","text":"The fear of the LORD is the beginning of knowledge, but fools despise wisdom and discipline.","from":11},{"book":"JAS","chapter":3,"verse":5,"verseEnd":5,"votes":14,"source":"openbible","text":"In the same way, the tongue is a small part of the body, but it boasts of great things. Consider how small a spark sets a great forest ablaze.","from":13}],"notes":[],"groups":[]},"15-22":{"people":[],"places":[],"words":[{"base":"H6662","lemma":"צַדִּיק","tr":"tsad·diq","gloss":"righteous","lang":"h","inPassage":3,"uses":206},{"base":"H0816","lemma":"אָשַׁם","tr":"a·sham","gloss":"be guilty","lang":"h","inPassage":2,"uses":35},{"base":"H7451","lemma":"רַע","tr":"ra","gloss":"bad: harmful","lang":"h","inPassage":3,"uses":661},{"base":"H7665","lemma":"שָׁבַר","tr":"sha·var","gloss":"to break","lang":"h","inPassage":2,"uses":147},{"base":"H5337","lemma":"נָצַל","tr":"na·tsal","gloss":"to rescue","lang":"h","inPassage":2,"uses":213},{"base":"H1793","lemma":"דַּכָּא","tr":"dak·ka","gloss":"contrite","lang":"h","inPassage":1,"uses":3},{"base":"H7775","lemma":"שַׁוְעָה","tr":"shav·ah","gloss":"cry","lang":"h","inPassage":1,"uses":11},{"base":"H2143","lemma":"זֵ֫כֶר","tr":"ze·kher","gloss":"memorial","lang":"h","inPassage":1,"uses":23},{"base":"H2620","lemma":"חָסָה","tr":"cha·sah","gloss":"to seek refuge","lang":"h","inPassage":1,"uses":37},{"base":"H9039","lemma":"הֶן","tr":"hen","gloss":"them","lang":"h","inPassage":1,"uses":54}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":147,"verse":3,"verseEnd":3,"votes":113,"source":"both","text":"He heals the brokenhearted and binds up their wounds.","from":18},{"book":"PSA","chapter":145,"verse":18,"verseEnd":18,"votes":87,"source":"both","text":"The LORD is near to all who call on Him, to all who call out to Him in truth.","from":18},{"book":"ISA","chapter":57,"verse":15,"verseEnd":15,"votes":71,"source":"both","text":"For thus says the One who is high and lifted up, who inhabits eternity, whose name is Holy: “I dwell in a high and holy place, and with the oppressed and humble in spirit, to restore the spirit of the lowly and revive the heart of the contrite.","from":18},{"book":"1PE","chapter":3,"verse":12,"verseEnd":12,"votes":56,"source":"both","text":"For the eyes of the Lord are on the righteous, and His ears are inclined to their prayer. But the face of the Lord is against those who do evil.”","from":15},{"book":"ISA","chapter":61,"verse":1,"verseEnd":1,"votes":51,"source":"both","text":"The Spirit of the Lord GOD is on Me, because the LORD has anointed Me to preach good news to the poor. He has sent Me to bind up the brokenhearted, to proclaim liberty to the captives and freedom to the prisoners,","from":18},{"book":"1PE","chapter":4,"verse":12,"verseEnd":12,"votes":49,"source":"openbible","text":"Beloved, do not be surprised at the fiery trial that has come upon you, as though something strange were happening to you.","from":19},{"book":"1PE","chapter":4,"verse":13,"verseEnd":13,"votes":49,"source":"openbible","text":"But rejoice that you share in the sufferings of Christ, so that you may be overjoyed at the revelation of His glory.","from":19},{"book":"PSA","chapter":51,"verse":17,"verseEnd":17,"votes":47,"source":"both","text":"The sacrifices of God are a broken spirit; a broken and a contrite heart, O God, You will not despise.","from":18}],"notes":[{"id":"ps-34-20","title":"Not one of his bones will be broken","kind":"prophecy"}],"groups":[]}}