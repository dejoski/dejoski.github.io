{"1-6":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1},{"id":"saul-h7586g","name":"Saul","kind":"person","brief":"King of Israel,","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H2620","lemma":"חָסָה","tr":"cha·sah","gloss":"to seek refuge","lang":"h","inPassage":2,"uses":37},{"base":"H5542","lemma":"סֶ֫לָה","tr":"se·lah","gloss":"Selah","lang":"h","inPassage":2,"uses":74},{"base":"H2603","lemma":"חָנַן","tr":"cha·nan","gloss":"be gracious","lang":"h","inPassage":2,"uses":78},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":3,"uses":754},{"base":"H7882","lemma":"שִׁיחָה","tr":"shi·chah","gloss":"pit","lang":"h","inPassage":1,"uses":2},{"base":"H8432","lemma":"תָּ֫וֶךְ","tr":"ta·vekh","gloss":"midst","lang":"h","inPassage":2,"uses":418},{"base":"H8064","lemma":"שָׁמַיִם","tr":"sha·ma·yim","gloss":"heaven","lang":"h","inPassage":2,"uses":421},{"base":"H2299","lemma":"חַד","tr":"chad","gloss":"sharp","lang":"h","inPassage":1,"uses":4},{"base":"H1584","lemma":"גָּמַר","tr":"ga·mar","gloss":"to cease","lang":"h","inPassage":1,"uses":5},{"base":"H3721","lemma":"כָּפַף","tr":"ka·phaph","gloss":"to bend","lang":"h","inPassage":1,"uses":5}],"parallels":[],"crossrefs":[{"book":"HAB","chapter":2,"verse":14,"verseEnd":14,"votes":149,"source":"both","text":"For the earth will be filled with the knowledge of the glory of the LORD as the waters cover the sea.","from":5},{"book":"ISA","chapter":6,"verse":3,"verseEnd":3,"votes":123,"source":"both","text":"And they were calling out to one another: “Holy, holy, holy is the LORD of Hosts; all the earth is full of His glory.”","from":5},{"book":"PSA","chapter":72,"verse":19,"verseEnd":19,"votes":105,"source":"both","text":"And blessed be His glorious name forever; may all the earth be filled with His glory. Amen and amen.","from":5},{"book":"NUM","chapter":14,"verse":21,"verseEnd":21,"votes":100,"source":"both","text":"“Yet as surely as I live and as surely as the whole earth is filled with the glory of the LORD,","from":5},{"book":"PSA","chapter":57,"verse":11,"verseEnd":11,"votes":93,"source":"both","text":"Be exalted, O God, above the heavens; may Your glory cover all the earth.","from":5},{"book":"PSA","chapter":108,"verse":4,"verseEnd":4,"votes":83,"source":"openbible","text":"For Your loving devotion extends beyond the heavens, and Your faithfulness reaches to the clouds.","from":5},{"book":"PSA","chapter":108,"verse":5,"verseEnd":5,"votes":83,"source":"openbible","text":"Be exalted, O God, above the heavens; may Your glory cover all the earth.","from":5},{"book":"PSA","chapter":113,"verse":4,"verseEnd":4,"votes":75,"source":"openbible","text":"The LORD is exalted over all the nations, His glory above the heavens.","from":5}],"notes":[],"groups":[{"id":"kings-prophets","title":"Kings, prophets and the house of David","people":2}]},"7-11":{"people":[],"places":[],"words":[{"base":"H5782","lemma":"עוּר","tr":"ur","gloss":"to rouse","lang":"h","inPassage":3,"uses":80},{"base":"H2167","lemma":"זָמַר","tr":"za·mar","gloss":"to sing","lang":"h","inPassage":2,"uses":45},{"base":"H3519","lemma":"כָּבוֹד","tr":"ka·vod","gloss":"glory","lang":"h","inPassage":2,"uses":200},{"base":"H3559","lemma":"כּוּן","tr":"kun","gloss":"to establish: prepare","lang":"h","inPassage":2,"uses":217},{"base":"H8064","lemma":"שָׁמַיִם","tr":"sha·ma·yim","gloss":"heaven","lang":"h","inPassage":2,"uses":421},{"base":"H3820","lemma":"לֵב","tr":"lev","gloss":"heart","lang":"h","inPassage":2,"uses":595},{"base":"H0523","lemma":"אֻמָּה","tr":"um·mah","gloss":"people","lang":"h","inPassage":1,"uses":7},{"base":"H7834","lemma":"שַׁ֫חַק","tr":"sha·chaq","gloss":"cloud","lang":"h","inPassage":1,"uses":21},{"base":"H7837","lemma":"שַׁ֫חַר","tr":"sha·char","gloss":"dawn","lang":"h","inPassage":1,"uses":24},{"base":"H5035","lemma":"נֵ֫בֶל","tr":"ne·vel","gloss":"bag","lang":"h","inPassage":1,"uses":38}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":112,"verse":7,"verseEnd":7,"votes":13,"source":"both","text":"He does not fear bad news; his heart is steadfast, trusting in the LORD.","from":7},{"book":"PSA","chapter":103,"verse":11,"verseEnd":11,"votes":12,"source":"both","text":"For as high as the heavens are above the earth, so great is His loving devotion for those who fear Him.","from":10},{"book":"PSA","chapter":108,"verse":4,"verseEnd":4,"votes":12,"source":"both","text":"For Your loving devotion extends beyond the heavens, and Your faithfulness reaches to the clouds.","from":10},{"book":"PSA","chapter":36,"verse":5,"verseEnd":5,"votes":11,"source":"both","text":"Your loving devotion, O LORD, reaches to the heavens, Your faithfulness to the clouds.","from":10},{"book":"PSA","chapter":34,"verse":4,"verseEnd":4,"votes":10,"source":"both","text":"I sought the LORD, and He answered me; He delivered me from all my fears.","from":7},{"book":"ISA","chapter":54,"verse":7,"verseEnd":7,"votes":9,"source":"openbible","text":"“For a brief moment I forsook you, but with great compassion I will bring you back.","from":10},{"book":"ISA","chapter":54,"verse":10,"verseEnd":10,"votes":9,"source":"openbible","text":"Though the mountains may be removed and the hills may be shaken, My loving devotion will not depart from you, and My covenant of peace will not be broken,” says the LORD, who has compassion on you.","from":10},{"book":"EPH","chapter":5,"verse":20,"verseEnd":20,"votes":9,"source":"both","text":"always giving thanks to God the Father for everything in the name of our Lord Jesus Christ.","from":7}],"notes":[],"groups":[]}}