{"1-6":{"people":[{"id":"ezra-h5830g","name":"Ezra","kind":"person","brief":"Returned priest","count":4,"firstVerse":1},{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":3,"firstVerse":1},{"id":"elam-h5867b","name":"Elam","kind":"person","brief":"Returned from exile","count":1,"firstVerse":2},{"id":"jehiel-h3171o","name":"Jehiel","kind":"person","brief":"Returned divorcee","count":1,"firstVerse":2},{"id":"shecaniah-h7935l","name":"Shecaniah","kind":"person","brief":"Returned divorcee","count":1,"firstVerse":2},{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":1,"firstVerse":5},{"id":"eliashib-h0475i","name":"Eliashib","kind":"person","brief":"Returned priest","count":1,"firstVerse":6},{"id":"jehohanan-h3076m","name":"Jehohanan","kind":"person","brief":"Returned priest","count":1,"firstVerse":6}],"places":[],"words":[{"base":"H5830","lemma":"עֶזְרָא","tr":"ez·ra","gloss":"Ezra","lang":"h","inPassage":4,"uses":22},{"base":"H6965","lemma":"קָמָי","tr":"qa·may","gloss":"(Leb)-kamai","lang":"h","inPassage":3,"uses":628},{"base":"H0802","lemma":"אִשָּׁה","tr":"ish·shah","gloss":"woman","lang":"h","inPassage":3,"uses":781},{"base":"H1058","lemma":"בָּכָה","tr":"ba·khah","gloss":"to weep","lang":"h","inPassage":2,"uses":114},{"base":"H0587","lemma":"אֲנַ֫חְנוּ","tr":"a·nach·nu","gloss":"we","lang":"h","inPassage":2,"uses":120},{"base":"H7650","lemma":"שָׁבַע","tr":"sha·va","gloss":"to swear","lang":"h","inPassage":2,"uses":186},{"base":"H6258","lemma":"עַתָּ֫ה","tr":"at·tah","gloss":"now","lang":"h","inPassage":2,"uses":433},{"base":"H2730","lemma":"חָרֵד","tr":"cha·red","gloss":"trembling","lang":"h","inPassage":1,"uses":6},{"base":"H7935","lemma":"שְׁכַנְיָהוּ","tr":"she·khan·yah","gloss":"Shecaniah","lang":"h","inPassage":1,"uses":10},{"base":"H3076","lemma":"יְהוֹחָנָן","tr":"ye·ho·cha·nan","gloss":"Johanan","lang":"h","inPassage":1,"uses":11}],"parallels":[],"crossrefs":[{"book":"1CH","chapter":28,"verse":10,"verseEnd":10,"votes":10,"source":"both","text":"Consider now that the LORD has chosen you to build a house for the sanctuary. Be strong and do it.”","from":4},{"book":"DAN","chapter":9,"verse":20,"verseEnd":20,"votes":10,"source":"both","text":"While I was speaking, praying, confessing my sin and that of my people Israel, and presenting my petition before the LORD my God concerning His holy mountain—","from":1},{"book":"ECC","chapter":9,"verse":10,"verseEnd":10,"votes":9,"source":"both","text":"Whatever you find to do with your hands, do it with all your might, for in Sheol, where you are going, there is no work or planning or knowledge or wisdom.","from":4},{"book":"DEU","chapter":7,"verse":2,"verseEnd":2,"votes":8,"source":"openbible","text":"and when the LORD your God has delivered them over to you to defeat them, then you must devote them to complete destruction. Make no treaty with them and show them no mercy.","from":3},{"book":"DEU","chapter":7,"verse":3,"verseEnd":3,"votes":8,"source":"openbible","text":"Do not intermarry with them. Do not give your daughters to their sons or take their daughters for your sons,","from":3},{"book":"1CH","chapter":22,"verse":19,"verseEnd":19,"votes":8,"source":"both","text":"Now set your heart and soul to seek the LORD your God. Begin building the sanctuary of the LORD God, so that you may bring the ark of the covenant of the LORD and the holy articles of God into the temple that will be built for the Name of the LORD.”","from":4},{"book":"HEB","chapter":10,"verse":24,"verseEnd":24,"votes":8,"source":"both","text":"And let us consider how to spur one another on to love and good deeds.","from":4},{"book":"HEB","chapter":12,"verse":12,"verseEnd":12,"votes":8,"source":"openbible","text":"Therefore strengthen your limp hands and weak knees.","from":4}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":2}]},"7-15":{"people":[{"id":"judah-h3063g","name":"Judah","kind":"person","brief":"Son of Israel","count":2,"firstVerse":7},{"id":"benjamin-h1144g","name":"Benjamin","kind":"person","brief":"Son of Israel","count":1,"firstVerse":9},{"id":"ezra-h5830g","name":"Ezra","kind":"person","brief":"Returned priest","count":1,"firstVerse":10},{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":1,"firstVerse":10},{"id":"asahel-h6214j","name":"Asahel","kind":"person","brief":"Ezra's opponent","count":1,"firstVerse":15},{"id":"jahzeiah-h3167","name":"Jahzeiah","kind":"person","brief":"Ezra's opponent","count":1,"firstVerse":15},{"id":"jonathan-h3129i","name":"Jonathan","kind":"person","brief":"Ezra's opponents","count":1,"firstVerse":15},{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":1,"firstVerse":15},{"id":"meshullam-h4918p","name":"Meshullam","kind":"person","brief":"Ezra's opponent","count":1,"firstVerse":15},{"id":"shabbethai-h7678g","name":"Shabbethai","kind":"person","brief":"Ezra's opponent","count":1,"firstVerse":15},{"id":"tikvah-h8616h","name":"Tikvah","kind":"person","brief":"Ezra's opponent","count":1,"firstVerse":15}],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":2,"firstVerse":7}],"words":[{"base":"H5237","lemma":"נׇכְרִי","tr":"nokh·ri","gloss":"foreign","lang":"h","inPassage":3,"uses":45},{"base":"H6951","lemma":"קָהָל","tr":"qa·hal","gloss":"assembly","lang":"h","inPassage":3,"uses":123},{"base":"H1653","lemma":"גֶּ֫שֶׁם","tr":"ge·shem","gloss":"rain","lang":"h","inPassage":2,"uses":35},{"base":"H0914","lemma":"בָּדַל","tr":"ba·dal","gloss":"to separate","lang":"h","inPassage":2,"uses":42},{"base":"H1473","lemma":"גּוֹלָה","tr":"go·lah","gloss":"captivity","lang":"h","inPassage":2,"uses":43},{"base":"H5975","lemma":"עָמַד","tr":"a·mad","gloss":"to stand: stand","lang":"h","inPassage":3,"uses":521},{"base":"H3389","lemma":"יְרוּשָׁלִַ֫ם, יְרוּשְׁלֵם","tr":"ye·ru·sha·laim","gloss":"Jerusalem","lang":"h","inPassage":3,"uses":643},{"base":"H0802","lemma":"אִשָּׁה","tr":"ish·shah","gloss":"woman","lang":"h","inPassage":3,"uses":781},{"base":"H6908","lemma":"קָבַץ","tr":"qa·vats","gloss":"to gather","lang":"h","inPassage":2,"uses":127},{"base":"H3427","lemma":"יָשַׁב","tr":"ya·shav","gloss":"to dwell","lang":"h","inPassage":3,"uses":1079}],"parallels":[],"crossrefs":[{"book":"2CH","chapter":29,"verse":10,"verseEnd":10,"votes":6,"source":"both","text":"Now it is in my heart to make a covenant with the LORD, the God of Israel, so that His fierce anger will turn away from us.","from":14},{"book":"2CH","chapter":30,"verse":8,"verseEnd":8,"votes":6,"source":"both","text":"Now do not stiffen your necks as your fathers did. Submit to the LORD and come to His sanctuary, which He has consecrated forever. Serve the LORD your God, so that His fierce anger will turn away from you.","from":14},{"book":"LEV","chapter":26,"verse":40,"verseEnd":42,"votes":0,"source":"tsk","text":"But if they will confess their iniquity and that of their fathers in the unfaithfulness that they practiced against Me, by which they have also walked in hostility toward Me— and I acted with hostility toward them and brought them into the land of their enemies—and if their uncircumcised hearts will be humbled and they will make amends for their iniquity, then I will remember My covenant with Jacob and My covenant with Isaac and My covenant with Abraham, and I will remember the land.","from":11},{"book":"LEV","chapter":27,"verse":28,"verseEnd":28,"votes":0,"source":"tsk","text":"Nothing that a man sets apart to the LORD from all he owns—whether a man, an animal, or his inherited land—can be sold or redeemed; everything so devoted is most holy to the LORD.","from":8},{"book":"NUM","chapter":25,"verse":4,"verseEnd":4,"votes":0,"source":"tsk","text":"Then the LORD said to Moses, “Take all the leaders of the people and execute them in broad daylight before the LORD, so that His fierce anger may turn away from Israel.”","from":14},{"book":"NUM","chapter":32,"verse":14,"verseEnd":14,"votes":0,"source":"tsk","text":"Now behold, you, a brood of sinners, have risen up in place of your fathers to further stoke the burning anger of the LORD against Israel.","from":10},{"book":"DEU","chapter":7,"verse":3,"verseEnd":4,"votes":0,"source":"tsk","text":"Do not intermarry with them. Do not give your daughters to their sons or take their daughters for your sons, because they will turn your sons away from following Me to serve other gods. Then the anger of the LORD will burn against you, and He will swiftly destroy you.","from":11},{"book":"DEU","chapter":13,"verse":17,"verseEnd":17,"votes":0,"source":"tsk","text":"Nothing devoted to destruction shall cling to your hands, so that the LORD will turn from His fierce anger, grant you mercy, show you compassion, and multiply you as He swore to your fathers,","from":14}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":4}]},"16-17":{"people":[{"id":"ezra-h5830g","name":"Ezra","kind":"person","brief":"Returned priest","count":1,"firstVerse":16}],"places":[],"words":[{"base":"H2320","lemma":"חֹ֫דֶשׁ","tr":"cho·desh","gloss":"month","lang":"h","inPassage":2,"uses":283},{"base":"H0582","lemma":"אֱנוֹשׁ","tr":"e·nosh","gloss":"human","lang":"h","inPassage":2,"uses":565},{"base":"H0259","lemma":"אֶחָד","tr":"e·chad","gloss":"one","lang":"h","inPassage":2,"uses":970},{"base":"H3427","lemma":"יָשַׁב","tr":"ya·shav","gloss":"to dwell","lang":"h","inPassage":2,"uses":1079},{"base":"H5830","lemma":"עֶזְרָא","tr":"ez·ra","gloss":"Ezra","lang":"h","inPassage":1,"uses":22},{"base":"H6224","lemma":"עֲשִׂירִי","tr":"a·si·ri","gloss":"tenth","lang":"h","inPassage":1,"uses":29},{"base":"H0914","lemma":"בָּדַל","tr":"ba·dal","gloss":"to separate","lang":"h","inPassage":1,"uses":42},{"base":"H1473","lemma":"גּוֹלָה","tr":"go·lah","gloss":"captivity","lang":"h","inPassage":1,"uses":43},{"base":"H5237","lemma":"נׇכְרִי","tr":"nokh·ri","gloss":"foreign","lang":"h","inPassage":1,"uses":45},{"base":"H1875","lemma":"דָּרַשׁ","tr":"da·rash","gloss":"to seek","lang":"h","inPassage":1,"uses":164}],"parallels":[],"crossrefs":[{"book":"DEU","chapter":13,"verse":14,"verseEnd":14,"votes":0,"source":"tsk","text":"then you must inquire, investigate, and interrogate thoroughly. And if it is established with certainty that this abomination has been committed among you,","from":16},{"book":"JOB","chapter":29,"verse":16,"verseEnd":16,"votes":0,"source":"tsk","text":"I was a father to the needy, and I took up the case of the stranger.","from":16},{"book":"JHN","chapter":7,"verse":51,"verseEnd":51,"votes":0,"source":"tsk","text":"“Does our law convict a man without first hearing from him to determine what he has done?”","from":16}],"notes":[],"groups":[]},"18-24":{"people":[{"id":"eliezer-h0461n","name":"Eliezer","kind":"person","brief":"Returned priest","count":1,"firstVerse":18},{"id":"gedaliah-h1436a","name":"Gedaliah","kind":"person","brief":"Returned priest","count":1,"firstVerse":18},{"id":"jarib-h3402h","name":"Jarib","kind":"person","brief":"Returned priest","count":1,"firstVerse":18},{"id":"jeshua-h3442g","name":"Jeshua","kind":"person","brief":"Returned priest","count":1,"firstVerse":18},{"id":"jozadak-h3136g","name":"Jozadak","kind":"person","brief":"Returned priest","count":1,"firstVerse":18},{"id":"maaseiah-h4641l","name":"Maaseiah","kind":"person","brief":"Returned priest","count":1,"firstVerse":18},{"id":"hanani-h2607i","name":"Hanani","kind":"person","brief":"Returned divorcee","count":1,"firstVerse":20},{"id":"immer-h0564h","name":"Immer","kind":"person","brief":"Priestly division","count":1,"firstVerse":20},{"id":"zebadiah-h2069o","name":"Zebadiah","kind":"person","brief":"Returned priest","count":1,"firstVerse":20},{"id":"elijah-h0452i","name":"Elijah","kind":"person","brief":"Returned divorcee","count":1,"firstVerse":21},{"id":"harim-h2766g","name":"Harim","kind":"person","brief":"Priestly division","count":1,"firstVerse":21},{"id":"