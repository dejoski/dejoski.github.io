{"1-4":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H2416","lemma":"חַי","tr":"chay","gloss":"alive","lang":"h","inPassage":2,"uses":498},{"base":"H4285","lemma":"מַחְשָׁךְ","tr":"mach·shakh","gloss":"darkness","lang":"h","inPassage":1,"uses":7},{"base":"H5848","lemma":"עָטַף","tr":"a·taph","gloss":"to turn aside","lang":"h","inPassage":1,"uses":16},{"base":"H1792","lemma":"דָּכָא","tr":"da·kah","gloss":"to crush","lang":"h","inPassage":1,"uses":18},{"base":"H8469","lemma":"תַּחֲנוּן","tr":"ta·cha·nun","gloss":"supplication","lang":"h","inPassage":1,"uses":18},{"base":"H0238","lemma":"אָזַן","tr":"a·zan","gloss":"to listen","lang":"h","inPassage":1,"uses":41},{"base":"H6663","lemma":"צָדֵק","tr":"tsa·daq","gloss":"to justify","lang":"h","inPassage":1,"uses":41},{"base":"H0530","lemma":"אֱמוּנָה","tr":"e·mu·nah","gloss":"faithfulness","lang":"h","inPassage":1,"uses":49},{"base":"H8605","lemma":"תְּפִלָּה","tr":"te·phil·lah","gloss":"prayer","lang":"h","inPassage":1,"uses":77},{"base":"H8074","lemma":"שָׁמֵם","tr":"sha·mem","gloss":"be desolate: destroyed","lang":"h","inPassage":1,"uses":86}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":71,"verse":2,"verseEnd":2,"votes":16,"source":"both","text":"In Your justice, rescue and deliver me; incline Your ear and save me.","from":1},{"book":"ECC","chapter":7,"verse":20,"verseEnd":20,"votes":12,"source":"both","text":"Surely there is no righteous man on earth who does good and never sins.","from":2},{"book":"LAM","chapter":3,"verse":6,"verseEnd":6,"votes":9,"source":"openbible","text":"He has made me dwell in darkness like those dead for ages.","from":3},{"book":"JOB","chapter":25,"verse":4,"verseEnd":4,"votes":8,"source":"both","text":"How then can a man be just before God? How can one born of woman be pure?","from":2},{"book":"PSA","chapter":31,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"In You, O LORD, I have taken refuge; let me never be put to shame; save me by Your righteousness.","from":1},{"book":"ROM","chapter":3,"verse":20,"verseEnd":20,"votes":8,"source":"both","text":"Therefore no one will be justified in His sight by works of the law. For the law merely brings awareness of sin.","from":2},{"book":"PSA","chapter":7,"verse":1,"verseEnd":1,"votes":7,"source":"openbible","text":"O LORD my God, I take refuge in You; save me and deliver me from all my pursuers,","from":3},{"book":"PSA","chapter":7,"verse":2,"verseEnd":2,"votes":7,"source":"openbible","text":"or they will shred my soul like a lion and tear me to pieces with no one to rescue me.","from":3}],"notes":[],"groups":[]},"5-8":{"people":[],"places":[],"words":[{"base":"H9031","lemma":"ךָּ","tr":"ka","gloss":"you","lang":"h","inPassage":2,"uses":727},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":2,"uses":754},{"base":"H2098","lemma":"זוּ","tr":"zu","gloss":"this","lang":"h","inPassage":1,"uses":15},{"base":"H4911","lemma":"מָשַׁל","tr":"ma·shal","gloss":"to liken","lang":"h","inPassage":1,"uses":16},{"base":"H5889","lemma":"עָיֵף","tr":"a·yeph","gloss":"faint","lang":"h","inPassage":1,"uses":17},{"base":"H7878","lemma":"שִׂיחַ","tr":"si·ach","gloss":"to muse","lang":"h","inPassage":1,"uses":20},{"base":"H1897","lemma":"הָגָה","tr":"ha·gah","gloss":"to mutter","lang":"h","inPassage":1,"uses":25},{"base":"H6467","lemma":"פֹּ֫עַל","tr":"po·al","gloss":"work","lang":"h","inPassage":1,"uses":37},{"base":"H0953","lemma":"בּוֹר","tr":"bor","gloss":"pit","lang":"h","inPassage":1,"uses":66},{"base":"H6566","lemma":"פָּרַשׂ","tr":"pa·ra·s","gloss":"to spread","lang":"h","inPassage":1,"uses":67}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":25,"verse":4,"verseEnd":4,"votes":49,"source":"openbible","text":"Show me Your ways, O LORD; teach me Your paths.","from":8},{"book":"PSA","chapter":25,"verse":5,"verseEnd":5,"votes":49,"source":"openbible","text":"Guide me in Your truth and teach me, for You are the God of my salvation; all day long I wait for You.","from":8},{"book":"PRO","chapter":3,"verse":5,"verseEnd":5,"votes":36,"source":"openbible","text":"Trust in the LORD with all your heart, and lean not on your own understanding;","from":8},{"book":"PRO","chapter":3,"verse":6,"verseEnd":6,"votes":36,"source":"openbible","text":"in all your ways acknowledge Him, and He will make your paths straight.","from":8},{"book":"ISA","chapter":48,"verse":17,"verseEnd":17,"votes":30,"source":"both","text":"Thus says the LORD your Redeemer, the Holy One of Israel: “I am the LORD your God, who teaches you for your benefit, who directs you in the way you should go.","from":8},{"book":"PSA","chapter":32,"verse":8,"verseEnd":8,"votes":28,"source":"both","text":"I will instruct you and teach you the way you should go; I will give you counsel and watch over you.","from":8},{"book":"PSA","chapter":46,"verse":5,"verseEnd":5,"votes":28,"source":"both","text":"God is within her; she will not be moved. God will help her when morning dawns.","from":8},{"book":"ISA","chapter":30,"verse":21,"verseEnd":21,"votes":26,"source":"both","text":"And whether you turn to the right or to the left, your ears will hear this command behind you: “This is the way. Walk in it.”","from":8}],"notes":[],"groups":[]},"9-12":{"people":[],"places":[],"words":[{"base":"H0341","lemma":"אֹיֵב","tr":"o·yev","gloss":"enemy","lang":"h","inPassage":2,"uses":282},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":2,"uses":754},{"base":"H6789","lemma":"צָמַת","tr":"tsa·mat","gloss":"to destroy","lang":"h","inPassage":1,"uses":15},{"base":"H4334","lemma":"מִישׁוֹר","tr":"mi·shor","gloss":"plain","lang":"h","inPassage":1,"uses":23},{"base":"H5148","lemma":"נָחָה","tr":"na·chah","gloss":"to lead","lang":"h","inPassage":1,"uses":39},{"base":"H6887","lemma":"צָרַר","tr":"tsa·rar","gloss":"to confine","lang":"h","inPassage":1,"uses":54},{"base":"H7522","lemma":"רָצוֹן","tr":"ra·tson","gloss":"acceptance","lang":"h","inPassage":1,"uses":56},{"base":"H6869","lemma":"בַּצָּרָה","tr":"bats·tsa·rah","gloss":"dearth","lang":"h","inPassage":1,"uses":73},{"base":"H3925","lemma":"לָמַד","tr":"la·mad","gloss":"to learn: teach","lang":"h","inPassage":1,"uses":86},{"base":"H3680","lemma":"כָּסָה","tr":"ka·sah","gloss":"to cover","lang":"h","inPassage":1,"uses":152}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":25,"verse":4,"verseEnd":4,"votes":46,"source":"openbible","text":"Show me Your ways, O LORD; teach me Your paths.","from":10},{"book":"PSA","chapter":25,"verse":5,"verseEnd":5,"votes":46,"source":"openbible","text":"Guide me in Your truth and teach me, for You are the God of my salvation; all day long I wait for You.","from":10},{"book":"JHN","chapter":14,"verse":26,"verseEnd":26,"votes":23,"source":"both","text":"But the Advocate, the Holy Spirit, whom the Father will send in My name, will teach you all things and will remind you of everything I have told you.","from":10},{"book":"HEB","chapter":13,"verse":21,"verseEnd":21,"votes":20,"source":"both","text":"equip you with every good thing to do His will. And may He accomplish in us what is pleasing in His sight through Jesus Christ, to whom be glory forever and ever. Amen.","from":10},{"book":"PSA","chapter":23,"verse":3,"verseEnd":3,"votes":18,"source":"openbible","text":"He restores my soul; He guides me in the paths of righteousness for the sake of His name.","from":10},{"book":"NEH","chapter":9,"verse":20,"verseEnd":20,"votes":16,"source":"both","text":"You gave Your good Spirit to instruct them. You did not withhold Your manna from their mouths, and You gave them water for their thirst.","from":10},{"book":"PSA","chapter":119,"verse":12,"verseEnd":12,"votes":15,"source":"both","text":"Blessed are You, O LORD; teach me Your statutes.","from":10},{"book":"JHN","chapter":16,"verse":13,"verseEnd":13,"votes":13,"source":"openbible","text":"However, when the Spirit of truth comes, He will guide you into all truth. For He will not speak on His own, but He will speak what He hears, and He will declare to you what is to come.","from":10}],"notes":[],"groups":[]}}