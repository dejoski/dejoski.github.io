"","count":1,"firstVerse":37},{"id":"senaah-h5570g","name":"Senaah","kind":"place","brief":"In Benjamin(?)","count":1,"firstVerse":38}],"words":[{"base":"H3967","lemma":"מֵאָה","tr":"me·ah","gloss":"hundred","lang":"h","inPassage":26,"uses":581},{"base":"H8083","lemma":"שְׁמֹנֶה","tr":"she·mo·neh","gloss":"eight","lang":"h","inPassage":9,"uses":109},{"base":"H6242","lemma":"עֶשְׂרִים","tr":"es·rim","gloss":"twenty","lang":"h","inPassage":10,"uses":315},{"base":"H7969","lemma":"שָׁלֹשׁ","tr":"sha·losh","gloss":"three","lang":"h","inPassage":9,"uses":431},{"base":"H0582","lemma":"אֱנוֹשׁ","tr":"e·nosh","gloss":"human","lang":"h","inPassage":8,"uses":565},{"base":"H8147","lemma":"שְׁנַ֫יִם","tr":"she·na·yim","gloss":"two","lang":"h","inPassage":8,"uses":768},{"base":"H8337","lemma":"שֵׁשׁ","tr":"shesh","gloss":"six","lang":"h","inPassage":6,"uses":216},{"base":"H0505","lemma":"אֶ֫לֶף","tr":"e·leph","gloss":"thousand","lang":"h","inPassage":7,"uses":506},{"base":"H0705","lemma":"אַרְבָּעִים","tr":"ar·ba·im","gloss":"forty","lang":"h","inPassage":5,"uses":135},{"base":"H2572","lemma":"חֲמִשִּׁים","tr":"cha·mish·shim","gloss":"fifty","lang":"h","inPassage":5,"uses":163}],"parallels":[],"crossrefs":[{"book":"JOS","chapter":8,"verse":9,"verseEnd":9,"votes":0,"source":"tsk","text":"So Joshua sent them out, and they went to the place of ambush and lay in wait between Bethel and Ai, to the west of Ai. But Joshua spent that night among the people.","from":32},{"book":"JOS","chapter":8,"verse":17,"verseEnd":17,"votes":0,"source":"tsk","text":"Not a man was left in Ai or Bethel who did not go out after Israel, leaving the city wide open while they pursued Israel.","from":32},{"book":"JOS","chapter":9,"verse":17,"verseEnd":17,"votes":0,"source":"tsk","text":"So the Israelites set out and on the third day arrived at their cities—Gibeon, Chephirah, Beeroth, and Kiriath-jearim.","from":29},{"book":"JOS","chapter":18,"verse":24,"verseEnd":25,"votes":0,"source":"tsk","text":"Chephar-ammoni, Ophni, and Geba—twelve cities, along with their villages. Gibeon, Ramah, Beeroth,","from":30},{"book":"JOS","chapter":18,"verse":25,"verseEnd":25,"votes":0,"source":"tsk","text":"Gibeon, Ramah, Beeroth,","from":29},{"book":"JDG","chapter":18,"verse":12,"verseEnd":12,"votes":0,"source":"tsk","text":"They went up and camped at Kiriath-jearim in Judah. That is why the place west of Kiriath-jearim is called Mahaneh-dan to this day.","from":29},{"book":"1SA","chapter":13,"verse":5,"verseEnd":5,"votes":0,"source":"tsk","text":"Now the Philistines assembled to fight against Israel with three thousand chariots, six thousand horsemen, and troops as numerous as the sand on the seashore. They went up and camped at Michmash, east of Beth-aven.","from":31},{"book":"1SA","chapter":13,"verse":23,"verseEnd":23,"votes":0,"source":"tsk","text":"And a garrison of the Philistines had gone out to the pass at Michmash.","from":31}],"notes":[],"groups":[]},"39-60":{"people":[{"id":"jedaiah-h3048h","name":"Jedaiah","kind":"person","brief":"A priest","count":1,"firstVerse":39},{"id":"jeshua-h3442g","name":"Jeshua","kind":"person","brief":"Returned priest","count":1,"firstVerse":39},{"id":"immer-h0564h","name":"Immer","kind":"person","brief":"Priestly division","count":1,"firstVerse":40},{"id":"pashhur-h6583g","name":"Pashhur","kind":"person","brief":"Returned priest","count":1,"firstVerse":41},{"id":"harim-h2766g","name":"Harim","kind":"person","brief":"Priestly division","count":1,"firstVerse":42},{"id":"hodaviah-h1938j","name":"Hodaviah","kind":"person","brief":"Returned from exile","count":1,"firstVerse":43},{"id":"jeshua-h3442j","name":"Jeshua","kind":"person","brief":"Returned leader","count":1,"firstVerse":43},{"id":"kadmiel-h6934","name":"Kadmiel","kind":"person","brief":"Returned from exile","count":1,"firstVerse":43},{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":1,"firstVerse":43},{"id":"asaph-h0623g","name":"Asaph","kind":"person","brief":"