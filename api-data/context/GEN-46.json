-h3437h","name":"Jashub","kind":"person","brief":"Son of Issachar","count":1,"firstVerse":13},{"id":"puah-h6312g","name":"Puah","kind":"person","brief":"Son of Issachar","count":1,"firstVerse":13},{"id":"shimron-h8110b","name":"Shimron","kind":"person","brief":"Son of Issachar","count":1,"firstVerse":13},{"id":"tola-h8439g","name":"Tola","kind":"person","brief":"Son of Issachar","count":1,"firstVerse":13},{"id":"elon-h0356h","name":"Elon","kind":"person","brief":"Son of Zebulun","count":1,"firstVerse":14},{"id":"jahleel-h3177","name":"Jahleel","kind":"person","brief":"Son of Zebulun","count":1,"firstVerse":14},{"id":"sered-h5624","name":"Sered","kind":"person","brief":"Son of Zebulun","count":1,"firstVerse":14},{"id":"zebulun-h2074","name":"Zebulun","kind":"person","brief":"Son of Israel","count":1,"firstVerse":14},{"id":"dinah-h1783","name":"Dinah","kind":"person","brief":"Jacob's daughter","count":1,"firstVerse":15},{"id":"leah-h3812","name":"Leah","kind":"person","brief":"Sister of Rachel","count":1,"firstVerse":15}],"places":[{"id":"egypt-h4714g","name":"Egypt","kind":"place","brief":"","count":1,"firstVerse":8},{"id":"canaan-h3667a","name":"Canaan","kind":"place","brief":"","count":1,"firstVerse":12},{"id":"paddan-h6307","name":"Paddan","kind":"place","brief":"","count":1,"firstVerse":15}],"words":[{"base":"H0209","lemma":"אוֹנָן","tr":"o·nan","gloss":"Onan","lang":"h","inPassage":2,"uses":8},{"base":"H6147","lemma":"עֵר","tr":"er","gloss":"Er","lang":"h","inPassage":2,"uses":10},{"base":"H6557","lemma":"פֶּ֫רֶץ","tr":"pe·rets","gloss":"Perez","lang":"h","inPassage":2,"uses":15},{"base":"H2696","lemma":"חֶצְרוֹן","tr":"chets·ron","gloss":"Hezron","lang":"h","inPassage":2,"uses":18},{"base":"H3290","lemma":"יַעֲקֹב","tr":"ya·a·qov","gloss":"Jacob","lang":"h","inPassage":3,"uses":350},{"base":"H7205","lemma":"רְאוּבֵן","tr":"re·u·ven","gloss":"Reuben","lang":"h","inPassage":2,"uses":72},{"base":"H0161","lemma":"אֹ֫הַד","tr":"o·had","gloss":"Ohad","lang":"h","inPassage":1,"uses":2},{"base":"H3177","lemma":"יַחְלְאֵל","tr":"yach·le·el","gloss":"Jahleel","lang":"h","inPassage":1,"uses":2},{"base":"H3223","lemma":"יְמוּאֵל","tr":"ye·mu·el","gloss":"Jemuel","lang":"h","inPassage":1,"uses":2},{"base":"H5624","lemma":"סֶ֫רֶד","tr":"se·red","gloss":"Sered","lang":"h","inPassage":1,"uses":2}],"parallels":[],"crossrefs":[{"book":"EXO","chapter":6,"verse":15,"verseEnd":15,"votes":5,"source":"both","text":"The sons of Simeon were Jemuel, Jamin, Ohad, Jachin, Zohar, and Shaul, the son of a Canaanite woman. These were the clans of Simeon.","from":10},{"book":"GEN","chapter":25,"verse":20,"verseEnd":20,"votes":0,"source":"tsk","text":"and Isaac was forty years old when he married Rebekah, the daughter of Bethuel the Aramean from Paddan-aram and the sister of Laban the Aramean.","from":15},{"book":"GEN","chapter":28,"verse":1,"verseEnd":1,"votes":0,"source":"tsk","text":"So Isaac called for Jacob and blessed him. “Do not take a wife from the Canaanite women,” he commanded.","from":10},{"book":"GEN","chapter":29,"verse":32,"verseEnd":32,"votes":0,"source":"tsk","text":"And Leah conceived and gave birth to a son, and she named him Reuben, for she said, “The Lordhas seen my affliction. Surely my husband will love me now.”","from":8},{"book":"GEN","chapter":29,"verse":32,"verseEnd":35,"votes":0,"source":"tsk","text":"And Leah conceived and gave birth to a son, and she named him Reuben, for she said, “The Lordhas seen my affliction. Surely my husband will love me now.” Again she conceived and gave birth to a son, and she said, “Because the Lordhas heard that I am unloved, He has given me this son as well.” So she named him Simeon. Once again Leah conceived and gave birth to a son, and she said, “Now at last my husband will become attached to me, because I have borne him three sons.” So he was named Levi. And once more she conceived and gave birth to a son and said, “This time I will praise the Lord.” So she named him Judah. Then Leah stopped having children.","from":15},{"book":"GEN","chapter":29,"verse":33,"verseEnd":33,"votes":0,"source":"tsk","text":"Again she conceived and gave birth to a son, and she said, “Because the Lordhas heard that I am unloved, He has given me this son as well.” So she named him Simeon.","from":10},{"book":"GEN","chapter":29,"verse":34,"verseEnd":34,"votes":0,"source":"tsk","text":"Once again Leah conceived and gave birth to a son, and she said, “Now at last my husband will become attached to me, because I have borne him three sons.” So he was named Levi.","from":11},{"book":"GEN","chapter":29,"verse":35,"verseEnd":35,"votes":0,"source":"tsk","text":"And once more she conceived and gave birth to a son and said, “This time I will praise the Lord.” So she named him Judah. Then Leah stopped having children.","from":12}],"notes":[],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":10},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2},{"id":"judges-era","title":"Judges era and the road to David","people":2}]},"16-27":{"people":[{"id":"areli-h0692","name":"Areli","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"arod-h0720","name":"Arod","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"eri-h6179","name":"Eri","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"ezbon-h0675g","name":"Ezbon","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"gad-h1410g","name":"Gad","kind":"person","brief":"Son of Israel","count":1,"firstVerse":16},{"id":"haggi-h2291","name":"Haggi","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"shuni-h7764","name":"Shuni","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"ziphion-h6837","name":"Ziphion","kind":"person","brief":"Son of Gad","count":1,"firstVerse":16},{"id":"asher-h0836","name":"Asher","kind":"person","brief":"Son of Israel","count":1,"firstVerse":17},{"id":"beriah-h1283g","na