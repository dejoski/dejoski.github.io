:22,"votes":0,"source":"tsk","text":"These were the clans of Judah, and their registration numbered 76,500.","from":27},{"book":"JOS","chapter":15,"verse":28,"verseEnd":29,"votes":0,"source":"tsk","text":"Hazar-shual, Beersheba, Biziothiah, Baalah, Iim, Ezem,","from":28}],"notes":[],"groups":[{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2},{"id":"patriarchs","title":"The patriarchal families","people":2}]},"34-43":{"people":[{"id":"amaziah-h0558h","name":"Amaziah","kind":"person","brief":"Father of Joshah","count":1,"firstVerse":34},{"id":"jamlech-h3230","name":"Jamlech","kind":"person","brief":"From Simeon","count":1,"firstVerse":34},{"id":"joshah-h3144","name":"Joshah","kind":"person","brief":"Son of Amaziah","count":1,"firstVerse":34},{"id":"meshobab-h4877","name":"Meshobab","kind":"person","brief":"From Simeon","count":1,"firstVerse":34},{"id":"asiel-h6221","name":"Asiel","kind":"person","brief":"Father of Seraiah","count":1,"firstVerse":35},{"id":"jehu-h3058j","name":"Jehu","kind":"person","brief":"Son of Joshibiah","count":1,"firstVerse":35},{"id":"joel-h3100h","name":"Joel","kind":"person","brief":"From Simeon","count":1,"firstVerse":35},{"id":"joshibiah-h3143","name":"Joshibiah","kind":"person","brief":"Son of Seraiah","count":1,"firstVerse":35},{"id":"seraiah-h8304k","name":"Seraiah","kind":"person","brief":"Son of Asiel","count":1,"firstVerse":35},{"id":"adiel-h5717g","name":"Adiel","kind":"person","brief":"From Simeon","count":1,"firstVerse":36},{"id":"asaiah-h6222h","name":"Asaiah","kind":"person","brief":"From Simeon","count":1,"firstVerse":36},{"id":"benaiah-h1141i","name":"Benaiah","kind":"person","brief":"From Simeon","count":1,"firstVerse":36},{"id":"elioenai-h0454h","name":"Elioenai","kind":"person","brief":"From Simeon","count":1,"firstVerse":36},{"id":"jaakobah-h3291","name":"Jaakobah","kind":"person","brief":"From Simeon","count":1,"firstVerse":36},{"id":"jeshohaiah-h3439","name":"Jeshohaiah","kind":"person","bri