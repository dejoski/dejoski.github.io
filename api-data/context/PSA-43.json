{"1-2":{"people":[],"places":[],"words":[{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":2,"uses":752},{"base":"H3906","lemma":"לַ֫חַץ","tr":"la·chats","gloss":"oppression","lang":"h","inPassage":1,"uses":12},{"base":"H6937","lemma":"קָדַר","tr":"qa·dar","gloss":"be dark","lang":"h","inPassage":1,"uses":17},{"base":"H2186","lemma":"זָנַח","tr":"za·nach","gloss":"to reject","lang":"h","inPassage":1,"uses":20},{"base":"H6403","lemma":"פָּלַט","tr":"pa·lat","gloss":"to escape","lang":"h","inPassage":1,"uses":26},{"base":"H2623","lemma":"חָסִיד","tr":"cha·sid","gloss":"pious","lang":"h","inPassage":1,"uses":32},{"base":"H4581","lemma":"מָעוֹז","tr":"ma·oz","gloss":"security","lang":"h","inPassage":1,"uses":36},{"base":"H4820","lemma":"מִרְמָה","tr":"mir·mah","gloss":"deceit","lang":"h","inPassage":1,"uses":39},{"base":"H5766","lemma":"עָ֫וֶל","tr":"e·vel","gloss":"injustice","lang":"h","inPassage":1,"uses":54},{"base":"H7379","lemma":"רִיב","tr":"riv","gloss":"strife","lang":"h","inPassage":1,"uses":61}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":42,"verse":9,"verseEnd":9,"votes":9,"source":"both","text":"I say to God my Rock, “Why have You forgotten me? Why must I walk in sorrow because of the enemyʼs oppression?”","from":2},{"book":"PSA","chapter":7,"verse":8,"verseEnd":8,"votes":8,"source":"both","text":"The LORD judges the peoples; vindicate me, O LORD, according to my righteousness and integrity.","from":1},{"book":"PSA","chapter":26,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Vindicate me, O LORD! For I have walked with integrity; I have trusted in the LORD without wavering.","from":1},{"book":"PSA","chapter":35,"verse":1,"verseEnd":1,"votes":8,"source":"both","text":"Contend with my opponents, O LORD; fight against those who fight against me.","from":1},{"book":"PSA","chapter":28,"verse":7,"verseEnd":7,"votes":7,"source":"both","text":"The LORD is my strength and my shield; my heart trusts in Him, and I am helped. Therefore my heart rejoices, and I give thanks to Him with my song.","from":2},{"book":"1SA","chapter":24,"verse":15,"verseEnd":15,"votes":6,"source":"both","text":"May the LORD be our judge and decide between you and me. May He take notice and plead my case and deliver me from your hand.”","from":1},{"book":"PSA","chapter":35,"verse":24,"verseEnd":24,"votes":6,"source":"both","text":"Vindicate me by Your righteousness, O LORD my God, and do not let them gloat over me.","from":1},{"book":"EPH","chapter":6,"verse":10,"verseEnd":10,"votes":6,"source":"both","text":"Finally, be strong in the Lord and in His mighty power.","from":2}],"notes":[],"groups":[]},"3-4":{"people":[],"places":[],"words":[{"base":"H1524","lemma":"גִּיל","tr":"gil","gloss":"rejoicing","lang":"h","inPassage":1,"uses":9},{"base":"H5148","lemma":"נָחָה","tr":"na·chah","gloss":"to lead","lang":"h","inPassage":1,"uses":39},{"base":"H3658","lemma":"כִּנּוֹר","tr":"kin·nor","gloss":"lyre","lang":"h","inPassage":1,"uses":42},{"base":"H8057","lemma":"שִׂמְחָה","tr":"sim·chah","gloss":"joy","lang":"h","inPassage":1,"uses":94},{"base":"H3034","lemma":"יָדָה","tr":"ya·dah","gloss":"to give thanks","lang":"h","inPassage":1,"uses":114},{"base":"H0216","lemma":"אוֹר","tr":"or","gloss":"light","lang":"h","inPassage":1,"uses":121},{"base":"H0571","lemma":"אֱמֶת","tr":"e·met","gloss":"truth: faithful","lang":"h","inPassage":1,"uses":127},{"base":"H4908","lemma":"מִשְׁכָּן","tr":"mish·kan","gloss":"tabernacle","lang":"h","inPassage":1,"uses":139},{"base":"H0410","lemma":"אֵל","tr":"el","gloss":"God","lang":"h","inPassage":1,"uses":241},{"base":"H4196","lemma":"מִזְבֵּחַ","tr":"miz·be·ach","gloss":"altar","lang":"h","inPassage":1,"uses":401}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":36,"verse":9,"verseEnd":9,"votes":44,"source":"openbible","text":"For with You is the fountain of life; in Your light we see light.","from":3},{"book":"PRO","chapter":3,"verse":5,"verseEnd":5,"votes":26,"source":"openbible","text":"Trust in the LORD with all your heart, and lean not on your own understanding;","from":3},{"book":"PRO","chapter":3,"verse":6,"verseEnd":6,"votes":26,"source":"openbible","text":"in all your ways acknowledge Him, and He will make your paths straight.","from":3},{"book":"JHN","chapter":1,"verse":4,"verseEnd":4,"votes":15,"source":"both","text":"In Him was life, and that life was the light of men.","from":3},{"book":"PSA","chapter":143,"verse":10,"verseEnd":10,"votes":12,"source":"both","text":"Teach me to do Your will, for You are my God. May Your good Spirit lead me on level ground.","from":3},{"book":"ISA","chapter":61,"verse":10,"verseEnd":10,"votes":12,"source":"both","text":"I will rejoice greatly in the LORD, my soul will exult in my God; for He has clothed me with garments of salvation and wrapped me in a robe of righteousness, as a bridegroom wears a priestly headdress, as a bride adorns herself with her jewels.","from":4},{"book":"PSA","chapter":97,"verse":11,"verseEnd":11,"votes":11,"source":"both","text":"Light shines on the righteous, gladness on the upright in heart.","from":3},{"book":"PSA","chapter":119,"verse":105,"verseEnd":105,"votes":11,"source":"both","text":"Your word is a lamp to my feet and a light to my path.","from":3}],"notes":[],"groups":[]},"5-5":{"people":[],"places":[],"words":[{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":2,"uses":752},{"base":"H7817","lemma":"שָׁחַח","tr":"sha·chach","gloss":"to bow","lang":"h","inPassage":1,"uses":21},{"base":"H1993","lemma":"הָמָה","tr":"ha·mah","gloss":"to roar","lang":"h","inPassage":1,"uses":34},{"base":"H3176","lemma":"יָחַל","tr":"ya·chal","gloss":"to wait: wait","lang":"h","inPassage":1,"uses":41},{"base":"H3444","lemma":"יְשׁוּעָה","tr":"ye·shu·ah","gloss":"salvation","lang":"h","inPassage":1,"uses":78},{"base":"H3034","lemma":"יָדָה","tr":"ya·dah","gloss":"to give thanks","lang":"h","inPassage":1,"uses":114},{"base":"H5750","lemma":"עוֹד","tr":"od","gloss":"still","lang":"h","inPassage":1,"uses":490},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":1,"uses":754}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":42,"verse":5,"verseEnd":5,"votes":15,"source":"both","text":"Why are you downcast, O my soul? Why the unease within me? Put your hope in God, for I will yet praise Him for the salvation of His presence.","from":5},{"book":"PSA","chapter":42,"verse":11,"verseEnd":11,"votes":11,"source":"both","text":"Why are you downcast, O my soul? Why the unease within me? Put your hope in God, for I will yet praise Him, my Savior and my God.","from":5},{"book":"PSA","chapter":44,"verse":4,"verseEnd":4,"votes":0,"source":"tsk","text":"You are my King, O God, who ordains victories for Jacob.","from":5}],"notes":[],"groups":[]}}