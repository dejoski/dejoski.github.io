{"1-3":{"people":[{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H0926","lemma":"בָּהַל","tr":"ba·hal","gloss":"to dismay","lang":"h","inPassage":2,"uses":39},{"base":"H0408","lemma":"אַל","tr":"al","gloss":"not","lang":"h","inPassage":2,"uses":724},{"base":"H3256","lemma":"יָסַר","tr":"ya·sar","gloss":"to discipline","lang":"h","inPassage":1,"uses":43},{"base":"H4970","lemma":"מָתַי","tr":"ma·tay","gloss":"how","lang":"h","inPassage":1,"uses":43},{"base":"H3198","lemma":"יָכַח","tr":"ya·khach","gloss":"to rebuke","lang":"h","inPassage":1,"uses":59},{"base":"H7495","lemma":"רָפָא","tr":"ra·pah","gloss":"to heal","lang":"h","inPassage":1,"uses":67},{"base":"H2603","lemma":"חָנַן","tr":"cha·nan","gloss":"be gracious","lang":"h","inPassage":1,"uses":78},{"base":"H2534","lemma":"חֵמָה","tr":"che·mah","gloss":"rage","lang":"h","inPassage":1,"uses":125},{"base":"H6106","lemma":"עֶ֫צֶם","tr":"e·tsem","gloss":"bone","lang":"h","inPassage":1,"uses":126},{"base":"H0639","lemma":"אַף","tr":"aph","gloss":"face: anger","lang":"h","inPassage":1,"uses":276}],"parallels":[],"crossrefs":[{"book":"HOS","chapter":6,"verse":1,"verseEnd":1,"votes":10,"source":"both","text":"Come, let us return to the LORD. For He has torn us to pieces, but He will heal us; He has wounded us, but He will bind up our wounds.","from":2},{"book":"PSA","chapter":38,"verse":1,"verseEnd":1,"votes":9,"source":"both","text":"O LORD, do not rebuke me in Your anger or discipline me in Your wrath.","from":1},{"book":"PSA","chapter":30,"verse":2,"verseEnd":2,"votes":8,"source":"both","text":"O LORD my God, I cried to You for help, and You healed me.","from":2},{"book":"PSA","chapter":31,"verse":10,"verseEnd":10,"votes":8,"source":"openbible","text":"For my life is consumed with grief and my years with groaning; my iniquity has drained my strength, and my bones are wasting away.","from":2},{"book":"PSA","chapter":118,"verse":18,"verseEnd":18,"votes":8,"source":"openbible","text":"The LORD disciplined me severely, but He has not given me over to death.","from":1},{"book":"JER","chapter":46,"verse":28,"verseEnd":28,"votes":8,"source":"both","text":"And you, My servant Jacob, do not be afraid, declares the LORD, for I am with you. Though I will completely destroy all the nations to which I have banished you, I will not completely destroy you. Yet I will discipline you justly, and will by no means leave you unpunished.”","from":1},{"book":"PSA","chapter":90,"verse":13,"verseEnd":13,"votes":7,"source":"both","text":"Return, O LORD! How long will it be? Have compassion on Your servants.","from":3},{"book":"JER","chapter":10,"verse":24,"verseEnd":24,"votes":7,"source":"both","text":"Correct me, O LORD, but only with justice— not in Your anger, or You will bring me to nothing.","from":1}],"notes":[],"groups":[]},"4-7":{"people":[],"places":[],"words":[{"base":"H6244","lemma":"עָשֵׁשׁ","tr":"a·shesh","gloss":"to waste","lang":"h","inPassage":1,"uses":3},{"base":"H7811","lemma":"שָׂחָה","tr":"sa·chah","gloss":"to swim","lang":"h","inPassage":1,"uses":3},{"base":"H4529","lemma":"מָסָה","tr":"ma·sah","gloss":"to liquefy","lang":"h","inPassage":1,"uses":4},{"base":"H6275","lemma":"עָתַק","tr":"a·taq","gloss":"to proceed","lang":"h","inPassage":1,"uses":9},{"base":"H6210","lemma":"עֶ֫רֶשׂ","tr":"e·re·s","gloss":"bed","lang":"h","inPassage":1,"uses":10},{"base":"H0585","lemma":"אֲנָחָה","tr":"a·na·chah","gloss":"sighing","lang":"h","inPassage":1,"uses":11},{"base":"H1832","lemma":"דִּמְעָה","tr":"dim·ah","gloss":"tears","lang":"h","inPassage":1,"uses":23},{"base":"H2143","lemma":"זֵ֫כֶר","tr":"ze·kher","gloss":"memorial","lang":"h","inPassage":1,"uses":23},{"base":"H3708","lemma":"כַּ֫עַס","tr":"ka·as","gloss":"vexation","lang":"h","inPassage":1,"uses":25},{"base":"H3021","lemma":"יָגֵעַ","tr":"ya·ga","gloss":"be weary","lang":"h","inPassage":1,"uses":26}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":88,"verse":10,"verseEnd":10,"votes":25,"source":"openbible","text":"Do You work wonders for the dead? Do departed spirits rise up to praise You? Selah","from":5},{"book":"PSA","chapter":88,"verse":12,"verseEnd":12,"votes":25,"source":"openbible","text":"Will Your wonders be known in the darkness, or Your righteousness in the land of oblivion?","from":5},{"book":"PSA","chapter":115,"verse":17,"verseEnd":17,"votes":24,"source":"both","text":"It is not the dead who praise the LORD, nor any who descend into silence.","from":5},{"book":"ECC","chapter":9,"verse":10,"verseEnd":10,"votes":22,"source":"both","text":"Whatever you find to do with your hands, do it with all your might, for in Sheol, where you are going, there is no work or planning or knowledge or wisdom.","from":5},{"book":"PSA","chapter":30,"verse":9,"verseEnd":9,"votes":19,"source":"both","text":"“What gain is there in my bloodshed, in my descent to the Pit? Will the dust praise You? Will it proclaim Your faithfulness?","from":5},{"book":"ISA","chapter":38,"verse":18,"verseEnd":18,"votes":10,"source":"openbible","text":"For Sheol cannot thank You; Death cannot praise You. Those who descend to the Pit cannot hope for Your faithfulness.","from":5},{"book":"ISA","chapter":38,"verse":19,"verseEnd":19,"votes":10,"source":"openbible","text":"The living, only the living, can thank You, as I do today; fathers will tell their children about Your faithfulness.","from":5},{"book":"PSA","chapter":118,"verse":17,"verseEnd":17,"votes":8,"source":"both","text":"I will not die, but I will live and proclaim what the LORD has done.","from":5}],"notes":[],"groups":[]},"8-10":{"people":[],"places":[],"words":[{"base":"H0954","lemma":"בּוֹשׁ","tr":"bush","gloss":"be ashamed","lang":"h","inPassage":2,"uses":127},{"base":"H7281","lemma":"רֶ֫גַע","tr":"re·ga","gloss":"moment","lang":"h","inPassage":1,"uses":22},{"base":"H8085","lemma":"שָׁמַע","tr":"sha·ma","gloss":"to hear: hear","lang":"h","inPassage":2,"uses":1159},{"base":"H8467","lemma":"תְּחִנָּה","tr":"te·chin·nah","gloss":"supplication","lang":"h","inPassage":1,"uses":25},{"base":"H1065","lemma":"בְּכִי","tr":"be·khi","gloss":"weeping","lang":"h","inPassage":1,"uses":30},{"base":"H0926","lemma":"בָּהַל","tr":"ba·hal","gloss":"to dismay","lang":"h","inPassage":1,"uses":39},{"base":"H6466","lemma":"פָּעַל","tr":"pa·al","gloss":"to work","lang":"h","inPassage":1,"uses":57},{"base":"H0205","lemma":"אָ֫וֶן","tr":"a·ven","gloss":"evil: wickedness","lang":"h","inPassage":1,"uses":77},{"base":"H8605","lemma":"תְּפִלָּה","tr":"te·phil·lah","gloss":"prayer","lang":"h","inPassage":1,"uses":77},{"base":"H0341","lemma":"אֹיֵב","tr":"o·yev","gloss":"enemy","lang":"h","inPassage":1,"uses":282}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":66,"verse":19,"verseEnd":19,"votes":14,"source":"openbible","text":"But God has surely heard; He has attended to the sound of my prayer.","from":9},{"book":"PSA","chapter":66,"verse":20,"verseEnd":20,"votes":14,"source":"openbible","text":"Blessed be God, who has not rejected my prayer or withheld from me His loving devotion!","from":9},{"book":"PSA","chapter":120,"verse":1,"verseEnd":1,"votes":13,"source":"both","text":"In my distress I cried to the LORD, and He answered me.","from":9},{"book":"PSA","chapter":145,"verse":18,"verseEnd":18,"votes":12,"source":"both","text":"The LORD is near to all who call on Him, to all who call out to Him in truth.","from":8},{"book":"LUK","chapter":13,"verse":27,"verseEnd":27,"votes":12,"source":"both","text":"And he will answer, ‘I tell you, I do not know where you are from. Depart from me, all you evildoers.’","from":8},{"book":"PSA","chapter":119,"verse":115,"verseEnd":115,"votes":11,"source":"both","text":"Depart from me, you evildoers, that I may obey the commandments of my God.","from":8},{"book":"PSA","chapter":3,"verse":4,"verseEnd":4,"votes":9,"source":"both","text":"To the LORD I cry aloud, and He answers me from His holy mountain. Selah","from":8},{"book":"MAT","chapter":7,"verse":23,"verseEnd":23,"votes":9,"source":"both","text":"Then I will tell them plainly, ‘I never knew you; depart from Me, you workers of lawlessness!’","from":8}],"notes":[],"groups":[]}}