{"1-11":{"people":[],"places":[],"words":[{"base":"H0995","lemma":"בִּין","tr":"bin","gloss":"to understand","lang":"h","inPassage":3,"uses":170},{"base":"H1847","lemma":"דַּ֫עַת","tr":"da·at","gloss":"knowledge","lang":"h","inPassage":2,"uses":92},{"base":"H2451","lemma":"חׇכְמָה","tr":"chokh·mah","gloss":"wisdom","lang":"h","inPassage":2,"uses":153},{"base":"H8193","lemma":"שָׂפָה","tr":"sa·phah","gloss":"lips","lang":"h","inPassage":2,"uses":176},{"base":"H5228","lemma":"נָכֹחַ","tr":"na·kho·ach","gloss":"straightforward","lang":"h","inPassage":1,"uses":4},{"base":"H6310","lemma":"פֶּה","tr":"peh","gloss":"lip","lang":"h","inPassage":2,"uses":498},{"base":"H6963","lemma":"קוֹל","tr":"qol","gloss":"voice","lang":"h","inPassage":2,"uses":506},{"base":"H6195","lemma":"עׇרְמָה","tr":"or·mah","gloss":"craftiness","lang":"h","inPassage":1,"uses":5},{"base":"H6617","lemma":"פָּתַל","tr":"pa·tal","gloss":"to twist","lang":"h","inPassage":1,"uses":5},{"base":"H7176","lemma":"קֶ֫רֶת","tr":"qe·ret","gloss":"town","lang":"h","inPassage":1,"uses":5}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":2,"verse":4,"verseEnd":4,"votes":13,"source":"openbible","text":"if you seek it like silver and search it out like hidden treasure,","from":10},{"book":"PRO","chapter":2,"verse":5,"verseEnd":5,"votes":13,"source":"openbible","text":"then you will discern the fear of the LORD and discover the knowledge of God.","from":10},{"book":"PSA","chapter":119,"verse":72,"verseEnd":72,"votes":10,"source":"both","text":"The law from Your mouth is more precious to me than thousands of pieces of gold and silver.","from":10},{"book":"PSA","chapter":119,"verse":127,"verseEnd":127,"votes":10,"source":"both","text":"Therefore I love Your commandments more than gold, even the purest gold.","from":10},{"book":"PRO","chapter":23,"verse":23,"verseEnd":23,"votes":8,"source":"both","text":"Invest in truth and never sell it— in wisdom and instruction and understanding.","from":10},{"book":"PSA","chapter":19,"verse":10,"verseEnd":10,"votes":7,"source":"both","text":"They are more precious than gold, than much pure gold; they are sweeter than honey, than honey from the comb.","from":11},{"book":"PSA","chapter":119,"verse":127,"verseEnd":127,"votes":7,"source":"both","text":"Therefore I love Your commandments more than gold, even the purest gold.","from":11},{"book":"PRO","chapter":3,"verse":13,"verseEnd":13,"votes":7,"source":"openbible","text":"Blessed is the man who finds wisdom, the man who acquires understanding,","from":10}],"notes":[],"groups":[]},"12-21":{"people":[],"places":[],"words":[{"base":"H0157","lemma":"אָהֵב","tr":"a·hav","gloss":"to love: lover","lang":"h","inPassage":3,"uses":211},{"base":"H9030","lemma":"נִי","tr":"ni","gloss":"me","lang":"h","inPassage":4,"uses":908},{"base":"H0589","lemma":"אֲנִי","tr":"a·ni","gloss":"I","lang":"h","inPassage":3,"uses":874},{"base":"H6664","lemma":"צֶ֫דֶק","tr":"tse·deq","gloss":"righteousness","lang":"h","inPassage":2,"uses":119},{"base":"H8130","lemma":"שָׂנֵא","tr":"sa·ne","gloss":"to hate","lang":"h","inPassage":2,"uses":146},{"base":"H6666","lemma":"צְדָקָה","tr":"tse·da·qah","gloss":"righteousness","lang":"h","inPassage":2,"uses":157},{"base":"H4672","lemma":"מָצָא","tr":"ma·tsa","gloss":"to find","lang":"h","inPassage":2,"uses":455},{"base":"H6195","lemma":"עׇרְמָה","tr":"or·mah","gloss":"craftiness","lang":"h","inPassage":1,"uses":5},{"base":"H8323","lemma":"שָׂרַר","tr":"sa·rar","gloss":"to rule","lang":"h","inPassage":1,"uses":5},{"base":"H7336","lemma":"רָזַן","tr":"ra·zan","gloss":"to rule","lang":"h","inPassage":1,"uses":6}],"parallels":[],"crossrefs":[{"book":"JHN","chapter":14,"verse":23,"verseEnd":23,"votes":42,"source":"both","text":"Jesus replied, “If anyone loves Me, he will keep My word. My Father will love him, and We will come to him and make Our home with him.","from":17},{"book":"JHN","chapter":14,"verse":21,"verseEnd":21,"votes":35,"source":"both","text":"Whoever has My commandments and keeps them is the one who loves Me. The one who loves Me will be loved by My Father, and I will love him and reveal Myself to him.”","from":17},{"book":"PSA","chapter":91,"verse":14,"verseEnd":14,"votes":28,"source":"both","text":"“Because he loves Me, I will deliver him; because he knows My name, I will protect him.","from":17},{"book":"1SA","chapter":2,"verse":30,"verseEnd":30,"votes":24,"source":"both","text":"Therefore, the LORD, the God of Israel, declares: ‘I did indeed say that your house and the house of your father would walk before Me forever. But now the LORD declares: Far be it from Me! For I will honor those who honor Me, but those who despise Me will be disdained.","from":17},{"book":"ISA","chapter":55,"verse":6,"verseEnd":6,"votes":24,"source":"both","text":"Seek the LORD while He may be found; call on Him while He is near.","from":17},{"book":"1JN","chapter":4,"verse":19,"verseEnd":19,"votes":21,"source":"both","text":"We love because He first loved us.","from":17},{"book":"PRO","chapter":16,"verse":6,"verseEnd":6,"votes":18,"source":"both","text":"By loving devotion and faithfulness iniquity is atoned for, and by the fear of the LORD one turns aside from evil.","from":13},{"book":"PSA","chapter":97,"verse":10,"verseEnd":10,"votes":17,"source":"both","text":"Hate evil, O you who love the LORD! He preserves the souls of His saints; He delivers them from the hand of the wicked.","from":13}],"notes":[],"groups":[]},"22-31":{"people":[],"places":[],"words":[{"base":"H5810","lemma":"עָזַז","tr":"a·zaz","gloss":"be strong","lang":"h","inPassage":1,"uses":11,"top":true},{"base":"H8415","lemma":"תְּהוֹם","tr":"te·hom","gloss":"abyss","lang":"h","inPassage":3,"uses":36},{"base":"H8191","lemma":"שַׁעֲשֻׁעִים","tr":"sha·shu·a","gloss":"delight","lang":"h","inPassage":2,"uses":9},{"base":"H2710","lemma":"חָקַק","tr":"cha·qaq","gloss":"to decree","lang":"h","inPassage":2,"uses":19},{"base":"H7832","lemma":"שָׂחַק","tr":"sa·chaq","gloss":"to laugh","lang":"h","inPassage":2,"uses":36},{"base":"H8398","lemma":"תֵּבֵל","tr":"te·vel","gloss":"world","lang":"h","inPassage":2,"uses":36},{"base":"H2342","lemma":"חוּל","tr":"chul","gloss":"to twist: tremble","lang":"h","inPassage":2,"uses":58},{"base":"H6924","lemma":"קֶ֫דֶם","tr":"qe·dem","gloss":"East","lang":"h","inPassage":2,"uses":87},{"base":"H0525","lemma":"אָמוֹן","tr":"a·mon","gloss":"artisan","lang":"h","inPassage":1,"uses":2},{"base":"H2329","lemma":"חוּג","tr":"chug","gloss":"circle","lang":"h","inPassage":1,"uses":3},{"base":"H4659","lemma":"מִפְעָל","tr":"miph·al","gloss":"work","lang":"h","inPassage":1,"uses":3}],"parallels":[],"crossrefs":[{"book":"COL","chapter":1,"verse":17,"verseEnd":17,"votes":12,"source":"both","text":"He is before all things, and in Him all things hold together.","from":22},{"book":"JHN","chapter":1,"verse":1,"verseEnd":1,"votes":11,"source":"openbible","text":"In the beginning was the Word, and the Word was with God, and the Word was God.","from":22},{"book":"JHN","chapter":1,"verse":1,"verseEnd":1,"votes":11,"source":"openbible","text":"In the beginning was the Word, and the Word was with God, and the Word was God.","from":30},{"book":"JHN","chapter":1,"verse":2,"verseEnd":2,"votes":11,"source":"openbible","text":"He was with God in the beginning.","from":22},{"book":"JHN","chapter":1,"verse":3,"verseEnd":3,"votes":11,"source":"openbible","text":"Through Him all things were made, and without Him nothing was made that has been made.","from":30},{"book":"PSA","chapter":104,"verse":9,"verseEnd":9,"votes":10,"source":"both","text":"You set a boundary they cannot cross, that they may never again cover the earth.","from":29},{"book":"JER","chapter":5,"verse":22,"verseEnd":22,"votes":9,"source":"both","text":"Do you not fear Me?” declares the LORD. “Do you not tremble before Me, the One who set the sand as the boundary for the sea, an enduring barrier it cannot cross? The waves surge, but they cannot prevail. They roar but cannot cross it.","from":29},{"book":"JOB","chapter":26,"verse":10,"verseEnd":10,"votes":8,"source":"openbible","text":"He has inscribed a horizon on the face of the waters at the boundary between light and darkness.","from":27}],"notes":[{"id":"prov-8-22-wisdom","title":"Wisdom at creation's side","kind":"type"}],"groups":[]},"32-36":{"people":[],"places":[],"words":[{"base":"H0835","lemma":"אֶ֫שֶׁר","tr":"e·sher","gloss":"blessed","lang":"h","inPassage":2,"uses":45},{"base":"H8085","lemma":"שָׁמַע","tr":"sha·ma","gloss":"to hear: hear","lang":"h","inPassage":3,"uses":1159},{"base":"H4672","lemma":"מָצָא","tr":"ma·tsa","gloss":"to find","lang":"h","inPassage":2,"uses":455},{"base":"H8104","lemma":"שָׁמַר","tr":"sha·mar","gloss":"to keep: obey","lang":"h","inPassage":2,"uses":469},{"base":"H6329","lemma":"פּוּק","tr":"puq","gloss":"to promote","lang":"h","inPassage":1,"uses":7},{"base":"H2554","lemma":"חָמַס","tr":"cha·mas","gloss":"to injure","lang":"h","inPassage":1,"uses":8},{"base":"H8245","lemma":"שָׁקַד","tr":"sha·qad","gloss":"to watch","lang":"h","inPassage":1,"uses":12},{"base":"H9030","lemma":"נִי","tr":"ni","gloss":"me","lang":"h","inPassage":2,"uses":908},{"base":"H6544","lemma":"פָּרַע","tr":"pa·ra","gloss":"to lead","lang":"h","inPassage":1,"uses":16},{"base":"H4201","lemma":"מְזוּזָה","tr":"me·zu·zah","gloss":"doorpost","lang":"h","inPassage":1,"uses":19}],"parallels":[],"crossrefs":[{"book":"JHN","chapter":3,"verse":36,"verseEnd":36,"votes":20,"source":"both","text":"Whoever believes in the Son has eternal life. Whoever rejects the Son will not see life. Instead, the wrath of God remains on him.”","from":35},{"book":"LUK","chapter":11,"verse":28,"verseEnd":28,"votes":16,"source":"both","text":"But He replied, “Blessed rather are those who hear the word of God and obey it.”","from":34},{"book":"MAT","chapter":7,"verse":24,"verseEnd":24,"votes":13,"source":"both","text":"Therefore everyone who hears these words of Mine and acts on them is like a wise man who built his house on the rock.","from":34},{"book":"PRO","chapter":12,"verse":2,"verseEnd":2,"votes":12,"source":"both","text":"The good man obtains favor from the LORD, but the LORD condemns a man who devises evil.","from":35},{"book":"1JN","chapter":5,"verse":11,"verseEnd":11,"votes":12,"source":"openbible","text":"And this is that testimony: God has given us eternal life, and this life is in His Son.","from":35},{"book":"1JN","chapter":5,"verse":12,"verseEnd":12,"votes":12,"source":"openbible","text":"Whoever has the Son has life; whoever does not have the Son of God does not have life.","from":35},{"book":"PRO","chapter":15,"verse":32,"verseEnd":32,"votes":11,"source":"openbible","text":"He who ignores discipline despises himself, but whoever heeds correction gains understanding.","from":36},{"book":"PSA","chapter":119,"verse":1,"verseEnd":1,"votes":10,"source":"openbible","text":"Blessed are those whose way is blameless, who walk in the Law of the LORD.","from":32}],"notes":[],"groups":[]}}