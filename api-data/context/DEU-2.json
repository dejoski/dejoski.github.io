{"1-8":{"people":[{"id":"esau-h6215g","name":"Esau","kind":"person","brief":"Son of Isaac","count":3,"firstVerse":4}],"places":[{"id":"seir-mount-h8165g","name":"Seir Mount","kind":"place","brief":"","count":2,"firstVerse":1},{"id":"red-sea-h5488g","name":"Red Sea","kind":"place","brief":"","count":1,"firstVerse":1},{"id":"seir-h8165a","name":"Seir","kind":"place","brief":"In Edom","count":2,"firstVerse":4},{"id":"arabah-h6160g","name":"Arabah","kind":"place","brief":"","count":1,"firstVerse":8},{"id":"elath-h0359a","name":"Elath","kind":"place","brief":"","count":1,"firstVerse":8},{"id":"ezion-geber-h6100","name":"Ezion-geber","kind":"place","brief":"","count":1,"firstVerse":8},{"id":"moab-h4124g","name":"Moab","kind":"place","brief":"In Edom","count":1,"firstVerse":8}],"words":[{"base":"H8165","lemma":"שֵׂעִיר","tr":"se·ir","gloss":"Seir","lang":"h","inPassage":4,"uses":39},{"base":"H6215","lemma":"עֵשָׂו","tr":"e·sav","gloss":"Esau","lang":"h","inPassage":3,"uses":97},{"base":"H9036","lemma":"כֶם","tr":"khem","gloss":"you","lang":"h","inPassage":4,"uses":591},{"base":"H6437","lemma":"פָּנָה","tr":"pa·nah","gloss":"to turn","lang":"h","inPassage":3,"uses":135},{"base":"H6100","lemma":"עֶצְיוֹן גֶּ֫בֶר","tr":"ets·yon ge·ver","gloss":"Ezion-geber","lang":"h","inPassage":2,"uses":14},{"base":"H4057","lemma":"מִדְבָּר","tr":"mid·bar","gloss":"mouth","lang":"h","inPassage":3,"uses":271},{"base":"H2022","lemma":"הַר","tr":"har","gloss":"mountain: mount","lang":"h","inPassage":3,"uses":546},{"base":"H5674","lemma":"עָבַר","tr":"a·var","gloss":"to pass","lang":"h","inPassage":3,"uses":556},{"base":"H1870","lemma":"דֶּ֫רֶךְ","tr":"de·rekh","gloss":"way: conduct","lang":"h","inPassage":3,"uses":706},{"base":"H0854","lemma":"אֵת","tr":"et","gloss":"with","lang":"h","inPassage":3,"uses":929}],"parallels":[],"crossrefs":[{"book":"NEH","chapter":9,"verse":21,"verseEnd":21,"votes":13,"source":"both","text":"For forty years You sustained them in the wilderness, so that they lacked nothing. Their clothes did not wear out and their feet did not swell.","from":7},{"book":"LUK","chapter":22,"verse":35,"verseEnd":35,"votes":13,"source":"both","text":"Then Jesus asked them, “When I sent you out without purse or bag or sandals, did you lack anything?” “Nothing,” they answered.","from":7},{"book":"DEU","chapter":1,"verse":6,"verseEnd":6,"votes":12,"source":"both","text":"The LORD our God said to us at Horeb: “You have stayed at this mountain long enough.","from":3},{"book":"DEU","chapter":8,"verse":2,"verseEnd":2,"votes":12,"source":"openbible","text":"Remember that these forty years the LORD your God led you all the way in the wilderness, so that He might humble you and test you in order to know what was in your heart, whether or not you would keep His commandments.","from":7},{"book":"DEU","chapter":8,"verse":4,"verseEnd":4,"votes":12,"source":"openbible","text":"Your clothing did not wear out and your feet did not swell during these forty years.","from":7},{"book":"DEU","chapter":29,"verse":5,"verseEnd":5,"votes":10,"source":"both","text":"For forty years I led you in the wilderness, yet your clothes and sandals did not wear out.","from":7},{"book":"JOB","chapter":23,"verse":10,"verseEnd":10,"votes":9,"source":"both","text":"Yet He knows the way I have taken; when He has tested me, I will come forth as gold.","from":7},{"book":"PSA","chapter":31,"verse":7,"verseEnd":7,"votes":9,"source":"both","text":"I will be glad and rejoice in Your loving devotion, for You have seen my affliction; You have known the anguish of my soul.","from":7}],"notes":[],"groups":[]},"9-15":{"people":[{"id":"lot-h3876g","name":"Lot","kind":"person","brief":"Son of Haran","count":1,"firstVerse":9},{"id":"anak-h6061","name":"Anak","kind":"person","brief":"Son of Arba","count":2,"firstVerse":10},{"id":"emim-h0368","name":"Emim","kind":"person","brief":"","count":2,"firstVerse":10},{"id":"rephaim-h7497b","name":"Rephaim","kind":"person","brief":"","count":1,"firstVerse":11},{"id":"esau-h6215g","name":"Esau","kind":"person","brief":"Son of Isaac","count":1,"firstVerse":12},{"id":"hori-h2753h","name":"Hori","kind":"person","brief":"Son of Lotan","count":1,"firstVerse":12},{"id":"israel-h3478","name":"Israel","kind":"person","brief":"Son of Isaac","count":1,"firstVerse":12}],"places":[{"id":"moab-h4124g","name":"Moab","kind":"place","brief":"In Edom","count":2,"firstVerse":9},{"id":"ar-h6144","name":"Ar","kind":"place","brief":"","count":1,"firstVerse":9},{"id":"seir-h8165a","name":"Seir","kind":"place","brief":"In Edom","count":1,"firstVerse":12},{"id":"zered-h2218","name":"Zered","kind":"place","brief":"","count":2,"firstVerse":13},{"id":"kadesh-h6946g","name":"Kadesh","kind":"place","brief":"","count":1,"firstVerse":14}],"words":[{"base":"H2218","lemma":"זֶ֫רֶד","tr":"ze·red","gloss":"Zered","lang":"h","inPassage":3,"uses":4},{"base":"H3425","lemma":"יְרֻשָּׁה","tr":"ye·rush·shah","gloss":"possession","lang":"h","inPassage":3,"uses":14},{"base":"H9038","lemma":"הֶם","tr":"hem","gloss":"them","lang":"h","inPassage":5,"uses":1125},{"base":"H0368","lemma":"אֵימִים","tr":"e·mim","gloss":"Emim","lang":"h","inPassage":2,"uses":3},{"base":"H5158","lemma":"נַ֫חַל","tr":"na·chal","gloss":"torrent: river","lang":"h","inPassage":3,"uses":141},{"base":"H6062","lemma":"עֲנָקִי","tr":"a·na·qi","gloss":"Anakite","lang":"h","inPassage":2,"uses":9},{"base":"H6947","lemma":"קָדֵשׁ בַּרְנֵעַ","tr":"qa·desh bar·ne·a","gloss":"Kadesh-barnea","lang":"h","inPassage":2,"uses":20},{"base":"H5674","lemma":"עָבַר","tr":"a·var","gloss":"to pass","lang":"h","inPassage":3,"uses":556},{"base":"H8552","lemma":"תָּמַם","tr":"ta·mam","gloss":"to finish","lang":"h","inPassage":2,"uses":63},{"base":"H3427","lemma":"יָשַׁב","tr":"ya·shav","gloss":"to dwell","lang":"h","inPassage":3,"uses":1079}],"parallels":[],"crossrefs":[{"book":"DEU","chapter":2,"verse":22,"verseEnd":22,"votes":7,"source":"both","text":"just as He had done for the descendants of Esau who lived in Seir, when He destroyed the Horites from before them. They drove them out and have lived in their place to this day.","from":12},{"book":"GEN","chapter":19,"verse":36,"verseEnd":36,"votes":6,"source":"openbible","text":"Thus both of Lotʼs daughters became pregnant by their father.","from":9},{"book":"GEN","chapter":19,"verse":37,"verseEnd":37,"votes":6,"source":"openbible","text":"The older daughter gave birth to a son and named him Moab. He is the father of the Moabites of today.","from":9},{"book":"GEN","chapter":14,"verse":5,"verseEnd":5,"votes":5,"source":"both","text":"In the fourteenth year, Chedorlaomer and the kings allied with him went out and defeated the Rephaites in Ashteroth-karnaim, the Zuzites in Ham, the Emites in Shaveh-kiriathaim,","from":10},{"book":"NUM","chapter":14,"verse":28,"verseEnd":28,"votes":5,"source":"openbible","text":"So tell them: As surely as I live, declares the LORD, I will do to you exactly as I heard you say.","from":14},{"book":"NUM","chapter":14,"verse":35,"verseEnd":35,"votes":5,"source":"openbible","text":"I, the LORD, have spoken, and I will surely do these things to this entire wicked congregation, which has conspired against Me. They will meet their end in the wilderness, and there they will die.”","from":14},{"book":"NUM","chapter":21,"verse":15,"verseEnd":15,"votes":5,"source":"both","text":"even the slopes of the wadis that extend to the site of Ar and lie along the border of Moab.”","from":9},{"book":"NUM","chapter":26,"verse":64,"verseEnd":64,"votes":5,"source":"openbible","text":"Among all these, however, there was not one who had been numbered by Moses and Aaron the priest when they counted the Israelites in the Wilderness of Sinai.","from":14}],"notes":[{"id":"num-14-wilderness-generation","title":"The wilderness generation will not enter","kind":"prophecy"}],"groups":[{"id":"patriarchs","title":"The patriarchal families","people":3}]},"16-25":{"people":[{"id":"lot-h3876g","name":"Lot","kind":"person","brief":"Son of H