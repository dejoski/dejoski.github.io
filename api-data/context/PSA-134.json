{"1-3":{"people":[],"places":[{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":3}],"words":[{"base":"H1288","lemma":"בָּרַךְ","tr":"ba·rakh","gloss":"to bless","lang":"h","inPassage":3,"uses":330},{"base":"H6726","lemma":"צִיּוֹן","tr":"tsiy·yon","gloss":"Zion","lang":"h","inPassage":1,"uses":154},{"base":"H3915","lemma":"לַ֫יְלָה","tr":"lay·lah","gloss":"night","lang":"h","inPassage":1,"uses":233},{"base":"H8064","lemma":"שָׁמַיִם","tr":"sha·ma·yim","gloss":"heaven","lang":"h","inPassage":1,"uses":421},{"base":"H6944","lemma":"קֹ֫דֶשׁ","tr":"qo·desh","gloss":"holiness","lang":"h","inPassage":1,"uses":469},{"base":"H5975","lemma":"עָמַד","tr":"a·mad","gloss":"to stand: stand","lang":"h","inPassage":1,"uses":521},{"base":"H5375","lemma":"נָשָׂא","tr":"na·sa","gloss":"to lift: raise","lang":"h","inPassage":1,"uses":656},{"base":"H5650","lemma":"עֶ֫בֶד","tr":"e·ved","gloss":"servant","lang":"h","inPassage":1,"uses":800},{"base":"H2009","lemma":"הִנֵּה","tr":"hin·neh","gloss":"behold","lang":"h","inPassage":1,"uses":843}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":128,"verse":5,"verseEnd":5,"votes":12,"source":"both","text":"May the LORD bless you from Zion, that you may see the prosperity of Jerusalem all the days of your life,","from":3},{"book":"PSA","chapter":28,"verse":2,"verseEnd":2,"votes":11,"source":"both","text":"Hear my cry for mercy when I call to You for help, when I lift up my hands toward Your holy sanctuary.","from":2},{"book":"PSA","chapter":63,"verse":4,"verseEnd":4,"votes":9,"source":"both","text":"So I will bless You as long as I live; in Your name I will lift my hands.","from":2},{"book":"PSA","chapter":120,"verse":1,"verseEnd":1,"votes":9,"source":"openbible","text":"In my distress I cried to the LORD, and He answered me.","from":1},{"book":"1TI","chapter":2,"verse":8,"verseEnd":8,"votes":9,"source":"both","text":"Therefore I want the men everywhere to pray, lifting up holy hands, without anger or dissension.","from":2},{"book":"1CH","chapter":9,"verse":33,"verseEnd":33,"votes":8,"source":"both","text":"Those who were musicians, the heads of Levite families, stayed in the temple chambers and were exempt from other duties because they were on duty day and night.","from":1},{"book":"PSA","chapter":135,"verse":1,"verseEnd":1,"votes":8,"source":"openbible","text":"Hallelujah! Praise the name of the LORD. Give praise, O servants of the LORD,","from":1},{"book":"PSA","chapter":135,"verse":2,"verseEnd":2,"votes":8,"source":"openbible","text":"who stand in the house of the LORD, in the courts of the house of our God.","from":1}],"notes":[],"groups":[]}}