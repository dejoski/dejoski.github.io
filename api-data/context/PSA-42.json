{"1-4":{"people":[{"id":"korah-h7141i","name":"Korah","kind":"person","brief":"Aaron's adversary","count":1,"firstVerse":1}],"places":[],"words":[{"base":"H6165","lemma":"עָרַג","tr":"a·rag","gloss":"to long for","lang":"h","inPassage":2,"uses":3},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":3,"uses":754},{"base":"H1718","lemma":"דָּדָה","tr":"da·dah","gloss":"to go slowly","lang":"h","inPassage":1,"uses":2},{"base":"H6770","lemma":"צָמֵא","tr":"tsa·me","gloss":"to thirst","lang":"h","inPassage":1,"uses":10},{"base":"H0354","lemma":"אַיָּל","tr":"ay·yal","gloss":"deer","lang":"h","inPassage":1,"uses":11},{"base":"H2287","lemma":"חָגַג","tr":"cha·gag","gloss":"to celebrate","lang":"h","inPassage":1,"uses":16},{"base":"H0650","lemma":"אָפִיק","tr":"a·phiq","gloss":"channel","lang":"h","inPassage":1,"uses":19},{"base":"H1832","lemma":"דִּמְעָה","tr":"dim·ah","gloss":"tears","lang":"h","inPassage":1,"uses":23},{"base":"H8426","lemma":"תּוֹדָה","tr":"to·dah","gloss":"thanksgiving","lang":"h","inPassage":1,"uses":32},{"base":"H7440","lemma":"רִנָּה","tr":"rin·nah","gloss":"cry","lang":"h","inPassage":1,"uses":33}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":63,"verse":1,"verseEnd":1,"votes":63,"source":"openbible","text":"O God, You are my God. Earnestly I seek You; my soul thirsts for You. My body yearns for You in a dry and weary land without water.","from":1},{"book":"PSA","chapter":63,"verse":2,"verseEnd":2,"votes":63,"source":"openbible","text":"So I have seen You in the sanctuary and beheld Your power and glory.","from":1},{"book":"PSA","chapter":143,"verse":6,"verseEnd":6,"votes":46,"source":"openbible","text":"I stretch out my hands to You; my soul thirsts for You like a parched land. Selah","from":1},{"book":"PSA","chapter":143,"verse":7,"verseEnd":7,"votes":46,"source":"openbible","text":"Answer me quickly, O LORD; my spirit fails. Do not hide Your face from me, or I will be like those who descend to the Pit.","from":1},{"book":"PSA","chapter":119,"verse":131,"verseEnd":131,"votes":38,"source":"openbible","text":"I open my mouth and pant, longing for Your commandments.","from":1},{"book":"ISA","chapter":26,"verse":8,"verseEnd":8,"votes":35,"source":"openbible","text":"Yes, we wait for You, O LORD; we walk in the path of Your judgments. Your name and renown are the desire of our souls.","from":1},{"book":"ISA","chapter":26,"verse":9,"verseEnd":9,"votes":35,"source":"openbible","text":"My soul longs for You in the night; indeed, my spirit seeks You at dawn. For when Your judgments come upon the earth, the people of the world learn righteousness.","from":1},{"book":"PSA","chapter":84,"verse":1,"verseEnd":1,"votes":31,"source":"both","text":"How lovely is Your dwelling place, O LORD of Hosts!","from":1}],"notes":[],"groups":[]},"5-5":{"people":[],"places":[],"words":[{"base":"H7817","lemma":"שָׁחַח","tr":"sha·chach","gloss":"to bow","lang":"h","inPassage":1,"uses":21},{"base":"H1993","lemma":"הָמָה","tr":"ha·mah","gloss":"to roar","lang":"h","inPassage":1,"uses":34},{"base":"H3176","lemma":"יָחַל","tr":"ya·chal","gloss":"to wait: wait","lang":"h","inPassage":1,"uses":41},{"base":"H3444","lemma":"יְשׁוּעָה","tr":"ye·shu·ah","gloss":"salvation","lang":"h","inPassage":1,"uses":78},{"base":"H3034","lemma":"יָדָה","tr":"ya·dah","gloss":"to give thanks","lang":"h","inPassage":1,"uses":114},{"base":"H5750","lemma":"עוֹד","tr":"od","gloss":"still","lang":"h","inPassage":1,"uses":490},{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":1,"uses":752},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":1,"uses":754}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":37,"verse":7,"verseEnd":7,"votes":54,"source":"both","text":"Be still before the LORD and wait patiently for Him; do not fret when men prosper in their ways, when they carry out wicked schemes.","from":5},{"book":"HEB","chapter":10,"verse":36,"verseEnd":36,"votes":37,"source":"openbible","text":"You need to persevere, so that after you have done the will of God, you will receive what He has promised.","from":5},{"book":"HEB","chapter":10,"verse":37,"verseEnd":37,"votes":37,"source":"openbible","text":"For, “In just a little while, He who is coming will come and will not delay.","from":5},{"book":"PSA","chapter":61,"verse":2,"verseEnd":2,"votes":30,"source":"both","text":"From the ends of the earth I call out to You whenever my heart is faint. Lead me to the rock that is higher than I.","from":5},{"book":"MAT","chapter":1,"verse":23,"verseEnd":23,"votes":22,"source":"both","text":"“Behold, the virgin will be with child and will give birth to a son, and they will call Him Immanuel” (which means, “God with us”).","from":5},{"book":"PSA","chapter":27,"verse":13,"verseEnd":13,"votes":21,"source":"openbible","text":"Still I am certain to see the goodness of the LORD in the land of the living.","from":5},{"book":"PSA","chapter":27,"verse":14,"verseEnd":14,"votes":21,"source":"openbible","text":"Wait patiently for the LORD; be strong and courageous. Wait patiently for the LORD!","from":5},{"book":"PSA","chapter":56,"verse":3,"verseEnd":3,"votes":21,"source":"both","text":"When I am afraid, I put my trust in You.","from":5}],"notes":[],"groups":[]},"6-10":{"people":[],"places":[{"id":"hermon-mount-h2768","name":"Hermon Mount","kind":"place","brief":"","count":1,"firstVerse":6},{"id":"jordan-h3383","name":"Jordan","kind":"place","brief":"","count":1,"firstVerse":6},{"id":"mizar-mount-h4706","name":"Mizar Mount","kind":"place","brief":"","count":1,"firstVerse":6}],"words":[{"base":"H8415","lemma":"תְּהוֹם","tr":"te·hom","gloss":"abyss","lang":"h","inPassage":2,"uses":36},{"base":"H0410","lemma":"אֵל","tr":"el","gloss":"God","lang":"h","inPassage":2,"uses":241},{"base":"H6794","lemma":"צִנּוֹר","tr":"tsin·nur","gloss":"water","lang":"h","inPassage":1,"uses":2},{"base":"H7524","lemma":"רֶ֫צַח","tr":"re·tsach","gloss":"shattering","lang":"h","inPassage":1,"uses":2},{"base":"H4867","lemma":"מִשְׁבָּר","tr":"mish·bar","gloss":"wave","lang":"h","inPassage":1,"uses":5},{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":2,"uses":752},{"base":"H3906","lemma":"לַ֫חַץ","tr":"la·chats","gloss":"oppression","lang":"h","inPassage":1,"uses":12},{"base":"H6937","lemma":"קָדַר","tr":"qa·dar","gloss":"be dark","lang":"h","inPassage":1,"uses":17},{"base":"H7817","lemma":"שָׁחַח","tr":"sha·chach","gloss":"to bow","lang":"h","inPassage":1,"uses":21},{"base":"H1530","lemma":"גַּל","tr":"gal","gloss":"heap","lang":"h","inPassage":1,"uses":34}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":61,"verse":2,"verseEnd":2,"votes":16,"source":"both","text":"From the ends of the earth I call out to You whenever my heart is faint. Lead me to the rock that is higher than I.","from":6},{"book":"JON","chapter":2,"verse":3,"verseEnd":3,"votes":15,"source":"both","text":"For You cast me into the deep, into the heart of the seas, and the current swirled about me; all Your breakers and waves swept over me.","from":7},{"book":"PSA","chapter":16,"verse":7,"verseEnd":7,"votes":10,"source":"openbible","text":"I will bless the LORD who counsels me; even at night my conscience instructs me.","from":8},{"book":"PSA","chapter":63,"verse":6,"verseEnd":6,"votes":10,"source":"both","text":"When I remember You on my bed, I think of You through the watches of the night.","from":8},{"book":"PSA","chapter":69,"verse":14,"verseEnd":14,"votes":10,"source":"openbible","text":"Rescue me from the mire and do not let me sink; deliver me from my foes and out of the deep waters.","from":7},{"book":"PSA","chapter":69,"verse":15,"verseEnd":15,"votes":10,"source":"openbible","text":"Do not let the floods engulf me or the depths swallow me up; let not the Pit close its mouth over me.","from":7},{"book":"PSA","chapter":149,"verse":5,"verseEnd":5,"votes":10,"source":"both","text":"Let the saints exult in glory; let them shout for joy upon their beds.","from":8},{"book":"JON","chapter":2,"verse":7,"verseEnd":7,"votes":10,"source":"both","text":"As my life was fading away, I remembered the LORD. My prayer went up to You, to Your holy temple.","from":6}],"notes":[],"groups":[]},"11-11":{"people":[],"places":[],"words":[{"base":"H4100","lemma":"מָה","tr":"mah","gloss":"what?","lang":"h","inPassage":2,"uses":752},{"base":"H7817","lemma":"שָׁחַח","tr":"sha·chach","gloss":"to bow","lang":"h","inPassage":1,"uses":21},{"base":"H1993","lemma":"הָמָה","tr":"ha·mah","gloss":"to roar","lang":"h","inPassage":1,"uses":34},{"base":"H3176","lemma":"יָחַל","tr":"ya·chal","gloss":"to wait: wait","lang":"h","inPassage":1,"uses":41},{"base":"H3444","lemma":"יְשׁוּעָה","tr":"ye·shu·ah","gloss":"salvation","lang":"h","inPassage":1,"uses":78},{"base":"H3034","lemma":"יָדָה","tr":"ya·dah","gloss":"to give thanks","lang":"h","inPassage":1,"uses":114},{"base":"H5750","lemma":"עוֹד","tr":"od","gloss":"still","lang":"h","inPassage":1,"uses":490},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":1,"uses":754}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":42,"verse":5,"verseEnd":5,"votes":17,"source":"both","text":"Why are you downcast, O my soul? Why the unease within me? Put your hope in God, for I will yet praise Him for the salvation of His presence.","from":11},{"book":"JER","chapter":33,"verse":6,"verseEnd":6,"votes":16,"source":"both","text":"Nevertheless, I will bring to it health and healing, and I will heal its people and reveal to them the abundance of peace and truth.","from":11},{"book":"JER","chapter":30,"verse":17,"verseEnd":17,"votes":14,"source":"both","text":"But I will restore your health and heal your wounds, declares the LORD, because they call you an outcast, Zion, for whom no one cares.”","from":11},{"book":"PSA","chapter":43,"verse":5,"verseEnd":5,"votes":13,"source":"both","text":"Why are you downcast, O my soul? Why the unease within me? Put your hope in God, for I will yet praise Him, my Savior and my God.","from":11},{"book":"MAT","chapter":9,"verse":12,"verseEnd":12,"votes":0,"source":"tsk","text":"On hearing this, Jesus said, “It is not the healthy who need a doctor, but the sick.","from":11}],"notes":[],"groups":[]}}