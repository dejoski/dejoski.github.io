on-h1391","name":"Gibeon","kind":"place","brief":"","count":1,"firstVerse":7},{"id":"meronothites-h4824","name":"Meronothites","kind":"place","brief":"","count":1,"firstVerse":7},{"id":"mizpah-h4709g","name":"Mizpah","kind":"place","brief":"","count":1,"firstVerse":7},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":3,"firstVerse":8},{"id":"broad-wall-h7342g","name":"Broad Wall","kind":"place","brief":"","count":1,"firstVerse":8},{"id":"tower-of-the-ovens-h4026i","name":"Tower of the Ovens","kind":"place","brief":"","count":1,"firstVerse":11}],"words":[{"base":"H2388","lemma":"חָזַק","tr":"cha·zaq","gloss":"to strengthen: strengthen","lang":"h","inPassage":9,"uses":291},{"base":"H6418","lemma":"פֶּ֫לֶךְ","tr":"pe·lekh","gloss":"district","lang":"h","inPassage":2,"uses":10},{"base":"H6355","lemma":"פַּ֫חַת מוֹאָב","tr":"pa·chat mo·av","gloss":"Pahath-moab","lang":"h","inPassage":2,"uses":12},{"base":"H3389","lemma":"יְרוּשָׁלִַ֫ם, יְרוּשְׁלֵם","tr":"ye·ru·sha·laim","gloss":"Jerusalem","lang":"h","inPassage":3,"uses":643},{"base":"H2677","lemma":"חֲצִי","tr":"che·tsi","gloss":"half","lang":"h","inPassage":2,"uses":125},{"base":"H2813","lemma":"חֲשַׁבְנְיָה","tr":"cha·shav·ne·yah","gloss":"Hashabneiah","lang":"h","inPassage":1,"uses":2},{"base":"H3042","lemma":"יְדָיָה","tr":"ye·da·yah","gloss":"Jedaiah","lang":"h","inPassage":1,"uses":2},{"base":"H3873","lemma":"הַלּוֹחֵשׁ","tr":"lo·chesh","gloss":"Hallohesh","lang":"h","inPassage":1,"uses":2},{"base":"H4824","lemma":"מֵרֹנֹתִי","tr":"me·ro·no·ti","gloss":"Meronothite","lang":"h","inPassage":1,"uses":2},{"base":"H8269","lemma":"שַׂר","tr":"sar","gloss":"ruler","lang":"h","inPassage":2,"uses":421}],"parallels":[],"crossrefs":[{"book":"NEH","chapter":12,"verse":38,"verseEnd":38,"votes":5,"source":"both","text":"The second thanksgiving choir proceeded to the left, and I followed it with half the people along the top of the wall, past the Tower of the Ovens to the Broad Wall,","from":8},{"book":"NEH","chapter":12,"verse":38,"verseEnd":38,"votes":5,"source":"both","text":"The second thanksgiving choir proceeded to the left, and I followed it with half the people along the top of the wall, past the Tower of the Ovens to the Broad Wall,","from":11},{"book":"NEH","chapter":12,"verse":39,"verseEnd":39,"votes":5,"source":"both","text":"over the Gate of Ephraim, the Jeshanah Gate, the Fish Gate, the Tower of Hananel, and the Tower of the Hundred, as far as the Sheep Gate. And they stopped at the Gate of the Guard.","from":6},{"book":"GEN","chapter":50,"verse":2,"verseEnd":2,"votes":0,"source":"tsk","text":"And Joseph directed the physicians in his service to embalm his father Israel. So they embalmed him,","from":8},{"book":"EXO","chapter":30,"verse":25,"verseEnd":25,"votes":0,"source":"tsk","text":"Prepare from these a sacred anointing oil, a fragrant blend, the work of a perfumer; it will be a sacred anointing oil.","from":8},{"book":"EXO","chapter":35,"verse":25,"verseEnd":25,"votes":0,"source":"tsk","text":"Every skilled woman spun with her hands and brought what she had spun: blue, purple, or scarlet yarn, or fine linen.","from":12},{"book":"JOS","chapter":9,"verse":3,"verseEnd":27,"votes":0,"source":"tsk","text":"But the people of Gibeon, having heard what Joshua had done to Jericho and Ai, acted deceptively and set out as envoys, carrying on their donkeys worn-out sacks and old wineskins, cracked and mended. They put worn, patched sandals on their feet and threadbare clothing on their bodies, and their whole supply of bread was dry and moldy. They went to Joshua in the camp at Gilgal and said to him and the men of Israel, “We have come from a distant land; please make a treaty with us.” But the men of Israel said to the Hivites, “Perhaps you dwell near us. How can we make a treaty with you?”","from":7},{"book":"2SA","chapter":21,"verse":2,"verseEnd":2,"votes":0,"source":"tsk","text":"At this, David summoned the Gibeonites and spoke to them. (Now the Gibeonites were not Israelites, but a remnant of the Amorites. The Israelites had taken an oath concerning them, but in his zeal for Israel and Judah, Saul had sought to kill them.)","from":7}],"notes":[],"groups":[]},"13-15":{"people":[{"id":"hanun-h2586h","name":"Hanun","kind":"person","brief":"Returned builder","count":1,"firstVerse":13},{"id":"malchijah-h4441n","name":"Malchijah","kind":"person","brief":"Returned builder","count":1,"firstVerse":14},{"id":"rechab-h7394i","name":"Rechab","kind":"person","brief":"Returned builder","count":1,"firstVerse":14},{"id":"col-hozeh-h3626g","name":"Col-hozeh","kind":"person","brief":"Returned builder","count":1,"firstVerse":15},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":15},{"id":"shallum-h7968","name":"Shallum","kind":"person","brief":"Returned builder","count":1,"firstVerse":15}],"places":[{"id":"dung-gate-h0830g","name":"Dung Gate","kind":"place","brief":"","count":2,"firstVerse":13},{"id":"valley-gate-h1516m","name":"Valley Gate","kind":"place","brief":"","count":1,"firstVerse":13},{"id":"zanoah-h2182g","name":"Zanoah","kind":"place","brief":"","count":1,"firstVerse":13},{"id":"beth-haccherem-h1021","name":"Beth-haccherem","kind":"place","brief":"","count":1,"firstVerse":14},{"id":"fountain-gate-h5869b","name":"Fountain Gate","kind":"place","brief":"","count":1,"firstVerse":15},{"id":"mizpah-h4709g","name":"Mizpah","kind":"place","brief":"","count":1,"firstVerse":15},{"id":"shelah-h7975a","name":"Shelah","kind":"place","brief":"","count":1,"firstVerse":15}],"words":[{"base":"H4514","lemma":"מַנְעוּל","tr":"man·ul","gloss":"bolt","lang":"h","inPassage":3,"uses":6},{"base":"H1280","lemma":"בְּרִיחַ","tr":"be·ri·ach","gloss":"bar","lang":"h","inPassage":3,"uses":40},{"base":"H8179","lemma":"שַׁ֫עַר","tr":"sha·ar","gloss":"gate","lang":"h","inPassage":4,"uses":374},{"base":"H1817","lemma":"דָּל","tr":"dal","gloss":"door","lang":"h","inPassage":3,"uses":88},{"base":"H1021","lemma":"בֵּית הַכֶּ֫רֶם","tr":"bet hak·ke·rem","gloss":"Beth-haccherem","lang":"h","inPassage":2,"uses":4},{"base":"H3626","lemma":"כׇּל־חֹזֶה","tr":"kol-cho·zeh","gloss":"Col-hozeh","lang":"h","inPassage":2,"uses":4},{"base":"H0830","lemma":"אַשְׁפֹּת","tr":"ash·pot","gloss":"Dung (Gate)","lang":"h","inPassage":2,"uses":7},{"base":"H6418","lemma":"פֶּ֫לֶךְ","tr":"pe·lekh","gloss":"district","lang":"h","inPassage":2,"uses":10},{"base":"H2388","lemma":"חָזַק","tr":"cha·zaq","gloss":"to strengthen: strengthen","lang":"h","inPassage":3,"uses":291},{"base":"H1129","lemma":"בָּנָה","tr":"ba·nah","gloss":"to build","lang":"h","inPassage":3,"uses":376}],"parallels":[],"crossrefs":[{"book":"NEH","chapter":2,"verse":13,"verseEnd":13,"votes":6,"source":"both","text":"So I went out at night through the Valley Gate toward the Well of the Serpent and the Dung Gate, and I inspected the walls of Jerusalem that had been broken down and the gates that had been destroyed by fire.","from":13},{"book":"JHN","chapter":9,"verse":7,"verseEnd":7,"votes":6,"source":"both","text":"Then He told him, “Go, wash in the Pool of Siloam” (which means “Sent”). So the man went and washed, and came back seeing.","from":15},{"book":"ISA","chapter":8,"verse":6,"verseEnd":6,"votes":5,"source":"both","text":"“Because this people has rejected the gently flowing waters of Shiloah and rejoiced in Rezin and the son of Remaliah,","from":15},{"book":"JER","chapter":6,"verse":1,"verseEnd":1,"votes":5,"source":"both","text":"“Run for cover, O sons of Benjamin; flee from Jerusalem! Sound the ramʼs horn in Tekoa; send up a signal over Beth-haccherem, for disaster looms from the north, even great destruction.","from":14},{"book":"JOS","chapter":15,"verse":34,"verseEnd":34,"votes":0,"source":"tsk","text":"Zanoah, En-gannim, Tappuah, Enam,","from":13},{"book":"JOS","chapter":15,"verse":56,"verseEnd":56,"votes":0,"source":"tsk","text":"Jezreel, Jokdeam, Zanoah,","from":13},{"book":"JDG","chapter":20,"verse":1,"verseEnd":1,"votes":0,"source":"tsk","text":"Then all the Israelites from Dan to Beersheba and from the land of Gilead came out, and the congregation assembled as one man before the LORD at Mizpah.","from":15},{"book":"JDG","chapter":20,"verse":3,"verseEnd":3,"votes":0,"source":"tsk","text":"(Meanwhile the Benjamites heard that the Israelites had gone up to Mizpah.) And the Israelites asked, “Tell us, how did this wicked thing happen?”","from":15}],"notes":[],"groups":[]},"16-27":{"people":[{"id":"azbuk-h5802","name":"Azbuk","kind":"person","brief":"Returned builder","count":1,"firstVerse":16},{"id":"david-h1732","name":"David","kind":"person","brief":"King of Judah","count":1,"firstVerse":16},{"id":"nehemiah-h5166i","name":"Nehemiah","kind":"person","brief":"Returned builder","count":1,"firstVerse":16},{"id":"bani-h1137l","name":"Bani","kind":"person","brief":"Returned builder","count":1,"firstVerse":17},{"id":"hashabiah-h2811n","name":"Hashabiah","kind":"person","brief":"Returned builder","count":1,"firstVerse":17},{"id":"levi-h3878","name":"Levi","kind":"person","brief":"Son of Israel","count":1,"firstVerse":17},{"id":"rehum-h7348g","name":"Rehum","kind":"person","brief":"Returned builder","count":1,"firstVerse":17},{"id":"bavvai-h0942","name":"Bavvai","kind":"person","brief":"Returned leader","count":1,"firstVerse":18},{"id":"henadad-h2582h","name":"Henadad","kind":"person","brief":"Returned builder","count":1,"firstVerse":18},{"id":"ezer-h5829i","name":"Ezer","kind":"person","brief":"Returned builder","count":1,"firstVerse":19},{"id":"jeshua-h3442l","name":"Jeshua","kind":"person","brief":"Returned builder","count":1,"firstVerse":19},{"id":"eliashib-h0475m","name":"Eliashib","kind":"person","brief":"High Priest","count":2,"firstVerse":20},{"id":"baruch-h1263g","name":"Baruch","kind":"person","brief":"Returned builder","count":1,"firstVerse":20},{"id":"zabbai-h2079h","name":"Zabbai","kind":"person","brief":"Returned builder","count":1,"firstVerse":20},{"id":"hakkoz-h6976