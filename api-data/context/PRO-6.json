{"1-5":{"people":[],"places":[],"words":[{"base":"H7453","lemma":"רֵעַ","tr":"re·a","gloss":"neighbor","lang":"h","inPassage":3,"uses":188},{"base":"H0561","lemma":"אֵמֶר","tr":"e·mer","gloss":"word","lang":"h","inPassage":2,"uses":49},{"base":"H3709","lemma":"כַּף","tr":"kaph","gloss":"palm","lang":"h","inPassage":2,"uses":193},{"base":"H5337","lemma":"נָצַל","tr":"na·tsal","gloss":"to rescue","lang":"h","inPassage":2,"uses":213},{"base":"H7511","lemma":"רָפַס","tr":"ra·phas","gloss":"to stamp","lang":"h","inPassage":1,"uses":2},{"base":"H3353","lemma":"יָקוּשׁ","tr":"ya·qush","gloss":"fowler","lang":"h","inPassage":1,"uses":3},{"base":"H7292","lemma":"רָהַב","tr":"ra·hav","gloss":"to be assertive","lang":"h","inPassage":1,"uses":4},{"base":"H6310","lemma":"פֶּה","tr":"peh","gloss":"lip","lang":"h","inPassage":2,"uses":498},{"base":"H8572","lemma":"תְּנוּמָה","tr":"te·nu·mah","gloss":"slumber","lang":"h","inPassage":1,"uses":5},{"base":"H3369","lemma":"יָקֹשׁ","tr":"ya·qosh","gloss":"to snare","lang":"h","inPassage":1,"uses":8}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":18,"verse":7,"verseEnd":7,"votes":16,"source":"both","text":"A foolʼs mouth is his ruin, and his lips are a snare to his soul.","from":2},{"book":"PRO","chapter":12,"verse":13,"verseEnd":13,"votes":15,"source":"both","text":"An evil man is trapped by his rebellious speech, but a righteous man escapes from trouble.","from":2},{"book":"PSA","chapter":132,"verse":4,"verseEnd":4,"votes":8,"source":"both","text":"I will not give sleep to my eyes or slumber to my eyelids,","from":4},{"book":"PRO","chapter":17,"verse":18,"verseEnd":18,"votes":8,"source":"both","text":"A man lacking judgment strikes hands in pledge and puts up security for his neighbor.","from":1},{"book":"PRO","chapter":22,"verse":26,"verseEnd":26,"votes":8,"source":"both","text":"Do not be one who gives pledges, who puts up security for debts.","from":1},{"book":"PSA","chapter":91,"verse":3,"verseEnd":3,"votes":7,"source":"openbible","text":"Surely He will deliver you from the snare of the fowler, and from the deadly plague.","from":5},{"book":"PRO","chapter":11,"verse":15,"verseEnd":15,"votes":7,"source":"both","text":"He who puts up security for a stranger will surely suffer, but the one who hates indebtedness is secure.","from":1},{"book":"PSA","chapter":124,"verse":7,"verseEnd":7,"votes":6,"source":"both","text":"We have escaped like a bird from the snare of the fowler; the net is torn, and we have slipped away.","from":5}],"notes":[],"groups":[]},"6-11":{"people":[],"places":[],"words":[{"base":"H4592","lemma":"מְעַט","tr":"me·at","gloss":"little","lang":"h","inPassage":3,"uses":101},{"base":"H6102","lemma":"עָצֵל","tr":"a·tsel","gloss":"sluggish","lang":"h","inPassage":2,"uses":14},{"base":"H8142","lemma":"שֵׁנָה","tr":"she·nah","gloss":"sleep","lang":"h","inPassage":2,"uses":23},{"base":"H4970","lemma":"מָתַי","tr":"ma·tay","gloss":"how","lang":"h","inPassage":2,"uses":43},{"base":"H7901","lemma":"שָׁכַב","tr":"sha·khav","gloss":"to lie down: lay down","lang":"h","inPassage":2,"uses":212},{"base":"H2264","lemma":"חִבֻּק","tr":"chib·buq","gloss":"folding","lang":"h","inPassage":1,"uses":2},{"base":"H5244","lemma":"נְמָלָה","tr":"ne·ma·lah","gloss":"ant","lang":"h","inPassage":1,"uses":2},{"base":"H0103","lemma":"אָגַר","tr":"a·gar","gloss":"to gather","lang":"h","inPassage":1,"uses":3},{"base":"H8572","lemma":"תְּנוּמָה","tr":"te·nu·mah","gloss":"slumber","lang":"h","inPassage":1,"uses":5},{"base":"H7389","lemma":"רֵישׁ","tr":"resh","gloss":"poverty","lang":"h","inPassage":1,"uses":7}],"parallels":[],"crossrefs":[{"book":"PRO","chapter":20,"verse":4,"verseEnd":4,"votes":18,"source":"both","text":"The slacker does not plow in season; at harvest time he looks, but nothing is there.","from":6},{"book":"PRO","chapter":18,"verse":9,"verseEnd":9,"votes":16,"source":"both","text":"Whoever is slothful in his work is brother to him who destroys.","from":6},{"book":"PRO","chapter":13,"verse":4,"verseEnd":4,"votes":13,"source":"both","text":"The slacker craves yet has nothing, but the soul of the diligent is fully satisfied.","from":6},{"book":"HEB","chapter":6,"verse":12,"verseEnd":12,"votes":13,"source":"both","text":"Then you will not be sluggish, but will imitate those who through faith and patience inherit what has been promised.","from":6},{"book":"PRO","chapter":30,"verse":25,"verseEnd":25,"votes":12,"source":"openbible","text":"The ants are creatures of little strength, yet they store up their food in the summer;","from":6},{"book":"MAT","chapter":25,"verse":26,"verseEnd":26,"votes":12,"source":"both","text":"‘You wicked, lazy servant!’ replied his master. ‘You knew that I reap where I have not sown and gather where I have not scattered seed.","from":6},{"book":"ROM","chapter":12,"verse":11,"verseEnd":11,"votes":10,"source":"both","text":"Do not let your zeal subside; keep your spiritual fervor, serving the Lord.","from":6},{"book":"PRO","chapter":26,"verse":13,"verseEnd":13,"votes":9,"source":"openbible","text":"The slacker says, “A lion is in the road! A fierce lion roams the public square!”","from":6}],"notes":[],"groups":[]},"12-15":{"people":[],"places":[],"words":[{"base":"H6143","lemma":"עִקְּשׁוּת","tr":"iq·q·shut","gloss":"crookedness","lang":"h","inPassage":1,"uses":2},{"base":"H4448","lemma":"מָלַל","tr":"ma·lal","gloss":"to speak","lang":"h","inPassage":1,"uses":5},{"base":"H7169","lemma":"קָרַץ","tr":"qa·rats","gloss":"to wink","lang":"h","inPassage":1,"uses":5},{"base":"H6621","lemma":"פֶּתַע","tr":"pe·ta","gloss":"suddenness","lang":"h","inPassage":1,"uses":7},{"base":"H4079","lemma":"מִדְיָן","tr":"mid·yan","gloss":"contention","lang":"h","inPassage":1,"uses":10},{"base":"H8419","lemma":"תַּהְפֻּכָה","tr":"tah·pu·khah","gloss":"perversity","lang":"h","inPassage":1,"uses":10},{"base":"H4832","lemma":"מַרְפֵּא","tr":"mar·pe","gloss":"healing","lang":"h","inPassage":1,"uses":16},{"base":"H0343","lemma":"אֵיד","tr":"ed","gloss":"calamity","lang":"h","inPassage":1,"uses":24},{"base":"H6597","lemma":"פִּתְאֹם","tr":"pit·om","gloss":"suddenly","lang":"h","inPassage":1,"uses":25},{"base":"H1100","lemma":"בְּלִיַּ֫עַל","tr":"be·liy·ya·al","gloss":"Belial","lang":"h","inPassage":1,"uses":27}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":35,"verse":19,"verseEnd":19,"votes":6,"source":"both","text":"Let not my enemies gloat over me without cause, nor those who hate me without reason wink in malice.","from":13},{"book":"PRO","chapter":4,"verse":24,"verseEnd":24,"votes":6,"source":"both","text":"Put away deception from your mouth; keep your lips from perverse speech.","from":12},{"book":"PRO","chapter":16,"verse":27,"verseEnd":27,"votes":6,"source":"openbible","text":"A worthless man digs up evil, and his speech is like a scorching fire.","from":12},{"book":"JER","chapter":19,"verse":11,"verseEnd":11,"votes":6,"source":"both","text":"and you are to proclaim to them that this is what the LORD of Hosts says: I will shatter this nation and this city, like one shatters a potterʼs jar that can never again be repaired. They will bury the dead in Topheth until there is no more room to bury them.","from":15},{"book":"MAT","chapter":12,"verse":34,"verseEnd":34,"votes":6,"source":"both","text":"You brood of vipers, how can you who are evil say anything good? For out of the overflow of the heart, the mouth speaks.","from":12},{"book":"2CH","chapter":36,"verse":16,"verseEnd":16,"votes":5,"source":"both","text":"But they mocked the messengers of God, despising His words and scoffing at His prophets, until the wrath of the LORD against His people was stirred up beyond remedy.","from":15},{"book":"JOB","chapter":15,"verse":12,"verseEnd":12,"votes":5,"source":"both","text":"Why has your heart carried you away, and why do your eyes flash,","from":13},{"book":"PRO","chapter":10,"verse":10,"verseEnd":10,"votes":5,"source":"both","text":"He who winks the eye causes grief, and foolish lips will come to ruin.","from":13}],"notes":[],"groups":[]},"16-19":{"people":[],"places":[],"words":[{"base":"H8267","lemma":"שֶׁ֫קֶר","tr":"she·qer","gloss":"deception","lang":"h","inPassage":2,"uses":113},{"base":"H4090","lemma":"מְדָן","tr":"me·dan","gloss":"strife","lang":"h","inPassage":1,"uses":2},{"base":"H6315","lemma":"פּוּחַ","tr":"pu·ach","gloss":"to breathe","lang":"h","inPassage":1,"uses":14},{"base":"H2007","lemma":"הֵנָּה","tr":"hen·nah","gloss":"they(fem.)","lang":"h","inPassage":1,"uses":30},{"base":"H3577","lemma":"כָּזָב","tr":"ka·zav","gloss":"lie","lang":"h","inPassage":1,"uses":31},{"base":"H5355","lemma":"נָקִי","tr":"na·qi","gloss":"innocent","lang":"h","inPassage":1,"uses":43},{"base":"H4284","lemma":"מַחֲשָׁבָה","tr":"ma·cha·sha·vah","gloss":"plot","lang":"h","inPassage":1,"uses":56},{"base":"H4116","lemma":"מָהַר","tr":"ma·har","gloss":"to hasten","lang":"h","inPassage":1,"uses":68},{"base":"H5707","lemma":"עֵד","tr":"ed","gloss":"witness","lang":"h","inPassage":1,"uses":70},{"base":"H2790","lemma":"חָרַשׁ","tr":"cha·rash","gloss":"to plow","lang":"h","inPassage":1,"uses":74}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":120,"verse":2,"verseEnd":2,"votes":31,"source":"openbible","text":"Deliver my soul, O LORD, from lying lips and a deceitful tongue.","from":17},{"book":"PSA","chapter":120,"verse":3,"verseEnd":3,"votes":31,"source":"openbible","text":"What will He do to you, and what will be added to you, O deceitful tongue?","from":17},{"book":"PSA","chapter":11,"verse":5,"verseEnd":5,"votes":23,"source":"both","text":"The LORD tests the righteous and the wicked; His soul hates the lover of violence.","from":16},{"book":"PRO","chapter":8,"verse":13,"verseEnd":13,"votes":16,"source":"both","text":"To fear the LORD is to hate evil; I hate arrogant pride, evil conduct, and perverse speech.","from":16},{"book":"PRO","chapter":12,"verse":22,"verseEnd":22,"votes":16,"source":"both","text":"Lying lips are detestable to the LORD, but those who deal faithfully are His delight.","from":17},{"book":"PRO","chapter":11,"verse":20,"verseEnd":20,"votes":14,"source":"both","text":"The perverse in heart are an abomination to the LORD, but the blameless in their walk are His delight.","from":16},{"book":"GEN","chapter":6,"verse":5,"verseEnd":5,"votes":12,"source":"both","text":"Then the Lordsaw that the wickedness of man was great upon the earth, and that every inclination of the thoughts of his heart was altogether evil all the time.","from":18},{"book":"ISA","chapter":1,"verse":15,"verseEnd":15,"votes":12,"source":"both","text":"When you spread out your hands in prayer, I will hide My eyes from you; even though you multiply your prayers, I will not listen. Your hands are covered with blood.","from":17}],"notes":[],"groups":[]},"20-26":{"people":[],"places":[],"words":[{"base":"H0408","lemma":"אַל","tr":"al","gloss":"not","lang":"h","inPassage":3,"uses":724},{"base":"H0802","lemma":"אִשָּׁה","tr":"ish·shah","gloss":"woman","lang":"h","inPassage":3,"uses":781},{"base":"H4687","lemma":"מִצְוָה","tr":"mits·vah","gloss":"commandment","lang":"h","inPassage":2,"uses":181},{"base":"H8451","lemma":"תּוֹרָה","tr":"to·rah","gloss":"instruction","lang":"h","inPassage":2,"uses":219},{"base":"H6029","lemma":"עָנַד","tr":"a·nad","gloss":"to bind","lang":"h","inPassage":1,"uses":2},{"base":"H8104","lemma":"שָׁמַר","tr":"sha·mar","gloss":"to keep: obey","lang":"h","inPassage":2,"uses":469},{"base":"H1621","lemma":"גַּרְגְּרוֹת","tr":"gar·ge·rot","gloss":"neck","lang":"h","inPassage":1,"uses":4},{"base":"H6079","lemma":"עַפְעַף","tr":"aph·aph","gloss":"eyelid","lang":"h","inPassage":1,"uses":10},{"base":"H6679","lemma":"צוּד","tr":"tsud","gloss":"to hunt","lang":"h","inPassage":1,"uses":18},{"base":"H3308","lemma":"יֳפִי","tr":"yo·phi","gloss":"beauty","lang":"h","inPassage":1,"uses":19}],"parallels":[],"crossrefs":[{"book":"PSA","chapter":119,"verse":105,"verseEnd":105,"votes":19,"source":"both","text":"Your word is a lamp to my feet and a light to my path.","from":23},{"book":"PSA","chapter":19,"verse":8,"verseEnd":8,"votes":13,"source":"both","text":"The precepts of the LORD are right, bringing joy to the heart; the commandments of the LORD are radiant, giving light to the eyes.","from":23},{"book":"2PE","chapter":1,"verse":19,"verseEnd":19,"votes":13,"source":"both","text":"We also have the word of the prophets as confirmed beyond doubt. And you will do well to pay attention to it, as to a lamp shining in a dark place, until the day dawns and the morning star rises in your hearts.","from":23},{"book":"PRO","chapter":15,"verse":31,"verseEnd":31,"votes":12,"source":"both","text":"He who listens to life-giving reproof will dwell among the wise.","from":23},{"book":"PRO","chapter":4,"verse":13,"verseEnd":13,"votes":11,"source":"both","text":"Hold on to instruction; do not let go. Guard it, for it is your life.","from":23},{"book":"PRO","chapter":4,"verse":4,"verseEnd":4,"votes":10,"source":"both","text":"he taught me and said, “Let your heart lay hold of my words; keep my commands and you will live.","from":23},{"book":"PSA","chapter":119,"verse":98,"verseEnd":98,"votes":9,"source":"openbible","text":"Your commandments make me wiser than my enemies, for they are always with me.","from":23},{"book":"PSA","chapter":119,"verse":100,"verseEnd":100,"votes":9,"source":"openbible","text":"I discern more than the elders, for I obey Your precepts.","from":23}],"notes":[],"groups":[]},"27-35":{"people":[],"places":[],"words":[{"base":"H3554","lemma":"כָּוָה","tr":"ka·vah","gloss":"to burn","lang":"h","inPassage":1,"uses":2},{"base":"H4672","lemma":"מָצָא","tr":"ma·tsa","gloss":"to find","lang":"h","inPassage":2,"uses":455},{"base":"H2846","lemma":"חָתָה","tr":"cha·tah","gloss":"to snatch up","lang":"h","inPassage":1,"uses":4},{"base":"H7659","lemma":"שִׁבְעָתַיִם","tr":"shiv·a·ta·yim","gloss":"sevenfold","lang":"h","inPassage":1,"uses":6},{"base":"H5315","lemma":"נֶ֫פֶשׁ","tr":"ne·phesh","gloss":"soul","lang":"h","inPassage":2,"uses":754},{"base":"H0802","lemma":"אִשָּׁה","tr":"ish·shah","gloss":"woman","lang":"h","inPassage":2,"uses":781},{"base":"H0936","lemma":"בּוּז","tr":"buz","gloss":"to despise","lang":"h","inPassage":1,"uses":12},{"base":"H7456","lemma":"רָעֵב","tr":"ra·ev","gloss":"be hungry","lang":"h","inPassage":1,"uses":13},{"base":"H1590","lemma":"גַּנָּב","tr":"gan·nav","gloss":"thief","lang":"h","inPassage":1,"uses":17},{"base":"H2638","lemma":"חָסֵר","tr":"cha·ser","gloss":"lacking","lang":"h","inPassage":1,"uses":17}],"parallels":[],"crossrefs":[{"book":"JOB","chapter":20,"verse":18,"verseEnd":18,"votes":7,"source":"both","text":"He must return the fruit of his labor without consuming it; he cannot enjoy the profits of his trading.","from":31},{"book":"LUK","chapter":19,"verse":8,"verseEnd":8,"votes":7,"source":"both","text":"But Zacchaeus stood up and said to the Lord, “Look, Lord, half of my possessions I give to the poor, and if I have cheated anyone, I will repay it fourfold.”","from":31},{"book":"EXO","chapter":22,"verse":1,"verseEnd":1,"votes":6,"source":"both","text":"“If a man steals an ox or a sheep and slaughters or sells it, he must repay five oxen for an ox and four sheep for a sheep.","from":31},{"book":"EXO","chapter":22,"verse":4,"verseEnd":4,"votes":6,"source":"openbible","text":"If what was stolen is actually found alive in his possession—whether ox or donkey or sheep—he must pay back double.","from":31},{"book":"2SA","chapter":12,"verse":6,"verseEnd":6,"votes":6,"source":"both","text":"Because he has done this thing and has shown no pity, he must pay for the lamb four times over.”","from":31},{"book":"PRO","chapter":7,"verse":7,"verseEnd":7,"votes":6,"source":"both","text":"I saw among the simple, I noticed among the youths, a young man lacking judgment,","from":32},{"book":"JOB","chapter":31,"verse":9,"verseEnd":9,"votes":5,"source":"openbible","text":"If my heart has been enticed by my neighborʼs wife, or I have lurked at his door,","from":27},{"book":"JOB","chapter":31,"verse":12,"verseEnd":12,"votes":5,"source":"openbible","text":"For it is a fire that burns down to Abaddon; it would root out my entire harvest.","from":27}],"notes":[],"groups":[]}}