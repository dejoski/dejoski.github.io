{"1-18":{"people":[{"id":"peter-g4074g","name":"Peter","kind":"person","brief":"An apostle","count":4,"firstVerse":2},{"id":"john-g2491g","name":"John","kind":"person","brief":"A prophet","count":1,"firstVerse":16},{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":1,"firstVerse":17}],"places":[{"id":"judea-h3063n","name":"Judea","kind":"place","brief":"","count":1,"firstVerse":1},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":2},{"id":"joppa-h3305","name":"Joppa","kind":"place","brief":"","count":2,"firstVerse":5},{"id":"caesarea-g2542h","name":"Caesarea","kind":"place","brief":"","count":1,"firstVerse":11}],"words":[{"base":"G4074","lemma":"Πέτρος","tr":"Petros","gloss":"Peter","lang":"g","inPassage":4,"uses":155},{"base":"G3772","lemma":"οὐρανός","tr":"ouranos","gloss":"heaven","lang":"g","inPassage":4,"uses":272},{"base":"G1909","lemma":"ἐπί","tr":"epi","gloss":"upon","lang":"g","inPassage":5,"uses":885},{"base":"G3624","lemma":"οἶκος","tr":"oikos","gloss":"house: home","lang":"g","inPassage":3,"uses":113},{"base":"G4314","lemma":"πρός","tr":"pros","gloss":"to","lang":"g","inPassage":4,"uses":700},{"base":"G2445","lemma":"Ἰόππη","tr":"Ioppē","gloss":"Joppa","lang":"g","inPassage":2,"uses":10},{"base":"G1525","lemma":"εἰσέρχομαι","tr":"eiserchomai","gloss":"to enter","lang":"g","inPassage":3,"uses":194},{"base":"G1473","lemma":"ἐγώ","tr":"egō","gloss":"I","lang":"g","inPassage":4,"uses":841},{"base":"G0435","lemma":"ἀνήρ","tr":"anēr","gloss":"man","lang":"g","inPassage":3,"uses":216},{"base":"G1537","lemma":"ἐκ","tr":"ek","gloss":"out from","lang":"g","inPassage":4,"uses":913}],"parallels":[],"crossrefs":[{"book":"ROM","chapter":10,"verse":12,"verseEnd":12,"votes":15,"source":"openbible","text":"For there is no difference between Jew and Greek: The same Lord is Lord of all, and gives richly to all who call on Him,","from":18},{"book":"ROM","chapter":10,"verse":13,"verseEnd":13,"votes":15,"source":"openbible","text":"for, “Everyone who calls on the name of the Lord will be saved.”","from":18},{"book":"ACT","chapter":1,"verse":5,"verseEnd":5,"votes":9,"source":"both","text":"For John baptized with water, but in a few days you will be baptized with the Holy Spirit.”","from":16},{"book":"2CO","chapter":7,"verse":10,"verseEnd":10,"votes":9,"source":"both","text":"Godly sorrow brings repentance that leads to salvation without regret, but worldly sorrow brings death.","from":18},{"book":"MRK","chapter":1,"verse":8,"verseEnd":8,"votes":8,"source":"both","text":"I baptize you with water, but He will baptize you with the Holy Spirit.”","from":16},{"book":"ACT","chapter":8,"verse":29,"verseEnd":29,"votes":7,"source":"both","text":"The Spirit said to Philip, “Go over to that chariot and stay by it.”","from":12},{"book":"ACT","chapter":10,"verse":47,"verseEnd":47,"votes":7,"source":"both","text":"“Can anyone withhold the water to baptize these people? They have received the Holy Spirit just as we have!”","from":17},{"book":"ACT","chapter":15,"verse":9,"verseEnd":9,"votes":7,"source":"both","text":"He made no distinction between us and them, for He cleansed their hearts by faith.","from":9}],"notes":[],"groups":[{"id":"herod-family","title":"The Herods","people":3},{"id":"john-baptist-circle","title":"John the Baptist's Circle","people":3},{"id":"paul-circle","title":"Paul's Circle","people":2},{"id":"jerusalem-church","title":"The Jerusalem Church","people":2},{"id":"high-priestly-family","title":"The High-Priestly Family","people":2},{"id":"roman-officials","title":"Roman Officials","people":2},{"id":"jesus-family","title":"Jesus and His Family Circle","people":2}]},"19-26":{"people":[{"id":"judah-h3063g","name":"Judah","kind":"person","brief":"Son of Israel","count":1,"firstVerse":19},{"id":"stephen-g4736","name":"Stephen","kind":"person","brief":"Christian deacon","count":1,"firstVerse":19},{"id":"jesus-g2424g","name":"Jesus","kind":"person","brief":"Son of Joseph","count":2,"firstVerse":20},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":2,"firstVerse":22},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":1,"firstVerse":25}],"places":[{"id":"antioch-g0490g","name":"Antioch","kind":"place","brief":"","count":4,"firstVerse":19},{"id":"cyprus-h3794h","name":"Cyprus","kind":"place","brief":"In Cyprus","count":2,"firstVerse":19},{"id":"phoenicia-g5403","name":"Phoenicia","kind":"place","brief":"","count":1,"firstVerse":19},{"id":"cyrene-g2956","name":"Cyrene","kind":"place","brief":"","count":1,"firstVerse":20},{"id":"greece-h3120h","name":"Greece","kind":"place","brief":"In Greece","count":1,"firstVerse":20},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":22},{"id":"tarsus-g5019","name":"Tarsus","kind":"place","brief":"","count":1,"firstVerse":25}],"words":[{"base":"G0490","lemma":"Ἀντιόχεια","tr":"Antiocheia","gloss":"Antioch","lang":"g","inPassage":5,"uses":18},{"base":"G2962","lemma":"κύριος","tr":"kurios","gloss":"lord: God","lang":"g","inPassage":5,"uses":714},{"base":"G2425","lemma":"ἱκανός","tr":"hikanos","gloss":"sufficient","lang":"g","inPassage":2,"uses":39},{"base":"G1330","lemma":"διέρχομαι","tr":"dierchomai","gloss":"to pass through","lang":"g","inPassage":2,"uses":43},{"base":"G1577","lemma":"ἐκκλησία","tr":"ekklēsia","gloss":"assembly","lang":"g","inPassage":2,"uses":114},{"base":"G2193","lemma":"ἕως","tr":"heōs","gloss":"until","lang":"g","inPassage":2,"uses":146},{"base":"G3793","lemma":"ὄχλος","tr":"ochlos","gloss":"crowd","lang":"g","inPassage":2,"uses":175},{"base":"G5037","lemma":"τε","tr":"te","gloss":"and","lang":"g","inPassage":2,"uses":215},{"base":"G0435","lemma":"ἀνήρ","tr":"anēr","gloss":"man","lang":"g","inPassage":2,"uses":216},{"base":"G2980","lemma":"λαλέω","tr":"laleō","gloss":"to speak","lang":"g","inPassage":2,"uses":294}],"parallels":[],"crossrefs":[{"book":"1PE","chapter":4,"verse":16,"verseEnd":16,"votes":12,"source":"openbible","text":"But if you suffer as a Christian, do not be ashamed, but glorify God that you bear that name.","from":26},{"book":"ACT","chapter":26,"verse":28,"verseEnd":28,"votes":9,"source":"both","text":"Then Agrippa said to Paul, “Can you persuade me in such a short time to become a Christian?”","from":26},{"book":"1CO","chapter":15,"verse":58,"verseEnd":58,"votes":8,"source":"both","text":"Therefore, my beloved brothers, be steadfast and immovable. Always excel in the work of the Lord, because you know that your labor in the Lord is not in vain.","from":23},{"book":"ACT","chapter":14,"verse":22,"verseEnd":22,"votes":7,"source":"both","text":"strengthening the souls of the disciples and encouraging them to continue in the faith. “We must endure many hardships to enter the kingdom of God,” they said.","from":23},{"book":"LUK","chapter":1,"verse":66,"verseEnd":66,"votes":5,"source":"both","text":"And all who heard this wondered in their hearts and asked, “What then will this child become?” For the Lordʼs hand was with him.","from":21},{"book":"ACT","chapter":2,"verse":47,"verseEnd":47,"votes":5,"source":"both","text":"praising God and enjoying the favor of all the people. And the Lord added to their number daily those who were being saved.","from":21},{"book":"ACT","chapter":5,"verse":14,"verseEnd":14,"votes":5,"source":"both","text":"Yet more and more believers were brought to the Lord—large numbers of both men and women.","from":24},{"book":"ACT","chapter":13,"verse":43,"verseEnd":43,"votes":5,"source":"both","text":"After the synagogue was dismissed, many of the Jews and devout converts to Judaism followed Paul and Barnabas, who spoke to them and urged them to continue in the grace of God.","from":23}],"notes":[],"groups":[{"id":"paul-circle","title":"Paul's Circle","people":5},{"id":"jerusalem-church","title":"The Jerusalem Church","people":5},{"id":"herod-family","title":"The Herods","people":3},{"id":"royal-line","title":"The royal line: Judah to David to Jesus","people":2},{"id":"high-priestly-family","title":"The High-Priestly Family","people":2},{"id":"roman-officials","title":"Roman Officials","people":2}]},"27-30":{"people":[{"id":"agabus-g0013","name":"Agabus","kind":"person","brief":"","count":1,"firstVerse":28},{"id":"claudius-g2804g","name":"Claudius","kind":"person","brief":"Roman Emperor","count":1,"firstVerse":28},{"id":"barnabas-g0921g","name":"Barnabas","kind":"person","brief":"Brother of Mary","count":1,"firstVerse":30},{"id":"paul-g3972g","name":"Paul","kind":"person","brief":"An apostle","count":1,"firstVerse":30}],"places":[{"id":"antioch-g0490g","name":"Antioch","kind":"place","brief":"","count":1,"firstVerse":27},{"id":"jerusalem-h3389","name":"Jerusalem","kind":"place","brief":"","count":1,"firstVerse":27},{"id":"judea-h3063n","name":"Judea","kind":"place","brief":"","count":1,"firstVerse":29}],"words":[{"base":"G0013","lemma":"Ἄγαβος","tr":"Agabos","gloss":"Agabus","lang":"g","inPassage":1,"uses":2},{"base":"G2804","lemma":"Κλαύδιος","tr":"Klaudios","gloss":"Claudius","lang":"g","inPassage":1,"uses":3},{"base":"G4591","lemma":"σημαίνω","tr":"sēmainō","gloss":"to signify","lang":"g","inPassage":1,"uses":6},{"base":"G1223","lemma":"διά","tr":"dia","gloss":"through","lang":"g","inPassage":2,"uses":666},{"base":"G3724","lemma":"ὁρίζω","tr":"horizō","gloss":"to determine","lang":"g","inPassage":1,"uses":8},{"base":"G3042","lemma":"λιμός","tr":"limos","gloss":"hunger","lang":"g","inPassage":1,"uses":12},{"base":"G1909","lemma":"ἐπί","tr":"epi","gloss":"upon","lang":"g","inPassage":2,"uses":885},{"base":"G3625","lemma":"οἰκουμένη","tr":"oikoumenē","gloss":"world","lang":"g","inPassage":1,"uses":15},{"base":"G4569","lemma":"Σαῦλος","tr":"Saulos","gloss":"Saul","lang":"g","inPassage":1,"uses":15},{"base":"G2718","lemma":"κατέρχομαι","tr":"katerchomai","gloss":"to descend","lang":"g","inPassage":1,"uses":16}],"parallels":[],"crossrefs":[{"book":"ACT","chapter":13,"verse":1,"verseEnd":1,"votes":7,"source":"both","text":"Now in the church at Antioch there were prophets and teachers: Barnabas, Simeon called Niger, Lucius of Cyrene, Manaen (who had been brought up with Herod the tetrarch), and Saul.","from":27},{"book":"2CO","chapter":8,"verse":12,"verseEnd":12,"votes":7,"source":"openbible","text":"For if the eagerness is there, the gift is acceptable according to what one has, not according to what he does not have.","from":29},{"book":"2CO","chapter":8,"verse":14,"verseEnd":14,"votes":7,"source":"openbible","text":"At the present time, your surplus will meet their need, so that in turn their surplus will meet your need. This way there will be equality.","from":29},{"book":"ACT","chapter":21,"verse":10,"verseEnd":10,"votes":6,"source":"both","text":"After we had been there several days, a prophet named Agabus came down from Judea.","from":28},{"book":"ACT","chapter":12,"verse":25,"verseEnd":25,"votes":5,"source":"both","text":"When Barnabas and Saul had fulfilled their mission to Jerusalem, they returned, bringing with them John, also called Mark.","from":30},{"book":"ACT","chapter":14,"verse":23,"verseEnd":23,"votes":5,"source":"both","text":"Paul and Barnabas appointed elders for them in each church, praying and fasting as they entrusted them to the Lord, in whom they had believed.","from":30},{"book":"1CO","chapter":12,"verse":28,"verseEnd":28,"votes":5,"source":"both","text":"And in the church God has appointed first of all apostles, second prophets, third teachers, then workers of miracles, and those with gifts of healing, helping, administration, and various tongues.","from":27},{"book":"GEN","chapter":41,"verse":30,"verseEnd":31,"votes":0,"source":"tsk","text":"but seven years of famine will follow them. Then all the abundance in the land of Egypt will be forgotten, and the famine will devastate the land. The abundance in the land will not be remembered, since the famine that follows it will be so severe.","from":28}],"notes":[],"groups":[{"id":"jerusalem-church","title":"The Jerusalem Church","people":4},{"id":"paul-circle","title":"Paul's Circle","people":3},{"id":"herod-family","title":"The Herods","people":2},{"id":"roman-officials","title":"Roman Officials","people":2}]}}